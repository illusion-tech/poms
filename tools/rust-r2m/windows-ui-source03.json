      "file": "tools/rust-r2m/windows-ui-bridge.test.mjs",
      "beforeRawBytesSha256": "87e0b28049131766aab747f41f92feae36c51fce85c6bcc7174624ebdbb9b544",
      "afterRawBytesSha256": "1d576bbfa0862cada71d0af89b50741efb32119ba06c0bb0532df82c1adc8276",
      "beforeChangedLines": [
        "import {createDriverBridge,BRIDGE_PREFIX,windowsBrowserEnvironment,validateRuntimeArrangement} from './windows-ui-driver.mjs';"
      ],
      "afterChangedLines": [
        "import {createDriverBridge,BRIDGE_PREFIX,windowsBrowserEnvironment,validateRuntimeArrangement,windowsUiPrivateFailure} from './windows-ui-driver.mjs';",
        "test('original Windows startup and close diagnostics are serialized only into the private failure frame',()=>{const error=Object.assign(new Error('synthetic-private-startup-secret'),{code:'PURE_START',privateCauses:[{stage:'browser',message:'synthetic-private-close-secret',stack:'synthetic-private-close-stack',code:'PURE_CLOSE'}]}),value=windowsUiPrivateFailure(error);assert.equal(value.message,error.message);assert.equal(value.stack,error.stack);assert.equal(value.code,error.code);assert.deepEqual(value.causes,error.privateCauses)});",
        "for(const kind of['pre-profile-driver','spawn','malformed-frame'])test('original '+kind+' failure is private and never copied into the public Windows lifecycle',{timeout:3000},async()=>{",
        " const child=new EventEmitter();Object.assign(child,{pid:190010,stdin:new PassThrough(),stdout:new PassThrough(),stderr:new PassThrough(),unref(){}});const records=[],diagnostics=[],secret='synthetic-private-'+kind+'-secret',error=Object.assign(new Error(secret),{code:'PURE_CODE',diagnostic:{message:secret}}),bridgeId='10000000-0000-4000-8000-000000000001';",
        " child.stdin.on('data',bytes=>{for(const line of bytes.toString().trim().split('\\n'))if(JSON.parse(line).type==='abort')queueMicrotask(()=>child.emit('exit',1,null))});",
        " const running=driveWindowsUi({child,options:{},bridgeId,driverSha:'a'.repeat(64),append:text=>diagnostics.push(text),totalTimeoutMs:1000,graceMs:10,queueGraceMs:200,identityTimeoutMs:100,inspect:async()=>({exists:false}),async retain(record){records.push(record);return{file:'/home/wangzishi/.local/share/poms-r2m/private/pure/'+records.length+'.json',bytes:1,rawBytesSha256:'b'.repeat(64)}}});",
        " if(kind==='pre-profile-driver'){child.stdout.write(BRIDGE_PREFIX+JSON.stringify({type:'failure',id:0,report:null,privateFailure:windowsUiPrivateFailure(error)})+'\\n');setImmediate(()=>child.emit('exit',1,null))}else if(kind==='spawn')child.emit('error',error);else child.stdout.write(BRIDGE_PREFIX+'{\"'+secret+'\": invalid}\\n');",

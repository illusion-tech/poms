            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "minItems": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "policyVersion",
          "issueCodes",
          "riskDecision",
          "evidenceRefs",
          "rationale"
        ]
      },
      "MoneyFact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge",
          "value",
          "unknownReasonCode",
          "evidenceRefs",
          "zeroProof"
        ],
        "properties": {
          "knowledge": {
            "type": "string",
            "enum": [
              "known",
              "unknown"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "unknownReasonCode": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "maxItems": 1000
          },
          "zeroProof": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "source-basis-value",
                  "sum-known-members-zero",
                  "exhaustive-classified-scope-zero"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "knowledge": {
                  "const": "known"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
                },
                "unknownReasonCode": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": "null"
                },
                "unknownReasonCode": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "zeroProof": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "value": {
                  "const": "0.00"
                }
              }
            },
            "then": {
              "properties": {
                "zeroProof": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "knowledge": {
                  "const": "known"
                },
                "value": {
                  "not": {
                    "const": "0.00"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "zeroProof": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },

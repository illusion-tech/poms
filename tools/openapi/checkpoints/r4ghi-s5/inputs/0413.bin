          "rateRef",
          "laborPeriodStart",
          "laborPeriodEnd",
          "actualHours",
          "actualPersonDays",
          "workSummary",
          "attachmentRefs",
          "stageEvidenceRefs",
          "reason"
        ],
        "properties": {
          "supersededCostRef": {
            "$ref": "#/components/schemas/ExpectedRef"
          },
          "rateRef": {
            "$ref": "#/components/schemas/ExpectedRef"
          },
          "laborPeriodStart": {
            "type": "string",

      "OperatingReasonCode": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "x-registered-rule-codes": [
          "missing-hard-evidence",
          "pending-optional-facts",
          "low-receipt-ratio",
          "risk-attention",
          "risk-confirmed",
          "restatement-pending",
          "extreme-ratio",
          "qualitative-materiality-unassessed",
          "authoritative-cost-block",
          "authoritative-cost-review",
          "normal-complete"
        ],
        "x-runtime-validation": "Must be a reason actually emitted by frozen policy for this exact evidence, not an arbitrary manual code"
      },
      "OperatingReasonView": {

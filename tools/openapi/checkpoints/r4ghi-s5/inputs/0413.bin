          "converted",
          "closed"
        ]
      },
      "LegacyAssertions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "originalBaselineCost",
          "currentEffectiveBaselineCost",
          "changePackageTotal",
          "effectiveContractTotal",
          "receivableConfirmedTotal",
          "includedCostTotal",
          "taxImpactPendingAmount",
          "currentActionLevel",
          "referencedBaselineVersion"

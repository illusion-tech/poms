                "type": "null"
              }
            ]
          },
          "actualPersonDays": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{1,8}(?:\\.[0-9]{1,2})?$"
              },
              {
                "type": "null"
              }
            ]
          },

                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentEffectiveBaselineCost": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "changePackageTotal": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effectiveContractTotal": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "receivableConfirmedTotal": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "includedCostTotal": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "taxImpactPendingAmount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentActionLevel": {
            "anyOf": [
              {
                "type": "string",

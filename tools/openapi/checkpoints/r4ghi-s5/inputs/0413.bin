{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Effective v2 public contract assembly input; no product generation",
  "components": {
    "schemas": {
      "AcceptanceRecordList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AcceptanceRecordSummary"
        }
      },
      "AcceptanceRecordSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "acceptanceType": {
            "type": "string",
            "enum": [
              "stage-outcome",
              "stage-acceptance",
              "final-acceptance"
            ]
          },
          "acceptanceResult": {
            "type": "string",
            "enum": [
              "accepted",
              "conditional",
              "rejected"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "voided"
            ]
          },
          "scopeSummary": {
            "type": "string"
          },
          "evidenceSummary": {
            "type": "string"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmationRecordId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "confirmedBy": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "createdBy": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updatedBy": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rowVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sourcePayloadHash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceQualification": {
            "enum": [
              "verified-producer",
              "legacy-unverified"
            ],
            "type": "string"
          },
          "sourceStageRecordId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidenceRefs": {
            "minItems": 0,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrozenLifecycleEvidence"
            }
          },
          "conditionalSummary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "acceptanceResult",
          "acceptanceType",
          "comment",
          "confirmationRecordId",
          "confirmedAt",
          "confirmedBy",
          "createdAt",
          "createdBy",
          "evidenceRefs",
          "evidenceSummary",
          "id",
          "projectId",
          "rowVersion",
          "scopeSummary",
          "sourcePayloadHash",
          "sourceQualification",
          "sourceStageRecordId",
          "status",
          "updatedAt",
          "updatedBy",
          "conditionalSummary"
        ]
      },
      "ActivateOperatingBaselinePackageRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approvedChangeRefs",
          "assertions",
          "expectedCurrentPackageRef",
          "expectedInputHash",
          "expectedProjectVersion",
          "expectedVersion",
          "handoverRebaselineRef",
          "inputVersion",
          "originalAdoptedCostRef",
          "projectId",
          "reason",
          "selectedHandoverBasisRef"
        ],
        "properties": {
          "inputVersion": {
            "const": "server-derived-v1",
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "expectedProjectVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "expectedInputHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "assertions": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LegacyAssertions"
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedCurrentPackageRef": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectedRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "originalAdoptedCostRef": {
            "$ref": "#/components/schemas/ExpectedRef"
          },
          "selectedHandoverBasisRef": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectedRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "handoverRebaselineRef": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectedRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "approvedChangeRefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpectedRef"
            },
            "maxItems": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "AffectedRestatementTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "expectedVersion",
          "restatesSnapshotRef",
          "periodEndSnapshotRef",
          "costDecisions"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "restatesSnapshotRef": {
            "$ref": "#/components/schemas/ExpectedRef"
          },
          "periodEndSnapshotRef": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpectedRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "costDecisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CostDecisionInput"
            },
            "maxItems": 1000
          }
        }
      },
      "AllocationCorrection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "basisRef",
          "sourceCostRefs",
          "projectShareItems",
          "reason"
        ],
        "properties": {
          "basisRef": {
            "$ref": "#/components/schemas/ExpectedRef"
          },
          "sourceCostRefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpectedRef"
            },
            "maxItems": 1000
          },
          "projectShareItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllocationShareInput"
            },
            "maxItems": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "AllocationShareInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "allocationWeight",
          "expectedCurrentResultRef",
          "reason"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "allocationWeight": {
            "type": "string",
            "pattern": "^[0-9]{1,16}(?:\\.[0-9]{1,6})?$"
          },
          "expectedCurrentResultRef": {
            "$ref": "#/components/schemas/ExpectedRef"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "BaselineSelectionSource": {
        "type": "string",
        "enum": [
          "original",
          "handover-rebaseline"
        ]
      },
      "BusinessAccountingFeedbackView": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "signalLevel": {
            "$ref": "#/components/schemas/OperatingSignalLevel"
          },
          "currentActionLevel": {
            "type": "string",
            "enum": [
              "prompt",
              "review",
              "block"
            ]
          },
          "taxImpactSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "allocationStabilitySummary": {
            "type": "null"
          },
          "unmappedCostSummary": {
            "type": "null"
          },
          "dataMaturityLevel": {
            "$ref": "#/components/schemas/OperatingDataMaturityLevel"
          },
          "costActionRecommendation": {
            "$ref": "#/components/schemas/OperatingSnapshotActionLevel"
          },
          "referencedBaselineVersion": {
            "type": "string"
          },
          "referencedSnapshotVersion": {
            "type": "string"
          },
          "nextActionSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "downstreamConsumerSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluationContext": {
            "$ref": "#/components/schemas/OperatingEvaluationContext"
          },
          "reasonItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperatingReasonView"
            }
          },
          "reviewState": {
            "type": "string",
            "enum": [
              "not-required",
              "pending",
              "acknowledged",
              "manual-confirmed",
              "stale"
            ]
          },
          "metricKnowledge": {
            "$ref": "#/components/schemas/OperatingMetricKnowledge"
          },
          "signalEvaluationId": {
            "type": "string",
            "format": "uuid"
          },
          "stageBindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperatingGateFeedbackItem"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "allocationStabilitySummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "unmappedCostSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          }
        },
        "required": [
          "allocationStabilitySummary",
          "allocationStabilitySummaryProjection",
          "allowedActions",
          "costActionRecommendation",
          "currentActionLevel",
          "dataMaturityLevel",
          "downstreamConsumerSummaryProjection",
          "evaluationContext",
          "metricKnowledge",
          "nextActionSummaryProjection",
          "projectId",
          "reasonItems",
          "referencedBaselineVersion",
          "referencedSnapshotVersion",
          "reviewState",
          "signalEvaluationId",
          "signalLevel",
          "stageBindings",
          "taxImpactSummaryProjection",
          "unmappedCostSummary",
          "unmappedCostSummaryProjection"
        ],
        "additionalProperties": false
      },
      "CloseProjectCompletionConditionRequest": {
        "additionalProperties": false,
        "required": [
          "closureSummary",
          "evidenceRefs",
          "expectedCompletionVersion",
          "expectedConditionVersion",
          "inputVersion"
        ],
        "type": "object",
        "properties": {
          "evidenceRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LifecycleEvidenceRef"
            }
          },
          "expectedConditionVersion": {
            "minimum": 1,
            "maximum": 2147483647,
            "type": "integer"
          },
          "closureSummary": {
            "maxLength": 2000,
            "minLength": 1,
            "x-trim": true,
            "type": "string"
          },
          "expectedCompletionVersion": {
            "minimum": 1,
            "maximum": 2147483647,
            "type": "integer"
          },
          "inputVersion": {
            "const": "server-derived-v1",
            "type": "string"
          }
        }
      },
      "CloseProjectCompletionConditionResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/FullProjectConditionCloseResult"
          },
          {
            "$ref": "#/components/schemas/OwnConditionCloseResult"
          }
        ],
        "discriminator": {
          "propertyName": "scopeKind"
        }
      },
      "CommissionGateBindingHistoryView": {
        "type": "object",
        "properties": {
          "bindingId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "signalEvaluationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "gateStageType": {
            "$ref": "#/components/schemas/OperatingGateStage"
          },
          "signalLevel": {
            "$ref": "#/components/schemas/OperatingSignalLevel"
          },
          "taxImpactSummary": {
            "type": "null"
          },
          "taxImpactPendingAmount": {
            "type": "null"
          },
          "dataMaturityLevel": {
            "$ref": "#/components/schemas/OperatingDataMaturityLevel"
          },
          "costActionRecommendation": {
            "$ref": "#/components/schemas/OperatingSnapshotActionLevel"
          },
          "currentActionLevel": {
            "type": "string",
            "enum": [
              "prompt",
              "review",
              "block"
            ]
          },
          "baselineSelectionSource": {
            "$ref": "#/components/schemas/BaselineSelectionSource"
          },
          "referencedBaselineVersion": {
            "type": "string"
          },
          "referencedSnapshotVersion": {
            "type": "string"
          },
          "bindingAction": {
            "$ref": "#/components/schemas/OperatingSnapshotActionLevel"
          },
          "gateReviewDecision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OperatingGateReviewDecision"
              },
              {
                "type": "null"
              }
            ]
          },
          "blockingReasonSummary": {
            "type": "null"
          },
          "summaryPackageKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "summarySnapshotId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "projectionLevel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "exportPolicy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "nextActionSummary": {
            "type": "null"
          },
          "handledBy": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "handledAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evaluationContext": {
            "$ref": "#/components/schemas/OperatingEvaluationContext"
          },
          "reasonItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperatingReasonView"
            }
          },
          "reviewState": {
            "type": "string",
            "enum": [
              "not-required",
              "pending",
              "acknowledged",
              "manual-confirmed",
              "stale"
            ]
          },
          "metricKnowledge": {
            "$ref": "#/components/schemas/OperatingMetricKnowledge"
          },
          "rowVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "systemBindingAction": {
            "type": "string",
            "enum": [
              "prompt",
              "review",
              "block"
            ]
          },
          "systemSignalLevel": {
            "$ref": "#/components/schemas/OperatingSignalLevel"
          },
          "sourceSummarySnapshotId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "taxImpactSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "taxImpactPendingAmountProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "blockingReasonSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "nextActionSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          }
        },
        "required": [
          "allowedActions",
          "baselineSelectionSource",
          "bindingAction",
          "bindingId",
          "blockingReasonSummary",
          "blockingReasonSummaryProjection",
          "costActionRecommendation",
          "currentActionLevel",
          "dataMaturityLevel",
          "evaluationContext",
          "exportPolicy",
          "gateReviewDecision",
          "gateStageType",
          "handledAt",
          "handledBy",
          "metricKnowledge",
          "nextActionSummary",
          "nextActionSummaryProjection",
          "projectId",
          "projectionLevel",
          "reasonItems",
          "referencedBaselineVersion",
          "referencedSnapshotVersion",
          "reviewState",
          "rowVersion",
          "signalEvaluationId",
          "signalLevel",
          "sourceSummarySnapshotId",
          "summaryPackageKey",
          "summarySnapshotId",
          "systemBindingAction",
          "systemSignalLevel",
          "taxImpactPendingAmount",
          "taxImpactPendingAmountProjection",
          "taxImpactSummary",

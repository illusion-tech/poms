  for(const n of['taxContinuation13','taxContinuation14','taxContinuation15','taxContinuation121'])for(const k of['pendingMain','pendingTaxTrial','normalTaxPending','unexpectedTaxACK'])assert(!state[n]?.[k]);
  const r=state.taxContinuation121;assert(r?.taxPreparation&&r.continuation121);samePin121(r.continuation121,BUDGET118.K);assert.equal(r.runtimeAdmission121.rawBytesSha256,BUDGET118.birthRegistrySHA);samePin121(r.identity.runtimeAdmission121,r.runtimeAdmission121);for(const k of['sweep','complete','sidecar'])assert.equal(r[k],null);
  const j=state.consumerChecks?.taxInvocation121?.invocations?.[BUDGET118.nonce];assert(j&&j.phase==='closed-verified'&&j.mode==='prepare-only');samePin121(j.result,r.taxPreparation.artifact);assert.equal(state.sequence,65);assert.equal(Object.keys(state.actors).length,14);assert.deepEqual(p.stateTransfer.actorCacheDelta,{actorKeys:Object.keys(state.actors).sort(),clearCookies:false,clearPermissions:false});return state;
}

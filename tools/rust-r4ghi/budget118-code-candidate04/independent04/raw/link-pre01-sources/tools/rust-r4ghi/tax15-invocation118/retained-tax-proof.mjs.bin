    "runtimeBindings",
    "bodySHA256",
    "runtimeAdmission121",
    "runtimeReference121",
];
function keys118(v, keys) {
    assert(v && typeof v === "object" && !Array.isArray(v));
    assert.deepEqual(Object.keys(v).sort(), [...keys].sort());
}
export function sourceIdentities118(list) {
    assert(Array.isArray(list) && list.length > 0);
    const normalized = list.map((p) => {
        pin118(p);
        if (p.bytes !== undefined) {
            assert(Number.isSafeInteger(p.bytes) && p.bytes >= 0);
        }
        return { file: p.file, rawBytesSha256: p.rawBytesSha256 };
    });
    assert.equal(
        new Set(normalized.map((p) => p.file)).size,
        normalized.length,
        "A source group cannot omit uniqueness by duplicating a file",
    );
    return normalized.sort((a, b) =>
        Buffer.compare(Buffer.from(a.file), Buffer.from(b.file))
    );
}
function sources118(list, relativeNames = null) {
    sourceIdentities118(list);
    if (relativeNames) {
        assert.deepEqual(
            list.map((p) => p.file).sort(),
            relativeNames.map((n) => F118.win + "/" + n).sort(),
        );
    }
    for (const p of list) read118(p);
    return list;
}
function sourceReview118(pin, closure, sources) {
    const r = json118(pin);
    assert(typeof r.kind === "string" && r.kind.startsWith("non-author-"));
    assert.equal(r.reviewerIsAuthor, false);
    assert.equal(r.verdict, "code-ready-for-exact-input-review");
    assert(r.sourceClosures && Object.hasOwn(r.sourceClosures, closure));
    sources118(r.sourceClosures[closure]);
    assert.deepEqual(
        sourceIdentities118(r.sourceClosures[closure]),
        sourceIdentities118(sources),
    );
    return r;
}
export function consumerArguments118(args) {
    keys118(args, ["consumerId", "consumerInput", "registration"]);
    assert(
        CONSUMERS118.includes(args.consumerId),
        "Only the five frozen consumer IDs",
    );
    pin118(args.consumerInput);
    pin118(args.registration);
    return args;
}
export function normalizeConsumer118(ctx, input, consumerId) {
    assert(CONSUMERS118.includes(consumerId));
    if (consumerId === "h15-287" || consumerId === "role15-setup") return null;
    const v = consumerId === "shared15-284" ? input.runtime : input;
    assert(v && typeof v === "object");
    if (consumerId === "shared15-284") {
        const required = [
            "sourcePins",
            "sourcePinsSHA256",
            "sourceCount",
            "helperH3",
            "helperCount",
            "codeAdmission15",
            "candidate",
            "apiProcess",
            "binarySHA256",
            "trustedSummaryBinary",
            "taxRuntimeBindings",
            "taxCompletion",
        ];
        keys118(v, required);
        return {
            sourcePins: v.sourcePins,
            sourcePinsSHA256: v.sourcePinsSHA256,
            sourceCount: v.sourceCount,
            helperPins: v.helperH3,
            helperCount: v.helperCount,
            helperSources: structuredClone(ctx.helperPins),
            apiProcess: v.apiProcess,
            binarySHA256: v.binarySHA256,
            codeAdmission15: v.codeAdmission15,
            candidate: v.candidate,
            taxRuntimeBindings: v.taxRuntimeBindings,
            taxCompletion: v.taxCompletion,
        };
    }
    return Object.fromEntries(RUNTIME12_118.map((k) => {
        assert(
            Object.hasOwn(v, k),
            "Missing native top-level runtime field: " + k,
        );
        return [k, v[k]];
    }));
}
export function assertInvocationJournal118(summary, sidecar, inventory) {
    pin118(summary.closedJournal);
    const journal = json118(summary.closedJournal),
        input = json118(summary.input),
        review = json118(summary.exactReview),
        entry = json118(summary.entryGuard),
        exit = json118(summary.exitGuard);
    assert.equal(summary.phase, journal.phase);
    assert(
        journal.phase === "closed-verified" ||
            journal.phase === "closed-failed" &&
                ["fi-closed-set", "fi-family"].includes(journal.mode),
    );
    for (
        const k of [
            "nonce",
            "pid",
            "bootId",
            "mode",
            "input",
            "exactReview",
            "codeReview",
            "entryGuard",
            "exitGuard",
            "executionSources",
            "prepareFactsSources",
        ]
    ) assert.deepEqual(summary[k], journal[k]);
    assert.equal(journal.epoch, F118.epoch);
    assert.equal(journal.run, F118.run);
    assert.equal(entry.phase, "entry-verified");
    assert.equal(exit.phase, "exit-verified");
    assert.equal(input.kind, "Root-reviewed-Tax15-invocation118");
    assert.equal(input.mode, journal.mode);
    assert.equal(input.nonce, journal.nonce);
    assert.equal(review.kind, "Root-approved-exact-Tax15-invocation118");
    assert.equal(review.actualG2Authorized, true);
    samePin118(review.approvedInput, summary.input);
    samePin118(review.codeReview, summary.codeReview);
    samePin118(review.expectedEntryState, input.expectedEntryState);
    assert.equal(review.mode, journal.mode);
    assert.equal(review.nonce, journal.nonce);
    assert.equal(review.normalTaxPOSTGranted, journal.mode === "commit-once");
    assert.equal(
        review.FIGranted,
        ["fi-closed-set", "fi-family"].includes(journal.mode),
    );
    samePin118(input.runtimeBindings, sidecar.runtimeBindings);
    samePin118(input.codeAdmission15, sidecar.codeAdmission15);
    samePin118(input.candidate, sidecar.candidate);
    samePin118(input.apiProcess, sidecar.apiProcess);
    const ordered = (list) =>
        [...list].sort((a, b) => a.file.localeCompare(b.file));
    assert.deepEqual(
        ordered(input.executionSources),
        ordered([
            ...sidecar.executionSources,
            ...sidecar.prepareFactsSources,
        ]),
    );
    assert.deepEqual(journal.executionSources, sidecar.executionSources);
    assert.deepEqual(journal.prepareFactsSources, sidecar.prepareFactsSources);
    samePin118(journal.codeReview, sidecar.codeReview);
    samePin118(entry.input, summary.input);
    samePin118(exit.input, summary.input);
    samePin118(entry.exactReview, summary.exactReview);
    assert.equal(entry.nonce, journal.nonce);
    assert.equal(exit.nonce, journal.nonce);
    assert.equal(entry.pid, journal.pid);
    assert.equal(exit.pid, journal.pid);
    assert.equal(entry.bootId, journal.bootId);
    assert.equal(exit.bootId, journal.bootId);
    read118(input.expectedEntryState);
    if (journal.result) read118(journal.result);
    else assert.equal(journal.phase, "closed-failed");
    assert.deepEqual(
        journal.commandLedgers,
        journal.httpAttempts.map((a) => a.ledger),
    );
    for (const a of journal.httpAttempts) {
        const wire = json118(a.http), ledger = json118(a.ledger);
        samePin118(wire.runtimeReference121.runtimeAdmission121,sidecar.runtimeAdmission121);samePin118(wire.runtimeReference121.candidate,sidecar.candidate);samePin118(wire.runtimeReference121.apiProcess,sidecar.apiProcess);assert.deepEqual(json118(wire.originals.requestConfig).runtimeReference121,wire.runtimeReference121);
        assert.equal(wire.responseComplete, true);
        assert.equal(wire.transportFailure, false);
        assert.equal(ledger.ownershipComplete, true);
        assert.deepEqual(ledger.blockers, []);
        assert.equal(ledger.requestId, wire.requestId);
        assert.equal(ledger.operationId, wire.operationId);
        samePin118(ledger.before, a.before);
        samePin118(ledger.after, a.after);
        for (const p of Object.values(wire.originals)) read118(p);
        if (wire.operationId === F118.operation) {
            assert(
                ["fi-closed-set", "fi-family", "commit-once"].includes(
                    journal.mode,
                ),
            );
            assert.equal(
                wire.status,
                journal.mode === "commit-once" ? 201 : 500,
            );
            assert.equal(
                sha118(read118(wire.originals.requestBody)),
                sidecar.bodySHA256,
            );
        } else {
            assert(
                [
                    "AuthController_getCsrfToken",
                    "AuthController_createPasswordAuthSession",
                    "AuthController_getCurrentAuthSession",
                    "ProjectCostController_getProjectUnifiedAccounting",
                ].includes(wire.operationId),
            );
            if (
                wire.operationId ===
                    "ProjectCostController_getProjectUnifiedAccounting"
            ) assert.equal(journal.mode, "prepare-only");
        }
    }
    if (["fi-closed-set", "fi-family"].includes(journal.mode)) {
        const groups = new Map();
        for (const f of journal.families) {
            const a = groups.get(f.cursor) ?? [];
            a.push(f);
            groups.set(f.cursor, a);
        }
        const stages = [
            "ready",
            "authenticated",
            "beforeCaptured",
            "controlsInstalled",
            "requestPending",
            "responseRecorded",
            "controlsRemoved",
            "afterCaptured",
            "reconciled",
            "familyVerified",
        ];
        for (const [cursor, frames] of groups) {
            assert.equal(frames[0].key, inventory[cursor]?.key);
            const complete = frames.at(-1).stage === "familyVerified";
            assert(
                complete || journal.phase === "closed-failed",
                "Only a stopped FI journal may contain an incomplete trailing family",
            );
            assert.deepEqual(
                frames.map((f) => f.stage),
                complete ? stages : stages.slice(0, frames.length),
            );
            for (const f of frames) {
                assert.equal(f.cursor, cursor);
                assert.equal(f.key, inventory[cursor].key);
                assert.equal(f.bodySHA256, sidecar.bodySHA256);
            }
            if (complete) {
                const listedReceipt =
                    json118(frames.at(-1).observation).failed.receipt;
                assert(
                    journal.httpAttempts.some((a) =>
                        a.http.file ===
                            (typeof listedReceipt === "string"
                                ? listedReceipt
                                : listedReceipt.file)
                    ),
                    "A covered family needs its actual listed HTTP attempt",
                );
                const final = frames.at(-1),
                    o = json118(final.observation),
                    wire = json118(
                        typeof o.failed.receipt === "string"
                            ? {
                                file: o.failed.receipt,
                                rawBytesSha256: sha118(
                                    fs.readFileSync(o.failed.receipt),
                                ),
                            }
                            : o.failed.receipt,
                    );
                samePin118(final.before, o.failed.before);
                samePin118(final.after, o.failed.after);
                samePin118(final.ledger, o.failed.ledger);
                assert.equal(final.requestId, wire.requestId);
                assert.equal(final.sessionId, o.failed.fault.sessionId);
                assert.equal(
                    final.response.receipt,
                    typeof o.failed.receipt === "string"
                        ? o.failed.receipt
                        : o.failed.receipt.file,
                );
                assert.deepEqual(final.controlIdentity, {
                    primary: o.failed.fault.primary.identitySHA,
                    fallback: o.failed.fault.fallback.identitySHA,
                });
                for (const f of frames) {
                    for (
                        const k of [
                            "requestId",
                            "sessionId",
                            "before",
                            "controlIdentity",
                            "response",
                            "after",
                            "ledger",
                        ]
                    ) {
                        if (f[k] !== undefined) {
                            assert.deepEqual(
                                f[k],
                                final[k],
                                "Immutable family phase fact changed: " + k,
                            );
                        }
                    }
                }
            }
        }
    }
    return journal;
}
export function verifyStoppedFIJournal118(ctx, journal, bodySHA256, actorId) {
    assert.equal(journal.phase, "closed-failed");
    assert(["fi-closed-set", "fi-family"].includes(journal.mode));
    const dispatched = new Set(
        journal.httpAttempts.map((a) => json118(a.http)).filter((w) =>
            w.operationId === F118.operation
        ).map((w) => w.requestId),
    );
    for (const f of journal.families) {
        if (
            [
                "requestPending",
                "responseRecorded",
                "controlsRemoved",
                "afterCaptured",
                "reconciled",
                "familyVerified",
            ].includes(f.stage)
        ) {
            assert(
                dispatched.has(f.requestId),
                "An unrecorded dispatched attempt remains unknown; no prefix recovery",
            );
        }
    }
    for (const a of journal.httpAttempts) {
        const wire = json118(a.http);
        assert.equal(
            wire.responseComplete,
            true,
            "An unknown transport is never a recoverable FI prefix",
        );
        assert.equal(wire.transportFailure, false);
        if (wire.operationId !== F118.operation) continue;
        assert.equal(
            wire.status,
            500,
            "An acknowledged business success is never replayed",
        );
        assert.equal(sha118(read118(wire.originals.requestBody)), bodySHA256);
        assert.deepEqual(json118(wire.originals.responseBody), {
            statusCode: 500,
            message: "Internal server error",
        });
        assert(a.fault?.receipt && a.fault.sessionId);
        const removed = json118(a.fault.receipt);
        assert.equal(removed.identityMatched, true);
        assert.equal(removed.active.requestId, wire.requestId);
        assert.equal(removed.active.kind, F118.faultKind);
        assert.equal(removed.counts.primary, a.fault.hitCount);
        assert.equal(removed.counts.fallback, a.fault.fallbackHitCount);
        const before = json118(a.before), after = json118(a.after);
        for (const s of [before, after]) {
            assert.equal(s.epoch, F118.epoch);
            assert.equal(s.run, F118.run);
            assert.equal(s.marker, ctx.state.marker);
            assert.deepEqual(
                Object.keys(s.databases).sort(),
                [...ctx.databases].sort(),
            );
            for (const db of ctx.databases) {
                assert.equal(Object.keys(s.databases[db].tables).length, 139);
            }
        }
        assertSweepRollback(ctx, before, after, a.fault, actorId);
    }
    return true;
}
function assertSidecar118(ctx, pin, envelopePin, registration) {
    const sidecar = json118(pin), envelope = json118(envelopePin);
    assert.equal(sidecar.kind, "actual-Source15-runtime121-Tax118-execution-sidecar");
    assert.equal(sidecar.schemaVersion, 2);
    assert.equal(sidecar.namespace, F118.namespace);
    assert.equal(sidecar.epoch, F118.epoch);
    assert.equal(sidecar.run, F118.run);
    assert.equal(sidecar.sourceGeneration, 15);
    assert.equal(sidecar.oldProducerRecordsEdited, false);
    assert.equal(sidecar.G3, false);
    assert.equal(sidecar.G4, false);
    samePin118(sidecar.completion, envelopePin);
    samePin118(sidecar.afterVerifiedFrame, envelope.afterVerifiedFrame);
    samePin118(
        sidecar.afterVerifiedFrame,
        ctx.state.taxContinuation121.sweep.afterVerifiedFrame,
    );
    samePin118(sidecar.fiCompletion, envelope.fiCompletionProof);
    samePin118(sidecar.runtimeAdmission121,envelope.runtimeAdmission121);assert.deepEqual(sidecar.runtimeReference121,envelope.runtimeReference121);
    samePin118(sidecar.retainedSource15State,envelope.retainedSource15State);
    assert.deepEqual(sidecar.retainedPreparation15,envelope.retainedPreparation15);
    samePin118(sidecar.continuation121,envelope.continuation121);
    samePin118(sidecar.continuationReadback,envelope.continuationReadback);
    for (
        const k of [
            "runtimeBindings",
            "codeAdmission15",
            "candidate",
            "apiProcess",
        ]
    ) samePin118(sidecar[k], envelope[k]);
    assert.equal(sidecar.sourcePinsSHA256, envelope.sourcePinsSHA256);
    assert.equal(sidecar.bodySHA256, envelope.bodySHA256);
    assert.equal(sidecar.scopeSHA256, sha118(JSON.stringify(envelope.scope)));
    assert.equal(
        sidecar.inventorySHA256,
        sha118(JSON.stringify(envelope.inventory)),
    );
    assert.deepEqual(sidecar.familyResults, envelope.failures);
    assert.deepEqual(sidecar.normalSuccess, envelope.finalSuccess);
    assert.deepEqual(
        sourceIdentities118(sidecar.executionSources),
        sourceIdentities118(registration.producerExecutionSources),
    );
    assert.deepEqual(
        sourceIdentities118(sidecar.prepareFactsSources),
        sourceIdentities118(registration.prepareFactsSources),
    );
    samePin118(sidecar.codeReview, registration.producerCodeReview);
    samePin118(sidecar.codeReview, registration.prepareFactsCodeReview);
    assert.equal(sidecar.technicalG1.rawBytesSha256, F118.g1SHA);
    read118(sidecar.technicalG1);
    const frame = json118(sidecar.afterVerifiedFrame);
    keys118(frame.current15, CURRENT15_118);
    assert.deepEqual(registration.current15, frame.current15);assert.deepEqual(sidecar.runtimeReference121,frame.current15.runtimeReference121);
    samePin118(frame.normalResult, sidecar.verification);
    samePin118(frame.fiCompletion, sidecar.fiCompletion);
    const journals = sidecar.invocations.map((s) =>
        assertInvocationJournal118(s, sidecar, envelope.inventory)
    );
    for (let i = 0; i < journals.length; i++) {
        if (journals[i].phase === "closed-failed") {
            verifyStoppedFIJournal118(
                ctx,
                journals[i],
                sidecar.bodySHA256,
                envelope.scope.actorId,
            );
            const stoppedPin = sidecar.invocations[i].closedJournal;
            const recoveries = journals.filter((j) =>
                j.mode === "fi-family" && j.phase === "closed-verified"
            ).map((j) => json118(json118(j.input).approvedRecovery));
            assert(
                recoveries.some((r) =>
                    r.stoppedInvocations?.some((p) =>
                        p.file === stoppedPin.file &&
                        p.rawBytesSha256 === stoppedPin.rawBytesSha256
                    )
                ),
                "Every retained interrupted prefix requires its own exact recovery approval",
            );
        }
    }
    assert.equal(new Set(journals.map((j) => j.nonce)).size, journals.length);
    const preparedJournals=journals.filter(j=>j.mode==="prepare-only");assert.equal(preparedJournals.length,1);const continuation=json118(sidecar.continuation121);samePin118(continuation.closedJournal,sidecar.invocations.find(j=>j.mode==="prepare-only").closedJournal);samePin118(continuation.runtimeAdmission121,sidecar.runtimeAdmission121);
    const commits = journals.filter((j) => j.mode === "commit-once");
    assert.equal(commits.length, 1);
    samePin118(commits[0].result, sidecar.verification);
    samePin118(commits[0].entryGuard, frame.entryGuard);
    samePin118(commits[0].exitGuard, frame.exitGuard);
    samePin118(
        sidecar.invocations.find((j) => j.mode === "commit-once").closedJournal,
        frame.closedJournal,
    );
    const families = journals.filter((j) =>
        ["fi-closed-set", "fi-family"].includes(j.mode)
    ).flatMap((j) => j.families.filter((f) => f.stage === "familyVerified"));
    assert.deepEqual(
        families.map((f) => f.key),
        envelope.inventory.map((d) => d.key),
    );
    assert.equal(families.length, envelope.failures.length);
    for (let i = 0; i < families.length; i++) {
        samePin118(families[i].observation, envelope.failures[i].observation);
    }
    return { sidecar, envelope, frame };
}
export async function consumeTax15Completion(ctx, args) {
    const { consumerId, consumerInput, registration } = consumerArguments118(
            args,
        ),
        originalInput = read118(consumerInput),
        input = JSON.parse(originalInput),
        reg = json118(registration);
    assert.equal(ctx.namespace, F118.namespace);
    assert.equal(ctx.epoch, F118.epoch);
    assert.equal(ctx.run, F118.run);
    assert(
        consumerInput.file.startsWith(ctx.priv + "/") &&
            registration.file.startsWith(ctx.priv + "/"),
    );
    keys118(reg, [
        "kind",
        "schemaVersion",
        "consumerId",
        "interfaceContract",
        "readerSources",
        "readerCodeReview",
        "producerExecutionSources",
        "producerCodeReview",
        "prepareFactsSources",
        "prepareFactsCodeReview",
        "callerExecutionSources",
        "callerCodeReview",
        "current15",
        "effectsGranted",
    ]);
    assert.equal(
        reg.kind,
        "Root-reviewed-Source15-runtime121-Tax118-consumer-registration",
    );
    assert.equal(reg.schemaVersion, 2);
    assert.equal(reg.consumerId, consumerId);
    assert.equal(reg.effectsGranted, false);
    assert.equal(reg.interfaceContract.rawBytesSha256, F118.interfaceSHA);
    read118(reg.interfaceContract);
    samePin118(input.tax118ConsumerRegistration, registration);
    const sidecarPin = pin118(input.taxExecution118Sidecar);
    samePin118(ctx.state.taxContinuation121.sidecar, sidecarPin);
    sources118(reg.readerSources, NATIVE118);
    sources118(reg.producerExecutionSources, EXEC118);
    sources118(reg.prepareFactsSources, PREP118);
    sources118(reg.callerExecutionSources);
    sourceReview118(reg.readerCodeReview, "nativeTax15", reg.readerSources);
    sourceReview118(
        reg.producerCodeReview,
        "executor118",
        reg.producerExecutionSources,
    );
    sourceReview118(
        reg.prepareFactsCodeReview,
        "prepareFacts118",
        reg.prepareFactsSources,
    );
    sourceReview118(
        reg.callerCodeReview,
        consumerId,
        reg.callerExecutionSources,
    );
    const union = new Map();
    for (
        const p of [
            ...reg.readerSources,
            ...reg.producerExecutionSources,
            ...reg.prepareFactsSources,
            ...reg.callerExecutionSources,
        ]
    ) {
        if (union.has(p.file)) samePin118(union.get(p.file), p);
        else union.set(p.file, p);
    }
    if (consumerId === "mixed15-271") {
        const period = json118(input.periodCompletion),
            priorPin = pin118(period.verificationInput),
            prior = json118(priorPin);
        assert(
            !(prior.tax118ConsumerRegistration.file === registration.file &&
                prior.tax118ConsumerRegistration.rawBytesSha256 ===
                    registration.rawBytesSha256),
            "Prior period uses its own registration",
        );
        samePin118(prior.taxExecution118Sidecar, sidecarPin);
        samePin118(prior.taxRuntimeBindings, input.taxRuntimeBindings);
        samePin118(prior.taxCompletion, input.taxCompletion);
        await consumeTax15Completion(ctx, {
            consumerId: "period15-270",
            consumerInput: priorPin,
            registration: prior.tax118ConsumerRegistration,
        });
    }
    // Fixed native entrypoints only. Neither the input nor the registration can
    // supply a module, export, callback, wrapper, or old14 fallback.
    const native = await import(
        pathToFileURL(
            F118.win + "/tools/rust-r4ghi/tax15-readonly/runtime15.mjs",
        ).href
    );
    let proof, envelopePin;
    if (consumerId === "h15-287" || consumerId === "role15-setup") {
        envelopePin = consumerId === "h15-287"
            ? input.taxCompletion15
            : input.taxCompletion;
        proof = native.readTax15SecurityCompletion(
            ctx,
            input.environmentBindings15,
            envelopePin,
        );
    } else {
        const normalized = normalizeConsumer118(ctx, input, consumerId);
        envelopePin = normalized.taxCompletion;
        proof = native.assertTax15Envelope(ctx, normalized);
    }
    const verified = assertSidecar118(ctx, sidecarPin, envelopePin, reg);
    for (const p of union.values()) read118(p);
    assert(read118(consumerInput).equals(originalInput));
    read118(registration);
    read118(sidecarPin);
    read118(envelopePin);
    return freeze118(structuredClone({
        ...proof,
        invocation118Sidecar: {
            sidecar: sidecarPin,
            runtimeAdmission121:verified.sidecar.runtimeAdmission121,
            continuation121:verified.sidecar.continuation121,
            registration,
            consumerInput,
            consumerId,
            interfaceContract: reg.interfaceContract,
            actualReaderSources: reg.readerSources,
            afterVerifiedFrame: verified.sidecar.afterVerifiedFrame,
            externalExecutorVerified: true,
            effectsGranted: false,
        },
    }));
}

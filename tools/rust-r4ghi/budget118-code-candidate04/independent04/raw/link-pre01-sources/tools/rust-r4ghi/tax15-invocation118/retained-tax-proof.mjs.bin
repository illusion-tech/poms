    "tools/rust-r4ghi/tax15-invocation118/" + n
);
const NATIVE118 = [
    "tools/rust-r4ghi/tax15-readonly/runtime15.mjs",
    "tools/rust-r4ghi/tax15-readonly/facts15.mjs",
];
const RUNTIME12_118 = [
    "sourcePins",
    "sourcePinsSHA256",
    "sourceCount",
    "helperPins",
    "helperCount",
    "helperSources",
    "apiProcess",
    "binarySHA256",
    "codeAdmission15",
    "candidate",
    "taxRuntimeBindings",
    "taxCompletion",
];
const CURRENT15_118 = [
    "namespace",
    "epoch",
    "run",
    "marker",
    "prefix",
    "api",
    "apiProcess",
    "binarySHA256",
    "codeAdmission15",
    "candidate",

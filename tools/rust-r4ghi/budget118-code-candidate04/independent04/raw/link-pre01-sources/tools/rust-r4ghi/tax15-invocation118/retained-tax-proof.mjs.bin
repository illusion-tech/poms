export const sha118 = (b) => createHash("sha256").update(b).digest("hex");
export function pin118(p) {
    assert(
        p && typeof p.file === "string" && p.file.startsWith("/") &&
            !p.file.startsWith("//") && !p.file.includes("\\") &&
            path.posix.normalize(p.file) === p.file,
        "Exact Linux absolute pin",
    );
    assert(/^[a-f0-9]{64}$/.test(p.rawBytesSha256));
    return p;
}
export function samePin118(a, b) {
    pin118(a);
    pin118(b);
    assert.equal(a.file, b.file);
    assert.equal(a.rawBytesSha256, b.rawBytesSha256);
    if (a.bytes !== undefined && b.bytes !== undefined) {
        assert.equal(a.bytes, b.bytes);
    }
}
export function read118(p) {
    pin118(p);
    const s = fs.lstatSync(p.file, { bigint: true });
    assert(s.isFile() && !s.isSymbolicLink() && s.nlink === 1n);
    assert.equal(fs.realpathSync(p.file), p.file);
    const fd = fs.openSync(
        p.file,
        fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0),
    );
    let b;
    try {
        const a = fs.fstatSync(fd, { bigint: true });
        assert.equal(a.dev, s.dev);
        assert.equal(a.ino, s.ino);
        b = fs.readFileSync(fd);
        const z = fs.fstatSync(fd, { bigint: true });
        for (const k of ["dev", "ino", "size", "mtimeNs", "ctimeNs"]) {
            assert.equal(z[k], a[k]);
        }
    } finally {
        fs.closeSync(fd);
    }
    assert.equal(sha118(b), p.rawBytesSha256);
    if (p.bytes !== undefined) assert.equal(b.length, p.bytes);
    return b;
}
export const json118 = (p) => JSON.parse(read118(p));
export function freeze118(v) {
    if (v && typeof v === "object" && !Object.isFrozen(v)) {
        for (const x of Object.values(v)) freeze118(x);
        Object.freeze(v);
    }
    return v;
}
export function rows118(meta) {
    return read118(meta).toString().split("\n").filter(Boolean).map((t) => {
        const r = JSON.parse(t);
        assert.equal(sha118(r.raw), r.sha256);
        return r;
    });
}

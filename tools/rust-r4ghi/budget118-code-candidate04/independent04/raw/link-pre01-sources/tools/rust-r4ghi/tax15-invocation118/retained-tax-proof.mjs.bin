function checkpointTax14(ctx, checkpoint, operationId) {
    assert.equal(checkpoint?.phase, "actual-success");
    const original = JSON.parse(read118(checkpoint.original));
    assert.equal(original.operationId, operationId);
    assert.deepEqual(original.value, checkpoint.value);
    assert.equal(original.receipt, checkpoint.receiptId);
    assert(
        original.ordinaryProducerOnly === true && original.FIClaimed === false,
    );
    const publicBytes = fs.readFileSync(original.receipt),
        http = JSON.parse(publicBytes);
    assert.equal(http.operationId, operationId);
    assert.equal(http.responseComplete, true);
    assert.equal(http.transportFailure, false);
    assert(http.status >= 200 && http.status < 300);
    assert.equal(http.status, http.expectedStatus);
    for (const p of Object.values(http.originals)) read118(p);
    const body = JSON.parse(read118(http.originals.responseBody));
    assert.deepEqual(body.data ?? body, original.value);
    assert.deepEqual(
        JSON.parse(read118(http.originals.requestBody)),
        original.request,
    );
    const before = JSON.parse(read118(original.before)),
        after = JSON.parse(read118(original.after));
    assert.equal(before.epoch, "g2-business12");
    assert.equal(after.epoch, "g2-business12");
    return {
        checkpoint,
        original,
        http,
        httpPin: { file: original.receipt, rawBytesSha256: sha(publicBytes) },
    };
}

export function readRetainedTaxProof118(ctx, manifest, registry, ticket = null) {
    if (ticket !== null) budgetNative121.assertBudgetProbeDispatch121(ctx, ticket);
    const verified = { registry };
    const oldState = JSON.parse(
        read118(manifest.legacy.originalProducerState12),
    );
    const identity = producerRootIdentity13(ctx, manifest, oldState);
    const { tax: t, projectIds } = identity;
    const currentRecord121=pointer54(ctx.state,manifest.legacy.registryPath);assert.deepEqual(currentRecord121,identity.old);
    const admitted = retainedFixture118(ctx, verified.registry, {
        registryPath: manifest.legacy.registryPath,
        record: currentRecord121,
        projectIds,
        producerReceipt: manifest.legacy.reconciliation,
    }, ticket);
    samePin118(
        admitted.originalProducerState,
        manifest.legacy.originalProducerState12,
    );
    samePin118(
        admitted.retainedProducerState,
        manifest.current.retainedSource15State,
    );
    samePin118(admitted.codeAdmission15, manifest.current.codeAdmission15);
    assert.equal(admitted.retainedProducerOnly, true);
    assert.equal(admitted.producerEpoch, "g2-business12");
    assert.equal(
        sha118(JSON.stringify(oldState.sourcePins)),
        manifest.legacy.sourcePinsSHA256,
    );
    const reconcile = JSON.parse(read118(manifest.legacy.reconciliation));
    assert.equal(
        reconcile.kind,
        "exact-metadata-only-known-Main-409-after-real-Tax-producer",
    );
    assert.equal(reconcile.failedMainSnapshotPublished, false);
    assert.equal(reconcile.producerComplete, false);
    assert.equal(reconcile.correctionPOSTExecuted, false);
    assert.equal(
        reconcile.noExpenseEFTaxAllocationOrSuccessfulSnapshotReplay,
        true,
    );
    samePin118(reconcile.ledger, manifest.legacy.failedMainLedger);
    samePin118(
        reconcile.successfulReceiverSnapshot,
        manifest.legacy.receiverSuccess,
    );
    assert.equal(
        reconcile.originalPending.bodySHA256,
        manifest.legacy.failedMainRequestBody.rawBytesSha256,
    );
    assert.equal(
        reconcile.originalPending.key,
        "snapshot:" + identity.mainProjectId,
    );
    read118(manifest.legacy.partial);
    const failedBody = JSON.parse(
        read118(manifest.legacy.failedMainRequestBody),
    );
    assert.equal(failedBody.projectId, identity.mainProjectId);
    const ledger = JSON.parse(read118(manifest.legacy.failedMainLedger));
    assert(
        ledger.ownershipComplete && ledger.recorded.length === 0 &&
            ledger.blockers.length === 0,
    );
    assert.equal(
        reconcile.rollback.allBusinessAuditSecurityRowsAndXminUnchanged,
        true,
    );
    const failedHTTP = JSON.parse(read118(reconcile.failedHTTP));
    assert.equal(
        failedHTTP.operationId,
        "ProjectCostController_createProjectOperatingSnapshot",
    );
    assert.equal(failedHTTP.requestId, ledger.requestId);
    assert.equal(failedHTTP.status, 409);
    assert.equal(failedHTTP.responseComplete, true);
    assert.equal(failedHTTP.transportFailure, false);
    samePin118(
        failedHTTP.originals.requestBody,
        manifest.legacy.failedMainRequestBody,
    );
    assert.equal(
        JSON.parse(read118(failedHTTP.originals.responseBody)).code,
        "operating_cost_source_missing",
    );
    for (const p of Object.values(failedHTTP.originals)) read118(p);
    const snapshots = [
        ledger.before,
        ledger.after,
        reconcile.freshEquivalentSnapshot,
    ].map((p) => JSON.parse(read118(p)));
    for (const other of snapshots.slice(1)) {
        assertEquivalentSnapshotsTax13(snapshots[0], other);
    }
    const operations = {
        expense: "ProjectCostController_createExpenseRecord",
        expenseConfirmed: "ProjectCostController_confirmExpenseRecord",
        cost: "ProjectCostController_createProjectActualCostRecord",
        stage: "ProjectCostController_confirmCostStageAttribution",
        tax: "ProjectCostController_confirmAccountingTaxTreatment",
        allocation: "ProjectCostController_confirmSharedCostAllocationBasis",
        ["snapshot:" + identity.sourceProjectId]:
            "ProjectCostController_createProjectOperatingSnapshot",
    };
    const checkpoints = {};
    for (const [key, op] of Object.entries(operations)) {
        checkpoints[key] = checkpointTax14(ctx, t[key], op);
    }
    samePin118(
        t["snapshot:" + identity.sourceProjectId].original,
        manifest.legacy.receiverSuccess,
    );
    assert.deepEqual(
        checkpoints["snapshot:" + identity.sourceProjectId].original,
        JSON.parse(read118(manifest.legacy.receiverSuccess)),
    );
    const costId = uuid(t.cost.value.targetId),
        taxId = uuid(t.tax.value.targetId),
        basisId = uuid(t.allocation.value.basisId),
        expenseId = uuid(t.expense.value.id),
        resultIds = t.allocation.value.allocationResultIds.map(uuid);
    assert.equal(resultIds.length, 2);
    assert.equal(
        checkpoints.tax.original.request.taxImpactPendingAmount,
        "130.00",
    );
    assert.equal(checkpoints.tax.original.request.taxImpactAmount, "0.00");
    assert.equal(
        checkpoints.tax.original.request.deductibilityStatus,
        "pending",
    );
    return {
        ...identity,
        admitted,
        checkpoints,
        costId,
        taxId,
        basisId,
        expenseId,
        resultIds,
        taxRequest: structuredClone(checkpoints.tax.original.request),
        producerStatePin: manifest.legacy.originalProducerState12,
        reconciliation: manifest.legacy.reconciliation,
        retainedMain13: retainedMain118(ctx, manifest, verified.registry, ticket),
    };
}

export const CONSUMERS118 = Object.freeze([
    "h15-287",
    "shared15-284",

// Bounded author regressions using the existing 362 declared-identity scaffold.
// Complete candidate modules run in isolated VM contexts. Every candidate I/O
// is virtual/forbidden; no Root Native/Core/app, P, proc/env, SQL or HTTP runs.
import fs from 'node:fs';
import path from 'node:path';
import vm from 'node:vm';
import assert from 'node:assert/strict';
import crypto,{createHash} from 'node:crypto';
import {isProxy} from 'node:util/types';
import {isDeepStrictEqual} from 'node:util';
import {fileURLToPath,pathToFileURL} from 'node:url';
const here=path.dirname(fileURLToPath(import.meta.url)),base=path.dirname(here),proposed=base+'/'+process.argv[2]+'/tools/rust-r4ghi';
const names={core:'business/runtime-admission-core121.mjs',native:'business/runtime-admission121.mjs',publisher:'runtime-recovery121/native/publish-runtime121.mjs',nativeData:'runtime-recovery121/Native-plan-data-candidate01/prepare-native-plan121.mjs',taxData:'runtime-recovery121/Tax121-current-metadata-data-candidate01/prepare-tax121-current-metadata.mjs'};
const code=Object.fromEntries(Object.entries(names).map(([k,p])=>[k,fs.readFileSync(proposed+'/'+p,'utf8')]));
const sha=b=>createHash('sha256').update(b).digest('hex');
const coreExports=[...code.core.matchAll(/export\s+(?:function|const)\s+([A-Za-z_][A-Za-z0-9_]*)/g)].map(m=>m[1]);
const strip=s=>s.replace(/^import[\s\S]*?from ['"][^'"]+['"];\r?\n/gm,'').replace(/^export /gm,'').replaceAll('import.meta.url',JSON.stringify('/SYNTHETIC-118-CANDIDATE-NOT-CLI'));
const scaffold=fs.readFileSync(here+'/scaffold362.mjs.txt','utf8')+'\n'+fs.readFileSync(here+'/scaffold118.mjs.txt','utf8');
const serialized=fs.readFileSync(here+'/public-basis362.json','utf8'),jointSerialized=fs.readFileSync(here+'/joint-G1.json','utf8'),graphSerialized=fs.readFileSync(here+'/execution284-before.json','utf8');
assert.equal(sha(jointSerialized),'68212af41282071678d3e062dd689fbffbf2b74443de0c5872bb2511e4d0c5a2');
assert.equal(sha(graphSerialized),'b8fd572ffa1e32ff581631410bcacc48e4350c51d4308e96d216cc985b89a25f');
const results=[],contexts={};
function check(who,label,js){try{vm.runInContext(js,contexts[who],{timeout:30000});results.push({module:who,test:label,status:'PASS'});}catch(e){results.push({module:who,test:label,status:'FAIL',error:{name:e.name,message:e.message}});throw e;}}
function context(name){
 const forbidden=new Proxy({}, {get:(_t,k)=>()=>{throw Error('CANDIDATE-ACTUAL-IO-FORBIDDEN:'+String(k));}});
 const c=vm.createContext({assert,crypto,createHash,isProxy,isDeepStrictEqual,Buffer,path:path.posix,fs:forbidden,serialized,jointSerialized,graphSerialized,process:{platform:'linux',version:'v24.19.0',argv:[],execArgv:[],env:{},getuid:()=>1000,cwd:()=>'/SYNTHETIC',pid:118,hrtime:{bigint:()=>1000000000000n}},fileURLToPath:x=>x,pathToFileURL:x=>({href:x}),console:{log(){},error(){}}});
 vm.runInContext('globalThis.structuredClone=v=>JSON.parse(JSON.stringify(v));',c);
 vm.runInContext('globalThis.__core=(()=>{'+strip(code.core)+';return{'+coreExports.join(',')+'};})();',c);
 for(const n of coreExports)c[n]=c.__core[n];
 if(name!=='core'){
  for(const m of code[name].matchAll(/^import\s*\{([\s\S]*?)\}\s*from\s*['"]([^'"]+)['"];?/gm))for(const item of m[1].split(',')){const n=item.trim().split(/\s+as\s+/).at(-1);if(n&&!Object.hasOwn(c,n))c[n]=()=>{throw Error('UNDECLARED-RELATIVE-DEPENDENCY:'+n);};}
  new vm.Script(strip(code[name]),{filename:'complete-'+name+'-candidate',importModuleDynamically:()=>{throw Error('ACTUAL-MODULE-IMPORT-FORBIDDEN');}}).runInContext(c);
 }else{
  // Reuse the complete pure Core module lexical bindings for its model tests.
  new vm.Script(strip(code.core),{filename:'complete-core-candidate'}).runInContext(c);
  // The old source scaffold needs the fixed B118 object in the other modules.
  vm.runInContext('const B118={...BUDGET118,root:C121.root,private:C121.private,carrierSHA:BUDGET118.carrier.rawBytesSha256};',c);
 }
 new vm.Script(scaffold,{filename:'declared-synthetic-scaffold-362-and-118'}).runInContext(c);
 return c;
}import {createRequire} from 'node:module';
const ts=createRequire('E:/projects/worktrees/poms-r3hijk-next28/poms/package.json')('typescript');
assert(/^link-(?:pre|final)[0-9]+-sources$/.test(process.argv[2]??''));
const output=process.argv[3];assert(/^[a-z0-9-]+\.json$/.test(output??''));
const oldFile=path.dirname(base)+'/control362-independent01/review-more-model.mjs';
const oldSource=fs.readFileSync(oldFile,'utf8'),ast=ts.createSourceFile(oldFile,oldSource,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS);
let literal=null;
function visit(n){if(ts.isCallExpression(n)&&n.expression.getText(ast)==='vm.runInContext'&&ts.isNoSubstitutionTemplateLiteral(n.arguments[0])&&n.arguments[0].text.includes('globalThis.fixtureAPI=()=>'))literal=n.arguments[0].text;ts.forEachChild(n,visit);}
visit(ast);assert(literal,'Existing complete API fixture missing');
const checks=[];
const nativeAST=ts.createSourceFile('candidate-native',code.native,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS);
const apiNode=nativeAST.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text==='currentAPI121');assert(apiNode);
const apiBody=code.native.slice(apiNode.getStart(nativeAST),apiNode.end);
for(const version of [3,4]){
 const c=context('core');
 vm.runInContext(apiBody,c);
 let program=literal.replace('sourceRowsAPI(x.newGraph)','sourceRowsAPI(p.tooling.executionSources)').replace('assert(raws.has(q.file));return raws.get(q.file);',"assert(raws.has(q.file),'Only virtual API raw file allowed: '+q.file);return raws.get(q.file);");
 if(version===4){
  program=program.replace('const x=fixture362(),m=loadModelAPI(x),p=cloneM(x.P3)',"const x=fixture362(),m3=loadModelAPI(x),p=cloneM(x.P3),newHelperPin={...cloneM(m3.witness.currentHelperPins),rawBytesSha256:'4'.repeat(64)},m={witness:{...m3.witness,baselineHelperPins:cloneM(m3.witness.currentHelperPins),currentHelperPins:newHelperPin},prior:m3};p.protocolVersion=4;p.current.helperPins=newHelperPin;const ignoredMarker=null");
  program=program.replace('m.prior.witness.baselineHelperPins','m.prior.prior.witness.baselineHelperPins').replace('m.prior.baselineComposition','m.prior.prior.baselineComposition').replace('m.prior.oldGraph','m.prior.prior.oldGraph');
 }
 try{vm.runInContext(program,c);vm.runInContext('globalThis.apiCase=fixtureAPI();globalThis.apiResult=currentAPI121(apiCase.p,apiCase.parent,apiCase.composition);assert.deepEqual(apiResult,apiCase.r);',c);checks.push({version,outcome:'PASS'});}catch(error){checks.push({version,outcome:'FAIL',error:{name:error.name,message:error.message}});}
}
const nativePin={file:proposed+'/business/runtime-admission121.mjs',bytes:Buffer.byteLength(code.native),rawBytesSha256:sha(code.native)};
const result={kind:'independent-budget118-complete-currentAPI-four-stage-startup-basis-model',recordedAt:new Date().toISOString(),engine:process.version,execPath:process.execPath,candidate:nativePin,fixtureSource:{file:oldFile,rawBytesSha256:sha(oldSource)},checks,passed:checks.filter(x=>x.outcome==='PASS').length,failed:checks.filter(x=>x.outcome==='FAIL').length,limits:{completeCurrentAPIFunctionExecuted:true,allProcessEnvironmentSocketBinaryIOVirtual:true,immutableMetadataUsesDeclaredSyntheticIdentities:true,actualPProcEnvSQLHTTP:false,actualRuntimeOrPerformance:false}};
const out=base+'/'+output;fs.writeFileSync(out,JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({file:out,passed:result.passed,failed:result.failed,checks,rawBytesSha256:sha(fs.readFileSync(out))}));if(result.failed)process.exitCode=1;

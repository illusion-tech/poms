  check(who,'all 284 current sources reread',`for(const q of x.graph)assert(x.reads.some(p=>p.file===q.file&&p.rawBytesSha256===q.rawBytesSha256));`);
  const cases=[
   ['ordinary purpose on valid S4',`const s=y.json(y.S4pin);s.allowedPurpose='ordinary';y.register(y.S4pin,s);`],
   ['original success CAS replaced with failed CAS',`const s=y.json(y.S4pin);s.retainedCurrentState=B.cfg.retainedState;y.register(y.S4pin,s);`],
   ['original P3 registry changed',`const s=y.json(y.S4pin);s.predecessorRegistry=s.predecessorCandidate;y.register(y.S4pin,s);`],
   ['Origin new K',`const s=y.json(y.originPin);s.continuation121=s.continuationReadback;y.register(y.originPin,s);`],
   ['W4 relabelled three-stage',`const w=y.json(y.W4pin);w.kind='Root-runtime121-three-stage-client-source-witness';y.register(y.W4pin,w);`],
   ['baseline graph changed',`const w=y.json(y.W4pin);w.baselineExecutionSources=w.currentExecutionSources;y.register(y.W4pin,w);`],
   ['retained nine missing preimage',`y.entries.delete(y.key(y.mappings[3].retainedCopy));`],

   ['old carrier backfilled',`const s=y.json(B118.state);s.taxContinuation121.continuationReadback=y.originPin;y.register(B118.state,s);`],
   ['source manifest tenth graph member',`const q=y.json(y.W4.successorManifest);q.production.push(q.production[0]);y.register(y.W4.successorManifest,q);`],
   ['source review author equals reviewer',`const q=y.json(y.W4.successorCodeReview);q.reviewer=q.author;y.register(y.W4.successorCodeReview,q);`],

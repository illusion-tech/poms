 }
 check('core','S4/Origin7/Adoption6 and FS exactly two top-level changes',`globalThis.x=fixture118();globalThis.p=x.P4;budgetSuccessorShape118(x.S4);budgetOriginShape118(x.origin);globalThis.planPin=x.put('actual-model-P4',p);globalThis.regBody={kind:'verified-Source15-append-runtime-registry121',current:p.current};globalThis.regPin={file:p.outputs.registryFile,bytes:10,rawBytesSha256:'a'.repeat(64)};globalThis.canPin={file:p.outputs.candidateFile,bytes:10,rawBytesSha256:'b'.repeat(64)};globalThis.adoption=budgetAdoptionBody118(p,planPin,regPin,canPin,x.S4);globalThis.adoptionPin={file:p.outputs.receiptDirectory+'/prepare-adoption121.json',bytes:10,rawBytesSha256:'c'.repeat(64)};globalThis.written={verifiedFromDisk:true,registryPin:regPin,registryBody:regBody,candidatePin:canPin,candidateBody:candidateBody121(p,regPin,regBody),prepareAdoption121:adoptionPin,adoptionBody:adoption};globalThis.after=stateBody121(x.state,p,written,'2026-11-13T12:00:00Z');assert.deepEqual(Object.keys(after).filter(k=>JSON.stringify(after[k])!==JSON.stringify(x.state[k])).sort(),['runtimeAdmission121','runtimeHistory121']);assert.deepEqual(after.taxContinuation121,x.state.taxContinuation121);assert.deepEqual(after.actors,x.state.actors);assert.deepEqual(after.consumerChecks,x.state.consumerChecks);`);

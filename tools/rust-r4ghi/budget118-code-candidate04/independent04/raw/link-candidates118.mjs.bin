// Independent static ESM linkage. No SourceTextModule is evaluated.
import fs from 'node:fs';
import path from 'node:path';
import vm from 'node:vm';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {fileURLToPath} from 'node:url';

const own=path.dirname(fileURLToPath(import.meta.url)).replaceAll('\\','/');
const R='E:/projects/worktrees/poms-r3hijk-next28/poms';
const base='E:/projects/worktrees/poms-r4i-lifecycle/poms/tools/rust-r4ghi/I/implementation/';
const linuxR='/mnt/e/projects/worktrees/poms-r3hijk-next28/poms';
const definitions=[
  ['control','business/runtime-admission121.mjs'],
  ['control','business/runtime-admission-core121.mjs'],
  ['control','runtime-recovery121/native/publish-runtime121.mjs'],
  ['control','runtime-recovery121/Native-plan-data-candidate01/prepare-native-plan121.mjs'],
  ['control','runtime-recovery121/Tax121-current-metadata-data-candidate01/prepare-tax121-current-metadata.mjs'],
  ['tax','tax15-invocation118/run-tax15-once.mjs'],
  ['tax','tax15-invocation118/invocation-proof.mjs'],
  ['tax','tax15-invocation118/retained-tax-proof.mjs'],
  ['tax','tax15-invocation118/tax15-once-effects.mjs'],
  ['tax','tax15-invocation118/tax15-once-wire.mjs'],
  ['tax','tax15-invocation118/tax15-once-ledger.mjs'],
];
const sha=b=>createHash('sha256').update(b).digest('hex');
const output=process.argv[2];
assert(output && /^[a-z0-9-]+\.json$/.test(output),'Own output filename required');
const retainedDirectory=own+'/'+output.slice(0,-5)+'-sources';
fs.mkdirSync(retainedDirectory,{mode:0o700});
const modules=new Map(), builtins=new Map(), edges=[], pins=[], evaluated=[];
const context=vm.createContext({});
const overrides=new Map(definitions.map(([owner,suffix])=>[
  linuxR+'/tools/rust-r4ghi/'+suffix,
  base+'runtime118-budget-'+owner+'-impl01/proposed/tools/rust-r4ghi/'+suffix,
]));
function read(file) {
  const host=overrides.get(file) ?? (file.startsWith(linuxR+'/') ? R+file.slice(linuxR.length) : file);
  assert(host.startsWith(R+'/') || host.startsWith(base),'Public source only');
  const bytes=fs.readFileSync(host);
  let retained=null;
  if(overrides.has(file)) {
    retained=retainedDirectory+file.slice(linuxR.length);
    fs.mkdirSync(path.dirname(retained),{recursive:true,mode:0o700});
    fs.writeFileSync(retained,bytes,{flag:'wx',mode:0o600});
  }
  pins.push({file,host,retained,bytes:bytes.length,rawBytesSha256:sha(bytes),candidate:overrides.has(file)});
  return bytes.toString('utf8');
}
async function builtin(spec) {
  if(!builtins.has(spec)) {
    const names=Object.keys(await import(spec));
    builtins.set(spec,new vm.SyntheticModule(names,()=>{
      evaluated.push(spec);throw Error('Static linkage cannot evaluate a builtin');
    },{context,identifier:'STATIC:'+spec}));
  }
  return builtins.get(spec);
}
function moduleFor(file) {
  if(modules.has(file)) return modules.get(file);
  const mod=new vm.SourceTextModule(read(file),{
    context,identifier:file,
    initializeImportMeta(){throw Error('No import-meta evaluation');},
    importModuleDynamically(){throw Error('No dynamic import/effect evaluation');},
  });
  modules.set(file,mod);return mod;
}
async function resolve(spec,from) {
  if(spec.startsWith('node:')) return builtin(spec);
  assert(spec.startsWith('./') || spec.startsWith('../'),'Unexpected bare dependency: '+spec);
  const target=path.posix.resolve(path.posix.dirname(from.identifier),spec);
  assert(target.startsWith(linuxR+'/'),'Outside public Root source closure');
  edges.push({from:from.identifier,specifier:spec,to:target,candidate:overrides.has(target)});
  return moduleFor(target);
}
let failure=null;
try {
  for(const file of overrides.keys()) {
    const mod=moduleFor(file);
    if(mod.status==='unlinked') await mod.link(resolve);
    assert.equal(mod.status,'linked');
  }
  assert.equal(evaluated.length,0);
} catch(error) {
  failure={name:error.name,message:error.message};
}
const result={
  kind:'independent-budget118-candidate-static-module-link',
  recordedAt:new Date().toISOString(),engine:process.version,execPath:process.execPath,
  entries:overrides.size,linkedModules:modules.size,builtinInterfaces:builtins.size,
  evaluatedModules:0,allLinked:failure===null,failure,
  candidatePins:pins.filter(p=>p.candidate),criticalCandidateEdges:edges.filter(e=>e.candidate),
  sourceModules:pins.map(p=>({file:p.file,rawBytesSha256:p.rawBytesSha256})),
  RootPrivateProcEnvSQLHTTPRead:false,actualAuthorityCreated:false,
};
const out=own+'/'+output;
fs.writeFileSync(out,JSON.stringify(result,null,2)+'\n',{flag:'wx',mode:0o600});
console.log(JSON.stringify({file:out,bytes:fs.statSync(out).size,rawBytesSha256:sha(fs.readFileSync(out)),allLinked:result.allLinked,failure}));
if(failure)process.exitCode=1;

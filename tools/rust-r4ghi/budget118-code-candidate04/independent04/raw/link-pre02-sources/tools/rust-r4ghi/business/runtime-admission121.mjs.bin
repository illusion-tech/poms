export function assertBudgetProbeDispatch121(root,ticket){
 assert.equal(arguments.length,2);const t=budgetTickets118.get(ticket);assert(t&&t.active&&t.b.root===root&&t.b.activeTicket===ticket,'Native fixed dispatch ticket required');const b=budgetLive118(t.b);assert.equal(b.activeOperation,t.operation);assert(['entry','auth','before','checkpoint','after','close'].includes(t.operation));assert.equal(nativeBrand121(root).purpose,'budget-probe');assert.equal(nativeBrand121(root).facts.plan.protocolVersion,4);if(t.operation==='close')assert.equal(b.stage,'closing');else assert.equal(b.stage,'running-'+t.operation);return undefined;
}

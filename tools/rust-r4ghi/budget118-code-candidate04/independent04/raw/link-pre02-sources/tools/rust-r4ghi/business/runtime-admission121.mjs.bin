  actor37BeforeCP(){assert.equal(arguments.length,0);return budgetStep118(b,'before','authenticated','before');},
  baseCPOnce(){assert.equal(arguments.length,0);return budgetStep118(b,'checkpoint','before','checkpoint');},
  actor37AfterCP(){assert.equal(arguments.length,0);return budgetStep118(b,'after','checkpoint','after');},
  closeOnce(pin){assert.equal(arguments.length,1);return budgetClose118(b,pin);},

function budgetOwnershipSource118(state,row){
 const lockFile=data15+'/driver.lock',lock=json121({file:lockFile,rawBytesSha256:sha121(fs.readFileSync(lockFile))});assert.equal(lock.mode,'budget-probe');assert.equal(lock.pid,process.pid);const journal=state.consumerChecks?.taxInvocation121?.invocations?.[lock.nonce];assert(journal&&journal.mode==='budget-probe','Ownership suffix belongs to this actual budget journal');const owned=state.owned[row.key];assert(owned);const candidates=[];for(const item of journal.httpAttempts??[]){const ledger=json121(item.ledger);if(ledger.requestId!==row.proof.requestId)continue;const http=json121(item.http);assert.equal(http.requestId,ledger.requestId);assert.equal(http.operationId,ledger.operationId);assert.equal(http.operationId,row.proof.operationId);assert.equal(http.status,row.proof.status);assert.equal(ledger.ownershipComplete,true);assert.deepEqual(ledger.blockers,[]);samePin121(ledger.before,item.before);samePin121(ledger.after,item.after);samePin121(ledger.before,row.proof.beforeSnapshot);samePin121(ledger.after,row.proof.afterSnapshot);assert(ledger.recorded.some(q=>q.table===owned.table&&JSON.stringify(q.key)===JSON.stringify(owned.key)&&['birth','owned-update'].includes(q.kind)),'Actual Auth ledger must record this owned row');candidates.push(ledger);}
 assert.equal(candidates.length,1,'Exactly one actual Auth HTTP/ledger source for each ownership append');const after=json121(candidates[0].after),descriptor=after.databases?.[owned.database]?.tables?.[owned.table];assert(descriptor);const rows=read121({file:descriptor.file,rawBytesSha256:descriptor.rawBytesSha256}).toString('utf8').split('\n').filter(Boolean).map(line=>JSON.parse(line));const match=rows.filter(q=>JSON.stringify(q.key)===JSON.stringify(owned.key));assert.equal(match.length,1);assert.equal(sha121(match[0].raw),match[0].sha256);assert.equal(match[0].sha256,row.rowSha256,'Ownership suffix must match the actual after-capture row');
}

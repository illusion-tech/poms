export function assertBudgetProbeRunner121(port,inputPin,Root9Pin){
 assert.equal(arguments.length,3);const b=budgetPorts118.get(port);budgetLive118(b);assert.equal(port,b.port);samePin121(inputPin,b.inputPin);samePin121(Root9Pin,b.Root9Pin);assert.equal(nativeBrand121(b.root).purpose,'budget-probe');
 if(b.stage==='created'){assert(!b.runnerClaimed,'Runner is one-shot');b.runnerClaimed=true;return undefined;}
 assert(b.completedCP&&b.afterAttempted&&['after','preserve'].includes(b.stage),'Sample can only follow real returned CP and attempted actor');assert(!b.sampleWriteAttempted,'Sample write is one-shot');b.sampleWriteAttempted=true;return undefined;
}
function budgetSafeError118(e){return{name:['Error','AssertionError','TypeError','SyntaxError'].includes(e?.name)?e.name:'Error',message:'Fixed budget validation failed; preserve the exact nonce and its existing evidence'};}
async function budgetDispatch118(b,operation,args=[]){
 budgetLive118(b);assert.equal(b.activeTicket,null,'Budget dispatch cannot reenter');const ticket=Object.freeze(Object.create(null));b.activeTicket=ticket;b.activeOperation=operation;budgetTickets118.set(ticket,{b,operation,active:true});
 try{const names={entry:'openBudgetInvocation118',auth:'authenticateBudgetInvocation118',before:'guardBudgetBefore118',checkpoint:'checkpointBudgetInvocation118',after:'guardBudgetAfter118',close:'closeBudgetInvocation118'};const value=await b.proof[names[operation]](b.root,ticket,...args);return budgetStepData118(b,operation,value);}
 catch(raw){throw budgetErrorProjection118(raw);}
 finally{budgetTickets118.delete(ticket);b.activeTicket=null;b.activeOperation=null;}
}
async function budgetStep118(b,operation,expected,next,args=[]){
 budgetLive118(b);assert(b.runnerClaimed);assert.equal(b.stage,expected,'Fixed budget order');b.stage='running-'+operation;if(operation==='after')b.afterAttempted=true;
 try{if(operation==='checkpoint')b.cpStartNs=process.hrtime.bigint();const value=await budgetDispatch118(b,operation,args);if(operation==='checkpoint'){b.cpEndNs=process.hrtime.bigint();b.completedCP=value;}b[operation]=value;b.stage=next;return value;}
 catch(e){b.failed=true;b.stage='preserve';b.failure=budgetSafeError118(e);throw e;}
}
function verifyBudgetSample118(b,pin){

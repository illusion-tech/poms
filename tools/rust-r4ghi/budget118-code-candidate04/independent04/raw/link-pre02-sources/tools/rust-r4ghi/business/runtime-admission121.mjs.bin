export function budgetOpeningPins121(root,ticket){
 assertBudgetProbeDispatch121(root,ticket);const t=budgetTickets118.get(ticket);assert.equal(t.operation,'close','Opening metadata is failed-close only');assert.equal(t.b.stage,'closing');return freeze121(copy121({inputPin:t.b.inputPin,reviewPin:t.b.Root9Pin}));

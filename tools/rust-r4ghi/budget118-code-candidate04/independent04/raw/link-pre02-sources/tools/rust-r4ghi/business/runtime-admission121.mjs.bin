// Only finite data/error projections leave the sole privileged external entry.
export async function executeBudgetProbe121(inputPin,Root9Pin){
 assert.equal(arguments.length,2);
 try{return await executeBudgetProbeBody118(inputPin,Root9Pin);}
 catch(raw){const error=new Error('Budget probe stopped; preserve the exact invocation evidence');const d=Object.getOwnPropertyDescriptor(raw,'budgetProbeTerminal');if(d&&Object.hasOwn(d,'value')){try{error.budgetProbeTerminal=freeze121(copy121(d.value));}catch{}}throw error;}
}

function budgetPinData118(p){pin121(p);return copy121(p);}
function budgetReferenceData118(value){keys121(value,['kind','protocolVersion','runtimeAdmission121','candidate','baseCodeRegistry','baseCodeCandidate','apiProcess','sourcePins','sourcePinsSHA256','compilePins','helperPins']);assert.equal(value.kind,'actual-runtime-lease-reference121');assert.equal(value.protocolVersion,1);for(const k of['runtimeAdmission121','candidate','baseCodeRegistry','baseCodeCandidate','apiProcess','sourcePins','compilePins','helperPins'])budgetPinData118(value[k]);assert(/^[a-f0-9]{64}$/.test(value.sourcePinsSHA256));}
function budgetActorData118(value){
 keys121(value,['status','observation','error']);assert.equal(value.status,'VERIFIED');assert.equal(value.error,null);const o=value.observation;keys121(o,['actorId','accountActive','permissionSetSHA256','permissionCount','sessionId','ownedSession','sqlNowMs','idleDeadlineMs','absoluteDeadlineMs','anchorNs','returnedNs','elapsedCeilMs','idleChargedRemainingMs','absoluteChargedRemainingMs','authSettings']);assert.equal(o.accountActive,true);assert.equal(o.ownedSession,true);assert.equal(o.permissionCount,37);assert(/^[a-f0-9]{64}$/.test(o.permissionSetSHA256));for(const k of['actorId','sessionId'])assert(typeof o[k]==='string'&&/^[a-f0-9-]{36}$/.test(o[k]));for(const k of['anchorNs','returnedNs'])assert(/^(0|[1-9][0-9]*)$/.test(o[k]));for(const k of['sqlNowMs','idleDeadlineMs','absoluteDeadlineMs','elapsedCeilMs','idleChargedRemainingMs','absoluteChargedRemainingMs'])assert(Number.isSafeInteger(o[k]));assert(o.idleChargedRemainingMs>2000&&o.absoluteChargedRemainingMs>2000);keys121(o.authSettings,['idleSeconds','absoluteSeconds','throttleSeconds','evidence']);assert.equal(o.authSettings.idleSeconds,900);assert.equal(o.authSettings.absoluteSeconds,28800);assert.equal(o.authSettings.throttleSeconds,60);assert(Array.isArray(o.authSettings.evidence));for(const p of o.authSettings.evidence)budgetPinData118(p);return o;
}
function budgetStepData118(b,operation,value){
 if(operation==='entry'){keys121(value,['currentFrame','entryGuard','prepareAdoption121']);budgetPinData118(value.entryGuard);samePin121(value.prepareAdoption121,b.manifest.prepareAdoption121);const f=value.currentFrame;keys121(f,['namespace','epoch','run','marker','prefix','api','apiProcess','binarySHA256','codeAdmission15','candidate','sourcePins','sourcePinsSHA256','helperPins','runtimeBindings','bodySHA256','runtimeAdmission121','runtimeReference121']);for(const k of['namespace','epoch','run','api'])assert.equal(f[k],b.root[k]);assert.equal(f.marker,b.root.state.marker);assert.equal(f.prefix,b.root.state.prefix);samePin121(f.runtimeBindings,b.p.runtimeBindings);samePin121(f.candidate,b.p.candidate);samePin121(f.sourcePins,b.p.actualSourcePins);assert.equal(f.bodySHA256,b.p.bodySHA256);budgetReferenceData118(f.runtimeReference121);}
 else if(operation==='auth'){assert(Array.isArray(value)&&value.length===3);const ops=['AuthController_getCsrfToken','AuthController_createPasswordAuthSession','AuthController_getCurrentAuthSession'];for(const[q,i]of value.map((q,i)=>[q,i])){keys121(q,['operationId','http','before','after','ledger']);assert.equal(q.operationId,ops[i]);for(const k of['http','before','after','ledger'])budgetPinData118(q[k]);}}
 else if(operation==='before'||operation==='after'){const o=budgetActorData118(value);assert.equal(o.actorId,b.p.actorId);assert.equal(o.permissionSetSHA256,sha121(JSON.stringify([...b.p.expectedActorPermissions].sort())));}
 else if(operation==='checkpoint'){keys121(value,['nonce','phase','cursor','pid','boot','runtimeReference121']);assert.equal(value.nonce,b.p.nonce);assert.equal(value.phase,'budget-base');assert.equal(value.pid,b.pid);assert.equal(value.boot,b.boot);budgetReferenceData118(value.runtimeReference121);}
 else if(operation==='close'){keys121(value,['exitGuard','closedJournal','result']);for(const k of['exitGuard','closedJournal'])if(value[k]!==null)budgetPinData118(value[k]);if(value.result!==null)budgetPinData118(value.result);}
 return freeze121(copy121(value));

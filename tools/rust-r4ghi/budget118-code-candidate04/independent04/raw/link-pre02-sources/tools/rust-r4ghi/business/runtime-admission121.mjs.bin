function budgetErrorProjection118(raw){
 const error=new Error('Fixed budget dispatch failed; preserve its existing evidence');const descriptor=Object.getOwnPropertyDescriptor(raw,'budgetCloseFacts');if(descriptor&&Object.hasOwn(descriptor,'value'))try{const f=descriptor.value;keys121(f,['exitGuard','closedJournal','result']);const safe={};for(const k of['exitGuard','closedJournal','result'])safe[k]=f[k]===null?null:budgetPinData118(f[k]);error.budgetCloseFacts=freeze121(safe);}catch{}return error;

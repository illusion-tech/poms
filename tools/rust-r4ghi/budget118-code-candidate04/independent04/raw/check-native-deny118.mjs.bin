function bodies(file,names) {
  const text=fs.readFileSync(file,'utf8');
  const ast=ts.createSourceFile(file,text,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS);
  return names.map(name=>{
    const node=ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name);
    assert(node,'Missing complete function '+name);
    const body=text.slice(node.getStart(ast),node.end).replace(/^export\s+/,'');
    captured.push({file,name,start:ast.getLineAndCharacterOfPosition(node.getStart(ast)).line+1,end:ast.getLineAndCharacterOfPosition(node.end).line+1,bytes:Buffer.byteLength(body),rawBodySha256:sha(body)});
    return body;
  }).join('\n');
}

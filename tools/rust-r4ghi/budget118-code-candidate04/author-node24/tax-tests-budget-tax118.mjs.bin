    f.memory.put(PRIV+"/tax118-invocation-"+NONCE+"/intent.json",{kind:"actual-Tax15-invocation118-intent",input:inputPin,exactReview:reviewPin,nonce:NONCE,pid:4242,mode:input.mode});
    return {input,inputPin,reviewPin};
}

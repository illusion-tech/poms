const cliArgs118=x=>["--input",x.inputPin.file,"--input-sha",x.inputPin.rawBytesSha256,"--review",x.reviewPin.file,"--review-sha",x.reviewPin.rawBytesSha256,"--execute"];
const results=[];
async function test(name,fn){try{await fn();results.push({name,status:"passed",evidence:"MODEL_ONLY"});}catch(error){results.push({name,status:"failed",message:error.message,stack:error.stack});}}

await test("runner rejects fake port before every filesystem operation",async()=>{const f=fixture(),e=await environment(f);f.native.assertBudgetProbeRunner121=()=>{throw Error("DENIED fake port");};const run=await e.get(INV+"run-tax15-once.mjs");const before=f.memory.calls.length;await assert.rejects(run.runBudgetProbe118({}, {}, {entryFacts(){throw Error("must not call");}}),/DENIED/);assert.equal(f.memory.calls.length,before);});

for(const scenario of ["complete","after-fails","cp-final-ref-fails","sample-gate-fails","sample-wx-fails","close-fails","close-coverage-expires"]){
await test("full runner "+scenario+" preserves finite truth and one close",async()=>{
    const f=fixture(),x=inputFixture(f);let claims=0,closes=0,cpCalls=0;
    f.native.assertBudgetProbeRunner121=port=>{assert.equal(port,genuine);claims++;if(scenario==="sample-gate-fails"&&claims===2)throw Error("MODEL_SOURCE_DRIFT");};
    const observation=()=>({status:"VERIFIED",observation:{actorId:ACTOR,accountActive:true,permissionSetSHA256:SHA(JSON.stringify(PERMISSIONS)),permissionCount:37,sessionId:SESSION,ownedSession:true,sqlNowMs:NOW,idleDeadlineMs:NOW+(scenario==="close-coverage-expires"?2001:900000),absoluteDeadlineMs:NOW+28800000,anchorNs:"1000000",returnedNs:"2000000",elapsedCeilMs:1,idleChargedRemainingMs:899999,absoluteChargedRemainingMs:28799999,authSettings:{idleSeconds:900,absoluteSeconds:28800,throttleSeconds:60,evidence:[]}},error:null});
    const entry={currentFrame:{MODEL_ONLY:true},entryGuard:f.memory.put("/model/entry.json",{}),prepareAdoption121:f.memory.put("/model/adoption.json",{})};
    const genuine=Object.freeze({entryFacts:async()=>entry,auth3Once:async()=>[],actor37BeforeCP:async()=>observation(),baseCPOnce:async()=>{cpCalls++;if(scenario==="cp-final-ref-fails")throw Error("MODEL_FINAL_REF_FAILURE");return {runtimeReference121:{MODEL_ONLY:true}};},actor37AfterCP:async()=>{if(scenario==="after-fails")throw Error("MODEL_ACTOR_FAILURE");return observation();},closeOnce:async sample=>{closes++;if(scenario==="close-fails")throw Error("MODEL_CLOSE_FAILURE");return {exitGuard:f.memory.put("/model/exit.json",{}),closedJournal:f.memory.put("/model/closed.json",{result:sample}),result:sample};}});
    if(scenario==="sample-wx-fails")f.memory.failWrite=p=>p.endsWith("budget-base-sample.json");
    const e=await environment(f),run=await e.get(INV+"run-tax15-once.mjs");const result=await run.runBudgetProbe118(x.inputPin,x.reviewPin,genuine);
    assert.equal(closes,1);assert.equal(cpCalls,1);assert.equal(result.probeOutcome,scenario==="complete"?"OBSERVATION_COMPLETE":"STOPPED_PRESERVE");
    if(scenario==="cp-final-ref-fails")assert.equal(result.sample,null);
    if(["sample-wx-fails","sample-gate-fails"].includes(scenario)){assert.equal(result.sample,null);assert.equal(result.failure.checkpointReturned,true);assert(result.failure.checkpointInterval);}
    if(scenario==="after-fails"){assert(result.sample);assert.equal(result.close.nativeCloseVerified,true);}
    if(scenario==="close-coverage-expires"){assert.equal(result.close.nativeCloseVerified,true);assert.equal(result.sessionCoverage.status,"UNKNOWN");}
    assert(!JSON.stringify(result).includes("fixture-secret"));assert(!Object.hasOwn(result,"port"));
});}

for(const scenario of ["valid","inactive","permission-missing","permission-extra","unowned","no-cookie","idle-edge","absolute-setting","idle-setting","throttle-setting"]){
await test("complete actor SQL body "+scenario,async()=>{
    const f=fixture();f.state.actors.manager.cookies.poms_session="model-session-token";
    f.root.connectionNs=1;f.root.queryNs=1;
    f.root.dbOriginal=f.root.db;
    const row={id:SESSION,user_id:ACTOR,token_hash:SHA("model-session-token"),status:"active",created_at:new Date(NOW).toISOString(),idle_expires_at:new Date(NOW+(scenario==="idle-edge"?2003:900000)).toISOString(),absolute_expires_at:new Date(NOW+(scenario==="absolute-setting"?28801000:28800000)).toISOString()};
    // Reuse the actual mock SQL router's private table via one model HTTP login.
    await new Promise(resolve=>{f.fakeHTTP.request(new URL("http://model/model-auth-1"),{headers:{"X-Request-Id":"model"}},res=>{res.on("end",resolve);}).end();});
    f.root.db=async fn=>f.root.dbOriginal(c=>fn({query:async(sql,args)=>{const r=await c.query(sql,args);if(sql.startsWith("SELECT to_jsonb(s)"))return {rows:[{value:{...row,observed_now:new Date(NOW).toISOString()}}]};if(sql.startsWith("SELECT to_jsonb(u)")&&scenario==="inactive")return {rows:[{value:{id:ACTOR,is_active:false}}]};if(sql.startsWith("SELECT role_id::text")&&scenario==="permission-missing")return {rows:r.rows.slice(1)};if(sql.startsWith("SELECT role_id::text")&&scenario==="permission-extra")return {rows:[...r.rows,{role_id:ROLE,permission_key:"model.extra",status:"active"}]};return r;}}));
    if(scenario!=="unowned")f.state.owned[JSON.stringify([f.root.database,"auth_session",[SESSION]])]={latestSha256:"model"};
    if(scenario==="no-cookie")delete f.state.actors.manager.cookies.poms_session;
    if(scenario==="idle-setting")f.root.idleSetting=901;if(scenario==="throttle-setting")f.root.throttleSetting=61;
    const e=await environment(f,"wire"),effects=await e.get(INV+"tax15-once-effects.mjs");
    if(scenario==="valid"){const actual=await effects.observeBudgetActor118(f.root,f.ticket);assert.equal(actual.status,"VERIFIED");assert.equal(Object.keys(actual.observation).length,15);assert.equal(actual.observation.permissionCount,37);assert.equal(f.queryLog.filter(sql=>sql.startsWith("SELECT")).length,5);assert(!JSON.stringify(actual).includes("token_hash"));}
    else await assert.rejects(effects.observeBudgetActor118(f.root,f.ticket));
});}

await test("actual snapshot capture and attribution ledger retain 139x2 and unknown drift deny",async()=>{
    const f=fixture(),e=await environment(f,"wire"),snapshot=await e.get(PREFIX+"business/snapshot.mjs"),ledger=await e.get(INV+"tax15-once-ledger.mjs");
    const baseline=await snapshot.capture(f.root,"model-baseline");f.root.comparisonBaseline=baseline;f.state.baseline=baseline.manifest;
    const before=await snapshot.capture(f.root,"model-http-before");ledger.assertBudgetRecorded118(f.root,f.ticket,before);
    assert.equal(Object.keys(before.databases).length,2);assert.equal(Object.keys(before.databases[f.root.database].tables).length,139);
    const bad=structuredClone(before);bad.databases[f.root.database].meta.normative.changed=["unowned"];
    await assert.rejects(async()=>ledger.assertBudgetRecorded118(f.root,f.ticket,bad));
    assert.throws(()=>ledger.assertBudgetRecorded118(f.root,{},before),/Genuine/);
    await new Promise(resolve=>{f.fakeHTTP.request(new URL("http://model/model-auth-1"),{headers:{"X-Request-Id":"model"}},res=>{res.on("end",resolve);}).end();});
    const unowned=await snapshot.capture(f.root,"unowned-drift-before");
    assert.throws(()=>ledger.assertBudgetRecorded118(f.root,f.ticket,unowned),/Unattributed/);
});


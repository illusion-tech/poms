    const review=pin(),g1={file:WIN+"/tools/rust-r4ghi/budget-probe118-g1-v2/Root-G1-budget-probe118-v2.json",bytes:19563,rawBytesSha256:"68212af41282071678d3e062dd689fbffbf2b74443de0c5872bb2511e4d0c5a2"};
    const input={kind:"Root-reviewed-Tax15-invocation118",schemaVersion:1,namespace:"poms-r4ghi",epoch:"g2-business15",run:"main01",mode:"budget-probe",nonce:NONCE,phase:"model",actorKey:"manager",actorId:ACTOR,expectedActorPermissions:PERMISSIONS,bodySHA256:"b".repeat(64),technicalG1:g1,baseline:{file:"/model/baseline.md",rawBytesSha256:"a5520bb4f4dbe8d79945e9ef10309828d01c390fa94ba31301aeb8cfff9f444c"},expectedEntryState:pin(),runtimeBindings:pin(),codeAdmission15:pin(),candidate:pin(),actualHelperPins:pin(),actualSourcePins:pin(),actualCompilePins:pin(),apiProcess:pin(),prepared15:pin(),fullInventory:pin(),codeReview:review,executionSources:sources,wireSpec:f.p.wireSpec,approvedClosedFISet:null,selectedFamily:null,approvedRecovery:null,approvedCompletedPrefix:null,approvedStartCursor:null,approvedFICompletion:null,expectedActiveFault:null};

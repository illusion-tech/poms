await test("complete normal nine-flag budget CLI normalizes actual Full3 before lock/intent and keeps every reference equal",async()=>{
    const f=fixture(),x=outerFixture(f);let calls=0,captured;
    f.native.executeBudgetProbe121=async(inputPin,reviewPin)=>{
        calls++;captured={inputPin,reviewPin};
        for(const pin of [inputPin,reviewPin]){assert.deepEqual(Object.keys(pin).sort(),["bytes","file","rawBytesSha256"]);assert.equal(pin.bytes,f.memory.readFileSync(pin.file).length);}
        const lock=JSON.parse(f.memory.readFileSync(PRIV+"/driver.lock","utf8")),intent=JSON.parse(f.memory.readFileSync(PRIV+"/tax118-invocation-"+NONCE+"/intent.json","utf8"));
        assert.deepEqual(realmData(lock.input),realmData(inputPin));assert.deepEqual(realmData(intent.input),realmData(inputPin));assert.deepEqual(realmData(intent.exactReview),realmData(reviewPin));
        const adoption=f.memory.put("/model/cli-adoption.json",{MODEL_ONLY:true}),entry=f.memory.put("/model/cli-entry.json",{MODEL_ONLY:true});
        const sample=f.memory.put(PRIV+"/tax118-invocation-"+NONCE+"/budget-base-sample.json",{kind:"actual-Tax15-budget-probe-base-sample118",schemaVersion:1,mode:"budget-probe",nonce:NONCE,input:inputPin,exactReview:reviewPin,prepareAdoption121:adoption,currentFrame:{MODEL_ONLY:true},entryGuard:entry,auth3:[],actorBefore:{MODEL_ONLY:true},checkpoint:{phase:"budget-base",startNs:"1",endNs:"2",elapsedNs:"1",returned:true,activeFault:false,value:{MODEL_ONLY:true}},actorAfter:{MODEL_ONLY:true},baseCPRecorded:true,full67BudgetStatus:"UNKNOWN",FIGranted:false,normalTaxPOSTGranted:false});
        const exit=f.memory.put("/model/cli-exit.json",{MODEL_ONLY:true}),closed=f.memory.put("/model/cli-closed.json",{MODEL_ONLY:true,result:sample});
        return {sample,baseCPRecorded:true,prepareAdoption121:adoption,close:{constructorReturned:true,attempted:true,startNs:"3",endNs:"4",elapsedNs:"1",returned:true,nativeCloseVerified:true,exitGuard:exit,closedJournal:closed,error:null},sessionCoverage:{status:"VERIFIED_THROUGH_CLOSE_RETURN",lastActorObservation:null,anchorNs:"1",throughNs:"4",elapsedCeilMs:1,idleChargedRemainingMs:899999,absoluteChargedRemainingMs:28799999},probeOutcome:"OBSERVATION_COMPLETE",failure:null};
    };
    const e=await environment(f),run=await e.get(INV+"run-tax15-once.mjs");await run.main118(cliArgs118(x));assert.equal(calls,1);
    const directory=PRIV+"/tax118-invocation-"+NONCE;
    const sample=JSON.parse(f.memory.readFileSync(directory+"/budget-base-sample.json","utf8")),report=JSON.parse(f.memory.readFileSync(directory+"/budget-probe-report.json","utf8")),complete=JSON.parse(f.memory.readFileSync(directory+"/complete.json","utf8"));
    for(const value of [sample,report]){assert.deepEqual(realmData(value.input),realmData(captured.inputPin));assert.deepEqual(realmData(value.exactReview),realmData(captured.reviewPin));}
    assert.deepEqual(realmData(complete.input),realmData(captured.inputPin));assert.deepEqual(realmData(complete.review),realmData(captured.reviewPin));assert.equal(f.memory.existsSync(PRIV+"/driver.lock"),false);
});

for(const which of ["input","review"]){
await test("budget outer rejects caller supplied wrong "+which+" bytes before nonce, lock or Native effects",async()=>{
    const f=fixture(),x=outerFixture(f);let calls=0;f.native.executeBudgetProbe121=async()=>{calls++;throw Error("must not enter Native");};
    const a={...x.inputPin},b={...x.reviewPin};if(which==="input")a.bytes++;else b.bytes++;
    const e=await environment(f),run=await e.get(INV+"run-tax15-once.mjs");const writes=f.memory.calls.filter(([op])=>op==="write"||op==="mkdir").length;
    await assert.rejects(run.runTax15Once118(a,b));assert.equal(calls,0);assert.equal(f.memory.calls.filter(([op])=>op==="write"||op==="mkdir").length,writes);assert.equal(f.memory.existsSync(PRIV+"/driver.lock"),false);
});}

await test("original verify-committed nine-flag CLI still sends Pin2 to its original proof entry",async()=>{
    const f=fixture(),x=outerFixture(f,"verify-committed"),original=await environment(f),proof=await original.get(INV+"invocation-proof.mjs");f.proof.assertInput118=proof.assertInput118;
    let opens=0;const cap=Object.freeze(Object.create(null));f.native.executeBudgetProbe121=()=>{throw Error("Old mode must not use budget Native entry");};
    f.proof.openInvocation118=async(a,b)=>{opens++;assert.equal(Object.hasOwn(a,"bytes"),false);assert.equal(Object.hasOwn(b,"bytes"),false);return cap;};
    f.proof.verifyPublishedInvocation121=async c=>{assert.equal(c,cap);return f.memory.put("/model/old-readback.json",{MODEL_ONLY:true});};
    f.proof.closeInvocation118=async(c,result)=>{assert.equal(c,cap);return {exitGuard:f.memory.put("/model/old-exit.json",{MODEL_ONLY:true}),closedJournal:f.memory.put("/model/old-closed.json",{MODEL_ONLY:true}),result};};
    const e=await environment(f,"outer"),run=await e.get(INV+"run-tax15-once.mjs");await run.main118(cliArgs118(x));assert.equal(opens,1);
});

const receipt={kind:"I-tax118-budget-candidate-model-tests",modelOnly:true,actualNativeCoreContextOrAppEvaluated:false,hostPrivateProcEnvSQLHTTPAccess:false,filesystem:"VM memory-only interface; host reads only public source and own candidate; unknown fs members and SQL/imports deny",performanceClaim:false,wholeFIBudget:"UNKNOWN",tests:results,passed:results.every(x=>x.status==="passed"),sourceModules:[...sourceCache].map(([file,source])=>({file,bytes:Buffer.byteLength(source),rawBytesSha256:SHA(source)}))};
const attempt=process.argv[2]??"02";assert(/^[0-9]{2}$/.test(attempt));
const output=OWN+"/test-results-attempt"+attempt+".json";hostFS.writeFileSync(output,JSON.stringify(receipt,null,2)+"\n",{flag:"wx"});
console.log(JSON.stringify({modelOnly:true,passed:receipt.passed,tests:results.length,failed:results.filter(x=>x.status!=="passed"),receipt:output}));
if(!receipt.passed)process.exitCode=1;

    const entry={currentFrame:{namespace:f.root.namespace,epoch:f.root.epoch,run:f.root.run,marker:f.state.marker,prefix:f.state.prefix,api:f.root.api,apiProcess:x.input.apiProcess,binarySHA256:"a".repeat(64),codeAdmission15:x.input.codeAdmission15,candidate:x.input.candidate,sourcePins:x.input.actualSourcePins,sourcePinsSHA256:ref.sourcePinsSHA256,helperPins:x.input.actualHelperPins,runtimeBindings:x.input.runtimeBindings,bodySHA256:x.input.bodySHA256,runtimeAdmission121:ref.runtimeAdmission121,runtimeReference121:ref},entryGuard:f.memory.put("/model/combined-entry.json",{MODEL_ONLY:true}),prepareAdoption121:f.memory.put("/model/combined-adoption.json",{MODEL_ONLY:true})};
    const modelProof={
        openBudgetInvocation118:async(root,ticket)=>{f.native.assertBudgetProbeDispatch121(root,ticket);return entry;},
        authenticateBudgetInvocation118:(root,ticket)=>wire.authenticateBudgetWire118(root,ticket),
        guardBudgetBefore118:(root,ticket)=>effects.observeBudgetActor118(root,ticket),
        checkpointBudgetInvocation118:async(root,ticket)=>{f.native.assertBudgetProbeDispatch121(root,ticket);return {nonce:NONCE,phase:"budget-base",cursor:0,pid:4242,boot:"model-boot",runtimeReference121:ref};},
        guardBudgetAfter118:(root,ticket)=>effects.observeBudgetActor118(root,ticket),
        closeBudgetInvocation118:async(root,ticket,sample)=>{f.native.assertBudgetProbeDispatch121(root,ticket);return {exitGuard:f.memory.put("/model/combined-exit.json",{MODEL_ONLY:true}),closedJournal:f.memory.put("/model/combined-closed.json",{MODEL_ONLY:true,result:sample}),result:sample};},
    };
    const model=e.modelNative.__declaredModelPort(f.root,x.input,x.inputPin,x.reviewPin,{prepareAdoption121:entry.prepareAdoption121},lockPin,modelProof);
    assert.throws(()=>f.native.currentRuntime121(f.root),/Budget purpose/);
    const terminal=await run.runBudgetProbe118(x.inputPin,x.reviewPin,model.port);
    assert.equal(terminal.probeOutcome,"OBSERVATION_COMPLETE");assert.equal(f.httpCount,3);assert.equal(model.summary().closed,true);
    assert.equal(Object.keys(JSON.parse(f.memory.readFileSync(terminal.sample.file,"utf8"))).length,17);
    assert.throws(()=>f.native.assertBudgetProbeRunner121(model.port,x.inputPin,x.reviewPin),/Live genuine/);
    assert(!JSON.stringify(terminal).includes("fixture-secret"));
});

for(const secondary of ["persist","failed-bookend-wx"]){
await test("complete close body preserves observed facts3 when secondary "+secondary+" also fails",async()=>{
    const f=fixture(),x=inputFixture(f);let nativeExitAttempts=0;
    f.state.taxContinuation121={sweep:null};
    f.state.consumerChecks.taxInvocation121.invocations[NONCE]={pid:4242,bootId:"model-boot",mode:"budget-probe",input:x.inputPin,exactReview:x.reviewPin,httpAttempts:[]};
    f.native.budgetAssertCurrentLease121=()=>{const error=Error("MODEL primary failure");error.actual=f.root;throw error;};
    f.native.budgetAssertRuntimeBinding121=()=>{nativeExitAttempts++;throw Error("MODEL native full-exit failure");};
    const observedExit=f.memory.put("/model/observed-exit.json",{MODEL_ONLY:true}),observedClosed=f.memory.put("/model/observed-closed.json",{MODEL_ONLY:true});
    if(secondary==="persist")f.root.persist=()=>{throw Error("MODEL secondary persist failure");};else f.memory.failWrite=p=>p.endsWith("/failed-bookend.json");
    const e=await environment(f,"proof-close"),proof=await e.get(INV+"invocation-proof.mjs");
    const cap=proof.__declaredObservedCloseFixture(f.root,f.ticket,x.input,x.inputPin,x.reviewPin,observedExit,observedClosed);
    await assert.rejects(proof.closeInvocation118(cap,null,{failed:true},f.ticket),error=>{
        assert.equal(error.message,"Budget full close failed; preserve existing private evidence");
        assert.deepEqual(realmData(error.budgetCloseFacts),realmData({exitGuard:observedExit,closedJournal:observedClosed,result:null}));
        assert.equal(Object.hasOwn(error,"actual"),false);assert.equal(Object.hasOwn(error,"cause"),false);return true;
    });
    assert.equal(nativeExitAttempts,1);assert.throws(()=>proof.runtime118(cap),/Live private/);
});}


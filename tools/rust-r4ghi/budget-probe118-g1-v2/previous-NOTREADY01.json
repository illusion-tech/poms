  "findings": [
    {
      "id": "BUDGET-NATIVE-PURPOSE-ISOLATION",
      "severity": "blocking-before-freeze",
      "problem": "The documents bind S4.allowedPurpose=budget-probe and make Tax old six modes reject schema3, but do not specify an enforcement boundary preventing that valid v4 lease/brand from satisfying ordinary Native or non-Tax effect consumers.",
      "staticCounterexample": "An implementation that only teaches fullPublished/current facts about v4, sets false semantics flags, and adds the Taxmode7 branch still lets ordinary createContext121 return a branded general Root; createWitnessView/createPolicyView and generic http/trusted/FI/policy entrypoints then obtain currentRuntime121/lease bindings. None of those unchanged consumers consults S4.allowedPurpose or Tax runtimeBindings.schemaVersion. This is a counterexample to the proposed design, not an executed v4 path or a claim of an existing v3 runtime exploit.",
      "minimumRevision": "Within the same Native/proof/retained-proof boundary, freeze a fixed genuine Tax budget-only construction/brand/binding channel deriving purpose from verified S4/adoption and exact input/Root9, never a caller-supplied purpose/skip/callback. Explicitly reject v4 budget leases at ordinary constructors/Root-view creation and general Native current/binding/retained-resource/GH/trusted/effect-consumer gates before any external effect or view escape. Enumerate the fixed strong methods still required by Tax checkpoint/legacy/Auth/entry/full-close, preserving all predicates through the restricted channel. Leave the other276 production leaves unchanged only if complete-function negative models show they fail through the central purpose gate. If that cannot be done honestly within10 leaves, report the exact extra dependency rather than weaken the deny."
    },
    {
      "id": "AFTER-CLOSE-TIMING-ENVELOPE",
      "severity": "required-finite-contract-clarification",
      "problem": "The proposed result field family includes final close duration/outcome and exit/closed pins, but the original close seals result/journal before returning and revokes cap. Their exact output placement must be frozen so implementations do not create a future-pin/self-hash cycle or revive the capability.",
      "minimumRevision": "Persist the completedCP sample as an existing wx artifact before close. close.result may refer only to that existing sample. Measure close around its one real call. After return, the existing run-owned nonce directory complete/report writer can wx the final close timing, real exit/closed pins and OBSERVATION_COMPLETE or STOPPED_PRESERVE result. Never back-write closed.result, oldK or6458, never close twice, never use a closed cap or expose a caller callback. Preserve a successful Native-close fact even when conservative post-close deadline coverage fails."
    }
  ],
  "timingJudgment": {
    "CPBracket": "Start/end tightly wrap the whole checkpoint118 including its actual Native final reference. Persist after end; an exception cannot be a completedCP sample.",
    "fullActorObservation": "Use the real account/full37/owned-cookie/session/SQL-clock checks. Keep the old guardActor118 string|null ABI and fixed private wire deadline path; no injected observation.",
    "closeCoverage": "The pre-SQL monotonic anchor may conservatively charge all connection/SQL/await work plus everything through close return, using ceil nanoseconds-to-ms and requiring both idle/absolute remaining>2000ms. A lost margin or unavailable observation yields STOPPED_PRESERVE, while any already completedCP/close facts retain their true labels. No post-close SQL observation or continuously active permission claim is inferred.",
    "qualification": "N=1 base(activeFault=false) can establish exactly that measured observation and bounded session-time bookends; it cannot establish a high-tail distribution, an upper bound for618 checkpoints, activeFault/DDL/500/rollback/waits/coflush/capture/final67/close whole-path budget, or FIG2 eligibility.",
    "wholeFIBudget": "UNKNOWN",
    "probeCouldBeFrozenAsLimitedMeasurementAfterFindingsResolved": true,
    "noAssumedBudgetPass": true
  },

+        } catch (error) { this.preparation.set(null); this.error.set(this.errorText(error)); }
+        finally { this.busy.set(false); }
+    }
+    async download(attachmentId: string) {
+        if (!this.evidenceChoices().some((ref) => ref.id === attachmentId)) return;

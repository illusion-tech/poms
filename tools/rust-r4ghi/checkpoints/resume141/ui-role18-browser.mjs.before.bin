import { observeFontBoundary32 } from './ui-font-boundary32.mjs';
import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';
export const SOURCE_BASE_SHA256='52addde6eab92076ea50970e597754bf426fc21a87019c91e25714b40068fe0c';
const origin='http://127.0.0.1:44551',root='E:/projects/worktrees/poms-r3hijk-next28/poms',unwrap=value=>value?.data??value;
function operations(){const spec=JSON.parse(fs.readFileSync(`${root}/libs/shared/api-spec/openapi.json`)),map=new Map();for(const[template,item]of Object.entries(spec.paths))for(const[method,op]of Object.entries(item))if(op.operationId){const statuses=Object.keys(op.responses).filter(v=>/^2\d\d$/.test(v));assert.equal(statuses.length,1);const pattern=template.split(/(\{[^}]+\})/).map(p=>p.startsWith('{')?'[^/]+':p.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('');map.set(op.operationId,{method:method.toUpperCase(),template,pattern:new RegExp(`^${pattern}$`),status:Number(statuses[0])});}return map;}
export async function executeCase(browser,expect,test,directory,server){assert.equal(test.kind,'role-forms');const action=test.writeAction,map=operations(),seen=[],requests=[],errors=[],consoleErrors=[],blocked=[],context=await browser.newContext({baseURL:origin,locale:'zh-CN',timezoneId:'Asia/Shanghai',viewport:{width:1440,height:1000},serviceWorkers:'block'}),page=await context.newPage();page.setDefaultTimeout(90000); const fontBoundary32 = observeFontBoundary32(page);const component=()=>page.locator('app-project-role-assignment-authoring');
 const save=(name,value)=>fs.writeFileSync(path.join(directory,name),Buffer.isBuffer(value)?value:Buffer.from(JSON.stringify(value,null,2)+'\n'),{flag:'wx',mode:0o600});
 const watch=(id,params=null)=>{const op=map.get(id);assert(op);const exact=params?op.template.replace(/\{([^}]+)\}/g,(_,key)=>{assert(params[key]);return encodeURIComponent(params[key]);}):null;const p=page.waitForResponse(r=>r.request().method()===op.method&&(exact?new URL(r.url()).pathname===exact:op.pattern.test(new URL(r.url()).pathname)));void p.catch(()=>{});return p;};
 const actual=async(id,p)=>{const r=await p;assert.equal(r.status(),map.get(id).status);assert(r.headers()['x-poms-r4ghi-ui-run']);const value=unwrap(await r.json());seen.push({operationId:id,status:r.status()});await server.settle();return value;};
 async function open(){await expect(page.getByRole('button',{name:'提成角色职责',exact:true})).toBeEnabled();await page.getByRole('button',{name:'提成角色职责',exact:true}).click();await expect(component()).toBeVisible();await expect(component().getByRole('button',{name:'重新读取当前分配',exact:true})).toBeEnabled();}
 let result;try{await context.addCookies(Object.entries(test.actor.cookies).map(([name,value])=>({name,value,url:origin,httpOnly:name==='poms_session',sameSite:'Lax'})));await context.route('**/*',async route=>{const url=new URL(route.request().url());if(!['http:','https:'].includes(url.protocol)||url.origin===origin)await route.continue();else{blocked.push(url.origin);await route.abort('blockedbyclient');}});page.on('request',r=>{const u=new URL(r.url());if(u.origin===origin&&u.pathname.startsWith('/api/'))requests.push({method:r.method(),path:u.pathname});});page.on('pageerror',e=>errors.push(e.stack||String(e)));page.on('console',m=>{if(m.type()==='error')consoleErrors.push(m.text());});
 const auth=watch('AuthController_getCurrentAuthSession',{}),primary=watch('ProjectController_getById',{id:test.projectId});await page.goto(`/projects/${test.projectId}/governance`,{waitUntil:'domcontentloaded'});const session=await actual('AuthController_getCurrentAuthSession',auth);assert(session.authenticated&&session.user.id===test.actor.id&&session.permissions.includes('commission:assignments:manage'));const project=await actual('ProjectController_getById',primary);assert.equal(project.scopeKind,'full-project');assert.equal(project.currentStage,'handover');assert.equal(project.id,test.projectId);
 const current=watch('CommissionController_getCurrentRoleAssignment',{projectId:test.projectId});await open();assert.equal(await actual('CommissionController_getCurrentRoleAssignment',current),null);
 for(let i=0;i<action.participants.length;i++){if(i)await component().getByRole('button',{name:'增加真实职责',exact:true}).click();const row=action.participants[i],actor=test.boundActors[row.actorKey];assert(actor);const field=component().getByRole('group',{name:`角色 ${i+1}`,exact:true});await expect(field).toHaveCount(1);const duty=field.getByRole('combobox');await expect(duty).toHaveCount(1);await duty.selectOption(`${actor.id}:${row.roleType}`);await field.getByLabel('责任说明',{exact:true}).fill(row.responsibilitySummary);await field.getByLabel('权重（0–1，最多六位有效小数）',{exact:true}).fill(row.weight);await field.getByLabel('零权重原因（权重为 0 时必填）',{exact:true}).fill(row.zeroWeightReason??'');}
 const creating=watch('CommissionController_createRoleAssignment',{projectId:test.projectId}),afterCreate=watch('ProjectController_getById',{id:test.projectId});await component().getByRole('button',{name:'保存新的分配版本',exact:true}).click();const created=await actual('CommissionController_createRoleAssignment',creating);assert.equal(created.status,'draft');await actual('ProjectController_getById',afterCreate);
 const detail=watch('CommissionRoleAssignmentController_getRoleAssignmentDetail',{id:created.id});await open();const actualDetail=await actual('CommissionRoleAssignmentController_getRoleAssignmentDetail',detail);assert(actualDetail.allowedActions.includes('freeze-commission-role-assignment'));await component().locator('input[name="freeze-comment"]').fill(action.freezeComment);
 const freezing=watch('CommissionRoleAssignmentController_freezeRoleAssignment',{id:created.id}),afterFreeze=watch('ProjectController_getById',{id:test.projectId});await component().getByRole('button',{name:'确认本次角色与权重冻结',exact:true}).click();const frozen=await actual('CommissionRoleAssignmentController_freezeRoleAssignment',freezing);assert.equal(frozen.businessStatusAfter,'frozen');assert.equal((await actual('ProjectController_getById',afterFreeze)).currentStage,'handover');assert.equal(errors.length,0);fontBoundary32.assertExpected({ consoleErrors, blocked: blocked });
 result={kind:test.kind,status:'passed',actualProjectNavigationObserved:true,assignmentId:created.id,freezeSummarySnapshotId:frozen.summarySnapshotId,actualOperations:seen,executionNotRequested:true,allA08FormsPassed:false,G3Certified:false};
 }catch(error){save('failure.log',Buffer.from(error.stack||String(error)));result={kind:test.kind,status:'failed',actualOperations:seen,allA08FormsPassed:false,G3Certified:false};}finally{ save('font-boundary32.json', fontBoundary32.snapshot());save('requests.json',requests);save('errors.json',{errors,consoleErrors,blocked});save('result.json',result);save('page.html',Buffer.from(await page.content()));await page.screenshot({path:path.join(directory,'page.png'),fullPage:true});await context.close();}return result;}

import assert from 'node:assert/strict';import {createRequire}from'node:module';import{sha}from'./pure.mjs';
export function fixturePointer(state,pointer){assert(pointer==='/fixtures/uiFormFixtureViews18/role-create/pause/result/projectId');return state.fixtures.uiFormFixtureViews18['role-create'].pause.result.projectId;}
export function fixtureFactsHash(ctx){const value=structuredClone(ctx.state.fixtures),record=value.uiFormFixtureViews18?.['role-create'];if(record)for(const key of['UICommandObserved','UICommandObserverReceipt','UICommandResponseOriginal','UICommandOperationId'])delete record[key];return sha(JSON.stringify(value));}
export function resolveCases(ctx,plans){assert.equal(plans.length,1);return plans.map(plan=>{assert.equal(plan.kind,'role-forms');assert.equal(plan.actorKey,'manager');const actor=ctx.state.actors.manager,projectId=fixturePointer(ctx.state,plan.projectIdPointer);assert(actor&&projectId);return{...plan,projectId,actor};});}
export function actualSpareRecord(ctx,scene,action){assert.equal(scene.kind,'role-forms');assert.equal(action.kind,scene.kind);const record=ctx.state.fixtures.uiFormFixtureViews18?.['role-create'];assert(record?.pause?.result.projectId===scene.projectId&&!record.UICommandObserved);assert.equal(record.pause.result.boundary.operationId,'CommissionController_createRoleAssignment');assert.equal(record.pause.result.boundary.requestedHTTPNotSent,true);const{assertAdmittedFixtureSource}=createRequire(import.meta.url)('./consumer-admission54.mjs');const proof=assertAdmittedFixtureSource(ctx,{registryPath:'/fixtures/uiFormFixtureViews18/role-create',record,projectIds:[scene.projectId]});assert(proof&&typeof proof.then!=='function');return record;}
export function recordActualUIReceipt(ctx,pending){const record=actualSpareRecord(ctx,pending.scene,pending.action);assert.equal(pending.operationId,'CommissionRoleAssignmentController_freezeRoleAssignment');record.UICommandObserved=true;record.UICommandObserverReceipt=pending.ledger;record.UICommandResponseOriginal=pending.originals;record.UICommandOperationId=pending.operationId;ctx.persist();}

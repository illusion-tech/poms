import { observeFontBoundary32 } from './ui-font-boundary32.mjs';
import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';
export const SOURCE_BASE_SHA256='52addde6eab92076ea50970e597754bf426fc21a87019c91e25714b40068fe0c';const origin='http://127.0.0.1:44551',root='E:/projects/worktrees/poms-r3hijk-next28/poms',unwrap=v=>v?.data??v;
function operations(){const spec=JSON.parse(fs.readFileSync(`${root}/libs/shared/api-spec/openapi.json`)),map=new Map();for(const[template,item]of Object.entries(spec.paths))for(const[method,op]of Object.entries(item))if(op.operationId){const statuses=Object.keys(op.responses).filter(v=>/^2\d\d$/.test(v));assert.equal(statuses.length,1);const pattern=template.split(/(\{[^}]+\})/).map(p=>p.startsWith('{')?'[^/]+':p.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')).join('');map.set(op.operationId,{method:method.toUpperCase(),template,pattern:new RegExp(`^${pattern}$`),status:Number(statuses[0])});}return map;}
export async function executeCase(browser,expect,test,directory,server){assert.equal(test.kind,'gh-forms');const action=test.writeAction,map=operations(),seen=[],requests=[],errors=[],consoleErrors=[],blocked=[],context=await browser.newContext({baseURL:origin,locale:'zh-CN',timezoneId:'Asia/Shanghai',viewport:{width:1440,height:1000},serviceWorkers:'block'}),page=await context.newPage();page.setDefaultTimeout(90000); const fontBoundary32 = observeFontBoundary32(page);const author=page.locator('app-project-operating-authoring'),review=page.locator('app-project-operating-review');
 const save=(name,v)=>fs.writeFileSync(path.join(directory,name),Buffer.isBuffer(v)?v:Buffer.from(JSON.stringify(v,null,2)+'\n'),{flag:'wx',mode:0o600}),watch=(id,params=null,query={})=>{const op=map.get(id);assert(op);const exact=params?op.template.replace(/\{([^}]+)\}/g,(_,k)=>{assert(params[k]);return encodeURIComponent(params[k]);}):null;const p=page.waitForResponse(r=>{const u=new URL(r.url());return r.request().method()===op.method&&(exact?u.pathname===exact:op.pattern.test(u.pathname))&&Object.entries(query).every(([k,v])=>u.searchParams.get(k)===v);});void p.catch(()=>{});return p;},actual=async(id,p)=>{const r=await p;assert.equal(r.status(),map.get(id).status);assert(r.headers()['x-poms-r4ghi-ui-run']);const v=unwrap(await r.json());seen.push({operationId:id,status:r.status()});await server.settle();return v;};
 let result;try{await context.addCookies(Object.entries(test.actor.cookies).map(([name,value])=>({name,value,url:origin,httpOnly:name==='poms_session',sameSite:'Lax'})));await context.route('**/*',async route=>{const u=new URL(route.request().url());if(!['http:','https:'].includes(u.protocol)||u.origin===origin)await route.continue();else{blocked.push(u.origin);await route.abort('blockedbyclient');}});page.on('request',r=>{const u=new URL(r.url());if(u.origin===origin&&u.pathname.startsWith('/api/'))requests.push({method:r.method(),path:u.pathname+u.search});});page.on('pageerror',e=>errors.push(e.stack||String(e)));page.on('console',m=>{if(m.type()==='error')consoleErrors.push(m.text());});
 const auth=watch('AuthController_getCurrentAuthSession',{}),primary=watch('ProjectController_getById',{id:test.projectId});await page.goto(`/projects/${test.projectId}/governance`,{waitUntil:'domcontentloaded'});const session=await actual('AuthController_getCurrentAuthSession',auth);assert(session.authenticated&&session.user.id===test.actor.id&&session.permissions.includes('contract:finance:manage'));const project=await actual('ProjectController_getById',primary);assert.equal(project.scopeKind,'full-project');assert.equal(project.id,test.projectId);
 const firstPrep=watch('ProjectCostController_getProjectUnifiedAccounting',{projectId:test.projectId},{view:'preparation',intent:'snapshot-create'});await page.getByRole('button',{name:'经营核算编制',exact:true}).click();await actual('ProjectCostController_getProjectUnifiedAccounting',firstPrep);
 const baselinePrep=watch('ProjectCostController_getProjectUnifiedAccounting',{projectId:test.projectId},{view:'preparation',intent:'baseline-activation'});await author.locator('label').filter({hasText:/^编制任务/}).locator('select').selectOption('baseline-activation');const p=(await actual('ProjectCostController_getProjectUnifiedAccounting',baselinePrep)).preparation;assert(p.allowedCommandCodes.includes('baseline-activation')&&p.proposedOriginalCostRef&&!p.selectedBaselinePackageRef);
 await author.locator('label').filter({hasText:/^采用或重述理由/}).locator('textarea').fill(action.baselineReason);const activating=watch('ProjectCostController_activateOperatingBaselinePackage',{});await author.getByRole('button',{name:'采用正式基线',exact:true}).click();const baseline=await actual('ProjectCostController_activateOperatingBaselinePackage',activating);assert.equal(baseline.evaluationRefs,null);
 const capturePrep=watch('ProjectCostController_getProjectUnifiedAccounting',{projectId:test.projectId},{view:'preparation',intent:'snapshot-create'});await author.locator('label').filter({hasText:/^编制任务/}).locator('select').selectOption('snapshot-create');const prepared=(await actual('ProjectCostController_getProjectUnifiedAccounting',capturePrep)).preparation;assert.equal(prepared.selectedBaselinePackageRef.id,baseline.targetId);assert(prepared.allowedCommandCodes.includes('snapshot-create'));
 const pending=prepared.sourceRows.filter(r=>r.rowKind==='direct-cost'&&!r.currentDecisionRef&&!r.blockingReasonCodes.includes('outside-business-cutoff'));assert(pending.length>0);for(const cost of pending){const row=author.locator('tbody tr').filter({hasText:cost.sourceRef.id});await expect(row).toHaveCount(1);await row.getByLabel('成本分类',{exact:true}).selectOption('include');await row.locator('label').filter({hasText:/^原因/}).locator('input').fill(action.classificationReason);const members=new Set([cost.sourceRef.id,...cost.sourceMembers.map(r=>r.id)]),evidence=prepared.sourceRows.filter(r=>r.rowKind==='stage-evidence'&&r.state==='ready'&&members.has(r.sourceRef.id));assert(evidence.length>0,'No real same-source classification evidence; cannot invent an option');await row.getByLabel('分类证据',{exact:true}).selectOption(evidence[0].sourceRef.id);}
 const capturing=watch('ProjectCostController_createProjectOperatingSnapshot',{}),snapshotRead=watch('ProjectCostController_getProjectOperatingSnapshot');await author.getByRole('button',{name:'冻结服务端经营快照',exact:true}).click();const captured=await actual('ProjectCostController_createProjectOperatingSnapshot',capturing),snapshot=await actual('ProjectCostController_getProjectOperatingSnapshot',snapshotRead);assert.equal(snapshot.id,captured.targetId);assert(snapshot.evaluationRefs&&new Set(Object.values(snapshot.evaluationRefs.bindingIds)).size===4);
 const signalRead=watch('ProjectCostController_getOperatingSignalEvaluation',{id:snapshot.evaluationRefs.signalEvaluationId});await page.getByRole('button',{name:'经营与提成门禁复核',exact:true}).click();const signal=await actual('ProjectCostController_getOperatingSignalEvaluation',signalRead),issue=signal.reasonItems.find(r=>r.code==='qualitative-materiality-unassessed');assert(issue&&issue.evidenceProjection.mode==='full'&&issue.evidenceProjection.value,'Actual OSER has no H08. Stop without fabricating an issue or claiming the signal form passed.');const refs=JSON.parse(issue.evidenceProjection.value);assert(Array.isArray(refs)&&refs.length);const source=refs[0],key=`${source.kind}:${source.id}:${source.rowVersion}:${source.payloadHash}`;
 const form=review.getByRole('form',{name:'质性重大性复核',exact:true});await form.locator('label').filter({hasText:/^冻结依据/}).locator('select').selectOption(key);await form.locator('label').filter({hasText:/^质性结论/}).locator('select').selectOption(action.riskDecision);await form.getByLabel('依据与理由',{exact:true}).fill(action.materialityRationale);
 const reviewing=watch('ProjectCostController_reviewOperatingSignalEvaluation',{id:signal.signalEvaluationId}),feedbackRead=watch('ProjectCostController_getBusinessAccountingFeedback',{projectId:test.projectId}),newSignalRead=watch('ProjectCostController_getOperatingSignalEvaluation',{id:signal.signalEvaluationId});await form.getByRole('button',{name:'提交质性复核',exact:true}).click();const reviewed=await actual('ProjectCostController_reviewOperatingSignalEvaluation',reviewing);assert.equal(reviewed.dataMaturityLevel,signal.dataMaturityLevel);const feedback=await actual('ProjectCostController_getBusinessAccountingFeedback',feedbackRead);await actual('ProjectCostController_getOperatingSignalEvaluation',newSignalRead);
 const index=feedback.stageBindings.findIndex(s=>s.gateStageType==='first');assert(index>=0);const first=feedback.stageBindings[index],gateRead=watch('ProjectCostController_getCommissionGateBinding',{id:first.bindingId});await review.getByRole('button',{name:'读取本阶段复核依据',exact:true}).nth(index).click();const gate=await actual('ProjectCostController_getCommissionGateBinding',gateRead);assert.equal(gate.gateStageType,'first');const gateForm=review.getByRole('form',{name:'提成阶段复核',exact:true});await gateForm.locator('label').filter({hasText:/^处理动作/}).locator('select').selectOption('tighten-block');await gateForm.getByLabel('复核说明',{exact:true}).fill(action.gateComment);
 const gating=watch('ProjectCostController_reviewCommissionGateBinding',{id:gate.bindingId});await gateForm.getByRole('button',{name:'提交本阶段复核',exact:true}).click();const gateResult=await actual('ProjectCostController_reviewCommissionGateBinding',gating);assert.equal(gateResult.bindingAction,'block');assert.equal(errors.length,0);fontBoundary32.assertExpected({ consoleErrors, blocked: blocked });
 result={kind:test.kind,status:'passed',actualProjectNavigationObserved:true,baselineId:baseline.targetId,snapshotId:snapshot.id,signalReviewId:reviewed.reviewRecordId,gateReviewId:gateResult.gateReviewRecordId,actualFrozenH08:true,actualOperations:seen,allA08FormsPassed:false,G3Certified:false};
 }catch(error){save('failure.log',Buffer.from(error.stack||String(error)));result={kind:test.kind,status:'failed',actualOperations:seen,allA08FormsPassed:false,G3Certified:false};}finally{ save('font-boundary32.json', fontBoundary32.snapshot());save('requests.json',requests);save('errors.json',{errors,consoleErrors,blocked});save('result.json',result);save('page.html',Buffer.from(await page.content()));await page.screenshot({path:path.join(directory,'page.png'),fullPage:true});await context.close();}return result;}

// Root external command capture. No approval signing or production writes.
const fs = require('node:fs');
const cp = require('node:child_process');
const assert = require('node:assert/strict');
const crypto = require('node:crypto');
const R = 'E:/projects/worktrees/poms-r3hijk-next28/poms';
const L = '/mnt/e/projects/worktrees/poms-r3hijk-next28/poms';
const NODE = '/home/wangzishi/.local/share/fnm/node-versions/v24.19.0/installation/bin/node';
const sha = b => crypto.createHash('sha256').update(b).digest('hex');
const a = process.argv.slice(2);
assert.deepEqual([a[0], a[2]], ['--spec', '--spec-sha']); assert.equal(a.length, 4);
const bytes = fs.readFileSync(a[1]); assert.equal(sha(bytes), a[3]);
const s = JSON.parse(bytes);
assert.deepEqual(Object.keys(s).sort(), ['args','mode','program'].sort());
assert(/^[a-z0-9-]+$/.test(s.mode));
assert.deepEqual(Object.keys(s.program).sort(), ['bytes','file','rawBytesSha256'].sort());
assert(s.program.file.startsWith('/mnt/e/projects/worktrees/'));
assert(!/[\\\0\r\n]/.test(s.program.file) && !s.program.file.includes('/../'));
const winFile = 'E:/' + s.program.file.slice('/mnt/e/'.length);
const programBytes = fs.readFileSync(winFile);
assert.equal(programBytes.length, s.program.bytes); assert.equal(sha(programBytes), s.program.rawBytesSha256);
assert(Array.isArray(s.args) && s.args.every(x => typeof x === 'string' && !/[\0\r\n]/.test(x)));
const parent = 'C:/Users/ynh2/.codex/tmp/runtime118-resume-2026-11-16';
fs.mkdirSync(parent, {recursive:true});
const out = parent + '/' + s.mode + '-' + a[3];
assert(!fs.existsSync(out), 'Existing exact attempt preserved; no blind retry');
fs.mkdirSync(out);
function save(name, value) {
  const file=out+'/'+name, b=Buffer.from(JSON.stringify(value,null,2)+'\n');
  fs.writeFileSync(file,b,{flag:'wx'}); return {file,bytes:b.length,rawBytesSha256:sha(b)};
}
const args=['-d','Debian','--cd',L,'--exec','/usr/bin/env','-i','HOME=/home/wangzishi','USER=wangzishi','LOGNAME=wangzishi','PATH=/usr/bin:/bin','LANG=C.UTF-8','LC_ALL=C.UTF-8',NODE,s.program.file,...s.args];
const startedAt=new Date().toISOString(), startedMono=process.hrtime.bigint();
save('intent.json',{kind:'Root-runtime118-exact-command-intent',schemaVersion:1,operatorIdentity:'/root',mode:s.mode,startedAt,program:s.program,spec:{file:a[1],bytes:bytes.length,rawBytesSha256:a[3]},executable:'C:/Windows/System32/wsl.exe',argv:args,cwd:R,automaticRetry:false,rawCapturePrivate:true});
const stdoutFile=out+'/stdout.bin', stderrFile=out+'/stderr.bin';
const ofd=fs.openSync(stdoutFile,'wx'), efd=fs.openSync(stderrFile,'wx');
let spawned=false,spawnError=null,pid=null,exitObservedAt=null,observedExitCode=null,observedSignal=null,stdoutEnded=false,stderrEnded=false;
const child=cp.spawn('C:/Windows/System32/wsl.exe',args,{cwd:R,windowsHide:true,stdio:['ignore','pipe','pipe']});
child.once('spawn',()=>{spawned=true;pid=child.pid;});
child.once('error',e=>{spawnError={name:e.name,code:e.code??null};});
child.stdout.on('data',b=>fs.writeSync(ofd,b)); child.stderr.on('data',b=>fs.writeSync(efd,b));
child.stdout.once('end',()=>{stdoutEnded=true;}); child.stderr.once('end',()=>{stderrEnded=true;});
child.once('exit',(code,signal)=>{exitObservedAt=new Date().toISOString();observedExitCode=code;observedSignal=signal;});
child.once('close',(exitCode,signal)=>{
  const captureClosedAt=new Date().toISOString(), elapsedNs=(process.hrtime.bigint()-startedMono).toString();
  fs.fsyncSync(ofd);fs.fsyncSync(efd);fs.closeSync(ofd);fs.closeSync(efd);
  const pin=file=>{const b=fs.readFileSync(file);return{file,bytes:b.length,rawBytesSha256:sha(b)};};
  const receipt=save('command-receipt.json',{kind:'Root-runtime118-exact-command-result',schemaVersion:1,operatorIdentity:'/root',mode:s.mode,program:s.program,executable:'C:/Windows/System32/wsl.exe',argv:args,cwd:R,startedAt,exitObservedAt,captureClosedAt,elapsedNs,pid,processSpawnConfirmed:spawned,exitCode,signal,observedExitCode,observedSignal,spawnError,naturalEOF:stdoutEnded&&stderrEnded,stdoutEnded,stderrEnded,stdout:pin(stdoutFile),stderr:pin(stderrFile),rawCapturePrivate:true,automaticRetry:false});
  console.log(JSON.stringify({mode:s.mode,receipt,processSpawnConfirmed:spawned,exitCode,signal,stdoutBytes:fs.statSync(stdoutFile).size,stderrBytes:fs.statSync(stderrFile).size}));
  if(!spawned||exitCode!==0||signal!==null)process.exitCode=1;
});

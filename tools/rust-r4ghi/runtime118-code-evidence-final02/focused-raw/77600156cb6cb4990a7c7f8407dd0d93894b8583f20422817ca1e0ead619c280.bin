   ['Origin new K',`const s=y.json(y.originPin);s.continuation121=s.continuationReadback;y.register(y.originPin,s);`],
   ['W4 relabelled three-stage',`const w=y.json(y.W4pin);w.kind='Root-runtime121-three-stage-client-source-witness';y.register(y.W4pin,w);`],
   ['baseline graph changed',`const w=y.json(y.W4pin);w.baselineExecutionSources=w.currentExecutionSources;y.register(y.W4pin,w);`],
   ['retained nine missing preimage',`y.entries.delete(y.key(y.mappings[3].retainedCopy));`],
   ['wrong stage file hash cannot fall back',`const r=y.json(y.retainedPin);r.mappings[0].retainedCopy.rawBytesSha256='0'.repeat(64);y.register(y.retainedPin,r);`],
   ['original K body null rewritten',`const k=y.json(B118.K);k.current15.bodySHA256=B118.bodySHA;y.register(B118.K,k);`],
   ['original record changed',`const s=y.json(B118.state);s.taxContinuation121.complete={synthetic:true};y.register(B118.state,s);`],
   ['original 6458 journal changed',`const s=y.json(B118.state);s.consumerChecks.taxInvocation121.invocations[B118.nonce].phase='closed-failed';y.register(B118.state,s);`],
   ['old carrier backfilled',`const s=y.json(B118.state);s.taxContinuation121.continuationReadback=y.originPin;y.register(B118.state,s);`],
   ['source manifest tenth graph member',`const q=y.json(y.W4.successorManifest);q.production.push(q.production[0]);y.register(y.W4.successorManifest,q);`],
   ['source review author equals reviewer',`const q=y.json(y.W4.successorCodeReview);q.reviewer=q.author;y.register(y.W4.successorCodeReview,q);`],

const API_KEYS=['kind','protocolVersion','namespace','epoch','run','root','port','pid','startTime','startedAt','bootId','binary','binarySha256','binaryFiles','baseBuildBinding','sourcePins','compilePins','helperPins','baseAPIProcess','lifetimeOwner','normalEnv','baseNormalEnv','readinessAttempt','input','code','recoveryG1','sourceComplete','startupGraph'];
const ENV_KEYS=['NODE_ENV','HOST','PORT','DB_CONNECT','DB_HOST','DB_PORT','DB_DATABASE','DB_USER','DB_PASSWORD','DB_SCHEMA','JWT_SECRET','CORS_ORIGIN','ATTACHMENT_STORAGE_PROVIDER_SECRET_KEY','IDENTITY_PROVIDER_SECRET_KEY','IDENTITY_PROVIDER_STATE_KEY','POMS_ATTACHMENT_LOCAL_ROOT'];
function deriveEnv(bytes){const text=new TextDecoder('utf-8',{fatal:true}).decode(bytes),env=new Map();for(const line of text.split(/\r?\n/)){if(!line.trim()||line.trim().startsWith('#'))continue;const m=/^([A-Z_][A-Z0-9_]*)=([^\r\n]*)$/.exec(line);assert(m&&ENV_KEYS.includes(m[1])&&!env.has(m[1]),'Private environment syntax');assert(!/["'#$`\\\0]/.test(m[2]),'Private environment encoding');env.set(m[1],m[2]);}assert.deepEqual([...env.keys()].sort(),[...ENV_KEYS].sort());for(const[key,value]of Object.entries({DB_CONNECT:'true',DB_HOST:'127.0.0.1',DB_PORT:'25434',DB_DATABASE:C.databases[1],DB_USER:'poms_r4ghi_rust_app',DB_SCHEMA:'poms',POMS_ATTACHMENT_LOCAL_ROOT:PRIVATE.slice(0,-'/private'.length)+'/objects/rust'}))assert.equal(env.get(key),value,'Private startup binding');env.set('HOST','127.0.0.1');env.set('PORT','31441');env.set('CORS_ORIGIN','http://127.0.0.1:44551,http://localhost:44551');return Buffer.from([...env].map(([key,value])=>key+'='+value).join('\n')+'\n');}
function binaryFact(p){full(p);const r=readFile(p.file,{single:false});assert.equal(r.bytes.length,p.bytes);assert.equal(sha(r.bytes),p.rawBytesSha256);assert.equal(r.bytes.subarray(0,4).toString('hex'),'7f454c46');const f=r.identity;return{file:p.file,rawBytesSha256:p.rawBytesSha256,bytes:p.bytes,dev:f.dev,ino:f.ino,nlink:f.nlink};}
function cargoFiles(root){const out=[],walk=dir=>{if(!fs.existsSync(dir))return;directory(dir);for(const name of fs.readdirSync(dir).sort()){if(['target','node_modules','.git'].includes(name))continue;const file=dir+'/'+name,s=fs.lstatSync(file);assert(!s.isSymbolicLink());if(s.isDirectory())walk(file);else if(/\.(rs|toml|json|cjs)$/.test(name)||name==='Cargo.lock'||(dir.endsWith('/.cargo')&&name==='config')){assert(s.isFile()&&s.nlink===1);out.push(file.slice(root.length+1));}}};walk(root+'/apps/poms-api-rust');walk(root+'/.cargo');return out.sort();}
function startupSources(p){const old=oldPlan();for(const k of['sourcePins','compilePins','binary','summaryBinary','nodeExecutable'])same(p[k],old.current[k]);assert.equal(p.baseNormalEnv.file,PRIVATE+'/rust.env');assert(p.baseNormalEnv.bytes>0);const sources=descriptors(json(p.sourcePins),420),compile=descriptors(json(p.compilePins),528);for(const root of[ROOT,C.mirror]){for(const pin of compile)assert.equal(sha(readFile(root+'/'+pin.file).bytes),pin.sha256);assert.deepEqual(cargoFiles(root),compile.filter(x=>x.file.startsWith('apps/poms-api-rust/')||x.file.startsWith('.cargo/')).map(x=>x.file).sort());}for(const pin of sources)assert.equal(sha(readFile(ROOT+'/'+pin.file).bytes),pin.sha256);const binaryFiles=[p.binary,p.summaryBinary].map(binaryFact);assert.deepEqual(binaryFiles,p.binaryFiles);return{old,binaryFiles};}
function startupEnv(p){const r=readFile(p.baseNormalEnv.file);assert.equal(r.identity.uid,1000);assert.equal(r.identity.mode&0o777,0o600);assert.equal(r.bytes.length,p.baseNormalEnv.bytes);assert.equal(sha(r.bytes),p.baseNormalEnv.rawBytesSha256);return r.bytes;}
function assertStartup(stat,startedAt){assert(stat.isFile()&&!stat.isSymbolicLink()&&stat.nlink===1n);assert.equal(stat.mode&0o777n,0o600n);assert.equal(stat.uid,1000n);const ns=BigInt(Date.parse(startedAt))*1000000n;assert(stat.mtimeNs<=ns&&stat.ctimeNs<=ns);if(stat.birthtimeNs>0n)assert(stat.birthtimeNs<=ns);}
async function waitAfterEnv(stat){const ns=[stat.mtimeNs,stat.ctimeNs,stat.birthtimeNs].filter(x=>typeof x==='bigint'&&x>0n);assert(ns.length>=2);const latest=ns.reduce((a,b)=>a>b?a:b),required=Number((latest+999999n)/1000000n);assert(required-Date.now()<=1000);const end=performance.now()+1000;while(Date.now()<required){assert(performance.now()<end);await new Promise(r=>setTimeout(r,1));}}
function readiness(attempt){assert.equal(attempt.method,'GET');assert.equal(attempt.url,'http://127.0.0.1:31441/api/health/readiness');assert.equal(attempt.status,200);assert.equal(attempt.complete,true);assert.equal(attempt.errorCode,null);const b=JSON.parse(attempt.body);assert.equal(b.service,'poms-api');assert.equal(b.status,'ready');assert.equal(b.checks?.process?.status,'pass');assert.equal(b.checks?.database?.status,'pass');}
function healthAttempt(){const url='http://127.0.0.1:31441/api/health/readiness',began=new Date().toISOString();return new Promise(resolve=>{const chunks=[];let size=0,settled=false;const done=x=>{if(settled)return;settled=true;resolve({method:'GET',url,began,ended:new Date().toISOString(),...x});};const request=http.request(url,{method:'GET',headers:{'Accept-Encoding':'identity'},timeout:3000},res=>{res.on('data',b=>{size+=b.length;if(size>1048576)request.destroy(new Error('Readiness bound'));else chunks.push(Buffer.from(b));});res.once('aborted',()=>done({status:res.statusCode,body:Buffer.concat(chunks).toString(),complete:false,errorCode:'RESPONSE_ABORTED'}));res.once('error',()=>done({status:res.statusCode,body:Buffer.concat(chunks).toString(),complete:false,errorCode:'RESPONSE_ERROR'}));res.once('end',()=>done({status:res.statusCode,body:Buffer.concat(chunks).toString(),complete:res.complete,errorCode:null,rawHeaders:res.rawHeaders}));});request.once('error',e=>done({status:null,body:'',complete:false,errorCode:e.code==='ECONNREFUSED'?'ECONNREFUSED':'READINESS_TRANSPORT_UNKNOWN'}));request.once('timeout',()=>request.destroy(new Error('Readiness timeout')));request.end();});}
function apiIdentity(p,pid,startTime=null,withSocket=false){const live=procIdentity(pid);if(startTime!==null)assert.equal(live.startTime,startTime);assert.equal(live.exe,p.binary.file);assert.equal(live.cwd,C.mirror);assert.equal(live.uid,1000);assert.deepEqual(live.argv,[p.binary.file]);assert.deepEqual(processEnvironment(pid),{...HOST_ENV,POMS_ENV_FILE:p.normalEnvFile});const st=fs.statSync('/proc/'+pid+'/exe',{bigint:true}),f=p.binaryFiles.find(x=>x.file===p.binary.file);assert.equal(st.dev.toString(),f.dev);assert.equal(st.ino.toString(),f.ino);let socket=null;if(withSocket){const l=listeners(31441);assert.equal(l.length,1);assert.equal(l[0].table,'/proc/net/tcp');assert.equal(l[0].local,'0100007F:7AD1');const fds=[];for(const fd of fs.readdirSync('/proc/'+pid+'/fd'))try{fds.push(fs.readlinkSync('/proc/'+pid+'/fd/'+fd));}catch(e){if(e.code!=='ENOENT')throw e;}assert(fds.includes('socket:['+l[0].inode+']'));socket={version:4,host:'0100007F',inode:l[0].inode};}return{pid,startTime:live.startTime,bootId:currentBoot(),argv:live.argv,uid:1000,cwd:C.mirror,executable:p.binary.file,environmentSHA256:sha(fs.readFileSync('/proc/'+pid+'/environ')),socket};}
function liveAPI(m){assert.equal(m.phase,'api-start');const p=m.p,r=json(m.e.outputs.processRecord);keys(r,API_KEYS);assert.equal(r.kind,'actual-Source15-runtime118-reentry-API-process');assert.equal(r.protocolVersion,2);same(r.recoveryG1,G1);same(r.input,m.e.input);assert.equal(m.e.outputs.processRecord.file,p.processFile);same(r.normalEnv,m.e.outputs.environment);assert.equal(r.normalEnv.file,p.normalEnvFile);assert.equal(r.root,C.mirror);assert.equal(r.port,31441);assert.equal(r.namespace,C.namespace);assert.equal(r.epoch,'g2-business15');assert.equal(r.run,'main01');assert.equal(r.bootId,currentBoot());assert.deepEqual(r.code,m.qualification.executionSources);const ev=json(m.peer.evidence),sc=assertSourceDelivery(p.sourceComplete,ev.independentReadback);same(r.sourceComplete,p.sourceComplete);same(r.helperPins,sc.currentGraphs.helper);same(r.startupGraph,sc.currentGraphs.execution);same(r.lifetimeOwner,p.lifetimeOwner);same(r.sourcePins,p.sourcePins);same(r.compilePins,p.compilePins);same(r.baseNormalEnv,p.baseNormalEnv);const pre=readEnvelope(p.preConservation,'ro-before'),h=liveHolder(pre.p.prior.holder);same(p.lifetimeOwner,h.e.outputs.lifetimeOwner);assert(Date.parse(r.startedAt)>=Date.parse(h.holder.startedAt));startupSources(p);assert(read(r.normalEnv).equals(deriveEnv(startupEnv(p))));assertStartup(fs.lstatSync(p.normalEnvFile,{bigint:true}),r.startedAt);readiness(json(r.readinessAttempt));const identity=apiIdentity(p,r.pid,r.startTime,true);const evidence=json(m.e.outputs.processEvidence);assert.deepEqual(evidence,identity);return{record:r,identity};}
async function apiPhase(m){const p=m.p;earlyGuard(m);const pre=readEnvelope(p.preConservation,'ro-before');verifyComparison(pre);const pg=verifyPGStep(p.PGStart);same(pre.p.prior.PG,p.PGStart);const h=liveHolder(pre.p.prior.holder);same(p.lifetimeOwner,h.e.outputs.lifetimeOwner);const sc=sourceHistory(p.sourceComplete,json(m.peer.evidence).independentReadback);same(sc.window.PGConservation,p.preConservation);same(sc.window.holder,pre.p.prior.holder);const {old,binaryFiles}=startupSources(p);verifyPGStep(pg.pin);const environment=save(p.outputDirectory,'rust-api118.env',deriveEnv(startupEnv(p)));m.completedOutputs.environment=environment;const stat=fs.lstatSync(p.normalEnvFile,{bigint:true});await waitAfterEnv(stat);earlyGuard(m);startupSources(p);read(environment);for(const k of ["dev","ino","nlink","mode","uid","size","mtimeNs","ctimeNs","birthtimeNs"])assert.equal(fs.lstatSync(p.normalEnvFile,{bigint:true})[k],stat[k]);const startedAt=new Date().toISOString();assertStartup(stat,startedAt);const out=fs.openSync(p.outputDirectory+'/API-stdout-live.log','wx',0o600),err=fs.openSync(p.outputDirectory+'/API-stderr-live.log','wx',0o600);const processFact={role:'API',state:'spawned-unverified',command:null,pid:null,startTime:null,bootId:currentBoot(),record:null,error:null};m.processes.push(processFact);let child;
 try{child=spawn(p.binary.file,[],{cwd:C.mirror,env:{...HOST_ENV,POMS_ENV_FILE:p.normalEnvFile},detached:true,stdio:['ignore',out,err]});if(Number.isSafeInteger(child.pid))processFact.pid=child.pid;await new Promise((resolve,reject)=>{child.once('spawn',resolve);child.once('error',reject);});processFact.pid=child.pid;assert(Number.isSafeInteger(child.pid)&&child.pid>1);child.unref();}catch{processFact.state='unknown-preserve';throw new Error('API spawn result UNKNOWN; preserve process without retry');}finally{fs.closeSync(out);fs.closeSync(err);}
 let identity=apiIdentity(p,processFact.pid);processFact.startTime=identity.startTime;let accepted=null;for(let i=0;i<30;i++){guardLock(m);assertBirth();liveHolder(pre.p.prior.holder);startupSources(p);apiIdentity(p,processFact.pid,processFact.startTime);const attempt=await healthAttempt(),pin=save(p.outputDirectory,'readiness-attempt-'+String(i+1).padStart(2,'0')+'.json',attempt);if(attempt.errorCode==='ECONNREFUSED'){assert(i<29,'API readiness not established');await new Promise(r=>setTimeout(r,500));continue;}readiness(attempt);accepted=pin;break;}assert(accepted);guardLock(m);assertBirth();startupSources(p);liveHolder(pre.p.prior.holder);identity=apiIdentity(p,processFact.pid,processFact.startTime,true);assertStartup(fs.lstatSync(p.normalEnvFile,{bigint:true}),startedAt);const oldAPI=oldJSON(old.current.apiProcess);const record={kind:'actual-Source15-runtime118-reentry-API-process',protocolVersion:2,namespace:C.namespace,epoch:'g2-business15',run:'main01',root:C.mirror,port:31441,pid:identity.pid,startTime:identity.startTime,startedAt,bootId:identity.bootId,binary:p.binary.file,binarySha256:p.binary.rawBytesSha256,binaryFiles,baseBuildBinding:old.base.buildBinding,sourcePins:p.sourcePins,compilePins:p.compilePins,helperPins:sc.sc.currentGraphs.helper,baseAPIProcess:oldAPI.baseAPIProcess,lifetimeOwner:p.lifetimeOwner,normalEnv:environment,baseNormalEnv:p.baseNormalEnv,readinessAttempt:accepted,input:m.inputPin,code:m.qualification.executionSources,recoveryG1:G1,sourceComplete:p.sourceComplete,startupGraph:sc.sc.currentGraphs.execution};keys(record,API_KEYS);const processRecord=save(p.outputDirectory,'rust-api118-process.json',record);processFact.record=processRecord;processFact.state='verified-live';m.completedOutputs.processRecord=processRecord;const ready=save(p.outputDirectory,'readiness.json',{mode:'start',port:31441,readiness:200,privateCredentialsPrinted:false,pid:identity.pid,binarySha256:record.binarySha256});m.completedOutputs.readiness=ready;const processEvidence=save(p.outputDirectory,'actual-process.json',identity);m.completedOutputs.processEvidence=processEvidence;return{processRecord,environment,readiness:ready,processEvidence};}

function sameIdentity(a,b){for(const key of['dev','ino','nlink','mode','uid','bytes','rawBytesSha256','mtimeNs','ctimeNs','birthtimeNs'])assert.equal(a[key],b[key],'Exact guarded file identity');}
function guardOtherStates(){assert.equal(sha(readFile(C.state13).bytes),C.state13SHA);assert.equal(sha(readFile(C.state14).bytes),C.state14SHA);for(const n of[13,14,15])absent(PRIVATE+'/business/g2-business'+n+'/main01/driver.lock');for(const file of['runtime121-corrective361-source.lock','runtime121-corrective362-source.lock'])absent(PRIVATE+'/'+file);}
function systemExecutable(role){assert(['pwsh','wsl'].includes(role));const expected=WINDOWS[role],r=readFile(expected.file,{single:false});assert.equal(r.identity.nlink,expected.nlink);assert.equal(r.bytes.length,expected.bytes);assert.equal(sha(r.bytes),expected.rawBytesSha256);return{file:expected.file,bytes:expected.bytes,rawBytesSha256:expected.rawBytesSha256};}
function splitWindows(line){assert.equal(typeof line,'string');const out=[];let i=0;while(i<line.length){while(/\s/.test(line[i]??'')&&i<line.length)i++;if(i>=line.length)break;let word='',quoted=false;while(i<line.length){if(!quoted&&/\s/.test(line[i]))break;let slashes=0;while(line[i]==='\\'){slashes++;i++;}if(line[i]==='"'){word+='\\'.repeat(Math.floor(slashes/2));if(slashes%2)word+='"';else quoted=!quoted;i++;}else{word+='\\'.repeat(slashes);if(i<line.length)word+=line[i++];}}assert(!quoted);out.push(word);}return out;}
function launcherArguments(m){const ps=m.qualification.executionSources.find(p=>p.file===LAUNCHER);assert(ps);const source=read(ps).toString(),match=/\$script:Bootstrap118=@'\r?\n([\s\S]*?)\r?\n'@/.exec(source);assert(match,'Fixed qualified bootstrap literal');const args=['-d','Debian','--cd',ROOT,'--exec','/usr/bin/env','-i',...Object.entries(HOST_ENV).map(([k,v])=>k+'='+v),'/bin/sh','-c',match[1],'--',NODE.file,NODE.rawBytesSha256,ROOT,SELF,m.e.input.file,m.e.input.rawBytesSha256,m.e.RootApproval.file,m.e.RootApproval.rawBytesSha256,m.e.executionReview.file,m.e.executionReview.rawBytesSha256,m.p.outputDirectory];for(const p of[...m.qualification.executionSources,m.e.input,m.e.RootApproval,m.e.executionReview])args.push(p.file,p.rawBytesSha256,String(p.bytes));return args;}
function windowsLive(m,w){systemExecutable('wsl');const pwsh=systemExecutable('pwsh');assert(Number.isSafeInteger(w.pid)&&w.pid>1);const script="$ErrorActionPreference='Stop';$p=Get-CimInstance Win32_Process -Filter 'ProcessId="+w.pid+"';if($null -eq $p){throw 'Missing fixed WSL process'};[Console]::OutputEncoding=[Text.UTF8Encoding]::new($false);@{pid=[int]$p.ProcessId;creationTime=$p.CreationDate.ToUniversalTime().ToString('o');executable=$p.ExecutablePath.Replace('\\','/');commandLine=[string]$p.CommandLine}|ConvertTo-Json -Compress";const result=spawnSync(pwsh.file,['-NoProfile','-NonInteractive','-EncodedCommand',Buffer.from(script,'utf16le').toString('base64')],{cwd:ROOT,env:{...HOST_ENV},encoding:'utf8',timeout:10000,maxBuffer:1048576,stdio:['ignore','pipe','pipe']});const a=JSON.parse(successful(result));keys(a,['pid','creationTime','executable','commandLine']);assert.equal(a.pid,w.pid);assert.equal(a.creationTime,w.creationTime);assert.equal(a.executable.toLowerCase(),'c:/windows/system32/wsl.exe');const parsed=splitWindows(a.commandLine);assert.equal(parsed.shift().replaceAll('\\','/').toLowerCase(),'c:/windows/system32/wsl.exe');assert.deepEqual(w.argv,launcherArguments(m));assert.deepEqual(parsed,w.argv);}
function holderFixed(m){const o=m.e.outputs,h=json(o.holderReady),w=json(o.windowsLaunch),cmd=json(o.launchCommand);keys(h,['kind','schemaVersion','recoveryG1','input','RootApproval','executionReview','operator','nonce','bootId','pid','startTime','startedAt','identity','bootObservation']);keys(w,['kind','schemaVersion','recoveryG1','input','RootApproval','executionReview','operator','nonce','pid','creationTime','executable','argv','stdoutFile','stderrFile']);keys(cmd,['kind','schemaVersion','recoveryG1','input','RootApproval','executionReview','operator','executable','argv','startedAt','endedAt','exitCode','signal','stdout','stderr']);assert.equal(h.kind,'actual-runtime118-holder-ready');assert.equal(w.kind,'Root-runtime118-holder-Windows-launch');assert.equal(cmd.kind,'Root-runtime118-command-result');for(const r of[h,w,cmd]){assert.equal(r.schemaVersion,1);same(r.recoveryG1,G1);same(r.input,m.e.input);same(r.RootApproval,m.e.RootApproval);same(r.executionReview,m.e.executionReview);}same(h.operator,m.e.operator);const ps=m.qualification.executionSources.find(p=>p.file===LAUNCHER);same(w.operator,ps);same(cmd.operator,ps);same(cmd.executable,systemExecutable('pwsh'));assert.deepEqual(cmd.argv,['-NoProfile','-NonInteractive','-File','E:/projects/worktrees/poms-r3hijk-next28/poms/tools/rust-r4ghi/runtime-recovery121/budget118/start-budget118-holder.ps1','-InputFile',m.e.input.file,'-InputSha',m.e.input.rawBytesSha256,'-RootReviewFile',m.e.RootApproval.file,'-RootReviewSha',m.e.RootApproval.rawBytesSha256,'-PeerReviewFile',m.e.executionReview.file,'-PeerReviewSha',m.e.executionReview.rawBytesSha256,'-Execute']);assert.equal(cmd.exitCode,0);assert.equal(cmd.signal,null);read(cmd.stdout);read(cmd.stderr);assert.equal(h.nonce,m.p.nonce);assert.equal(w.nonce,m.p.nonce);assert.equal(h.bootId,currentBoot());assert.equal(w.executable,'C:/Windows/System32/wsl.exe');assert.equal(o.windowsLaunch.file,m.p.windowsOutputDirectory+'/windows-launch.json');assert.equal(o.launchCommand.file,m.p.windowsOutputDirectory+'/launch-command.json');assert.equal(w.stdoutFile,m.p.windowsOutputDirectory+'/wsl-holder.stdout.log');assert.equal(w.stderrFile,m.p.windowsOutputDirectory+'/wsl-holder.stderr.log');keys(h.identity,['uid','node','source','cwd','argv','ppid','parentStartTime','processEvidence']);same(h.identity.node,NODE);same(h.identity.source,m.e.operator);assert.equal(h.identity.uid,1000);assert.equal(h.identity.cwd,ROOT);const expected=holderArgv(m.e.input,m.e.RootApproval,m.e.executionReview);assert.deepEqual(h.identity.argv,expected);const live=procIdentity(h.pid),parent=procStat(fs.readFileSync('/proc/'+h.identity.ppid+'/stat','utf8'));assert.equal(live.startTime,h.startTime);assert.equal(live.uid,1000);assert.equal(live.exe,NODE.file);assert.equal(live.cwd,ROOT);assert.deepEqual(live.argv,expected);assert.deepEqual(processEnvironment(h.pid),HOST_ENV);assert.equal(parent.startTime,h.identity.parentStartTime);const stat=procStat(fs.readFileSync('/proc/'+h.pid+'/stat','utf8'));assert.equal(stat.ppid,parent.pid);same(h.bootObservation,o.bootObservation);const boot=json(h.bootObservation);keys(boot,['kind','schemaVersion','recoveryG1','input','observedAt','bootId','canonical','ownership','environment','apiListeners','runtimeExecutables','processEvidence']);assert.equal(boot.kind,'Root-runtime118-holder-boot-observation');assert.equal(boot.schemaVersion,1);same(boot.recoveryG1,G1);same(boot.input,m.e.input);assert.equal(boot.bootId,h.bootId);assert.deepEqual(boot.apiListeners,[]);for(const[key,p]of Object.entries({canonical:BIRTH,ownership:OWNERSHIP})){keys(boot[key],['snapshot','identity']);assert(read(boot[key].snapshot).equals(read(p)));assert.equal(boot[key].identity.rawBytesSha256,p.rawBytesSha256);}read(boot.environment);read(boot.processEvidence);const proc=json(h.identity.processEvidence);same(proc.bootstrap,filePin(m.p.outputDirectory+'/bootstrap-observation.raw'));read(proc.bootstrap);keys(boot.runtimeExecutables,['node','podman']);same(boot.runtimeExecutables.node,NODE);same(boot.runtimeExecutables.podman,filePin(C.podman));windowsLive(m,w);return h;}
function liveHolder(pin){const m=readHolderBase(pin);holderFixed(m);return m;}
function verifyPGStep(pin){const m=pgStepBase(pin);for(const pin of[m.e.outputs.observationBefore,m.e.outputs.observationAfter]){const o=json(pin),e=json(o.evidence),raw=JSON.parse(read(e.inspect)),volume=JSON.parse(read(e.volume));assert(Array.isArray(raw)&&raw.length===1);assert(Array.isArray(volume)&&volume.length===1);keys(o.container,['id','running','status','exitCode']);keys(o.image,['id','digest']);keys(o.volume,['name','driver','mountpoint']);keys(o.mount,['source','destination','rw','pgdata']);const c=raw[0];assert.deepEqual(o.container,{id:c.Id,running:c.State.Running,status:c.State.Status,exitCode:c.State.ExitCode??null});assert.deepEqual(o.image,{id:c.Image,digest:c.ImageDigest??c.Image});assert.deepEqual(o.volume,{name:C.volume,driver:'local',mountpoint:C.volumeRoot});assert.deepEqual(o.mount,{source:C.volumeRoot,destination:C.volumeTarget,rw:true,pgdata:C.volumeTarget});assert.deepEqual(o.databases,C.databases.map((name,i)=>({name,oid:C.oids[i]})));if(o.container.running){keys(o.pgProcess,['pid','startTime','startedAt']);assert.equal(o.pgProcess.pid,c.State.Pid);assert.equal(o.pgProcess.startedAt,c.State.StartedAt);assert(typeof o.pgProcess.startTime==='string'&&/^[0-9]+$/.test(o.pgProcess.startTime));}else{assert.equal(o.pgProcess,null);assert.equal(c.State.Pid,0);}for(const p of e.oidDirectories){const cmd=json(p);keys(cmd,['kind','schemaVersion','recoveryG1','input','RootApproval','executionReview','operator','executable','argv','startedAt','endedAt','exitCode','signal','stdout','stderr']);assert.equal(cmd.kind,'Root-runtime118-command-result');assert.equal(cmd.schemaVersion,1);same(cmd.recoveryG1,G1);same(cmd.input,m.e.input);same(cmd.RootApproval,m.e.RootApproval);same(cmd.executionReview,m.e.executionReview);same(cmd.operator,m.e.operator);same(cmd.executable,e.executable);read(cmd.stdout);read(cmd.stderr);}}for(const[p,i]of m.e.outputs.readiness.map((p,i)=>[p,i]))readinessShape(p,m.e.input,C.databases[i]);return m;}
function currentPG(pin){const m=verifyPGStep(pin),after=json(m.e.outputs.observationAfter),now=inspectPodmanRaw().c;assert.equal(after.bootId,currentBoot());assert.equal(now.State.Running,true);assert.equal(now.State.Pid,after.pgProcess.pid);assert.equal(now.State.StartedAt,after.pgProcess.startedAt);assert.equal(procStat(fs.readFileSync('/proc/'+after.pgProcess.pid+'/stat','utf8')).startTime,after.pgProcess.startTime);return m;}
function verifyComparison(m){const result=comparisonBase(m),cmp=json(m.e.outputs.comparison);assert.equal(new Set(cmp.transactionProofs.map(p=>p.file)).size,4);assert.equal(new Set(m.e.outputs.observations.map(p=>p.file)).size,2);assert.deepEqual(m.e.outputs.observations.map(p=>snapshot(p).label),['ro01','ro02']);for(const db of C.databases){const list=cmp.transactionProofs.map(json).filter(t=>t.database===db);assert.equal(list.length,2);for(const t of list){assert.deepEqual(t.connectionOptions,connectionOptions(db));serverIdentityShape(t.serverIdentity,db);const baseline=snapshot(result.baseline),roles=baseline.databases[db].meta.normative.roles.map(raw=>{const row=JSON.parse(raw);return Object.fromEntries(['rolname','rolsuper','rolcreatedb','rolcreaterole','rolreplication','rolbypassrls'].map(k=>[k,row[k]]));});assert.deepEqual(t.serverIdentity.roles,roles);}}return result;}
async function rebindPhase(m){
 const p=m.p;earlyGuard(m,{afterAPI:true});guardOtherStates();const post=readEnvelope(p.prior.conservationAfter,'ro-after');verifyComparison(post);same(post.p.prior.conservationBefore,p.prior.conservationBefore);same(post.p.prior.API,p.prior.API);same(post.p.prior.PG,p.prior.PG);same(post.p.prior.holder,p.prior.holder);const sc=sourceHistory(p.prior.sourceDelivery.sourceComplete,p.prior.sourceDelivery.independentReadback);same(sc.window.PGConservation,p.prior.conservationBefore);same(sc.window.holder,p.prior.holder);const api=readEnvelope(p.prior.API,'api-start'),a=liveAPI(api);same(api.p.sourceComplete,p.prior.sourceDelivery.sourceComplete);same(json(api.peer.evidence).independentReadback,p.prior.sourceDelivery.independentReadback);verifyPGStep(p.prior.PG);
 const before=readFile(D+'/state.json'),owned=readFile(D+'/ownership.jsonl');assert(before.bytes.equals(read(BIRTH)));assert(owned.bytes.equals(read(OWNERSHIP)));const beforePin=save(p.outputDirectory,'before-state.json',before.bytes);m.completedOutputs.before=beforePin;const state=JSON.parse(before.bytes);state.apiProcess={file:api.e.outputs.processRecord.file,rawBytesSha256:api.e.outputs.processRecord.rawBytesSha256,record:a.record};const bytes=Buffer.from(JSON.stringify(state,null,2)+'\n'),restored=clone(state);restored.apiProcess=JSON.parse(before.bytes).apiProcess;const restoredBytes=Buffer.from(JSON.stringify(restored,null,2)+'\n');assert(restoredBytes.equals(before.bytes),'Only API binding, original serialization and every other byte preserved');const restorePin=save(p.outputDirectory,'restored-before.json',restoredBytes),tempFile=D+'/state.json.runtime118-reentry-'+p.nonce+'.tmp';assert(!fs.existsSync(tempFile));guardLock(m);sameIdentity(readFile(D+'/state.json').identity,before.identity);sameIdentity(readFile(D+'/ownership.jsonl').identity,owned.identity);fs.writeFileSync(tempFile,bytes,{flag:'wx',mode:before.identity.mode&0o777});const temp=readFile(tempFile);assert(temp.bytes.equals(bytes));earlyGuard(m,{afterAPI:true});guardOtherStates();sameIdentity(readFile(D+'/state.json').identity,before.identity);sameIdentity(readFile(D+'/ownership.jsonl').identity,owned.identity);sameIdentity(readFile(tempFile).identity,temp.identity);m.renameAttempted=true;fs.renameSync(tempFile,D+'/state.json');m.renameConfirmed=false;const actual=readFile(D+'/state.json');assert(actual.bytes.equals(bytes));m.renameConfirmed=true;assert(readFile(D+'/ownership.jsonl').bytes.equals(read(OWNERSHIP)));guardOtherStates();guardLock(m);const after=save(p.outputDirectory,'after-state.json',actual.bytes);m.completedOutputs.after=after;const deltaProof=save(p.outputDirectory,'delta-proof.json',{kind:'Root-runtime118-api-only-delta-proof',schemaVersion:1,recoveryG1:G1,input:m.inputPin,before:beforePin,after,newProcess:api.e.outputs.processRecord,changedKeys:['apiProcess'],restoredBytes:restorePin,ownership:OWNERSHIP,guards:{beforeState:before.identity,ownership:owned.identity,temp:temp.identity,lockIdentity:{dev:m.lock.identity.dev,ino:m.lock.identity.ino,nonce:p.nonce,rawCopy:m.lockCopy}},verified:true});m.completedOutputs.deltaProof=deltaProof;return{before:beforePin,after,deltaProof};
}
function rebindHistory(pin){const m=readEnvelope(pin,'api-rebind'),o=m.e.outputs,dp=json(o.deltaProof);keys(dp,['kind','schemaVersion','recoveryG1','input','before','after','newProcess','changedKeys','restoredBytes','ownership','guards','verified']);assert.equal(dp.kind,'Root-runtime118-api-only-delta-proof');assert.equal(dp.schemaVersion,1);same(dp.recoveryG1,G1);same(dp.input,m.e.input);same(dp.before,o.before);same(dp.after,o.after);same(dp.ownership,OWNERSHIP);assert.deepEqual(dp.changedKeys,['apiProcess']);assert.equal(dp.verified,true);assert(read(dp.before).equals(read(BIRTH)));const before=json(dp.before),after=json(dp.after),record=json(dp.newProcess);keys(after.apiProcess,['file','rawBytesSha256','record']);assert.equal(after.apiProcess.file,dp.newProcess.file);assert.equal(after.apiProcess.rawBytesSha256,dp.newProcess.rawBytesSha256);assert.deepEqual(after.apiProcess.record,record);after.apiProcess=before.apiProcess;const restored=Buffer.from(JSON.stringify(after,null,2)+'\n');assert(restored.equals(read(BIRTH)));assert(read(dp.restoredBytes).equals(restored));keys(dp.guards,['beforeState','ownership','temp','lockIdentity']);for(const[k,f]of Object.entries(dp.guards)){if(k==='lockIdentity')continue;keys(f,['file','dev','ino','nlink','mode','uid','bytes','rawBytesSha256','mtimeNs','ctimeNs','birthtimeNs']);for(const n of['dev','ino','mtimeNs','ctimeNs','birthtimeNs'])assert(typeof f[n]==='string'&&/^[0-9]+$/.test(f[n]));assert.equal(f.nlink,1);assert.equal(f.uid,1000);}keys(dp.guards.lockIdentity,['dev','ino','nonce','rawCopy']);assert.equal(dp.guards.lockIdentity.nonce,m.p.nonce);const lock=json(dp.guards.lockIdentity.rawCopy);same(lock.input,m.e.input);assert.equal(lock.phase,'api-rebind');same(lock.G1,G1);assert.equal(dp.guards.beforeState.rawBytesSha256,BIRTH.rawBytesSha256);assert.equal(dp.guards.ownership.rawBytesSha256,OWNERSHIP.rawBytesSha256);assert.equal(dp.guards.temp.rawBytesSha256,o.after.rawBytesSha256);return{...m,dp,state:json(o.after)};}

// Fixed historical/data entry for the source tool's later S4 handoff. It never
// repeats the source phase's live API-absent/canonical-birth gate.
function sourceRecoveryHandoff118(sourceCompletePin,recoveryBundlePin){
 assert.equal(arguments.length,2);cleanHost();assertNoEarlyPartial();const b=json(recoveryBundlePin);keys(b,['kind','schemaVersion','recoveryG1','recoveryComplete','independentReadback']);assert.equal(b.kind,'Root-runtime118-reentry-acceptance-bundle');assert.equal(b.schemaVersion,1);same(b.recoveryG1,G1);const c=json(b.recoveryComplete),r=json(b.independentReadback);keys(c,['kind','schemaVersion','recoveryG1','namespace','prepareOrigin121','steps','sourceDelivery','canonicalRebind','ownership','semantics']);assert.equal(c.kind,'Root-runtime118-successful-prepare-reentry-complete');assert.equal(c.schemaVersion,1);same(c.recoveryG1,G1);assert.equal(c.namespace,C.namespace);same(c.ownership,OWNERSHIP);assert.deepEqual(c.semantics,{originalPreparationPreserved:true,canonicalChangedKeys:['apiProcess'],contextAuthGranted:false,FIOrNormalGranted:false});keys(c.steps,['holder','PG','conservationBefore','API','conservationAfter']);keys(c.sourceDelivery,['sourceComplete','independentReadback']);same(c.sourceDelivery.sourceComplete,sourceCompletePin);const source=sourceHistory(sourceCompletePin,c.sourceDelivery.independentReadback);same(c.prepareOrigin121,source.sc.prepareOrigin121);keys(r,['kind','schemaVersion','recoveryG1','complete','reviewer','reviewerIsExecutor','verdict','evidence']);assert.equal(r.kind,'non-author-runtime118-actual-reentry-readback');assert.equal(r.schemaVersion,1);same(r.recoveryG1,G1);same(r.complete,b.recoveryComplete);assert(typeof r.reviewer==='string'&&r.reviewer);assert.equal(r.reviewerIsExecutor,false);assert.equal(r.verdict,'approved-actual-source-bound-reentry');read(r.evidence);
 const holder=liveHolder(c.steps.holder),pg=verifyPGStep(c.steps.PG),pre=readEnvelope(c.steps.conservationBefore,'ro-before'),api=readEnvelope(c.steps.API,'api-start'),post=readEnvelope(c.steps.conservationAfter,'ro-after'),rebind=rebindHistory(c.canonicalRebind);for(const m of[holder,pg,pre,api,post,rebind]){assert.notEqual(r.reviewer,m.qualification.author);assert.notEqual(r.reviewer,m.root.operatorIdentity);}same(pg.p.prior.holder,holder.pin);same(pre.p.prior.holder,holder.pin);same(pre.p.prior.PG,pg.pin);verifyComparison(pre);verifyComparison(post);assert.deepEqual(post.p.prior,{holder:holder.pin,PG:pg.pin,conservationBefore:pre.pin,API:api.pin});assert.deepEqual(rebind.p.prior,{holder:holder.pin,PG:pg.pin,conservationBefore:pre.pin,API:api.pin,conservationAfter:post.pin,sourceDelivery:c.sourceDelivery});same(source.window.holder,holder.pin);same(source.window.PGConservation,pre.pin);same(api.p.preConservation,pre.pin);same(api.p.PGStart,pg.pin);same(api.p.lifetimeOwner,holder.e.outputs.lifetimeOwner);same(api.p.sourceComplete,sourceCompletePin);same(json(api.peer.evidence).independentReadback,c.sourceDelivery.independentReadback);liveAPI(api);same(rebind.dp.newProcess,api.e.outputs.processRecord);assert(readFile(D+'/state.json').bytes.equals(read(rebind.e.outputs.after)),'Handoff requires actual X before Native publication');assert(readFile(D+'/ownership.jsonl').bytes.equals(read(OWNERSHIP)));guardOtherStates();const out={...clone(PREDECESSOR),retainedCurrentState:clone(rebind.e.outputs.after),retainedOwnership:clone(OWNERSHIP),prepareOrigin121:clone(source.sc.prepareOrigin121),sourceWitness:clone(source.sc.sourceWitness),recoveryReceipt:clone(recoveryBundlePin)};return freeze(out);
}

function emptyOutputs(phase){return Object.fromEntries(OUTPUTS[phase].map(k=>[k,['readiness','observations'].includes(k)?[null,null]:null]));}
function finiteError(m,writeFailures=[]){return{name:'Error',message:'Reentry phase incomplete; preserve actual evidence and processes',phase:m.phase,primaryEvidence:Object.values(m.completedOutputs).flat().filter(p=>p&&typeof p==='object'&&typeof p.file==='string').map(clone),writeFailures,replayForbidden:true};}
function preserveFailure(m,error){for(const f of m.processes)if(['spawned-unverified','verified-live'].includes(f.state)&&!f.record)f.state='unknown-preserve';const report={kind:'Root-runtime118-reentry-partial-preserve',schemaVersion:1,recoveryG1:G1,input:m.inputPin,RootApproval:m.rootPin,executionReview:m.peerPin,operator:m.root.operator,phase:m.phase,completedOutputs:clone(m.completedOutputs),error:finiteError(m,clone(writeFailures118.get(error)??[])),processes:clone(m.processes),retryPolicy:'preserve-partial-no-blind-retry'};let partial=null;try{if(m.outReady)partial=save(m.p.outputDirectory,'partial.json',report);}catch(e){const facts=writeFailures118.get(e)??[{file:m.p.outputDirectory+'/partial.json',existingFilePreserved:false,status:'unknown',message:'Partial receipt write/readback failed; primary preserved'}];report.error.writeFailures.push(...facts);}return freeze({kind:'Root-runtime118-reentry-stopped',phase:m.phase,partial,error:report.error,completedOutputs:report.completedOutputs,processes:report.processes,preservePartialAndLocks:true});}
export function readSourcePromotionWindow118(pin){try{assert.equal(arguments.length,1);return sourcePromotionWindow118(pin);}catch{throw new Error("Source window verification failed; preserve actual state");}}
export function readSourceRecoveryHandoff118(source,bundle){try{assert.equal(arguments.length,2);return sourceRecoveryHandoff118(source,bundle);}catch{throw new Error("Historical recovery handoff verification failed; preserve actual evidence");}}
export function collectHolder118(pin){try{assert.equal(arguments.length,1);return collectHolderData118(pin);}catch{throw new Error("Holder data collection incomplete; preserve actual processes and receipts");}}
export async function main118(args=process.argv.slice(2)){
 cleanHost();assert.equal(fileURLToPath(import.meta.url),SELF);assert.equal(args.length,13);assert.deepEqual([args[0],args[2],args[4],args[6],args[8],args[10],args[12]],['--input','--input-sha','--root-review','--root-review-sha','--peer-review','--peer-review-sha','--execute']);const inputPin=norm({file:args[1],rawBytesSha256:args[3]}),rootPin=norm({file:args[5],rawBytesSha256:args[7]}),peerPin=norm({file:args[9],rawBytesSha256:args[11]}),p=json(inputPin),a=approvals(p,inputPin,rootPin,peerPin);const m={...a,p,inputPin,rootPin,peerPin,startedAt:new Date().toISOString(),completedOutputs:emptyOutputs(a.phase),processes:[],outReady:false,lock:null};
 try{guardOtherStates();assertBirth();if(['ro-after','api-rebind'].includes(m.phase))liveAPI(readEnvelope(m.p.prior.API,'api-start'));else apiAbsent();read(K);for(const q of m.qualification.executionSources)read(q);acquire(m);if(m.phase==='holder-start')m.processes.push({role:'holder',state:'verified-live',command:null,pid:process.pid,startTime:m.lock.value.startTime,bootId:m.lock.value.bootId,record:null,error:null});let outputs;if(m.phase==='holder-start')return await holderPhase(m);if(m.phase==='pg-current')outputs=await pgPhase(m);else if(['ro-before','ro-after'].includes(m.phase))outputs=await roPhase(m);else if(m.phase==='api-start')outputs=await apiPhase(m);else outputs=await rebindPhase(m);for(const[k,v]of Object.entries(outputs))m.completedOutputs[k]=v;const complete=envelope(m,outputs);read(complete);release(m);return freeze({complete});}catch(error){const result=preserveFailure(m,error);process.exitCode=1;return result;}
}
if(process.argv[1]&&import.meta.url===pathToFileURL(path.resolve(process.argv[1])).href)main118().then(value=>{if(value)console.log(JSON.stringify(value));}).catch(()=>{process.exitCode=1;console.error(JSON.stringify({kind:'Root-runtime118-reentry-rejected',actualEffectAuthorized:false,preserveOriginals:true,replayForbidden:true}));});

const clone=x=>JSON.parse(JSON.stringify(x));
function freeze(x){if(x&&typeof x==='object'){for(const v of Object.values(x))freeze(v);Object.freeze(x);}return x;}
function plain(x){assert(x&&typeof x==='object'&&!types.isProxy(x)&&!Array.isArray(x)&&Object.getPrototypeOf(x)===Object.prototype,'Plain data required');for(const k of Reflect.ownKeys(x)){assert.equal(typeof k,'string');assert(Object.hasOwn(Object.getOwnPropertyDescriptor(x,k),'value'),'No getters');}}
function keys(x,n){plain(x);assert.deepEqual(Reflect.ownKeys(x).sort(),[...n].sort(),'Closed data keys');return x;}
function absolute(x){assert(typeof x==='string'&&x.startsWith('/')&&!x.startsWith('//')&&!/[\\\0\r\n]/.test(x)&&path.posix.normalize(x)===x,'Canonical Linux path');return x;}
function full(p){keys(p,['file','bytes','rawBytesSha256']);absolute(p.file);assert(Number.isSafeInteger(p.bytes)&&p.bytes>=0);assert(/^[a-f0-9]{64}$/.test(p.rawBytesSha256));return p;}
function pin2(p){keys(p,['file','rawBytesSha256']);absolute(p.file);assert(/^[a-f0-9]{64}$/.test(p.rawBytesSha256));return p;}
function same(a,b){assert(a&&b);absolute(a.file);absolute(b.file);assert.equal(a.file,b.file);assert.equal(a.rawBytesSha256,b.rawBytesSha256);if(a.bytes!==undefined&&b.bytes!==undefined)assert.equal(a.bytes,b.bytes);}
function uuid(x){assert(typeof x==='string'&&/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/.test(x));return x;}
function facts(file,s,bytes){return{file,dev:s.dev.toString(),ino:s.ino.toString(),nlink:Number(s.nlink),mode:Number(s.mode),uid:Number(s.uid),bytes:bytes.length,rawBytesSha256:sha(bytes),mtimeNs:s.mtimeNs.toString(),ctimeNs:s.ctimeNs.toString(),birthtimeNs:s.birthtimeNs.toString()};}
function readFile(file,{single=true}={}){
 absolute(file);const a=fs.lstatSync(file,{bigint:true});assert(a.isFile()&&!a.isSymbolicLink());if(single)assert.equal(a.nlink,1n);assert.equal(fs.realpathSync(file),file);
 const fd=fs.openSync(file,fs.constants.O_RDONLY|(fs.constants.O_NOFOLLOW??0));
 try{const b=fs.fstatSync(fd,{bigint:true});for(const k of['dev','ino','nlink','size','mtimeNs','ctimeNs'])assert.equal(b[k],a[k]);const bytes=fs.readFileSync(fd);const z=fs.fstatSync(fd,{bigint:true}),p=fs.lstatSync(file,{bigint:true});for(const k of['dev','ino','nlink','size','mtimeNs','ctimeNs']){assert.equal(z[k],b[k]);assert.equal(p[k],b[k]);}return{bytes,identity:facts(file,b,bytes)};}finally{fs.closeSync(fd);}
}
function read(p){full(p);const r=readFile(p.file);assert.equal(r.bytes.length,p.bytes);assert.equal(sha(r.bytes),p.rawBytesSha256);return r.bytes;}
function entryPresent(file){absolute(file);try{fs.lstatSync(file,{bigint:true});return true;}catch(error){if(error?.code==='ENOENT')return false;throw new Error('Filesystem presence UNKNOWN; preserve without retry');}}
function absent(file){assert(!entryPresent(file),'Existing filesystem entry preserved, including links and unknown locks');}
function json(p){return JSON.parse(read(p));}
function filePin(file){const r=readFile(file);return{file,bytes:r.bytes.length,rawBytesSha256:sha(r.bytes)};}
function norm(p){absolute(p.file);assert(/^[a-f0-9]{64}$/.test(p.rawBytesSha256));const r=readFile(p.file);assert.equal(sha(r.bytes),p.rawBytesSha256);if(p.bytes!==undefined)assert.equal(r.bytes.length,p.bytes);return{file:p.file,bytes:r.bytes.length,rawBytesSha256:sha(r.bytes)};}
function directory(dir,{create=false}={}){absolute(dir);if(create){assert(!fs.existsSync(dir),'Output already exists');fs.mkdirSync(dir,{mode:0o700});}const s=fs.lstatSync(dir,{bigint:true});assert(s.isDirectory()&&!s.isSymbolicLink());assert.equal(fs.realpathSync(dir),dir);return dir;}
function save(dir,name,value){assert(path.posix.basename(name)===name&&!/[\\\0\r\n]/.test(name));directory(dir);const file=dir+'/'+name,bytes=Buffer.isBuffer(value)?value:Buffer.from(typeof value==='string'?value:JSON.stringify(value,null,2)+'\n');let wrote=false;try{fs.writeFileSync(file,bytes,{flag:'wx',mode:0o600});wrote=true;const p={file,bytes:bytes.length,rawBytesSha256:sha(bytes)};read(p);return p;}catch{let exists=false;try{exists=fs.existsSync(file);}catch{}const e=new Error('Control output write/readback incomplete; preserve without retry');writeFailures118.set(e,[{file,existingFilePreserved:exists,status:wrote?'readback-failed':'write-failed',message:'Control output not certified complete'}]);throw e;}}
function currentBoot(){return fs.readFileSync('/proc/sys/kernel/random/boot_id','utf8').trim();}
function procStat(text){const right=text.lastIndexOf(')');assert(right>0);const tail=text.slice(right+1).trim().split(/\s+/);assert(tail.length>=20);return{pid:Number(text.slice(0,text.indexOf(' '))),ppid:Number(tail[1]),startTime:tail[19]};}
function procIdentity(pid){assert(Number.isSafeInteger(pid)&&pid>1);const prefix='/proc/'+pid,s=procStat(fs.readFileSync(prefix+'/stat','utf8'));assert.equal(s.pid,pid);return{pid,startTime:s.startTime,exe:fs.realpathSync(prefix+'/exe'),cwd:fs.realpathSync(prefix+'/cwd'),uid:Number(fs.statSync(prefix,{bigint:true}).uid),argv:fs.readFileSync(prefix+'/cmdline').toString().split('\0').filter(Boolean)};}
function processEnvironment(pid){const list=fs.readFileSync('/proc/'+pid+'/environ').toString().split('\0').filter(Boolean),out={};for(const line of list){const i=line.indexOf('=');assert(i>0);const key=line.slice(0,i);assert(!Object.hasOwn(out,key));out[key]=line.slice(i+1);}return out;}
function holderArgv(input,root,peer){return[NODE.file,SELF,'--input',input.file,'--input-sha',input.rawBytesSha256,'--root-review',root.file,'--root-review-sha',root.rawBytesSha256,'--peer-review',peer.file,'--peer-review-sha',peer.rawBytesSha256,'--execute'];}
function readBootstrapFD118(){
 let accepted=false;try{const s=fs.fstatSync(3,{bigint:true});assert.equal(s.uid,1000n);assert(s.isFIFO()||(s.isFile()&&s.nlink===0n),'Only inherited anonymous heredoc transport');if(s.isFile())assert(s.size<=65536n);accepted=true;const chunks=[],block=Buffer.alloc(4096);let total=0;for(;;){const n=fs.readSync(3,block,0,Math.min(block.length,65537-total),null);assert(Number.isInteger(n)&&n>=0);if(n===0)break;total+=n;assert(total<=65536,'Bootstrap transport exceeds fixed bound');chunks.push(Buffer.from(block.subarray(0,n)));}assert(total>0,'Bootstrap transport missing/truncated');return Buffer.concat(chunks);}finally{if(accepted)fs.closeSync(3);}
}
function validateBootstrap118(bytes,m){
 assert(Buffer.isBuffer(bytes)&&bytes.length>0&&bytes.length<=65536);const text=new TextDecoder('utf-8',{fatal:true}).decode(bytes);assert(text.endsWith('\n')&&!/[\r\0]/.test(text));const lines=text.slice(0,-1).split('\n');assert.equal(lines.length,14);const expected={kind:'runtime118-system-bootstrap',uid:'1000',node:NODE.file,nodeSHA256:NODE.rawBytesSha256,version:'v24.19.0',entry:SELF,input:m.inputPin.file,inputSHA256:m.inputPin.rawBytesSha256,rootReview:m.rootPin.file,rootSHA256:m.rootPin.rawBytesSha256,peerReview:m.peerPin.file,peerSHA256:m.peerPin.rawBytesSha256,output:m.p.outputDirectory};const identity=lines[6],values={};for(const[line,i]of lines.map((line,i)=>[line,i])){if(i===6)continue;const at=line.indexOf('=');assert(at>0);const key=line.slice(0,at);assert(!Object.hasOwn(values,key));values[key]=line.slice(at+1);}assert.deepEqual(values,expected);const match=/^node\.dev=([0-9]+) node\.ino=([0-9]+) node\.nlink=1 node\.mode=([0-7]{3,4}) node\.bytes=125989464$/.exec(identity);assert(match);const node=readFile(NODE.file);assert.equal(node.bytes.length,NODE.bytes);assert.equal(sha(node.bytes),NODE.rawBytesSha256);assert.equal(node.identity.dev,match[1]);assert.equal(node.identity.ino,match[2]);assert.equal(node.identity.mode&0o7777,Number.parseInt(match[3],8));same(m.root.operator,m.qualification.executionSources.find(p=>p.file===SELF));for(const p of m.qualification.executionSources)read(p);read(m.inputPin);read(m.rootPin);read(m.peerPin);return bytes;
}
function listeners(port){return['/proc/net/tcp','/proc/net/tcp6'].flatMap(file=>{const lines=fs.readFileSync(file,'utf8').trim().split('\n');assert(/local_address\s+rem(?:ote)?_address\s+st/.test(lines[0]??''),'Listener observation UNKNOWN');return lines.slice(1).filter(Boolean).map(line=>{const a=line.trim().split(/\s+/);assert(a.length>=10&&/^[A-F0-9]{8,32}:[A-F0-9]{4}$/.test(a[1])&&/^[A-F0-9]{2}$/.test(a[3])&&/^[0-9]+$/.test(a[9]),'Malformed listener observation');return a;}).filter(a=>a[3]==='0A'&&a[1].endsWith(':'+port.toString(16).toUpperCase().padStart(4,'0'))).map(a=>({table:file,local:a[1],inode:a[9]}));});}
function apiAbsent(){assert.deepEqual(listeners(31441),[],'Existing API listener preserved; stop');}
function assertBirth(){assert(readFile(D+'/state.json').bytes.equals(read(BIRTH)),'Canonical is not birth6c');assert(readFile(D+'/ownership.jsonl').bytes.equals(read(OWNERSHIP)),'Ownership is not full1da');}
function cleanHost(){assert.equal(process.platform,'linux');assert.equal(process.version,'v24.19.0');assert.equal(process.execPath,NODE.file);assert.equal(process.getuid(),1000);assert.equal(process.cwd(),ROOT);assert.deepEqual(process.execArgv,[]);assert(!process.env.NODE_OPTIONS&&!process.env.NODE_PATH);same(filePin(NODE.file),NODE);const c=json(CORRECTIVE);same(c.frozenG1,G1);assert.equal(c.authority.implementationWithinExistingScope,true);}
function currentNodeSources(q){keys(q,['kind','schemaVersion','technicalG1','operator','executionSources','author','reviewer','reviewerIsAuthor','verdict','modelEvidence','engines']);assert.equal(q.kind,'non-author-runtime118-reentry-tool-code-qualification');assert.equal(q.schemaVersion,1);same(q.technicalG1,G1);same(q.operator,{file:SELF,...filePin(SELF)});assert(q.author&&q.reviewer&&q.author!==q.reviewer);assert.equal(q.reviewerIsAuthor,false);assert.equal(q.verdict,'approved-bounded-reentry-tool-code');assert(Array.isArray(q.executionSources));assert.deepEqual(q.executionSources.map(p=>p.file),[...new Set(q.executionSources.map(p=>p.file))].sort());assert(q.executionSources.some(p=>p.file===SELF)&&q.executionSources.some(p=>p.file===LAUNCHER));for(const p of q.executionSources){assert(!/\/(?:business\/runtime-admission|tax15-invocation118\/|runtime-recovery121\/(?:native|Native-plan|Tax121))/.test(p.file),'Static closure must not include changing284');read(p);}read(q.modelEvidence);keys(q.engines,['linuxNode','windowsNode']);keys(q.engines.linuxNode,['expectedExecutable','expectedVersion','observationStage']);same(q.engines.linuxNode.expectedExecutable,NODE);assert.equal(q.engines.linuxNode.expectedVersion,'v24.19.0');assert.equal(q.engines.linuxNode.observationStage,'holder-system-bootstrap');keys(q.engines.windowsNode,['executable','versionEvidence','modelResults']);for(const p of Object.values(q.engines.windowsNode))read(p);return q;}
function phaseOf(p){return p.kind==='Root-runtime118-reentry-API-input'?'api-start':p.phase;}
function inputShape(p){const phase=phaseOf(p);assert(PHASES.includes(phase));keys(p,phase==='api-start'?IA20:I13);assert.equal(p.kind,phase==='api-start'?'Root-runtime118-reentry-API-input':'Root-runtime118-reentry-phase-input');assert.equal(p.schemaVersion,1);same(p.recoveryG1,G1);uuid(p.nonce);same(p.expectedState,BIRTH);same(p.expectedOwnership,OWNERSHIP);absolute(p.outputDirectory);
 if(phase==='api-start'){assert.equal(p.outputDirectory,PRIVATE+'/rust-api-reentry/'+p.nonce);assert.equal(p.processFile,p.outputDirectory+'/rust-api118-process.json');assert.equal(p.normalEnvFile,p.outputDirectory+'/rust-api118.env');same(p.nodeExecutable,NODE);for(const k of['lifetimeOwner','PGStart','preConservation','sourceComplete','sourcePins','compilePins','binary','summaryBinary','baseNormalEnv'])full(p[k]);assert(Array.isArray(p.binaryFiles));}
 else{assert.equal(p.operator.file,SELF);full(p.operator);full(p.codeQualification);same(p.preparation,K);assert.equal(p.outputDirectory,PRIVATE+'/runtime118-reentry/'+phase+'/'+p.nonce);const prior={'holder-start':[],'pg-current':['holder'],'ro-before':['holder','PG'],'ro-after':['holder','PG','conservationBefore','API'],'api-rebind':['holder','PG','conservationBefore','API','conservationAfter','sourceDelivery']}[phase];keys(p.prior,prior);for(const[k,v]of Object.entries(p.prior)){if(k==='sourceDelivery'){keys(v,['sourceComplete','independentReadback']);full(v.sourceComplete);full(v.independentReadback);}else full(v);}if(phase==='holder-start')assert.equal(p.windowsOutputDirectory,ROOT+'/tmp/rust-r4ghi/root/runtime118-reentry-windows/'+p.nonce);else assert.equal(p.windowsOutputDirectory,null);}
 return phase;
}
function grants(phase){return{holderStartGranted:phase==='holder-start',startOriginalPGGranted:phase==='pg-current',readonlyPGGranted:['pg-current','ro-before','ro-after'].includes(phase),APIStartGranted:phase==='api-start',canonicalApiProcessWriteGranted:phase==='api-rebind',ownControlWritesGranted:true,contextAuthGranted:false,FIOrNormalGranted:false};}
function approvals(p,inputPin,rootPin,peerPin){const phase=inputShape(p),r=json(rootPin),e=json(peerPin);keys(r,['kind','schemaVersion','input','G1','codeQualification','operator','operatorIdentity','nonce','grants','retryPolicy']);assert.equal(r.kind,'Root-approved-runtime118-exact-reentry-phase');assert.equal(r.schemaVersion,1);same(r.input,inputPin);same(r.G1,G1);assert.equal(r.operatorIdentity,'Root');assert.equal(r.operator.file,SELF);assert.equal(r.nonce,p.nonce);assert.deepEqual(r.grants,grants(phase));assert.equal(r.retryPolicy,'preserve-partial-no-blind-retry');if(phase!=='api-start'){same(r.operator,p.operator);same(r.codeQualification,p.codeQualification);}read(r.operator);const q=currentNodeSources(json(r.codeQualification));keys(e,['kind','schemaVersion','input','G1','codeQualification','operator','RootApproval','author','reviewer','reviewerIsAuthor','reviewerIsExecutor','verdict','evidence']);assert.equal(e.kind,'non-author-runtime118-exact-reentry-phase-review');assert.equal(e.schemaVersion,1);same(e.input,inputPin);same(e.G1,G1);same(e.codeQualification,r.codeQualification);same(e.operator,r.operator);same(e.RootApproval,rootPin);assert.equal(e.author,q.author);assert(e.reviewer&&e.reviewer!==q.author&&e.reviewer!==r.operatorIdentity);assert.equal(e.reviewerIsAuthor,false);assert.equal(e.reviewerIsExecutor,false);assert.equal(e.verdict,'approved-exact-reentry-phase');read(e.evidence);if(phase==='api-start'){const v=json(e.evidence);keys(v,['sourceComplete','independentReadback','startupGraphs']);same(v.sourceComplete,p.sourceComplete);assertSourceDelivery(p.sourceComplete,v.independentReadback);const sc=json(p.sourceComplete);assert.deepEqual(v.startupGraphs,sc.currentGraphs);}return{phase,root:r,peer:e,qualification:q};}
function readEnvelope(pin,phase){const e=json(pin);keys(e,E9);assert.equal(e.kind,E_KIND[phase]);assert.equal(e.schemaVersion,1);same(e.recoveryG1,G1);const p=json(e.input);const a=approvals(p,e.input,e.RootApproval,e.executionReview);assert.equal(a.phase,phase);same(e.operator,a.root.operator);assert.deepEqual(e.semantics,{businessDML:false,contextAuthGranted:false,FIOrNormalGranted:false});keys(e.outputs,OUTPUTS[phase]);for(const[k,v]of Object.entries(e.outputs)){if(k==='mode'){assert(['started-existing','observed-running'].includes(v));continue;}if(v===null){assert(phase==='pg-current'&&k==='command'&&e.outputs.mode==='observed-running');continue;}if(Array.isArray(v)){assert.equal(v.length,2);v.forEach(read);}else read(v);}return{pin,e,p,...a};}
function assertSourceDelivery(scPin,reviewPin){return sourceHistory(scPin,reviewPin).sc;}
function assertNoEarlyPartial(){absent(C.operationLock);}
function readHolderBase(pin){const m=readEnvelope(pin,'holder-start'),o=m.e.outputs,h=json(o.holderReady),w=json(o.windowsLaunch),cmd=json(o.launchCommand),owner=json(o.lifetimeOwner);keys(h,['kind','schemaVersion','recoveryG1','input','RootApproval','executionReview','operator','nonce','bootId','pid','startTime','startedAt','identity','bootObservation']);assert.equal(h.kind,'actual-runtime118-holder-ready');same(h.recoveryG1,G1);same(h.input,m.e.input);same(h.RootApproval,m.e.RootApproval);same(h.executionReview,m.e.executionReview);assert.equal(h.nonce,m.p.nonce);assert.equal(h.bootId,currentBoot());same(h.bootObservation,o.bootObservation);keys(owner,['kind','holderReady','windowsLaunch','launchCommand']);assert.equal(owner.kind,'actual-runtime118-lifetime-owner');same(owner.holderReady,o.holderReady);same(owner.windowsLaunch,o.windowsLaunch);same(owner.launchCommand,o.launchCommand);keys(w,['kind','schemaVersion','recoveryG1','input','RootApproval','executionReview','operator','nonce','pid','creationTime','executable','argv','stdoutFile','stderrFile']);assert.equal(w.kind,'Root-runtime118-holder-Windows-launch');same(w.recoveryG1,G1);same(w.input,m.e.input);assert.equal(w.nonce,m.p.nonce);keys(cmd,['kind','schemaVersion','recoveryG1','input','RootApproval','executionReview','operator','executable','argv','startedAt','endedAt','exitCode','signal','stdout','stderr']);assert.equal(cmd.kind,'Root-runtime118-command-result');same(cmd.input,m.e.input);assert.equal(cmd.exitCode,0);assert.equal(cmd.signal,null);read(cmd.stdout);read(cmd.stderr);const live=procIdentity(h.pid);assert.equal(live.startTime,h.startTime);assert.equal(live.exe,NODE.file);assert.equal(live.cwd,ROOT);assert.equal(live.uid,1000);assert.deepEqual(live.argv,h.identity.argv);same(h.identity.node,NODE);same(h.identity.source,m.e.operator);read(h.identity.processEvidence);return{...m,holder:h,windows:w,owner};}

// Fixed entry for Root's source tool. Never returns a reader or executable object.
function sourcePromotionWindow118(runtimeWindowPin){assert.equal(arguments.length,1);cleanHost();const w=json(runtimeWindowPin);keys(w,['kind','schemaVersion','bootId','holder','PGConservation','states','ownership','apiPort']);assert.equal(w.kind,'Root-runtime118-pre-API-source-window');assert.equal(w.schemaVersion,1);assert.equal(w.bootId,currentBoot());liveHolder(w.holder);const pre=readEnvelope(w.PGConservation,'ro-before');same(pre.p.prior.holder,w.holder);keys(w.states,['state13','state14','state15']);assert.equal(w.states.state13.rawBytesSha256,C.state13SHA);assert.equal(w.states.state14.rawBytesSha256,C.state14SHA);assert(readFile(C.state13).bytes.equals(read(w.states.state13)));assert(readFile(C.state14).bytes.equals(read(w.states.state14)));assert(readFile(D+'/state.json').bytes.equals(read(w.states.state15)));assert.equal(w.states.state15.rawBytesSha256,BIRTH.rawBytesSha256);same(w.ownership,OWNERSHIP);assertBirth();assert.equal(w.apiPort,31441);apiAbsent();absent(C.driverLock);verifyComparison(pre);currentPG(pre.p.prior.PG);guardOtherStates();return freeze(clone(w));}

// Phase implementations and fixed history projection follow below.
function readOld(p){if(Object.hasOwn(p??{},'bytes'))return read(p);pin2(p);const r=readFile(p.file);assert.equal(sha(r.bytes),p.rawBytesSha256);return r.bytes;}
function oldJSON(p){return JSON.parse(readOld(p));}
function exactSources(a,b){assert(Array.isArray(a)&&Array.isArray(b));const project=x=>x.map(p=>({file:p.file,rawBytesSha256:p.rawBytesSha256})).sort((x,y)=>x.file.localeCompare(y.file));const x=project(a),y=project(b);assert.equal(new Set(x.map(p=>p.file)).size,x.length);assert.deepEqual(x,y);}
function rows(p){const bytes=readFile(p.file).bytes;assert.equal(sha(bytes),p.rawBytesSha256);const a=bytes.toString().split('\n').filter(Boolean).map(line=>JSON.parse(line));for(const r of a){keys(r,['key','cells','raw','sha256','xmin']);assert.equal(sha(r.raw),r.sha256);assert(Array.isArray(r.key));assert.equal(typeof r.xmin,'string');JSON.parse(r.raw);}if(p.count!==undefined)assert.equal(a.length,p.count);return a;}
function snapshot(pin){const s=json(pin);keys(s,['schemaVersion','label','marker','epoch','run','capturedAt','databases','objects']);assert.equal(s.schemaVersion,1);assert.equal(s.marker,C.marker);keys(s.databases,C.databases);keys(s.objects,C.databases);for(const db of C.databases){const d=s.databases[db];keys(d,['meta','tables']);keys(d.meta,['tables','foreignKeys','externalForeignKeys','normative','sequences']);assert.equal(d.meta.tables.length,139);assert.equal(Object.keys(d.tables).length,139);assert.deepEqual(Object.keys(d.tables).sort(),d.meta.tables.map(t=>t.name).sort());for(const [name,t]of Object.entries(d.tables)){assert(/^[a-z_][a-z0-9_]*$/.test(name));keys(t,['file','count','pk','columns','rawBytesSha256','logicalRowsSha256']);const rr=rows(t);assert.equal(sha(rr.map(r=>r.raw).join('\n')),t.logicalRowsSha256);}const o=s.objects[db];keys(o,['root','existed','files','directories']);for(const f of o.files){keys(f,['key','file','bytes','sha256']);const b=readFile(f.file).bytes;assert.equal(b.length,f.bytes);assert.equal(sha(b),f.sha256);}}return s;}
function compareSnapshots(aPin,bPin){const a=snapshot(aPin),b=snapshot(bPin);let count=0;for(const db of C.databases){assert.deepEqual(a.databases[db].meta,b.databases[db].meta,'Full catalog/DDL/OID/roles/sequence conservation');assert.deepEqual(a.objects[db],b.objects[db],'Full object conservation');const at=a.databases[db].tables,bt=b.databases[db].tables;assert.deepEqual(Object.keys(at).sort(),Object.keys(bt).sort());for(const name of Object.keys(at)){assert.deepEqual(Object.fromEntries(Object.entries(at[name]).filter(([k])=>k!=='file')),Object.fromEntries(Object.entries(bt[name]).filter(([k])=>k!=='file')));assert.deepEqual(rows(at[name]),rows(bt[name]),'All raw/key/cells/xmin must match');count++;}}assert.equal(count,278);return{left:clone(aPin),right:clone(bPin),tablePairs:count,allRawAndXminEqual:true,allMetadataObjectsEqual:true};}
function pendingProjection(state){const record=state.taxContinuation121,out={};for(const key of['pendingMain','pendingTaxTrial','normalTaxPending','unexpectedTaxACK','activeFault','blockedObservation']){const source=['activeFault','blockedObservation'].includes(key)?state:record;const present=Object.hasOwn(source,key),value=present?source[key]:null;assert(!value,'No unclosed command/effect');out[key]={present,value};}return out;}
function closedBaseline(){const state=json(BIRTH),k=json(K),record=state.taxContinuation121;assert.equal(k.kind,'actual-Source15-runtime121-prepare-continuation-verified');same(record.continuation121,K);same(k.prepared15,record.taxPreparation.artifact);const closed=oldJSON(k.closedJournal),entry=oldJSON(k.entryGuard),exit=oldJSON(k.exitGuard);assert.equal(closed.phase,'closed-verified');assert.equal(closed.mode,'prepare-only');assert.equal(closed.nonce,'6458f733-0fe1-4b5e-b2ff-076908543af3');same(closed.result,k.prepared15);same(closed.entryGuard,k.entryGuard);same(closed.exitGuard,k.exitGuard);assert.equal(entry.phase,'entry-verified');assert.equal(exit.phase,'exit-verified');assert.deepEqual(closed.families,[]);assert.equal(closed.httpAttempts.length,7);assert.equal(closed.commandLedgers.length,7);assert.deepEqual(closed.current15,k.current15);const prepared=json(k.prepared15);assert.equal(prepared.bodySHA256,k.bodySHA256);same(prepared.fullInventory,k.fullInventory);assert.deepEqual(prepared.inventory,json(k.fullInventory));assert(prepared.before,'Final fresh prepared.before required');snapshot(prepared.before);for(const item of closed.httpAttempts){for(const p of Object.values(item))readOld(p);const h=oldJSON(item.http),ledger=oldJSON(item.ledger);assert(h.responseComplete&&!h.transportFailure);assert.equal(h.status,h.expectedStatus);assert.equal(ledger.ownershipComplete,true);assert.deepEqual(ledger.blockers,[]);same(ledger.before,item.before);same(ledger.after,item.after);assert.equal(h.requestId,ledger.requestId);assert(['AuthController_getCsrfToken','AuthController_createPasswordAuthSession','AuthController_getCurrentAuthSession','ProjectCostController_getProjectUnifiedAccounting'].includes(h.operationId));}closed.commandLedgers.forEach(readOld);pendingProjection(state);return{state,k,record,closed,entry,exit,prepared,baseline:prepared.before};}
function producerGraph(b){const input=oldJSON(b.closed.input);assert.equal(input.mode,'prepare-only');assert.equal(input.nonce,b.closed.nonce);assert.equal(input.executionSources.length,8);const runtime=oldJSON(input.runtimeBindings);same(runtime.current.runtimeAdmission121,b.k.runtimeAdmission121);const registry=oldJSON(runtime.current.runtimeAdmission121),plan=oldJSON(registry.approvedPlan);assert.equal(plan.protocolVersion,3);const g1=json(G1),graph=json(g1.sourceBoundary.graph);exactSources(plan.tooling.executionSources,graph);assert.equal(graph.length,284);assert.equal(runtime.current.helperSources.length,229);const sourceMap=new Map(graph.map(p=>[p.file,p.rawBytesSha256]));for(const p of input.executionSources)assert.equal(sourceMap.get(p.file),p.rawBytesSha256);const helper=oldJSON(runtime.current.helperPins);assert.deepEqual(helper,runtime.current.helperSources);for(const p of helper)assert.equal(sourceMap.get(ROOT+'/'+p.file),p.sha256);return graph;}
function preserveProducer(dir,b){const graph=producerGraph(b),out=[];directory(dir+'/producer-before',{create:true});for(const [i,p]of graph.entries()){const bytes=readOld(p);const original={file:p.file,bytes:bytes.length,rawBytesSha256:sha(bytes)},retainedCopy=save(dir+'/producer-before',String(i).padStart(3,'0')+'-'+path.posix.basename(p.file)+'.bin',bytes);out.push({original,retainedCopy});}return out;}
function validateBaselineLocator(pin){const l=json(pin);keys(l,['kind','schemaVersion','recoveryG1','input','state','ownership','continuation','entryGuard','exitGuard','closedJournal','prepared','baseline','audit']);assert.equal(l.kind,'Root-runtime118-last-closed-prepare-baseline');same(l.recoveryG1,G1);same(l.state,BIRTH);same(l.ownership,OWNERSHIP);same(l.continuation,K);const b=closedBaseline();for(const k of['entryGuard','exitGuard','closedJournal'])same(l[k],b.k[k]);same(l.prepared,b.k.prepared15);same(l.baseline,b.baseline);const a=json(l.audit);keys(a,['kind','schemaVersion','recoveryG1','input','producerSources','captureReference','closedCommandSet','pendingProjection','noFurtherEffects']);assert.equal(a.kind,'Root-runtime118-closed-prepare-baseline-audit');same(a.recoveryG1,G1);same(a.input,l.input);assert.equal(a.noFurtherEffects,true);keys(a.captureReference,['prepared','pointer','baseline']);same(a.captureReference.prepared,l.prepared);assert.equal(a.captureReference.pointer,'/before');same(a.captureReference.baseline,l.baseline);assert.deepEqual(a.pendingProjection,pendingProjection(b.state));keys(a.closedCommandSet,['closedJournal','httpAttempts','commandLedgers']);same(a.closedCommandSet.closedJournal,l.closedJournal);assert.deepEqual(a.closedCommandSet.httpAttempts,b.closed.httpAttempts);assert.deepEqual(a.closedCommandSet.commandLedgers,b.closed.commandLedgers);assert.equal(a.producerSources.length,284);exactSources(a.producerSources.map(p=>p.original),producerGraph(b));for(const p of a.producerSources){keys(p,['original','retainedCopy']);full(p.original);full(p.retainedCopy);const bytes=read(p.retainedCopy);assert.equal(bytes.length,p.original.bytes);assert.equal(sha(bytes),p.original.rawBytesSha256);}return{locator:l,baseline:b.baseline};}
function comparisonBase(m){const o=m.e.outputs,{locator,baseline}=validateBaselineLocator(o.baselineLocator),c=json(o.comparison);keys(c,['kind','schemaVersion','recoveryG1','input','baselineLocator','observations','priorConservation','transactionProofs','comparisons','summary','crossDatabaseAtomicity','status']);assert.equal(c.kind,'Root-runtime118-RO-comparison');same(c.recoveryG1,G1);same(c.input,m.e.input);same(c.baselineLocator,o.baselineLocator);assert.deepEqual(c.observations,o.observations);assert.equal(c.status,'verified');assert.equal(c.crossDatabaseAtomicity,false);assert.equal(c.transactionProofs.length,4);const candidates=[...o.observations];for(const p of o.observations){const s=snapshot(p);assert.equal(s.epoch,'runtime118-reentry');assert.equal(s.run,m.p.nonce);}if(m.phase==='ro-before'){assert.equal(c.priorConservation,null);same(locator.input,m.e.input);}else{same(c.priorConservation,m.p.prior.conservationBefore);const pre=readEnvelope(m.p.prior.conservationBefore,'ro-before');verifyComparison(pre);same(o.baselineLocator,pre.e.outputs.baselineLocator);candidates.push(...pre.e.outputs.observations);}for(const t of c.transactionProofs){const r=json(t);keys(r,['kind','schemaVersion','recoveryG1','input','database','connectionOptions','serverIdentity','begin','transactionSettings','outcome','error']);assert.equal(r.kind,'Root-runtime118-RO-transaction');same(r.recoveryG1,G1);same(r.input,m.e.input);assert(C.databases.includes(r.database));assert.equal(r.begin,'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY');assert.deepEqual(r.transactionSettings,{transaction_read_only:'on',default_transaction_read_only:'on',transaction_isolation:'repeatable read'});assert.equal(r.outcome,'committed-read-only');assert.equal(r.error,null);}assert.equal(c.comparisons.length,candidates.length);for(const p of candidates)compareSnapshots(baseline,p);return{locator,baseline};}

function podman(args){assert(Array.isArray(args)&&args.every(x=>typeof x==='string'));const before=readFile(C.podman),result=spawnSync(C.podman,args,{cwd:ROOT,encoding:'utf8',timeout:60000,maxBuffer:16*1024*1024,stdio:['ignore','pipe','pipe'],env:{...HOST_ENV}});sameIdentity(readFile(C.podman).identity,before.identity);return result;}
function successful(r){assert.equal(r.status,0,'Unknown/failed Podman operation; preserve and do not retry');assert.equal(r.signal,null);assert(!r.error);return r.stdout??'';}
function inspectPodmanRaw(){const raw=podman(['inspect',C.container]);const a=JSON.parse(successful(raw));assert.equal(a.length,1);const c=a[0];assert.equal(c.Id,C.container);assert.equal(c.Image,C.image);assert.equal(c.Mounts.length,1);const m=c.Mounts[0];assert.equal(m.Type,'volume');assert.equal(m.Name,C.volume);assert.equal(m.Source,C.volumeRoot);assert.equal(m.Destination,C.volumeTarget);assert.equal(m.Driver,'local');assert.equal(m.RW,true);assert.equal(m.Mode,'');assert.deepEqual([...m.Options].sort(),['nodev','nosuid','rbind']);assert.equal(m.Propagation,'rprivate');assert.deepEqual((c.Config.Env??[]).filter(x=>x.startsWith('PGDATA=')),['PGDATA='+C.volumeTarget]);assert.deepEqual(c.HostConfig.PortBindings['15432/tcp'],[{HostIp:'127.0.0.1',HostPort:'25434'}]);assert(['exited','running'].includes(c.State.Status));assert.equal(typeof c.State.Running,'boolean');assert(Number.isSafeInteger(c.State.Pid)&&c.State.Pid>=0);assert.equal(c.State.Running,c.State.Status==='running');if(!c.State.Running)assert.equal(c.State.Pid,0);return{raw,c,m};}
function pgStepBase(pin){const m=readEnvelope(pin,'pg-current'),before=json(m.e.outputs.observationBefore),after=json(m.e.outputs.observationAfter);for(const p of[before,after]){keys(p,['kind','schemaVersion','recoveryG1','input','observedAt','bootId','container','image','volume','mount','pgProcess','databases','evidence']);assert.equal(p.kind,'Root-runtime118-original-PG-observation');same(p.recoveryG1,G1);same(p.input,m.e.input);assert.equal(p.bootId,currentBoot());assert.equal(p.container.id,C.container);assert.equal(p.image.id,C.image);assert.equal(p.volume.name,C.volume);assert.equal(p.mount.source,C.volumeRoot);assert.equal(p.mount.destination,C.volumeTarget);const e=json(p.evidence);keys(e,['inspect','volume','PG_VERSION','oidDirectories','executable','sqlVerified']);assert.equal(e.sqlVerified,false);const raw=JSON.parse(read(e.inspect))[0];assert.equal(raw.Id,C.container);assert.equal(raw.Image,C.image);assert.equal(raw.Mounts.length,1);const mount=raw.Mounts[0];assert.deepEqual({Type:mount.Type,Name:mount.Name,Source:mount.Source,Destination:mount.Destination,Driver:mount.Driver,RW:mount.RW,Mode:mount.Mode,Options:[...mount.Options].sort(),Propagation:mount.Propagation},{Type:'volume',Name:C.volume,Source:C.volumeRoot,Destination:C.volumeTarget,Driver:'local',RW:true,Mode:'',Options:['nodev','nosuid','rbind'],Propagation:'rprivate'});assert.deepEqual(raw.Config.Env.filter(x=>x.startsWith('PGDATA=')),['PGDATA='+C.volumeTarget]);assert.deepEqual(raw.HostConfig.PortBindings['15432/tcp'],[{HostIp:'127.0.0.1',HostPort:'25434'}]);assert.equal(read(e.PG_VERSION).toString().trim(),'15');assert.equal(e.oidDirectories.length,2);for(const[p,i]of e.oidDirectories.map((p,i)=>[p,i])){const cmd=json(p);assert.equal(cmd.exitCode,0);assert.equal(cmd.signal,null);assert.deepEqual(cmd.argv,['unshare','/usr/bin/test','-d',C.volumeRoot+'/base/'+C.oids[i]]);}const volume=JSON.parse(read(e.volume))[0];assert.equal(volume.Name,C.volume);assert.equal(volume.Driver,'local');assert.equal(volume.Mountpoint,C.volumeRoot);same(e.executable,filePin(C.podman));}assert.equal(after.container.running,true);if(m.e.outputs.mode==='observed-running'){assert.equal(before.container.running,true);assert.equal(m.e.outputs.command,null);}else{assert.equal(before.container.running,false);const cmd=json(m.e.outputs.command);assert.equal(cmd.exitCode,0);assert.equal(cmd.signal,null);assert.deepEqual(cmd.argv,['start',C.container]);}assert.equal(m.e.outputs.readiness.length,2);for(const[p,i]of m.e.outputs.readiness.map((p,i)=>[p,i])){const r=json(p);assert.equal(r.database,C.databases[i]);assert.equal(r.serverIdentity.oid,C.oids[i]);assert.equal(r.settings.transaction_read_only,'on');assert.equal(r.settings.default_transaction_read_only,'on');}return m;}
function ensureParent(dir){absolute(dir);assert(dir.startsWith(PRIVATE+'/runtime118-reentry/')||dir.startsWith(PRIVATE+'/rust-api-reentry/'));const parent=path.posix.dirname(dir);if(!fs.existsSync(parent)){const top=path.posix.dirname(parent);if(!fs.existsSync(top)){assert.equal(path.posix.dirname(top),PRIVATE);directory(PRIVATE);fs.mkdirSync(top,{mode:0o700});}directory(top);fs.mkdirSync(parent,{mode:0o700});}directory(parent);}
function acquire(m){absent(C.driverLock);absent(C.operationLock);assertBirth();const boot=currentBoot(),self=procIdentity(process.pid),value={kind:'Root-runtime118-reentry-operation-lock',schemaVersion:1,G1, input:m.inputPin,operator:m.root.operator,phase:m.phase,nonce:m.p.nonce,pid:process.pid,startTime:self.startTime,bootId:boot};fs.writeFileSync(C.operationLock,JSON.stringify(value,null,2)+'\n',{flag:'wx',mode:0o600});const lock=readFile(C.operationLock);m.lock={bytes:lock.bytes,identity:lock.identity,value};ensureParent(m.p.outputDirectory);directory(m.p.outputDirectory,{create:true});m.outReady=true;m.lockCopy=save(m.p.outputDirectory,'operation-lock.raw',lock.bytes);return m;}
function guardLock(m){assert(m.lock);const now=readFile(C.operationLock);assert(now.bytes.equals(m.lock.bytes),'Operation lock bytes changed');for(const k of['dev','ino','nlink'])assert.equal(now.identity[k],m.lock.identity[k]);assert.equal(currentBoot(),m.lock.value.bootId);assert.equal(procIdentity(process.pid).startTime,m.lock.value.startTime);absent(C.driverLock);}
function earlyGuard(m,{afterAPI=false}={}){guardLock(m);assertBirth();guardOtherStates();for(const p of m.qualification.executionSources)read(p);if(afterAPI){const a=readEnvelope(m.p.prior.API,'api-start');liveAPI(a);}else apiAbsent();if(m.phase!=='holder-start'){const holder=m.phase==='api-start'?readEnvelope(m.p.preConservation,'ro-before').p.prior.holder:m.p.prior.holder;liveHolder(holder);if(m.phase!=='pg-current')currentPG(m.phase==='api-start'?m.p.PGStart:m.p.prior.PG);}}
function release(m){guardLock(m);fs.unlinkSync(C.operationLock);m.lock=null;}
function envelope(m,outputs){keys(outputs,OUTPUTS[m.phase]);const body={kind:E_KIND[m.phase],schemaVersion:1,recoveryG1:G1,input:m.inputPin,RootApproval:m.rootPin,executionReview:m.peerPin,operator:m.root.operator,outputs,semantics:{businessDML:false,contextAuthGranted:false,FIOrNormalGranted:false}};return save(m.p.outputDirectory,'complete.json',body);}
function command(m,label,executable,argv,run){const startedAt=new Date().toISOString();const result=run();const endedAt=new Date().toISOString();const stdout=save(m.p.outputDirectory,label+'-stdout.log',Buffer.from(result.stdout??'')),stderr=save(m.p.outputDirectory,label+'-stderr.log',Buffer.from(result.stderr??''));return{result,pin:save(m.p.outputDirectory,label+'.json',{kind:'Root-runtime118-command-result',schemaVersion:1,recoveryG1:G1,input:m.inputPin,RootApproval:m.rootPin,executionReview:m.peerPin,operator:m.root.operator,executable:filePin(executable),argv,startedAt,endedAt,exitCode:result.status??null,signal:result.signal??null,stdout,stderr})};}
function pgObservation(m,label){const {raw,c,m:mount}=inspectPodmanRaw(),inspect=save(m.p.outputDirectory,label+'-inspect.raw',Buffer.from(raw.stdout));const volumeResult=podman(['volume','inspect',C.volume]);const volume=save(m.p.outputDirectory,label+'-volume.raw',Buffer.from(successful(volumeResult)));const v=JSON.parse(read(volume))[0];assert.equal(v.Name,C.volume);assert.equal(v.Driver,'local');assert.equal(v.Mountpoint,C.volumeRoot);const version=podman(['unshare','/usr/bin/cat',C.volumeRoot+'/PG_VERSION']),PG_VERSION=save(m.p.outputDirectory,label+'-PG_VERSION.raw',Buffer.from(successful(version)));assert.equal(read(PG_VERSION).toString().trim(),'15');const oidDirectories=[];for(const oid of C.oids){const argv=['unshare','/usr/bin/test','-d',C.volumeRoot+'/base/'+oid],x=command(m,label+'-oid-'+oid,C.podman,argv,()=>podman(argv));successful(x.result);oidDirectories.push(x.pin);}const evidence=save(m.p.outputDirectory,label+'-evidence.json',{inspect,volume,PG_VERSION,oidDirectories,executable:filePin(C.podman),sqlVerified:false});const body={kind:'Root-runtime118-original-PG-observation',schemaVersion:1,recoveryG1:G1,input:m.inputPin,observedAt:new Date().toISOString(),bootId:currentBoot(),container:{id:c.Id,running:c.State.Running,status:c.State.Status,exitCode:c.State.ExitCode??null},image:{id:c.Image,digest:c.ImageDigest??c.Image},volume:{name:C.volume,driver:'local',mountpoint:C.volumeRoot},mount:{source:mount.Source,destination:mount.Destination,rw:mount.RW,pgdata:C.volumeTarget},pgProcess:c.State.Running?{pid:c.State.Pid,startTime:procStat(fs.readFileSync('/proc/'+c.State.Pid+'/stat','utf8')).startTime,startedAt:c.State.StartedAt}:null,databases:C.databases.map((name,i)=>({name,oid:C.oids[i]})),evidence};return{body,pin:save(m.p.outputDirectory,label+'.json',body)};}
async function pgPhase(m){
 earlyGuard(m);const before=pgObservation(m,'before');m.completedOutputs.observationBefore=before.pin;let cmd=null,mode='observed-running';m.completedOutputs.mode=mode;
 if(!before.body.container.running){earlyGuard(m);mode='started-existing';m.completedOutputs.mode=mode;m.processes.push({role:'PG',state:'unknown-preserve',command:null,pid:null,startTime:null,bootId:currentBoot(),record:null,error:null});const x=command(m,'command',C.podman,['start',C.container],()=>podman(['start',C.container]));cmd=x.pin;m.completedOutputs.command=cmd;m.processes[0].command=cmd;successful(x.result);}
 const after=pgObservation(m,'after');m.completedOutputs.observationAfter=after.pin;assert(after.body.container.running);const readiness=[];
 for(const[db,i]of C.databases.map((db,i)=>[db,i])){
  earlyGuard(m);const argv=['exec',C.container,'/opt/pgsql/bin/pg_isready','-h','127.0.0.1','-p','15432','-U','poms_r0e_owner','-d',db],x=command(m,'pg-isready-'+db,C.podman,argv,()=>podman(argv));successful(x.result);
  const c=await openReadOnly(db,m);let guard,primary=null;try{guard=await databaseGuard(c,db);assert.equal(guard.identity.oid,C.oids[i]);await c.commit();}catch(e){primary=e;throw e;}finally{try{await c.close();}catch(e){if(!primary)throw e;}}
  const pin=save(m.p.outputDirectory,'readiness-'+(i===0?'native':'rust')+'.json',{kind:'Root-runtime118-PG-readiness',schemaVersion:1,recoveryG1:G1,input:m.inputPin,database:db,observedAt:new Date().toISOString(),connectionOptions:connectionOptions(db),settings:guard.settings,serverIdentity:guard.identity});readiness.push(pin);m.completedOutputs.readiness[i]=pin;
 }
 earlyGuard(m);return{mode,observationBefore:before.pin,command:cmd,observationAfter:after.pin,readiness};
}
async function holderPhase(m){earlyGuard(m);const bootstrap=validateBootstrap118(readBootstrapFD118(),m);save(m.p.outputDirectory,'bootstrap-observation.raw',bootstrap);const self=procIdentity(process.pid),parentId=procStat(fs.readFileSync('/proc/'+process.pid+'/stat','utf8')).ppid,parent=procStat(fs.readFileSync('/proc/'+parentId+'/stat','utf8'));const proc=save(m.p.outputDirectory,'holder-process-evidence.json',{self,parent,bootstrap:filePin(m.p.outputDirectory+'/bootstrap-observation.raw')});const canonical=readFile(D+'/state.json'),ownership=readFile(D+'/ownership.jsonl');const canonicalSnap=save(m.p.outputDirectory,'canonical-before.json',canonical.bytes),ownershipSnap=save(m.p.outputDirectory,'ownership-before.jsonl',ownership.bytes);let environment;try{environment=pgObservation(m,'initial-environment').pin;}catch{environment=save(m.p.outputDirectory,'initial-environment-unknown.json',{status:'unknown-preserve',notPGConservation:true});}const boot=save(m.p.outputDirectory,'boot-observation.json',{kind:'Root-runtime118-holder-boot-observation',schemaVersion:1,recoveryG1:G1,input:m.inputPin,observedAt:new Date().toISOString(),bootId:currentBoot(),canonical:{snapshot:canonicalSnap,identity:canonical.identity},ownership:{snapshot:ownershipSnap,identity:ownership.identity},environment,apiListeners:[],runtimeExecutables:{node:filePin(NODE.file),podman:filePin(C.podman)},processEvidence:proc});m.completedOutputs.bootObservation=boot;earlyGuard(m);release(m);const ready=save(m.p.outputDirectory,'holder-ready.json',{kind:'actual-runtime118-holder-ready',schemaVersion:1,recoveryG1:G1,input:m.inputPin,RootApproval:m.rootPin,executionReview:m.peerPin,operator:m.root.operator,nonce:m.p.nonce,bootId:currentBoot(),pid:process.pid,startTime:self.startTime,startedAt:m.startedAt,identity:{uid:1000,node:filePin(NODE.file),source:m.root.operator,cwd:ROOT,argv:self.argv,ppid:parent.pid,parentStartTime:parent.startTime,processEvidence:proc},bootObservation:boot});m.completedOutputs.holderReady=ready;console.log(JSON.stringify({kind:'runtime118-holder-ready',ready}));await new Promise(()=>{setInterval(()=>{},1000);});}
function collectHolderData118(dataPin){
 assert.equal(arguments.length,1);cleanHost();const d=json(dataPin);keys(d,['kind','schemaVersion','recoveryG1','input','RootApproval','executionReview','raw']);assert.equal(d.kind,'Root-runtime118-holder-data-input');assert.equal(d.schemaVersion,1);same(d.recoveryG1,G1);keys(d.raw,['windowsLaunch','holderReady','launchCommand']);const p=json(d.input),a=approvals(p,d.input,d.RootApproval,d.executionReview);assert.equal(a.phase,'holder-start');assertNoEarlyPartial();assertBirth();guardOtherStates();apiAbsent();const h=json(d.raw.holderReady),outputs={holderReady:d.raw.holderReady,windowsLaunch:d.raw.windowsLaunch,launchCommand:d.raw.launchCommand,bootObservation:h.bootObservation,lifetimeOwner:null},m={p,inputPin:d.input,rootPin:d.RootApproval,peerPin:d.executionReview,...a,e:{input:d.input,RootApproval:d.RootApproval,executionReview:d.executionReview,operator:a.root.operator,outputs}};
 holderFixed(m);const owner=save(p.outputDirectory,'lifetime-owner.json',{kind:'actual-runtime118-lifetime-owner',holderReady:d.raw.holderReady,windowsLaunch:d.raw.windowsLaunch,launchCommand:d.raw.launchCommand});outputs.lifetimeOwner=owner;holderFixed(m);assertNoEarlyPartial();assertBirth();return envelope(m,outputs);
}

// Complete catalog/capture and object observation bodies retained from the fixed
// existing snapshot/objects implementation; no original main/context is imported.
const quote = name => { assert(/^[a-z_][a-z0-9_]*$/.test(name)); return `"${name}"`; };
const segment = name => { assert(typeof name==="string"&&/^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$/.test(name)); return name; };
const objectRoot = (ctx,database) => `${ctx.stateRoot}/objects/${database===C.databases[0]?"native":"rust"}`;
function captureObjects(ctx, database) {
  const root = objectRoot(ctx, database), files = [], directories = [];
  if (!entryPresent(root)) return { root, existed: false, files, directories };
  assert.equal(fs.realpathSync(root), root, 'Object root must not be redirected');
  const walk = folder => {
    const stat = fs.lstatSync(folder); assert(stat.isDirectory() && !stat.isSymbolicLink());
    directories.push(path.relative(root, folder));
    for (const item of fs.readdirSync(folder, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
      const file = path.join(folder, item.name), st = fs.lstatSync(file); assert(!st.isSymbolicLink(), 'Object tree symlink forbidden');
      if (st.isDirectory()) walk(file);
      else { assert(st.isFile() && st.nlink === 1, 'Object must be a regular unlinked file'); const bytes = fs.readFileSync(file); files.push({ key: path.relative(root, file), file, bytes: bytes.length, sha256: sha(bytes) }); }
    }
  };
  walk(root); return { root, existed: true, files: files.sort((a, b) => a.key.localeCompare(b.key)), directories: directories.sort() };
}

async function catalogRO(c, expectedTables = 139) {
  const tables = (await c.query(`SELECT c.relname name,c.oid::text oid,COALESCE((SELECT array_agg(a.attname::text ORDER BY k.n) FROM pg_index i CROSS JOIN LATERAL unnest(i.indkey) WITH ORDINALITY k(attnum,n) JOIN pg_attribute a ON a.attrelid=c.oid AND a.attnum=k.attnum WHERE i.indrelid=c.oid AND i.indisprimary),'{}'::text[]) pk,
    (SELECT array_agg(a.attname::text ORDER BY a.attnum) FROM pg_attribute a WHERE a.attrelid=c.oid AND a.attnum>0 AND NOT a.attisdropped) columns FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='poms' AND c.relkind='r' ORDER BY c.relname`)).rows;
  assert.equal(tables.length, expectedTables, 'Exact registered table inventory required');
  const foreignKeys = (await c.query(`SELECT x.conname name,child.relname child,parent.relname parent,
    (SELECT array_agg(a.attname::text ORDER BY k.n) FROM unnest(x.conkey) WITH ORDINALITY k(attnum,n) JOIN pg_attribute a ON a.attrelid=x.conrelid AND a.attnum=k.attnum) "childColumns",
    (SELECT array_agg(a.attname::text ORDER BY k.n) FROM unnest(x.confkey) WITH ORDINALITY k(attnum,n) JOIN pg_attribute a ON a.attrelid=x.confrelid AND a.attnum=k.attnum) "parentColumns",x.confdeltype "deleteRule"
    FROM pg_constraint x JOIN pg_class child ON child.oid=x.conrelid JOIN pg_class parent ON parent.oid=x.confrelid JOIN pg_namespace n ON n.oid=child.relnamespace JOIN pg_namespace pn ON pn.oid=parent.relnamespace WHERE x.contype='f' AND n.nspname='poms' AND pn.nspname='poms' ORDER BY child.relname,x.conname`)).rows;
  const externalForeignKeys = (await c.query(`SELECT x.oid::text oid,x.conname name,n.nspname "childSchema",child.relname child,parent.relname parent,pg_get_constraintdef(x.oid,true) definition
    FROM pg_constraint x JOIN pg_class child ON child.oid=x.conrelid JOIN pg_class parent ON parent.oid=x.confrelid JOIN pg_namespace n ON n.oid=child.relnamespace JOIN pg_namespace pn ON pn.oid=parent.relnamespace
    WHERE x.contype='f' AND pn.nspname='poms' AND n.nspname<>'poms' ORDER BY n.nspname,child.relname,x.conname`)).rows;
  const normative = {};
  const queries = {
    relations: "SELECT c.oid::text oid,n.nspname schema,c.relname name,c.relkind,pg_get_userbyid(c.relowner) owner,c.relacl::text acl,c.relrowsecurity,c.relforcerowsecurity FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('poms','r4ghi_control') AND c.relkind IN ('r','p','S','v','m') ORDER BY n.nspname,c.relname",
    schemas: "SELECT oid::text oid,nspname,pg_get_userbyid(nspowner) owner,nspacl::text acl FROM pg_namespace WHERE nspname IN ('poms','r4ghi_control') ORDER BY nspname",
    columns: "SELECT n.nspname schema,c.relname table_name,a.attnum,a.attname,format_type(a.atttypid,a.atttypmod) type,a.attnotnull,a.attidentity,a.attgenerated,a.attacl::text acl,pg_get_expr(d.adbin,d.adrelid) default_expr FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attrdef d ON d.adrelid=a.attrelid AND d.adnum=a.attnum WHERE n.nspname IN ('poms','r4ghi_control') AND c.relkind IN ('r','p') AND a.attnum>0 AND NOT a.attisdropped ORDER BY n.nspname,c.relname,a.attnum",
    constraints: "SELECT x.oid::text oid,n.nspname schema,c.relname table_name,x.conname,pg_get_constraintdef(x.oid,true) definition FROM pg_constraint x JOIN pg_class c ON c.oid=x.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('poms','r4ghi_control') ORDER BY n.nspname,c.relname,x.conname",
    indexes: "SELECT schemaname,tablename,indexname,indexdef FROM pg_indexes WHERE schemaname IN ('poms','r4ghi_control') ORDER BY schemaname,tablename,indexname",
    triggers: "SELECT t.oid::text oid,n.nspname schema,c.relname table_name,t.tgname,pg_get_triggerdef(t.oid,true) definition,t.tgenabled FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('poms','r4ghi_control') AND NOT t.tgisinternal ORDER BY n.nspname,c.relname,t.tgname",
    functions: "SELECT p.oid::text oid,n.nspname schema,p.proname,pg_get_function_identity_arguments(p.oid) arguments,pg_get_userbyid(p.proowner) owner,p.proacl::text acl,p.prosecdef,p.proconfig,pg_get_functiondef(p.oid) definition FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname IN ('poms','r4ghi_control') AND p.prokind='f' ORDER BY n.nspname,p.proname,arguments",
    roles: "SELECT rolname,rolsuper,rolinherit,rolcreaterole,rolcreatedb,rolcanlogin,rolreplication,rolbypassrls,rolconnlimit,rolconfig FROM pg_roles WHERE rolname IN ('poms_r0e_owner','poms_r4ghi_native_app','poms_r4ghi_rust_app') ORDER BY rolname",
    memberships: "SELECT a.rolname member,b.rolname granted,r.admin_option FROM pg_auth_members r JOIN pg_roles a ON a.oid=r.member JOIN pg_roles b ON b.oid=r.roleid WHERE a.rolname IN ('poms_r0e_owner','poms_r4ghi_native_app','poms_r4ghi_rust_app') ORDER BY a.rolname,b.rolname",
  };
  for (const [key, sql] of Object.entries(queries)) normative[key] = (await c.query(`SELECT row_to_json(x)::text raw FROM (${sql}) x`)).rows.map(r => r.raw);
  const sequences = [];
  for (const sequence of (await c.query("SELECT n.nspname schema,c.relname name,c.oid::text oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname IN ('poms','r4ghi_control') AND c.relkind='S' ORDER BY n.nspname,c.relname")).rows) {
    sequences.push({ ...sequence, ...(await c.query(`SELECT last_value::text value,is_called FROM ${quote(sequence.schema)}.${quote(sequence.name)}`)).rows[0] });
  }
  return { tables, foreignKeys, externalForeignKeys, normative, sequences };
}
async function captureRO(ctx, label) {
  segment(label); const folder = `${ctx.priv}/snapshot-${label}`; fs.mkdirSync(folder, { mode: 0o700 });
  const result = { schemaVersion: 1, label, marker: ctx.identity.marker, epoch: ctx.epoch, run: ctx.run, capturedAt: new Date().toISOString(), databases: {} };
  for (const database of ctx.databases) await ctx.db(async c => {
    await c.query('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY');
    try {
      const meta = await catalogRO(c, ctx.tables), tables = {};
      for (const table of meta.tables) {
        const pkSql = table.pk.length ? `json_build_array(${table.pk.map(k => `t.${quote(k)}::text`).join(',')})::text` : 'NULL::text';
        const needed = [...new Set([...table.pk, ...meta.foreignKeys.filter(f => f.child === table.name).flatMap(f => f.childColumns), ...meta.foreignKeys.filter(f => f.parent === table.name).flatMap(f => f.parentColumns)])];
        const cellsSql = needed.length ? `json_build_object(${needed.flatMap(k => [`'${k}'`, `t.${quote(k)}::text`]).join(',')})::text` : "'{}'::text";
        const rows = (await c.query(`SELECT row_to_json(t)::text raw,t.xmin::text xmin,${pkSql} key,${cellsSql} cells FROM poms.${quote(table.name)} t ORDER BY ${table.pk.length ? table.pk.map(k => `t.${quote(k)}`).join(',') : 'row_to_json(t)::text'}`)).rows;
        const values = rows.map(r => ({ key: r.key === null ? [`no-pk:${sha(r.raw)}`] : JSON.parse(r.key), cells: JSON.parse(r.cells), raw: r.raw, sha256: sha(r.raw), xmin: r.xmin }));
        const bytes = Buffer.from(values.map(r => JSON.stringify(r)).join('\n') + (values.length ? '\n' : ''));
        const file = `${folder}/${database}-${table.name}.jsonl`; fs.writeFileSync(file, bytes, { flag: 'wx', mode: 0o600 });
        tables[table.name] = { file, count: rows.length, pk: table.pk, columns: table.columns, rawBytesSha256: sha(bytes), logicalRowsSha256: sha(values.map(r => r.raw).join('\n')) };
      }
      result.databases[database] = { meta, tables }; await c.query('COMMIT');
    } catch (e) { await c.query('ROLLBACK'); throw e; }
  }, database);
  result.objects = Object.fromEntries(ctx.databases.map(database => [database, captureObjects(ctx, database)]));
  const manifest = ctx.artifact(`snapshot-${label}.json`, result, { kind: 'actual-private-full-baseline-observation', label, databaseCount: ctx.databases.length, tablesPerDatabase: ctx.tables,
    objectCounts: Object.fromEntries(ctx.databases.map(d => [d, result.objects[d].files.length])),
    counts: Object.fromEntries(ctx.databases.map(d => [d, Object.values(result.databases[d].tables).reduce((n, t) => n + t.count, 0)])), crossDatabaseAtomicity: false });
  return { ...result, manifest };
}

function connectionOptions(database){assert(C.databases.includes(database));return{transport:'podman-exec-psql',host:'127.0.0.1',port:15432,database,user:'poms_r0e_owner',applicationName:'runtime118-reentry-readonly'};}
function serverIdentityShape(r,database){keys(r,['database','oid','user','port','serverVersion','isolated','timeZone','marker','migrations','roles']);assert.equal(r.database,database);assert.equal(r.oid,C.oids[C.databases.indexOf(database)]);assert.equal(r.user,'poms_r0e_owner');assert.equal(r.port,'15432');assert.equal(r.serverVersion,'150012');assert.equal(r.isolated,'on');assert.equal(r.timeZone,'Etc/GMT-8');assert.deepEqual(r.marker,{instance_id:C.marker,namespace:C.namespace,source_base:'aaa4b16ac66092f0cb1dc6646a02cf14e80823ee'});assert.equal(r.migrations,98);assert.equal(r.roles.length,3);for(const role of r.roles){keys(role,['rolname','rolsuper','rolcreatedb','rolcreaterole','rolreplication','rolbypassrls']);assert(['poms_r0e_owner','poms_r4ghi_native_app','poms_r4ghi_rust_app'].includes(role.rolname));for(const key of['rolsuper','rolcreatedb','rolcreaterole','rolreplication','rolbypassrls'])assert.equal(typeof role[key],'boolean');if(role.rolname!=='poms_r0e_owner')for(const key of['rolsuper','rolcreatedb','rolcreaterole','rolreplication','rolbypassrls'])assert.equal(role[key],false);}assert.deepEqual(r.roles.map(x=>x.rolname),['poms_r0e_owner','poms_r4ghi_native_app','poms_r4ghi_rust_app']);return r;}
function readinessShape(pin,input,database){const r=json(pin);keys(r,['kind','schemaVersion','recoveryG1','input','database','observedAt','connectionOptions','settings','serverIdentity']);assert.equal(r.kind,'Root-runtime118-PG-readiness');assert.equal(r.schemaVersion,1);same(r.recoveryG1,G1);same(r.input,input);assert.equal(r.database,database);assert.deepEqual(r.connectionOptions,connectionOptions(database));assert.deepEqual(r.settings,SETTINGS);serverIdentityShape(r.serverIdentity,database);return r;}

async function openReadOnly(database,observation){
 assert(C.databases.includes(database));const password=readFile(PRIVATE+'/owner-password').bytes;assert(/^[a-f0-9]{64}$/.test(password.toString()),'Original owner credential syntax');
 const argv=['exec','-i',C.container,'/usr/bin/env','-i','LANG=C.UTF-8','LC_ALL=C.UTF-8','PGAPPNAME=runtime118-reentry-readonly','PGOPTIONS=-c default_transaction_read_only=on -c statement_timeout=45000 -c lock_timeout=10000','/bin/sh','-c',PSQL_SCRIPT,'--',database];
 const processFact=observation?{role:'RO-psql-'+(database===C.databases[0]?'native':'rust'),state:'spawned-unverified',command:null,pid:null,startTime:null,bootId:observation.lock?.value.bootId??null,record:null,error:null}:null;if(processFact)observation.processes.push(processFact);let child;try{child=spawn(C.podman,argv,{cwd:ROOT,env:{...HOST_ENV},stdio:['pipe','pipe','pipe'],windowsHide:true});if(processFact&&Number.isSafeInteger(child.pid))processFact.pid=child.pid;}catch{if(processFact){processFact.state='unknown-preserve';processFact.error={name:'Error',message:'Read-only client spawn result UNKNOWN'};}throw new Error('Read-only bridge spawn UNKNOWN; preserve without retry');}
 let pending=null,terminal=false,protocolFailed=false,closed=false,closeFailed=false,committed=false,exitCode=null,signal=null,stderrBytes=0;
 const fail=()=>{protocolFailed=true;terminal=true;if(processFact){processFact.state='unknown-preserve';processFact.error={name:'Error',message:'Read-only bridge protocol result UNKNOWN'};}if(pending){const p=pending;pending=null;clearTimeout(p.timer);p.reject(new Error('Read-only bridge result UNKNOWN; preserve without retry'));}};
 child.on('error',fail);child.on('exit',(code,s)=>{exitCode=code;signal=s;terminal=true;if(pending||code!==0||s!==null||!closed)fail();if(processFact)processFact.state='exit-observed';});child.stderr.on('data',b=>{stderrBytes+=b.length;});child.stderr.on('error',fail);child.stdout.on('error',fail);
 let exitResolve;const exited=new Promise(resolve=>{exitResolve=resolve;});child.once('exit',()=>exitResolve());child.once('error',()=>exitResolve());
 const lines=createInterface({input:child.stdout,crlfDelay:Infinity});lines.on('line',line=>{if(!pending){fail();return;}const p=pending;pending=null;clearTimeout(p.timer);try{const result=p.show?[{[p.show]:line}]:JSON.parse(line);assert(Array.isArray(result),'Bridge requires one JSON array line');p.resolve({rows:result});}catch{fail();p.reject(new Error('Read-only bridge parse UNKNOWN; preserve without retry'));}});
 const drained=new Promise(resolve=>lines.once('close',resolve));
 child.stdin.on('error',fail);child.stdin.write(password);child.stdin.write('\n');
 async function query(sql){assert(!closed&&!terminal&&!pending,'One live fixed read-only bridge request');assert.equal(typeof sql,'string');let text,show=null;
  if(['SHOW default_transaction_read_only','SHOW transaction_read_only','SHOW transaction_isolation'].includes(sql)){text=sql+';\n';show=sql.slice(5);}
  else if([BEGIN_RO,'COMMIT','ROLLBACK'].includes(sql))text=sql+"; SELECT '[]';\n";
  else{assert(/^SELECT\s/i.test(sql),'Only fixed observation SELECT is permitted');assert(!sql.includes(';')&&!sql.includes('\\'),'No additional psql command');text="SELECT COALESCE(json_agg(row_to_json(reentry_rows)), '[]'::json)::text FROM ("+sql+") reentry_rows;\n";}
  const promise=new Promise((resolve,reject)=>{pending={resolve,reject,show,timer:setTimeout(()=>{fail();},50000)};});child.stdin.write(text);return promise;
 }
 const client={query,async commit(){await query('COMMIT');committed=true;},async close(){if(closed){assert(!closeFailed&&!protocolFailed&&exitCode===0&&signal===null,'Prior bridge close remains UNKNOWN');return;}closed=true;child.stdin.end();if(pending)fail();let timer;try{await Promise.race([Promise.all([exited,drained]),new Promise((_,reject)=>{timer=setTimeout(()=>reject(new Error('Read-only bridge exit/drain UNKNOWN; preserve without retry')),5000);})]);assert.equal(exitCode,0,'Read-only bridge must actually exit zero');assert.equal(signal,null);assert.equal(protocolFailed,false,'Bridge protocol failure cannot be cleared by zero exit');}catch{closeFailed=true;throw new Error('Read-only bridge close UNKNOWN; preserve without retry');}finally{clearTimeout(timer);lines.close();}},facts(){return{pid:child.pid??null,exitCode,signal,stderrBytes,committed};}};
 try{await query(BEGIN_RO);}catch(e){await client.close();throw e;}return client;
}
async function databaseGuard(c,database){
 const settings={};for(const key of['transaction_read_only','default_transaction_read_only','transaction_isolation'])settings[key]=(await c.query('SHOW '+key)).rows[0][key];assert.deepEqual(settings,SETTINGS);
 const r=(await c.query("SELECT current_database() db,current_user usr,current_setting('port') port,current_setting('server_version_num') version,current_setting('poms.r0e_isolated',true) isolated,current_setting('TimeZone') timezone,(SELECT oid::text FROM pg_database WHERE datname=current_database()) oid")).rows[0];
 const marker=(await c.query('SELECT instance_id::text,namespace,source_base FROM r4ghi_control.marker')).rows;assert.equal(marker.length,1);
 const roles=(await c.query("SELECT rolname,rolsuper,rolcreatedb,rolcreaterole,rolreplication,rolbypassrls FROM pg_roles WHERE rolname IN ('poms_r0e_owner','poms_r4ghi_native_app','poms_r4ghi_rust_app') ORDER BY rolname")).rows;
 const migrations=(await c.query('SELECT count(*)::int count FROM poms.poms_migrations')).rows[0].count;
 const identity={database:r.db,oid:r.oid,user:r.usr,port:r.port,serverVersion:r.version,isolated:r.isolated,timeZone:r.timezone,marker:marker[0],migrations,roles};serverIdentityShape(identity,database);return{identity,settings};
}
async function captureObservation(m,label,proofs){
 const ctx={priv:m.p.outputDirectory,stateRoot:PRIVATE.slice(0,-'/private'.length),identity:{marker:C.marker},epoch:'runtime118-reentry',run:m.p.nonce,databases:[...C.databases],tables:139,artifact:(name,value)=>save(m.p.outputDirectory,name,value)};
 ctx.db=async(body,database)=>{earlyGuard(m,{afterAPI:m.phase==='ro-after'});let c=null,identity=null,settings=null,outcome='failed-unknown-preserve',error=null,primary=null,value;
  // captureRO retains the original BEGIN/COMMIT statements; openReadOnly has
  // already begun this one connection, so the fixed adapter consumes only that
  // first BEGIN and forwards the original remaining SQL unchanged.
  let beginConsumed=false;const adapter={async query(sql){if(sql===BEGIN_RO){assert(!beginConsumed);beginConsumed=true;const g=await databaseGuard(c,database);identity=g.identity;settings=g.settings;return{rows:[]};}const result=await c.query(sql);if(sql==='COMMIT')outcome='committed-read-only';return result;}};
  try{c=await openReadOnly(database,m);value=await body(adapter);}catch(e){primary=e;}
  if(c)try{await c.close();}catch(e){if(!primary)primary=e;}
  if(primary){outcome='failed-unknown-preserve';error={name:'Error',message:'Full read-only capture or bridge exit incomplete; preserve actual partials'};}
  const proof={kind:'Root-runtime118-RO-transaction',schemaVersion:1,recoveryG1:G1,input:m.inputPin,database,connectionOptions:connectionOptions(database),serverIdentity:identity,begin:BEGIN_RO,transactionSettings:settings,outcome,error};
  try{proofs.push(save(m.p.outputDirectory,label+'-'+database+'-transaction.json',proof));}catch(e){if(!primary)primary=e;else writeFailures118.set(primary,[...(writeFailures118.get(primary)??[]),...(writeFailures118.get(e)??[])]);}
  if(primary)throw primary;return value;
 };
 return captureRO(ctx,label);
}
async function roPhase(m){
 earlyGuard(m,{afterAPI:m.phase==='ro-after'});verifyPGStep(m.p.prior.PG);const b=closedBaseline();let baselineLocator;
 if(m.phase==='ro-before'){const producerSources=preserveProducer(m.p.outputDirectory,b),audit=save(m.p.outputDirectory,'baseline-audit.json',{kind:'Root-runtime118-closed-prepare-baseline-audit',schemaVersion:1,recoveryG1:G1,input:m.inputPin,producerSources,captureReference:{prepared:b.k.prepared15,pointer:'/before',baseline:b.baseline},closedCommandSet:{closedJournal:b.k.closedJournal,httpAttempts:b.closed.httpAttempts,commandLedgers:b.closed.commandLedgers},pendingProjection:pendingProjection(b.state),noFurtherEffects:true});baselineLocator=save(m.p.outputDirectory,'baseline-locator.json',{kind:'Root-runtime118-last-closed-prepare-baseline',schemaVersion:1,recoveryG1:G1,input:m.inputPin,state:BIRTH,ownership:OWNERSHIP,continuation:K,entryGuard:b.k.entryGuard,exitGuard:b.k.exitGuard,closedJournal:b.k.closedJournal,prepared:b.k.prepared15,baseline:b.baseline,audit});}
 else{const pre=readEnvelope(m.p.prior.conservationBefore,'ro-before');verifyComparison(pre);same(pre.p.prior.PG,m.p.prior.PG);same(pre.p.prior.holder,m.p.prior.holder);baselineLocator=pre.e.outputs.baselineLocator;}
 m.completedOutputs.baselineLocator=baselineLocator;const transactionProofs=[],observations=[];
 for(const label of['ro01','ro02']){const s=await captureObservation(m,label,transactionProofs);observations.push(s.manifest);m.completedOutputs.observations[observations.length-1]=s.manifest;earlyGuard(m,{afterAPI:m.phase==='ro-after'});compareSnapshots(b.baseline,s.manifest);}
 const candidates=[...observations];if(m.phase==='ro-after')candidates.push(...readEnvelope(m.p.prior.conservationBefore,'ro-before').e.outputs.observations);const comparisons=candidates.map(p=>compareSnapshots(b.baseline,p));
 assert.equal(transactionProofs.length,4);const comparison=save(m.p.outputDirectory,'comparison.json',{kind:'Root-runtime118-RO-comparison',schemaVersion:1,recoveryG1:G1,input:m.inputPin,baselineLocator,observations,priorConservation:m.phase==='ro-before'?null:m.p.prior.conservationBefore,transactionProofs,comparisons,summary:{observations:candidates.length,tablesPerDatabase:139,databases:2,allRawXminMetaSequencesObjectsEqual:true},crossDatabaseAtomicity:false,status:'verified'});m.completedOutputs.comparison=comparison;earlyGuard(m,{afterAPI:m.phase==='ro-after'});return{baselineLocator,observations,comparison};
}

function descriptors(a,n){assert(Array.isArray(a)&&a.length===n);const names=[];for(const p of a){keys(p,['file','sha256']);assert(typeof p.file==='string'&&!p.file.startsWith('/')&&path.posix.normalize(p.file)===p.file&&!p.file.split('/').some(x=>x==='..'||x==='.'||!x)&&!p.file.includes('\\'));assert(/^[a-f0-9]{64}$/.test(p.sha256));names.push(p.file);}assert.deepEqual(names,[...new Set(names)].sort());return a;}
function oldPlan(){const p=json(PREDECESSOR.predecessorPlan),g=json(G1);assert.equal(p.protocolVersion,3);assert(read(PREDECESSOR.predecessorPlan).equals(read(g.currentFactBoundary.historicalP3PublicMirror)));const state=json(BIRTH);same(state.runtimeAdmission121.registry,PREDECESSOR.predecessorRegistry);same(state.runtimeAdmission121.candidate,PREDECESSOR.predecessorCandidate);same(json(PREDECESSOR.predecessorRegistry).approvedPlan,PREDECESSOR.predecessorPlan);same(json(PREDECESSOR.predecessorCandidate).runtimeAdmission121,PREDECESSOR.predecessorRegistry);const pub=json(PREDECESSOR.predecessorPublication);same(pub.input,PREDECESSOR.predecessorPlan);same(pub.registry,PREDECESSOR.predecessorRegistry);same(pub.candidate,PREDECESSOR.predecessorCandidate);assert.equal(pub.statePublished,true);const r=json(PREDECESSOR.predecessorReadback);assert.equal(r.verdict,'approved-actual-exact-successor-FS-publication-readback');same(r.complete,PREDECESSOR.predecessorPublication);return p;}

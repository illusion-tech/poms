body=body.replace('baseFiles.set(SELF,sourceRaw);',"const winNodeRaw=fs.readFileSync('C:/Users/ynh2/AppData/Roaming/fnm/node-versions/v24.19.0/installation/node.exe');assert.equal(sha(winNodeRaw),'3602f2bb1a10f2cbab4c36886218a33c1ab3db87290e73b033c46c77147d0237');baseFiles.set('/mnt/c/Users/ynh2/AppData/Roaming/fnm/node-versions/v24.19.0/installation/node.exe',winNodeRaw);baseFiles.set(SELF,sourceRaw);")

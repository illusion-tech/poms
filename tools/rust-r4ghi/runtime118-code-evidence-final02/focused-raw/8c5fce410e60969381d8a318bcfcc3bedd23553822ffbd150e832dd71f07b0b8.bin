helpers="""
 function value(pin){return JSON.parse(files.get(pin.file).raw);}
 function refreshInput(p=value(input)){Object.assign(input,put(input.file,p));const a=value(approval);a.input={...input};Object.assign(approval,put(approval.file,a));const r=value(peer);r.input={...input};r.RootApproval={...approval};Object.assign(peer,put(peer.file,r));}
 function replaceInput(fn){const p=value(input);fn(p);refreshInput(p);}
 function replaceRoot(fn){const p=value(approval);fn(p);Object.assign(approval,put(approval.file,p));const r=value(peer);r.RootApproval={...approval};Object.assign(peer,put(peer.file,r));}
 function replacePeer(fn){const p=value(peer);fn(p);Object.assign(peer,put(peer.file,p));}
 function replaceQualification(fn){const p=value(sq);fn(p);Object.assign(sq,put(sq.file,p));replaceInput(p=>p.codeReview={...sq});const a=value(approval);a.codeReview={...sq};Object.assign(approval,put(approval.file,a));const r=value(peer);r.codeReview={...sq};r.RootApproval={...approval};Object.assign(peer,put(peer.file,r));}
 function replaceFinite(group,fn){const s=value(sourcePlan),key=group==='production'?'graphReview':'dataQualification',q=value(s[key]);fn(q);s[key]=put(s[key].file,q);Object.assign(sourcePlan,put(sourcePlan.file,s));replaceInput(p=>p.sourcePlan={...sourcePlan});}
 function replaceManifest(fn){const m=value(manifest);fn(m);Object.assign(manifest,put(manifest.file,m));const s=value(sourcePlan);s.combinedManifest={...manifest};for(const key of['graphReview','dataQualification']){const q=value(s[key]);q.componentManifest={...manifest};s[key]=put(s[key].file,q);}Object.assign(sourcePlan,put(sourcePlan.file,s));replaceInput(p=>p.sourcePlan={...sourcePlan});}
"""

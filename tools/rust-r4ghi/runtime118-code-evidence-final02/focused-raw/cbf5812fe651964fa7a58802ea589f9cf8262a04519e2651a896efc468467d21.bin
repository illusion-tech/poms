const producerPath=path.resolve(here,'../../runtime118-reentry-tool-impl01/proposed/tools/rust-r4ghi/runtime-recovery121/budget118/reenter-budget118-runtime.mjs'),producerCode=fs.readFileSync(producerPath,'utf8'),native=context('native');
const seedSerialized=vm.runInContext(`globalThis.seedF=fixtureReentry118();JSON.stringify({header:seedF.json(seedF.pg),input:seedF.json(seedF.json(seedF.pg).input),boot:seedF.json(seedF.json(seedF.holder).outputs.holderReady).bootId,inspect:seedF.json(seedF.json(seedF.json(seedF.pg).outputs.observationAfter).evidence).inspect,rawInspect:seedF.read(seedF.json(seedF.json(seedF.json(seedF.pg).outputs.observationAfter).evidence).inspect).toString(),server:Object.fromEntries(['poms_r4ghi_native','poms_r4ghi_rust'].map(database=>[database,serverFixture118(database,seedF.state.marker)]))})`,native);
const forbidden=()=>{throw Error('ACTUAL IO/PROCESS/HTTP FORBIDDEN');},rootContext=vm.createContext({assert,createHash,Buffer,path:path.posix,seedSerialized,console:{log(){},error(){}},spawn:forbidden,http:new Proxy({}, {get:()=>forbidden}),createInterface:forbidden,fileURLToPath:x=>x,pathToFileURL:x=>({href:x}),process:{platform:'linux',version:'v24.19.0',argv:[],execArgv:[],env:{},pid:11803,getuid:()=>1000,cwd:()=>'/OWN-MODEL',execPath:'/OWN-MODEL-NODE'}});
vm.runInContext(`
 const seed=JSON.parse(seedSerialized),modelFiles=new Map(),modelFD=new Map(),modelDirs=new Set([seed.input.outputDirectory]);let nextFD=10,writes=0,reads=0,spawns=0;
 const pgRaw=JSON.parse(seed.rawInspect),volumeRoot=pgRaw[0].Mounts[0].Source;
 modelFiles.set('/usr/bin/podman',Buffer.from('OWN SYNTHETIC PODMAN'));
 modelFiles.set('/proc/sys/kernel/random/boot_id',Buffer.from(seed.boot+'\\n'));
 const tail=Array(20).fill('0');tail[0]='S';tail[1]='11800';tail[19]='11803';modelFiles.set('/proc/11803/stat',Buffer.from('11803 (postgres) '+tail.join(' ')));modelFiles.set('/proc/11803/cmdline',Buffer.from('/opt/pgsql/bin/postgres\\0'));
 const missing=()=>{throw Object.assign(new Error('OWN ABSENT'),{code:'ENOENT'});};
 function modelStat(file){if(modelDirs.has(file))return{isFile:()=>false,isDirectory:()=>true,isSymbolicLink:()=>false,nlink:1n,uid:1000n};if(file==='/proc/11803')return{uid:1000n};if(!modelFiles.has(file))return missing();return{isFile:()=>true,isDirectory:()=>false,isSymbolicLink:()=>false,nlink:1n,size:BigInt(modelFiles.get(file).length),dev:1n,ino:BigInt([...modelFiles.keys()].indexOf(file)+1),uid:1000n,mode:384n,mtimeNs:100n,ctimeNs:100n,birthtimeNs:100n};}
 globalThis.fs={constants:{O_RDONLY:0,O_NOFOLLOW:131072},lstatSync:modelStat,statSync:modelStat,realpathSync:file=>{if(file==='/proc/11803/exe')return'/opt/pgsql/bin/postgres';if(file==='/proc/11803/cwd')return'/OWN-PG';assert(modelFiles.has(file)||modelDirs.has(file));return file;},openSync:file=>{assert(modelFiles.has(file));const fd=nextFD++;modelFD.set(fd,file);return fd;},fstatSync:fd=>{assert(modelFD.has(fd));return modelStat(modelFD.get(fd));},readFileSync:(file,encoding)=>{if(typeof file==='number'){assert(modelFD.has(file));file=modelFD.get(file);}assert(modelFiles.has(file),'OWN FILES ONLY');reads++;const b=Buffer.from(modelFiles.get(file));return encoding?b.toString():b;},closeSync:fd=>{assert(modelFD.delete(fd));},writeFileSync:(file,bytes,o)=>{assert(file.startsWith(seed.input.outputDirectory+'/'),'OWN OUTPUT ONLY');assert.equal(o.flag,'wx');assert(!modelFiles.has(file));modelFiles.set(file,Buffer.from(bytes));writes++;},existsSync:file=>modelFiles.has(file)||modelDirs.has(file)};
 globalThis.spawnSync=(exe,args,o)=>{assert.equal(exe,'/usr/bin/podman');assert.deepEqual(o.stdio,['ignore','pipe','pipe']);spawns++;let stdout='';if(args[0]==='inspect'){assert.equal(args[1],pgRaw[0].Id);stdout=seed.rawInspect;}else if(args[0]==='volume'){assert.deepEqual(args,['volume','inspect',pgRaw[0].Mounts[0].Name]);stdout=JSON.stringify([{Name:pgRaw[0].Mounts[0].Name,Driver:'local',Mountpoint:volumeRoot}]);}else if(args[1]==='/usr/bin/cat'){assert.deepEqual(args,['unshare','/usr/bin/cat',volumeRoot+'/PG_VERSION']);stdout='15\\n';}else{assert.equal(args[0],'unshare');assert.equal(args[1],'/usr/bin/test');assert.equal(args[2],'-d');assert([volumeRoot+'/base/16385',volumeRoot+'/base/16387'].includes(args[3]));}return{status:0,signal:null,error:null,stdout,stderr:''};};
`,rootContext);
new vm.Script(strip(producerCode),{filename:'COMPLETE-TAX-REENTRY-TOOL-OWN-IO',importModuleDynamically:forbidden}).runInContext(rootContext);
const produced=await vm.runInContext(`(async()=>{const m={p:seed.input,inputPin:seed.header.input,rootPin:seed.header.RootApproval,peerPin:seed.header.executionReview,root:{operator:seed.header.operator}},before=pgObservation(m,'before'),after=pgObservation(m,'after'),readiness=[];let queries=0;for(const database of C.databases){const fixture=seed.server[database],identity=fixture.serverIdentity,client={async query(sql){queries++;if(sql.startsWith("SELECT current_setting('transaction_read_only')"))return{rows:[SETTINGS]};if(sql.startsWith('SELECT current_database()'))return{rows:[{db:database,usr:identity.user,port:identity.port,version:identity.serverVersion,isolated:identity.isolated,timezone:identity.timeZone,oid:String(identity.oid)}]};if(sql.startsWith('SELECT instance_id::text'))return{rows:[identity.marker]};if(sql.startsWith('SELECT rolname,'))return{rows:identity.roles};if(sql==='SELECT count(*)::int count FROM poms.poms_migrations')return{rows:[{count:98}]};throw Error('UNEXPECTED MODEL SQL');}};const guard=await databaseGuard(client,database);readiness.push(save(m.p.outputDirectory,'readiness-'+database+'.json',{kind:'Root-runtime118-PG-readiness',schemaVersion:1,recoveryG1:G1,input:m.inputPin,database,observedAt:new Date().toISOString(),connectionOptions:connectionOptions(database),settings:guard.settings,serverIdentity:guard.identity}));}assert.equal(modelFD.size,0);return JSON.stringify({before:before.pin,after:after.pin,readiness,files:[...modelFiles].map(([file,b])=>({file,body:b.toString('base64')})),statistics:{reads,writes,spawns,queries}});})()`,rootContext,{timeout:30000});
native.producerSerialized=produced;
vm.runInContext(`const produced=JSON.parse(producerSerialized),y=fixtureReentry118(),pg=y.json(y.pg);for(const q of produced.files){const b=Buffer.from(q.body,'base64'),pin={file:q.file,bytes:b.length,rawBytesSha256:hashM(b)};y.register(pin,b);}pg.outputs.observationBefore=produced.before;pg.outputs.observationAfter=produced.after;pg.outputs.readiness=produced.readiness;y.register(y.pg,pg);globalThis.linkResult=readReentryFiles118(y.P5,y.read);assert.equal(linkResult.recovery.PG.value.outputs.mode,'observed-running');assert.deepEqual(y.json(produced.after).databases.map(d=>typeof d.oid),['string','string']);const e=y.json(y.json(produced.after).evidence),cmd=y.json(e.oidDirectories[0]);assert.equal(cmd.executable.file,'/usr/bin/podman');assert.equal(linkResult.recovery.record.protocolVersion,2);assert.equal(linkResult.recovery.conservation.snapshots.length,4);`,native,{timeout:30000});

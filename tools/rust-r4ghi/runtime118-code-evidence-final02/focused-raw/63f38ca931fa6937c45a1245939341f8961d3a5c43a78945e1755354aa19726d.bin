function setupAPI5118(){
 const z=fixtureAPI(),f=fixtureReentry118(),m=readReentryFiles118(f.P5,f.read),p=f.P5,c=p.current,r=f.record,files=new Map(),links=new Map(),stats=new Map(),base=z.raws.get(z.r.baseNormalEnv.file),normal=z.raws.get(z.r.normalEnv.file),ready={mode:'start',port:31441,readiness:200,privateCredentialsPrinted:false,pid:r.pid,binarySha256:r.binarySha256},attempt={method:'GET',url:'http://127.0.0.1:31441/api/health/readiness',status:200,body:JSON.stringify({service:'poms-api',status:'ready',checks:{process:{status:'pass'},database:{status:'pass'}}})};
 read121=q=>{if(q.file===r.baseNormalEnv.file)return base;if(q.file===r.normalEnv.file)return normal;if(q.file===c.readiness.file)return Buffer.from(JSON.stringify(ready));if(q.file===r.readinessAttempt.file)return Buffer.from(JSON.stringify(attempt));return f.read(q);};
 files.set('/proc/'+r.pid+'/stat',JSON.stringify({pid:r.pid,startTime:r.startTime}));files.set('/proc/sys/kernel/random/boot_id',r.bootId+'\n');files.set('/proc/'+r.pid+'/status','Uid:\t1000\t1000\t1000\t1000\n');files.set('/proc/'+r.pid+'/cmdline',Buffer.from(r.binary+'\0'));files.set('/proc/'+r.pid+'/environ',Buffer.from('HOME=/home/wangzishi\0USER=wangzishi\0LOGNAME=wangzishi\0PATH=/usr/bin:/bin\0LANG=C.UTF-8\0LC_ALL=C.UTF-8\0POMS_ENV_FILE='+r.normalEnv.file+'\0'));files.set('/proc/net/tcp','header\n0: 0100007F:7AD1 00000000:0000 0A 0 0 0 0 0 123456\n');files.set('/proc/net/tcp6','header\n');links.set('/proc/'+r.pid+'/exe',r.binary);links.set('/proc/'+r.pid+'/cwd',r.root);const fact=c.binaryFiles.find(q=>q.file===r.binary);stats.set('/proc/'+r.pid+'/exe',{dev:BigInt(fact.dev),ino:BigInt(fact.ino)});
 parseProc15=text=>JSON.parse(text);globalThis.fs={readFileSync:(file,encoding)=>{assert(files.has(file),'Own API proc only');return encoding?files.get(file).toString():Buffer.from(files.get(file));},realpathSync:file=>{assert(links.has(file));return links.get(file);},statSync:file=>{assert(stats.has(file));return stats.get(file);},readdirSync:file=>{assert.equal(file,'/proc/'+r.pid+'/fd');return['10'];},readlinkSync:file=>{assert.equal(file,'/proc/'+r.pid+'/fd/10');return'socket:[123456]';}};return{f,m,p,c,r,files,links,stats,parent:{code:{plan:{consumer:{apiProcess:r.baseAPIProcess,binary:c.binary,summaryBinary:c.summaryBinary}}}},composition:{successor:m,executionSources:m.executionSources}};
}
function setupHolder5118(){
 const f=fixtureReentry118(),h=f.json(f.holder),ready=f.json(h.outputs.holderReady),i=ready.identity,files=new Map(),links=new Map();read121=f.read;parseProc15=text=>JSON.parse(text);binaryBytes121=pin=>{assert.deepEqual(pin,i.node);f.read(pin);return{declaredNodeIdentityOnly:true};};files.set('/proc/sys/kernel/random/boot_id',ready.bootId+'\n');files.set('/proc/'+ready.pid+'/stat',JSON.stringify({pid:ready.pid,startTime:ready.startTime}));files.set('/proc/'+i.ppid+'/stat',JSON.stringify({pid:i.ppid,startTime:i.parentStartTime}));files.set('/proc/'+ready.pid+'/cmdline',Buffer.from(i.argv.join('\0')+'\0'));files.set('/proc/'+ready.pid+'/status','Uid:\t1000\t1000\t1000\t1000\n');files.set('/proc/'+ready.pid+'/environ',Buffer.from('HOME=/home/wangzishi\0USER=wangzishi\0LOGNAME=wangzishi\0PATH=/usr/bin:/bin\0LANG=C.UTF-8\0LC_ALL=C.UTF-8\0'));links.set('/proc/'+ready.pid+'/exe',i.node.file);links.set('/proc/'+ready.pid+'/cwd',i.cwd);globalThis.fs={lstatSync:file=>{assert.equal(file,R118.operationLock);const e=new Error('OWN ABSENT');e.code='ENOENT';throw e;},readFileSync:(file,encoding)=>{assert(files.has(file),'Own holder proc only');return encoding?files.get(file).toString():Buffer.from(files.get(file));},realpathSync:file=>{assert(links.has(file));return links.get(file);}};return{f,h,ready,i,files,links};

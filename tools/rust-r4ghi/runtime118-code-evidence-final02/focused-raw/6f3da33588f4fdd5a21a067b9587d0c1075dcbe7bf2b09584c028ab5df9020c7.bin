function validateReentryPlan118(p,m,h,e){
 b118Keys(p,['kind','protocolVersion','namespace','epoch','run','nonce','base','current','composition','stateTransfer','tooling','outputs']);assert.equal(p.kind,'source15-append-runtime-plan121');assert.equal(p.protocolVersion,5);for(const[k,v]of Object.entries({namespace:'poms-r4ghi',epoch:'g2-business15',run:'main01'}))assert.equal(p[k],v);assert(/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/.test(p.nonce));assert.deepEqual(p.base,m.predecessorPlan.base);const current=b118Copy(m.recovery.current);assert.deepEqual(p.current,current);b118Keys(p.stateTransfer,['expectedState','expectedOwnership','actorCacheDelta','successor']);assert.deepEqual(p.stateTransfer.expectedState,m.successor.retainedCurrentState);assert.deepEqual(p.stateTransfer.expectedOwnership,B118.ownership);b118Same(p.stateTransfer.successor,m.successorPin);assert.deepEqual(p.stateTransfer.actorCacheDelta,{actorKeys:Object.keys(m.retainedState.actors).sort(),clearCookies:false,clearPermissions:false});
 b118Keys(p.composition,['helperComposition','externalComposition','independentCodeReviews']);assert.deepEqual(p.composition.independentCodeReviews,b118Reviews(m.predecessorPlan.composition.independentCodeReviews,m.witness.successorCodeReview));b118Keys(h,['kind','schemaVersion','baseline','finalHelperPins','sourceWitness']);b118Keys(e,['kind','schemaVersion','baseline','finalSources','sourceWitness']);assert.equal(h.kind,'Root-Source15-runtime121-H3-successor-composition');assert.equal(e.kind,'Root-Source15-runtime121-external-successor-composition');assert.equal(h.schemaVersion,5);assert.equal(e.schemaVersion,5);b118Same(h.baseline,m.predecessorPlan.composition.helperComposition);b118Same(e.baseline,m.predecessorPlan.composition.externalComposition);b118Same(h.finalHelperPins,m.witness.currentHelperPins);b118Same(h.sourceWitness,m.successor.sourceWitness);b118Same(e.sourceWitness,m.successor.sourceWitness);assert.deepEqual(e.finalSources,m.external);b118Keys(p.tooling,['manifest','executionSources']);b118Same(p.tooling.manifest,m.witness.successorManifest);assert.deepEqual(b118Sources(p.tooling.executionSources),m.executionSources);const d=B118.private+'/business/g2-business15/main01/runtime121-'+p.nonce;assert.deepEqual(p.outputs,{registryFile:d+'/registry.json',candidateFile:d+'/candidate.json',receiptDirectory:d});return p;

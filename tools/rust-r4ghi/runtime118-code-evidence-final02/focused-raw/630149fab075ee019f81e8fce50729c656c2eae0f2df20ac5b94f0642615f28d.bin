const here=path.dirname(fileURLToPath(import.meta.url)),runtimePath=process.argv[2],suffix=process.argv[3];assert(runtimePath&&suffix);
const runtimeRaw=fs.readFileSync(runtimePath),runtimeText=runtimeRaw.toString(),results=[];
const pass=(name,data={})=>results.push({name,status:'PASS',...data});let f,stage='fixture';
const stopped=x=>{assert.equal(x.kind,'Root-runtime118-data-assembly-stopped');assert.equal(x.retryPolicy,'preserve-partial-no-blind-retry');assert(!Object.hasOwn(x,'RootApproval'));assert(!Object.hasOwn(x,'executionReview'));assert(!JSON.stringify(x).includes('MODEL SECRET'));};
try{
 f=await fixtureJoint118({runtimeText});
 const assemblyFile='/mnt/e/projects/worktrees/poms-r3hijk-next28/poms/tools/rust-r4ghi/runtime118-data-assembly-corrective01/Root-G3-data-entry-assembly118-01.json',assemblyRaw=fs.readFileSync('E:/projects/worktrees/poms-r3hijk-next28/poms/tools/rust-r4ghi/runtime118-data-assembly-corrective01/Root-G3-data-entry-assembly118-01.json');assert.equal(sha(assemblyRaw),'e9009555328ab8377b333751dc403403179c4e0886e1f84e5fb498d1bd3991dc');f.putRaw(assemblyFile,assemblyRaw);
 const call=pin=>f.invoke('main118',[['--prepare-data','--input',pin.file,'--input-sha',pin.rawBytesSha256]]);
 const cInput=(change=()=>{})=>{const nonce=f.nonce(),c=f.get(f.C),d={kind:'Root-runtime118-reentry-complete-data-input',schemaVersion:1,recoveryG1:f.sourceModel.GPIN,nonce,prepareOrigin121:c.prepareOrigin121,steps:c.steps,sourceDelivery:c.sourceDelivery,canonicalRebind:c.canonicalRebind,outputDirectory:f.sourceModel.P+'/runtime118-reentry-data/complete/'+nonce};change(d);return{d,pin:f.at('independent-data-C-'+nonce,d)};};
 const requireNoOutput=d=>{assert(!f.memory.existsSync(d.outputDirectory+'/recovery-complete.json'));};
 stage='window';f.invoke('readSourcePromotionWindow118',[f.window]);const badWindow=f.get(f.window);delete badWindow.ownership.bytes;const bw=f.at('independent-window-Pin2',badWindow);assert.throws(()=>f.invoke('readSourcePromotionWindow118',[bw]));pass('Tool02 repairs public window ownership Full3 counterexample');
 stage='complete-actual-source-and-recovery-chain';await f.setupSource();const SC=await f.runSource(),sourceReadback=f.at('source-readback',{kind:'non-author-runtime118-actual-source-readback',schemaVersion:1,G1:f.sourceModel.GPIN,complete:SC,reviewer:'MODEL-independent-source-reviewer',reviewerIsExecutor:false,verdict:'approved-actual-nine-plus-two-source-only',evidence:f.proof});f.completeRecovery(SC,sourceReadback);f.invoke('readSourceRecoveryHandoff118',[SC,f.bundle]);pass('Tool02 complete public window -> actual Source eleven-step SC -> full currentX handoff calibrated');
 const badC=f.get(f.C);delete badC.prepareOrigin121.bytes;const badCPin=f.at('C-missing-Origin-bytes',badC),badR=f.get(f.readback);badR.complete=badCPin;const badRPin=f.at('R-for-bad-C',badR),badB=f.get(f.bundle);badB.recoveryComplete=badCPin;badB.independentReadback=badRPin;assert.throws(()=>f.invoke('readSourceRecoveryHandoff118',[SC,f.at('B-for-bad-C',badB)]));pass('Tool02 public handoff repairs C10 Origin Full3 counterexample');
 stage='data-C-negative-contracts';
 for(const[name,change]of [
  ['Origin Pin2',d=>{delete d.prepareOrigin121.bytes;}],
  ['extra caller purpose',d=>{d.allowedPurpose='budget-probe';}],
  ['wrong G1',d=>{d.recoveryG1={...d.recoveryG1,rawBytesSha256:'a'.repeat(64)};}],
  ['foreign output directory',d=>{d.outputDirectory='/mnt/e/projects/worktrees/poms-r3hijk-next28/poms/MODEL-FOREIGN';}],
  ['unknown kind',d=>{d.kind='Root-general-writer';}],
  ['unrelated source readback',d=>{d.sourceDelivery.independentReadback=f.proof;}]
 ]){const{d,pin}=cInput(change),out=await call(pin);stopped(out);requireNoOutput(d);pass('data CLI rejects '+name+' before C output');}
 const operation=f.sourceModel.P+'/runtime118-reentry-operation.lock',blocked=cInput();f.memory.symlink(operation,'/MODEL-MISSING');const blockedResult=await call(blocked.pin);stopped(blockedResult);requireNoOutput(blocked.d);f.memory.unlinkSync(operation);pass('data CLI rejects dangling operation without writing or removing lock');
 stage='data-C-success';const good=cInput(),before=f.memory.readFileSync(f.sourceModel.D+'/state.json'),C=await call(good.pin);assert.equal(C.file,good.d.outputDirectory+'/recovery-complete.json');assert.equal(Object.keys(f.get(C)).length,10);assert(f.memory.readFileSync(f.sourceModel.D+'/state.json').equals(before));pass('actual CLI5 writes closed10 C10 from C9 with no future R8/B5 dependency',{C});
 const replay=await call(good.pin);stopped(replay);assert.deepEqual(f.pin(C.file),f.cp(C));pass('C9 same nonce replay rejects and preserves existing C10');
 stage='data-B-success';const r=f.at('independent-actual-R8',{kind:'non-author-runtime118-actual-reentry-readback',schemaVersion:1,recoveryG1:f.sourceModel.GPIN,complete:C,reviewer:'MODEL-independent-reentry-reviewer',reviewerIsExecutor:false,verdict:'approved-actual-source-bound-reentry',evidence:f.proof}),bn=f.nonce(),bd={kind:'Root-runtime118-reentry-bundle-data-input',schemaVersion:1,recoveryG1:f.sourceModel.GPIN,nonce:bn,recoveryComplete:C,independentReadback:r,outputDirectory:f.sourceModel.P+'/runtime118-reentry-data/accept/'+bn},B=await call(f.at('independent-data-B',bd));assert.equal(B.file,bd.outputDirectory+'/recovery-bundle.json');assert.equal(Object.keys(f.get(B)).length,5);f.invoke('readSourceRecoveryHandoff118',[SC,B]);pass('actual CLI5 consumes independent R8 and writes closed5 B5 accepted by complete public handoff',{B});
 const wrongB={...bd,nonce:f.nonce(),independentReadback:f.proof};wrongB.outputDirectory=f.sourceModel.P+'/runtime118-reentry-data/accept/'+wrongB.nonce;const deniedB=await call(f.at('independent-data-B-wrong-R',wrongB));stopped(deniedB);assert(!f.memory.existsSync(wrongB.outputDirectory+'/recovery-bundle.json'));pass('B7 rejects unrelated reviewer record and does not self-sign R8');
 stage='Source-S4-with-data-output';const hn=f.nonce(),hp=f.at('Source-handoff-data02',{kind:'Root-runtime118-reentry-handoff-data-input',schemaVersion:1,G1:f.sourceModel.GPIN,nonce:hn,sourceComplete:SC,recoveryBundle:B,outputDirectory:f.sourceModel.P+'/runtime118-source-handoff/'+hn});f.loaded.context.handoffArgs=JSON.stringify(['--prepare-handoff','--input',hp.file,'--input-sha',hp.rawBytesSha256]);const hc=await vm.runInContext('sourceModule.main118(JSON.parse(handoffArgs))',f.loaded.context,{timeout:30000});assert.equal(Object.keys(f.get(f.get(hc).successor)).length,13);assert(f.memory.readFileSync(f.sourceModel.D+'/state.json').equals(before));pass('complete Source pure CLI consumes actual C/B dispatcher output and writes S4');
 stage='data-partial-double-write-failure';const failed=cInput(),originalWrite=f.memory.writeFileSync.bind(f.memory);f.memory.writeFileSync=(file,bytes,options)=>{if(typeof file==='string'&&file.startsWith(failed.d.outputDirectory+'/'))throw Object.assign(new Error('MODEL SECRET PRIMARY OR SECONDARY'),{code:'EIO'});return originalWrite(file,bytes,options);};const failure=await call(failed.pin);f.memory.writeFileSync=originalWrite;stopped(failure);assert.equal(failure.partial,null);assert.equal(failure.completedOutputs.recoveryComplete,null);assert(failure.error.writeFailures.length>=2);requireNoOutput(failed.d);pass('C output and partial write failure preserves finite primary facts without claiming files');
 stage='data-postwrite-bookend-failure';const late=cInput();f.memory.writeFileSync=(file,bytes,options)=>{const result=originalWrite(file,bytes,options);if(file===late.d.outputDirectory+'/recovery-complete.json')f.put(operation,{MODEL_NEW_UNRESOLVED_LOCK:true});return result;};const lateFailure=await call(late.pin);f.memory.writeFileSync=originalWrite;stopped(lateFailure);assert(lateFailure.completedOutputs.recoveryComplete);assert(lateFailure.partial);assert.deepEqual(f.pin(lateFailure.completedOutputs.recoveryComplete.file),f.cp(lateFailure.completedOutputs.recoveryComplete));assert(f.memory.existsSync(operation));f.memory.unlinkSync(operation);pass('post-output current guard failure retains actual C pin and partial without sealing success');
}catch(e){results.push({name:stage,status:'FAIL',error:{name:e.name,message:e.message,stack:e.stack?.split('\n').slice(0,17)}});}
const report={kind:'non-author-runtime118-complete-data-dispatcher-joint-model',reviewer:'/root/budget118_review',engine:{execPath:process.execPath,version:process.version},runtime:{file:runtimePath,bytes:runtimeRaw.length,rawBytesSha256:sha(runtimeRaw)},results,boundary:'Only copied candidate text evaluated in owned virtual FS/process/SQLHTTP; historical Node/birth/ELF byte-role aliases remain explicitly declared. New C/B/SC/S4 pins are computed from actual model output bytes. No host private/runtime effects.',actualG2Granted:false};const file=here+'/independent-data02-'+suffix+'.json';fs.writeFileSync(file,JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({file,pass:results.filter(x=>x.status==='PASS').length,fail:results.filter(x=>x.status==='FAIL')}));if(results.some(x=>x.status==='FAIL'))process.exitCode=1;

  "scopeUserDecision": {
    "kind": "actual-user-project-scope-decision-and-Root-refinement",
    "date": "2026-11-06",
    "batchIssue": 110,
    "question": "授权复核发现，当前没有组织主管或项目数据范围的配置机制。对于尚无个人主责的组织项目，建议允许创建人做首次主责指派；之后改派、移交和阶段推进只认当前主责及真实移交职责，同组织或持有 ProjectWrite 不自动获得项目权限。采用哪种规则？",
    "answer": "创建人负责首次指派，之后按真实责任链授权（推荐）",
    "source": "explicit user reply in this chat",
    "RootTechnicalRefinements": {
      "authority": "project-scope-v1-direct-relations",
      "bootstrap": "Only true new org-owned ownership-origin, verified creator, no ever-personal owner, unconsumed, active memberships and project-write plus CAS. First personal assignment permanently consumes; returning to org does not reactivate creator privileges. No origin or historical unknown fails closed.",
      "initialProducer": "Direct CreateProject starts with real actor as personal owner and consumed origin; Lead.convertToProject uses actual conversion operator as project creator and actual inherited owner, creates origin in the same transaction. No historical synthetic backfill.",
      "supportingCorrections": [
        "Existing owner reassignment verifies prior owner or exact first-assignment bootstrap before writing new owner",
        "Existing D prepare verifies real current owner before producing any participant delegation"
      ],
      "GHWrite": "Finance-manage permission AND (OwnerWrite OR delegated confirmed finance duty OR delegated confirmed business-admin duty). Duties must be real current handover facts.",
      "GHRead": "OwnerRead or actual project participant, independently enforce sensitive projections. Own-condition-only and creator-first-assignment-only do not grant operating or commission detail access.",
      "unmodeledManagerExceptions": "Fail closed; same org, ancestor org, roleKey, system-role flag or a bare write permission never manufacture project scope.",
      "conditionClose": "Designated condition responsible user acts as self with exact parent-child-project binding, action permission, active relationships and double CAS; no owner/admin impersonation."
    },
    "G1Certified": false,
    "productImplementationAuthorizedByThisFile": false
  },
  "lifecycleContract": {
    "rulesProducerDependency": {
      "source": [
        "docs/design/commission-settlement-design.md:110-134,401-417",
        "docs/design/interface-command-design.md:136",
        "apps/poms-api/src/app/features/commission/commission.service.ts:260-361,715-725"
      ],
      "additionalOperations": [],
      "seedAllowed": false,
      "note": "Rule version is a calculation input; freeze validates assignment policy separately",
      "required": false
    },
    "runtimeInvariants": [
      "All write actors from session, no supplied user/approver/status/stage truth",
      "Exact weight raw token -> checked millionths -> sum exactly1000000; no f64 epsilon; zero reason required",
      "CreateAssignment expectedCurrentAssignmentId/expectedCurrentRowVersion both null or both match current draft; current frozen rejected",
      "Freeze has exact current true handover, actual self-confirmations, basis/hash/summaries/current receipt freeze and project scope",
      "Own immutable freeze summarySnapshotId differs in meaning from upstream handoverSummarySnapshotId",
      "D real prepare enters handover atomically; does not invent early history or auto-enter execution",
      "startExecution only handover+true frozen same chain; startAcceptance only true execution+real attachment evidence",
      "Final accepted maps only completed; final conditional maps only conditional-completed; stage or rejected cannot complete project",
      "Condition closer actor equals responsibleUserId and has same-project data scope; no generic ProjectWrite override",
      "Last closed condition updates conditionStatus only; original completionResult immutable; pending blocks archive",
      "Archive terminal ancillary fact; recorded is single current; replacement and void keep complete audited chain",
      "One borrowed CommonSession inside outer TX; domain+summary+audit+pending auth atomic; unknown commit remains unknown"
    ],
    "legacyCertification": "Read/display only for upstream old advanced stages. Archive compatibility commands may retain real existing terminal anchors but remain legacy-unverified; they certify this archive write/audit, never a fresh close/completion producer. Unknown conditional completion cannot archive.",
    "adapterConstraints": {
      "openapiMultipleOf": "Contract annotation only; never sufficient runtime validation",
      "weightParser": "Validate raw JSON numeric tokens before Value/f64 conversion; retain exact weightUnits. Reject0.10000000000000001, accept1e-6, reject1e-7.",
      "resourceKeys": "Preserve both completionRecordId(path id) and conditionId. Current last-id-only matcher cannot represent this route."
    },
    "services": [
      "commission_assignment::execute(&mut CommonSession,Operation,ResourceKeys,AssignmentRequestWithRawWeights,&Actor)->Result<Value>",
      "commission_assignment::require_current_frozen(&mut CommonSession,projectId,exactRefs)->FrozenAssignmentFacts",
      "project_lifecycle::execute(&mut CommonSession,Operation,ResourceKeys,LifecycleRequest,&Actor)->Result<Value>",
      "project_lifecycle::enter_handover(&mut CommonSession,&Actor,projectLocked,handover,basis,expectedProjectVersion)->StageFact",
      "lifecycle_evidence::validate_and_freeze(&mut CommonSession,projectId,refs)->FrozenEvidenceSet",
      "project_action_authorization::require(&mut CommonSession,&Actor,project,action,trueResponsibilities)->Result<()>"
    ],
    "dependencyDAG": "R4 source and handover facts -> R5-P1 role freeze -> R4 explicit execution -> acceptance evidence -> I acceptance -> completion/conditions -> archive. No wait for full R5 rules/calculation/payout or H recommendation producer."
  },
  "publicContractInputs": {
    "G": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "G target DTO proposal; not yet shared runtime contract",
      "$defs": {
        "SourceRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "rowVersion",
            "payloadHash"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "rowVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "payloadHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "ExpectedRef": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "expectedVersion",
            "payloadHash"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "expectedVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "payloadHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "MoneyFact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "knowledge",
            "value",
            "unknownReasonCode",
            "evidenceRefs",
            "zeroProof"
          ],
          "properties": {
            "knowledge": {
              "type": "string",
              "enum": [
                "known",
                "unknown"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unknownReasonCode": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceRef"
              },
              "maxItems": 1000
            },
            "zeroProof": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "source-basis-value",
                    "sum-known-members-zero",
                    "exhaustive-classified-scope-zero"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "knowledge": {
                    "const": "known"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
                  },
                  "unknownReasonCode": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "value": {
                    "type": "null"
                  },
                  "unknownReasonCode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "zeroProof": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "value": {
                    "const": "0.00"
                  }
                }
              },
              "then": {
                "properties": {
                  "zeroProof": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "knowledge": {
                    "const": "known"
                  },
                  "value": {
                    "not": {
                      "const": "0.00"
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "zeroProof": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "FormalEligibility": {
          "type": "object",

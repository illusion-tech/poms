        "UPDATE poms.auth_session SET status='revoked',revoked_at=$1,revoked_reason=$2,\
        row_version=row_version+1,updated_at=$1 WHERE id=$3 AND status='active' RETURNING ",
        snapshot_columns!()
    ))
    .bind(now)
    .bind(reason.as_str())
    .bind(id)
    .fetch_optional(connection)
    .await?
    .map(map_snapshot)
    .transpose()

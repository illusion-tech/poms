        "laborCorrections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LaborCorrection"
          },
          "maxItems": 1000
        },
        "allocationCorrections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AllocationCorrection"
          },
          "maxItems": 1000
        },
        "affectedTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AffectedRestatementTarget"
          },
          "maxItems": 1000
        },
        "acknowledgedChangedSourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectedRef"
          },
          "maxItems": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "period"
              }
            }
          },
          "then": {
            "properties": {
              "periodEndSnapshotRef": {
                "$ref": "#/$defs/ExpectedRef"
              }
            }
          },
          "else": {
            "properties": {
              "periodEndSnapshotRef": {
                "type": "null"
              }
            }
          }
        }
      ]
    },

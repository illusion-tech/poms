  "components": {
    "schemas": {
      "AcceptanceRecordList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AcceptanceRecordSummary"
        }
      },
      "AcceptanceRecordSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "acceptanceType": {
            "type": "string",
            "enum": [
              "stage-outcome",
              "stage-acceptance",
              "final-acceptance"
            ]
          },
          "acceptanceResult": {
            "type": "string",
            "enum": [
              "accepted",
              "conditional",
              "rejected"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "voided"
            ]
          },
          "scopeSummary": {
            "type": "string"
          },
          "evidenceSummary": {
            "type": "string"
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "confirmationRecordId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "confirmedBy": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "createdBy": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updatedBy": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "rowVersion": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "projectId",
          "acceptanceType",
          "acceptanceResult",
          "status",
          "scopeSummary",
          "evidenceSummary",
          "comment",
          "confirmationRecordId",
          "confirmedAt",
          "confirmedBy",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "rowVersion"
        ]
      },
      "ActivateOperatingBaselinePackageRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "originalBaselineCost": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "baselineSelectionSource": {
            "default": "original",
            "$ref": "#/components/schemas/BaselineSelectionSource"
          },
          "effectiveOperatingBaselineId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "baselineSummary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "nullable": true
          },
          "changePackages": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "changePackageId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "changeAmount": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "changeSummary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "nullable": true
                },
                "effectiveAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                  "nullable": true
                }
              },
              "required": [
                "changePackageId",
                "changeAmount"
              ]
            }
          },
          "expectedCurrentPackageVersion": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          }
        },
        "required": [
          "projectId",
          "originalBaselineCost"
        ]
      },
      "BaselineSelectionSource": {
        "type": "string",
        "enum": [
          "original",
          "handover-rebaseline"
        ]
      },
      "BusinessAccountingFeedbackView": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "signalLevel": {
            "$ref": "#/components/schemas/OperatingSignalLevel"
          },
          "currentActionLevel": {
            "$ref": "#/components/schemas/OperatingSnapshotActionLevel"
          },
          "taxImpactSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "allocationStabilitySummary": {
            "type": "string",
            "nullable": true
          },
          "unmappedCostSummary": {
            "type": "string",
            "nullable": true
          },
          "dataMaturityLevel": {
            "$ref": "#/components/schemas/OperatingDataMaturityLevel"
          },
          "costActionRecommendation": {
            "$ref": "#/components/schemas/OperatingSnapshotActionLevel"
          },
          "referencedBaselineVersion": {
            "type": "string"
          },
          "referencedSnapshotVersion": {
            "type": "string"
          },
          "nextActionSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "downstreamConsumerSummaryProjection": {
            "$ref": "#/components/schemas/SensitiveStringFieldProjection"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "projectId",
          "signalLevel",
          "currentActionLevel",
          "taxImpactSummaryProjection",
          "allocationStabilitySummary",
          "unmappedCostSummary",
          "dataMaturityLevel",
          "costActionRecommendation",
          "referencedBaselineVersion",
          "referencedSnapshotVersion",
          "nextActionSummaryProjection",
          "downstreamConsumerSummaryProjection",
          "allowedActions"
        ]
      },
      "CommissionGateBindingHistoryView": {
        "type": "object",

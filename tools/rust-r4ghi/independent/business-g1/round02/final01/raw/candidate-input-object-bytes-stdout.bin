        tierDefinitionJson: CommissionTierDefinitionSchema,
        firstStageCapRuleJson: z.record(z.string(), z.unknown()).nullable().optional(),
        secondStageCapRuleJson: z.record(z.string(), z.unknown()).nullable().optional(),

      "inputVersion": null
    },
    {
      "operationId": "ProjectCostController_createPeriodClosingSnapshot",
      "method": "POST",
      "path": "/api/period-closing-snapshots",
      "canonicalLine": 165,
      "permission": "contract:finance:manage",
      "input": {
        "$ref": "#/$defs/CreatePeriodClosingSnapshotRequest"
      },
      "response": {
        "$ref": "#/$defs/OperatingCommandResult"
      },
      "successStatus": 201,
      "inputVersion": "server-derived-v1"
    },
    {
      "operationId": "ProjectCostController_getPeriodClosingSnapshot",
      "method": "GET",
      "path": "/api/period-closing-snapshots/{id}",
      "canonicalLine": 533,
      "permission": "contract:finance:manage",
      "input": null,
      "response": {
        "$ref": "#/$defs/PeriodClosingSnapshotSummary"
      },
      "successStatus": 200,
      "inputVersion": null
    },
    {
      "operationId": "ProjectCostController_createOperatingRestatement",
      "method": "POST",

      "ManualOperatingMaterialityReview": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "policyVersion": {
            "const": "r4h-operating-v1"
          },
          "issueCodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperatingReasonCode"
            },
            "minItems": 1
          },
          "riskDecision": {
            "enum": [
              "normal",
              "attention",
              "risk"
            ]
          },
          "evidenceRefs": {
            "type": "array",

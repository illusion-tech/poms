  "info": {
    "title": "POMS API",
    "description": "Project Oriented Management System API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "pomsSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "poms_session"
      },
      "pomsCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "AuditLogSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "eventType": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "operatorId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "$ref": "#/components/schemas/AuditLogResult"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "beforeSnapshot": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuditSnapshot"
              }
            ],
            "nullable": true
          },
          "afterSnapshot": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuditSnapshot"
              }
            ],
            "nullable": true
          },
          "metadata": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuditSnapshot"
              }
            ],
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "eventType",
          "targetType",
          "targetId",
          "operatorId",
          "requestId",
          "result",
          "reason",
          "beforeSnapshot",
          "afterSnapshot",
          "metadata",
          "occurredAt"
        ]
      },
      "AuditLogResult": {
        "type": "string",
        "enum": [
          "success",
          "rejected",
          "failed"
        ]
      },
      "AuditSnapshot": {
        "type": "object",
        "additionalProperties": {}
      },
      "AuditLogList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AuditLogSummary"
        }
      },
      "SecurityEventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "eventType": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/SecurityEventSeverity"
          },
          "actorId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "principal": {
            "type": "string",
            "nullable": true
          },
          "requestId": {
            "type": "string",
            "nullable": true
          },
          "path": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "nullable": true
          },
          "permissionKey": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "$ref": "#/components/schemas/SecurityEventResult"
          },
          "ip": {
            "type": "string",
            "nullable": true
          },
          "userAgent": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AuditSnapshot"
              }
            ],
            "nullable": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "eventType",
          "severity",
          "actorId",
          "principal",
          "requestId",
          "path",
          "method",
          "permissionKey",
          "result",
          "ip",
          "userAgent",
          "details",
          "occurredAt"
        ]
      },
      "SecurityEventSeverity": {
        "type": "string",
        "enum": [
          "info",
          "warning",
          "high"
        ]
      },
      "SecurityEventResult": {
        "type": "string",
        "enum": [
          "blocked",
          "failed",
          "expired"
        ]
      },
      "SecurityEventList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SecurityEventSummary"
        }
      },
      "RecordRouteDeniedSecurityEventRequest": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "returnUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "nullable": true
          },
          "requiredPermissions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "platform:users:manage",
                "platform:roles:manage",
                "platform:navigation:manage",
                "platform:org-units:manage",
                "platform:dictionaries:manage",
                "platform:identity-providers:manage",
                "platform:org-sync:manage",
                "platform:attachment-storage-providers:manage",
                "platform:system-settings:manage",
                "customer:read",
                "customer:write",
                "commission:rule-versions:manage",
                "commission:assignments:manage",
                "commission:calculations:manage",
                "commission:payouts:manage",
                "commission:adjustments:manage",
                "contract:finance:manage",
                "contract:finance:sensitive:read",
                "operating:finance:sensitive:read",
                "commission:amount:sensitive:read",
                "labor-cost-rate:sensitive:read",
                "exception-approval-opinion:sensitive:read",
                "lead:read",
                "lead:write",
                "lead:assign",
                "lead:score:override",
                "project:read",
                "project:write",
                "project:delete",
                "nav:dashboard:view",
                "nav:customers:view",
                "nav:platform:view",
                "nav:leads:view",
                "nav:attachments:view",
                "nav:projects:view",
                "nav:contracts:view",
                "nav:profile:view"
              ]
            }
          }
        },
        "required": [
          "path",
          "requiredPermissions"
        ]
      },
      "HealthDependencyCheckDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "durationMs": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "message",
          "durationMs"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "process": {
            "$ref": "#/components/schemas/HealthDependencyCheckDto"
          },
          "database": {
            "$ref": "#/components/schemas/HealthDependencyCheckDto"
          }
        },
        "required": [
          "process"
        ]
      },
      "HealthCheckDto": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "poms-api"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "live",
              "ready",
              "not_ready"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "uptimeSeconds": {
            "type": "number"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "service",
          "status",
          "checkedAt",
          "uptimeSeconds",
          "checks"
        ]
      },
      "CreatePasswordAuthSessionRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "CurrentAuthSessionStatus": {
        "type": "string",
        "enum": [
          "active"
        ]
      },
      "SanitizedUserWithOrgUnits": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "displayName": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "platform:users:manage",
                "platform:roles:manage",
                "platform:navigation:manage",
                "platform:org-units:manage",
                "platform:dictionaries:manage",
                "platform:identity-providers:manage",
                "platform:org-sync:manage",
                "platform:attachment-storage-providers:manage",
                "platform:system-settings:manage",
                "customer:read",
                "customer:write",
                "commission:rule-versions:manage",
                "commission:assignments:manage",
                "commission:calculations:manage",
                "commission:payouts:manage",
                "commission:adjustments:manage",
                "contract:finance:manage",
                "contract:finance:sensitive:read",
                "operating:finance:sensitive:read",
                "commission:amount:sensitive:read",
                "labor-cost-rate:sensitive:read",
                "exception-approval-opinion:sensitive:read",
                "lead:read",
                "lead:write",
                "lead:assign",
                "lead:score:override",
                "project:read",
                "project:write",
                "project:delete",
                "nav:dashboard:view",
                "nav:customers:view",
                "nav:platform:view",
                "nav:leads:view",
                "nav:attachments:view",
                "nav:projects:view",
                "nav:contracts:view",
                "nav:profile:view"
              ]
            }
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "lastLoginAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "nullable": true
          },
          "emailVerified": {
            "type": "boolean"
          },
          "phoneVerified": {
            "type": "boolean"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "orgUnits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserOrgUnitSummary"
            }
          }
        },
        "required": [
          "id",
          "displayName",
          "username",
          "roles",
          "permissions",
          "email",
          "avatarUrl",
          "isActive",
          "lastLoginAt",
          "emailVerified",
          "phoneVerified",
          "phone",
          "orgUnits"
        ]
      },
      "UserOrgUnitSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"

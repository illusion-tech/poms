            "live",
            "period"
          ]
        },
        "periodEndSnapshotRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "restatesSnapshotRef": {
          "$ref": "#/$defs/SourceRef"
        },
        "restatedSnapshotRef": {
          "$ref": "#/$defs/SourceRef"
        },
        "rootSnapshotRef": {
          "$ref": "#/$defs/SourceRef"
        },
        "causalitySourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 1000
        },
        "affectedRestatementRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 1000
        },
        "reasonProjection": {
          "$ref": "#/$defs/FinancialProjection"
        },
        "handledAt": {
          "type": "string",
          "format": "date-time"
        },
        "handledBy": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "superseded"
          ]
        }
      }
    },
    "OperatingRestatementListView": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OperatingRestatementSummary"
      },
      "maxItems": 1000
    },
    "OperatingPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputVersion",
        "kind",
        "officialSnapshotRef",
        "intent",
        "projectId",
        "headVersion",
        "projectVersion",
        "expectedInputHash",
        "preparedAt",
        "businessCutoff",
        "periodKey",
        "formalEligibility",
        "evaluationStatus",
        "sourceRows",
        "proposedOriginalCostRef",
        "selectedBaselinePackageRef",
        "allowedCommandCodes",
        "blockingReasonCodes"
      ],
      "properties": {
        "outputVersion": {
          "const": "server-derived-v1"
        },
        "kind": {
          "const": "preparation-only"
        },
        "officialSnapshotRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "intent": {
          "type": "string",
          "enum": [
            "baseline-activation",
            "snapshot-create",
            "period-close",
            "restatement",
            "receipt-basis"
          ]
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "headVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "projectVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "expectedInputHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preparedAt": {
          "type": "string",
          "format": "date-time"
        },
        "businessCutoff": {
          "type": "string",
          "format": "date"
        },
        "periodKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9]{4}-(?:0[1-9]|1[0-2])|[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3]))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "formalEligibility": {
          "$ref": "#/$defs/FormalEligibility"
        },
        "evaluationStatus": {
          "type": "string",
          "enum": [
            "not-evaluated",
            "preview-only"
          ]
        },
        "sourceRows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRow"
          },
          "maxItems": 1000
        },
        "proposedOriginalCostRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedBaselinePackageRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowedCommandCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 1000
        },
        "blockingReasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 1000
        }
      }
    }
  },
  "routes": [
    {
      "operationId": "ProjectCostController_activateOperatingBaselinePackage",
      "method": "POST",
      "path": "/api/operating-baseline-packages",
      "canonicalLine": 162,
      "permission": "contract:finance:manage",
      "input": {
        "$ref": "#/$defs/ActivateOperatingBaselinePackageRequest"
      },
      "response": {
        "$ref": "#/$defs/OperatingCommandResult"
      },
      "successStatus": 201,
      "inputVersion": "server-derived-v1"
    },
    {
      "operationId": "ProjectCostController_getCurrentOperatingBaselinePackage",
      "method": "GET",
      "path": "/api/projects/{projectId}/operating-baseline-package",
      "canonicalLine": 163,
      "permission": "contract:finance:manage",
      "input": null,
      "response": {
        "$ref": "#/$defs/OperatingBaselinePackageSummary"
      },
      "successStatus": 200,
      "inputVersion": null
    },
    {
      "operationId": "ProjectCostController_createProjectOperatingSnapshot",
      "method": "POST",
      "path": "/api/project-operating-snapshots",
      "canonicalLine": 164,
      "permission": "contract:finance:manage",
      "input": {
        "$ref": "#/$defs/CreateProjectOperatingSnapshotRequest"
      },
      "response": {
        "$ref": "#/$defs/OperatingCommandResult"
      },
      "successStatus": 201,
      "inputVersion": "server-derived-v1"
    },
    {
      "operationId": "ProjectCostController_getProjectOperatingSnapshot",
      "method": "GET",
      "path": "/api/project-operating-snapshots/{id}",
      "canonicalLine": 550,
      "permission": "contract:finance:manage",
      "input": null,
      "response": {
        "$ref": "#/$defs/ProjectOperatingSnapshotSummary"
      },

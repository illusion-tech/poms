        }
      }
    },
    "SharedSourceMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "costRef",
        "sourceRef",
        "stageAttributionRef",
        "attributedStage",
        "governanceEvidenceRefs",
        "containsLabor",

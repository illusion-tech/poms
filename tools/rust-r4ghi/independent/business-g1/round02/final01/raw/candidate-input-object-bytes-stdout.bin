//! R4 shared business types. All writes borrow the caller's outer transaction.
pub mod http;
pub mod validation;
use crate::{
    approval_common::{CommonFailure, CommonSession, FailureKind},
    auth::{model::ResolvedSession, projection::ProjectionRequestContext},
    error::ApiError,
};
use axum::http::StatusCode;
use serde_json::{Value, json};
use sha2::{Digest, Sha256};
use sqlx::{PgConnection, Row};
use uuid::Uuid;

pub struct Actor {
    pub id: Uuid,
    pub request_id: Option<String>,
    pub session: ResolvedSession,
    pub request_context: ProjectionRequestContext,
}

pub enum Error {
    BadRequest(String),
    NotFound(String),
    Conflict(String),
    Unprocessable(String),
    Forbidden(String),
    Selection { ids: Vec<Uuid> },
    CodedConflict { code: &'static str, message: String },
    Database(sqlx::Error),
    Common(CommonFailure),
    Internal,
}

impl std::fmt::Debug for Error {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str(match self {
            Self::BadRequest(_) => "R4BadRequest",
            Self::NotFound(_) => "R4NotFound",
            Self::Conflict(_) | Self::CodedConflict { .. } => "R4Conflict",
            Self::Unprocessable(_) => "R4Unprocessable",
            Self::Forbidden(_) => "R4Forbidden",
            Self::Selection { .. } => "R4ContractSelectionRequired",
            Self::Database(_) | Self::Common(_) | Self::Internal => "R4Internal",
        })
    }
}

impl From<CommonFailure> for Error {
    fn from(value: CommonFailure) -> Self {
        if value.kind == FailureKind::Database
            && value.sqlstate.as_deref() == Some("23505")
            && value
                .constraint
                .as_deref()
                .is_some_and(|name| UNIQUE_CONFLICTS.contains(&name))
        {
            return Self::Conflict("A business record with this identity already exists".into());
        }
        Self::Common(value)
    }
}

const UNIQUE_CONFLICTS: &[&str] = &[
    "uq_r4d_amendment_scope",
    "uq_r4d_amendment_open",
    "uq_r4d_review_scope",
    "uq_r4d_basis_version",
    "uq_r4d_basis_project",
    "uq_r4d_basis_current",
    "uq_r4d_plan_full_source",
    "uq_r4d_basis_contract",
    "uq_r4d_basis_anchor",
    "uq_r4d_basis_item_key",
    "uq_r4d_basis_item_scope",
    "uq_r4d_handover_version",
    "uq_r4d_handover_scope",
    "uq_r4d_handover_confirmation",
    "uq_r4d_handover_freeze_source",
    "uq_r4d_handover_current",
    "uq_r4d_participant_scope",
    "uq_r4d_participant_role",
    "uq_r4d_handover_execution_owner",
    "uq_r4d_rebaseline_before",
    "uq_r4d_rebaseline_item",
    "uq_r4d_receipt_freeze_version",
    "uq_project_actual_cost_record_payment_fact_source_current",
    "uq_project_actual_cost_record_invoice_source_current",
    "uq_project_actual_cost_record_expense_source_current",
    "uq_project_actual_cost_record_procurement_source_current",
    "uq_r4e_cost_single_successor",
    "uq_r4f_basis_successor",
    "uq_r4f_allocation_source_current",
    "uq_r4f_result_successor",
    "uq_r4f_stage_successor",
    "uq_r4f_tax_successor",
    "invoice_record_invoice_no_unique",
    "contract_contract_no_unique",
    "commercial_release_baseline_project_code_unique",
    "uq_contract_term_snapshot_contract_active",
    "uq_r4_baseline_project_current",
    "uq_r4_readiness_contract_current",
    "uq_r4_preparation_version",
    "uq_r4_preparation_current",
    "uq_r4_preparation_exact",
    "uq_r4_snapshot_source_preparation",
    "contract_review_binding_pkey",
    "uq_r4_plan_contract_version",
    "uq_r4_plan_contract_snapshot",
    "uq_r4_plan_contract_current",
    "uq_r4_plan_node_key",
    "uq_r4_plan_node_order",
    "receivable_plan_init_record_plan_version_id_key",
];

impl From<sqlx::Error> for Error {
    fn from(value: sqlx::Error) -> Self {
        if let Some(database) = value.as_database_error()
            && database.code().as_deref() == Some("23505")
            && database
                .constraint()
                .is_some_and(|name| UNIQUE_CONFLICTS.contains(&name))
        {
            return Self::Conflict("A business record with this identity already exists".into());
        }
        Self::Database(value)
    }
}

impl Error {
    pub fn into_api_error(self) -> ApiError {
        match self {
            Self::BadRequest(message) => ApiError::message(StatusCode::BAD_REQUEST, message),
            Self::NotFound(message) => ApiError::message(StatusCode::NOT_FOUND, message),
            Self::Conflict(message) => ApiError::message(StatusCode::CONFLICT, message),
            Self::Unprocessable(message) => {
                ApiError::message(StatusCode::UNPROCESSABLE_ENTITY, message)
            }
            Self::Forbidden(message) => ApiError::message(StatusCode::FORBIDDEN, message),
            Self::Selection { ids } => ApiError::object(
                StatusCode::CONFLICT,
                json!({
                    "statusCode":409,"error":"Conflict","message":"Select a contract explicitly",
                    "code":"contract_selection_required","candidateContractIds":ids
                }),
            ),
            Self::CodedConflict { code, message } => ApiError::object(
                StatusCode::CONFLICT,
                json!({"statusCode":409,"error":"Conflict","message":message,"code":code}),
            ),
            Self::Common(failure) if failure.kind == FailureKind::Http => {
                let status = failure
                    .status
                    .and_then(|n| StatusCode::from_u16(n).ok())
                    .unwrap_or(StatusCode::INTERNAL_SERVER_ERROR);
                if let Some(code) = failure.code {
                    ApiError::object(
                        status,
                        json!({"statusCode":status.as_u16(),"error":status.canonical_reason().unwrap_or("Error"),"message":failure.message.to_utf8_lossy(),"code":code}),
                    )
                } else {
                    ApiError::message(status, failure.message.to_utf8_lossy())
                }
            }
            Self::Common(_) | Self::Database(_) | Self::Internal => ApiError::internal(),
        }
    }
    pub fn into_common(self) -> CommonFailure {
        let (status, message) = match self {
            Self::BadRequest(message) => (StatusCode::BAD_REQUEST, message),
            Self::NotFound(message) => (StatusCode::NOT_FOUND, message),
            Self::Conflict(message) => (StatusCode::CONFLICT, message),
            Self::CodedConflict { code, message } => {
                let mut failure = CommonFailure::http(StatusCode::CONFLICT, message.as_str());
                failure.code = Some(code.into());
                return failure;
            }
            Self::Unprocessable(message) => (StatusCode::UNPROCESSABLE_ENTITY, message),
            Self::Forbidden(message) => (StatusCode::FORBIDDEN, message),
            Self::Common(failure) => return failure,
            _ => return CommonFailure::unexpected("Contract business operation failed"),
        };
        CommonFailure::http(status, message.as_str())
    }
}

fn scaled(value: &str, scale: usize, maximum: i128, allow_zero: bool) -> Result<i128, Error> {
    let value = value.trim();
    let mut parts = value.split('.');
    let whole = parts.next().unwrap_or_default();
    let fraction = parts.next();
    if whole.is_empty()
        || !whole.bytes().all(|b| b.is_ascii_digit())
        || parts.next().is_some()
        || fraction.is_some_and(|s| {
            s.is_empty() || s.len() > scale || !s.bytes().all(|b| b.is_ascii_digit())
        })
    {
        return Err(Error::BadRequest(
            "Expected an unsigned finite decimal with valid precision".into(),
        ));
    }
    let whole = whole.trim_start_matches('0');
    // Bound work and capacity by significant digits before integer conversion.
    if whole.len() > 18 {
        return Err(Error::BadRequest(
            "Decimal exceeds its supported capacity".into(),
        ));
    }
    let base = if whole.is_empty() {
        0
    } else {
        whole
            .parse::<i128>()
            .map_err(|_| Error::BadRequest("Invalid decimal".into()))?
    };
    let factor = 10_i128.pow(scale as u32);
    let remainder = fraction
        .map_or(Ok(0), |s| {
            s.parse::<i128>()
                .map(|n| n * 10_i128.pow((scale - s.len()) as u32))
        })
        .map_err(|_| Error::BadRequest("Invalid decimal fraction".into()))?;
    let amount = base
        .checked_mul(factor)
        .and_then(|n| n.checked_add(remainder))
        .ok_or_else(|| Error::BadRequest("Decimal exceeds its supported capacity".into()))?;
    if amount > maximum || (!allow_zero && amount == 0) {
        return Err(Error::BadRequest(
            "Decimal is outside the permitted range".into(),
        ));
    }
    Ok(amount)
}
pub fn money(value: &str) -> Result<i128, Error> {
    scaled(value, 2, 999_999_999_999_999_999, false)
}
pub fn nonnegative_money(value: &str) -> Result<i128, Error> {
    scaled(value, 2, 999_999_999_999_999_999, true)
}
pub fn money_string(cents: i128) -> String {
    let sign = if cents < 0 { "-" } else { "" };
    let value = cents.unsigned_abs();
    format!("{sign}{}.{:02}", value / 100, value % 100)
}
pub fn ratio(value: &str) -> Result<i64, Error> {
    scaled(value, 4, 10_000, true).map(|n| n as i64)
}
pub fn ratio_string(value: i64) -> String {
    format!("{}.{:04}", value / 10_000, value % 10_000)
}

pub fn new_uuid() -> Result<Uuid, Error> {
    let mut bytes = [0_u8; 16];
    getrandom::fill(&mut bytes).map_err(|_| Error::Internal)?;
    bytes[6] = (bytes[6] & 0x0f) | 0x40;
    bytes[8] = (bytes[8] & 0x3f) | 0x80;
    Ok(Uuid::from_bytes(bytes))
}
pub fn canonical_hash(value: &Value) -> Result<String, Error> {
    fn ordered(value: &Value) -> Value {
        match value {
            Value::Object(map) => {
                let mut fields = map.iter().collect::<Vec<_>>();
                fields.sort_by(|a, b| a.0.cmp(b.0));
                Value::Object(
                    fields
                        .into_iter()
                        .map(|(k, v)| (k.clone(), ordered(v)))
                        .collect(),
                )
            }
            Value::Array(values) => Value::Array(values.iter().map(ordered).collect()),
            other => other.clone(),
        }
    }
    let bytes = serde_json::to_vec(&ordered(value)).map_err(|_| Error::Internal)?;
    Ok(Sha256::digest(bytes)
        .iter()
        .map(|byte| format!("{byte:02x}"))
        .collect())
}
pub fn require_uuid(value: &Value, field: &str) -> Result<Uuid, Error> {
    value
        .get(field)
        .and_then(Value::as_str)
        .and_then(|s| Uuid::parse_str(s).ok())
        .ok_or_else(|| Error::BadRequest(format!("{field} must be a UUID")))
}
pub fn expected_version(body: &Value, actual: i32, entity: &str) -> Result<(), Error> {
    if let Some(value) = body.get("expectedVersion") {
        let expected = value.as_i64().filter(|n| *n > 0).ok_or_else(|| {
            Error::BadRequest("expectedVersion must be a positive integer".into())
        })?;
        if expected != i64::from(actual) {
            return Err(Error::Conflict(format!("{entity} version mismatch")));
        }
    }
    Ok(())
}
pub async fn lock_project(connection: &mut PgConnection, id: Uuid) -> Result<(), Error> {
    let row = sqlx::query("SELECT id FROM poms.project WHERE id=$1 FOR UPDATE")
        .bind(id)
        .fetch_optional(connection)
        .await?;
    if row.is_none() {
        return Err(Error::NotFound(format!("Project {id} not found")));
    }
    Ok(())
}

pub struct ContractFact {
    pub id: Uuid,
    pub project_id: Uuid,
    pub status: String,
    pub signed_amount: String,
    pub currency_code: String,
    pub row_version: i32,
    pub current_snapshot_id: Option<Uuid>,
}
pub async fn contract_fact(
    connection: &mut PgConnection,
    id: Uuid,
    project_scope: Option<Uuid>,
    lock: bool,
) -> Result<Option<ContractFact>, Error> {
    let sql = if lock {
        "SELECT id,project_id,status,signed_amount::text AS signed_amount,currency_code,row_version,current_snapshot_id FROM poms.contract WHERE id=$1 AND ($2::uuid IS NULL OR project_id=$2) FOR UPDATE"
    } else {
        "SELECT id,project_id,status,signed_amount::text AS signed_amount,currency_code,row_version,current_snapshot_id FROM poms.contract WHERE id=$1 AND ($2::uuid IS NULL OR project_id=$2)"
    };
    let row = sqlx::query(sql)
        .bind(id)
        .bind(project_scope)
        .fetch_optional(connection)
        .await?;
    let Some(row) = row else { return Ok(None) };
    let project_id: Uuid = row.try_get("project_id")?;
    if project_scope.is_some_and(|scope| scope != project_id) {
        return Ok(None);
    }
    Ok(Some(ContractFact {
        id: row.try_get("id")?,
        project_id,
        status: row.try_get("status")?,
        signed_amount: row.try_get("signed_amount")?,
        currency_code: row.try_get("currency_code")?,
        row_version: row.try_get("row_version")?,
        current_snapshot_id: row.try_get("current_snapshot_id")?,
    }))
}

pub struct AuditWrite {
    pub operation_id: String,
    pub target_type: String,
    pub target_id: Uuid,
    pub project_id: Uuid,
    pub contract_id: Option<Uuid>,
    pub before: Option<Value>,
    pub after: Option<Value>,
    pub reason: Option<String>,
    pub metadata: Value,
}

/// Global business facts have no project/contract scope. Never fabricate an ID.
pub struct GlobalAuditWrite {
    pub operation_id: String,
    pub target_type: String,
    pub target_id: Uuid,
    pub before: Option<Value>,
    pub after: Option<Value>,
    pub reason: Option<String>,
    pub metadata: Value,
}

pub async fn audit_global(
    session: &mut CommonSession<'_, '_>,
    actor: &Actor,
    input: GlobalAuditWrite,
) -> Result<(), Error> {
    let id = new_uuid()?;
    let mut metadata = input.metadata.as_object().cloned().unwrap_or_default();
    metadata.insert("schemaVersion".into(), json!(1));
    metadata.insert("projectId".into(), Value::Null);
    metadata.insert("contractId".into(), Value::Null);
    metadata.insert("operationId".into(), json!(input.operation_id));
    sqlx::query("INSERT INTO poms.audit_log(id,event_type,target_type,target_id,operator_id,request_id,result,reason,before_snapshot,after_snapshot,metadata,occurred_at) VALUES($1,$2,$3,$4,$5,$6,'success',$7,$8,$9,$10,$11)")
        .bind(id).bind(&input.operation_id).bind(&input.target_type).bind(input.target_id.to_string()).bind(actor.id).bind(actor.request_id.as_deref())
        .bind(input.reason).bind(input.before).bind(input.after).bind(Value::Object(metadata)).bind(crate::auth::model::clock_now())
        .execute(&mut *session.connection).await?;
    session.state.trace.inserted("audit_log", &id.to_string());
    Ok(())
}
pub async fn audit(
    session: &mut CommonSession<'_, '_>,
    actor: &Actor,
    input: AuditWrite,
) -> Result<(), Error> {
    audit_identity(session, actor.id, actor.request_id.as_deref(), input).await
}
pub async fn audit_identity(
    session: &mut CommonSession<'_, '_>,
    actor_id: Uuid,
    request_id: Option<&str>,
    input: AuditWrite,
) -> Result<(), Error> {
    let id = new_uuid()?;
    let mut metadata = input.metadata.as_object().cloned().unwrap_or_default();
    metadata.insert("schemaVersion".into(), json!(1));
    metadata.insert("projectId".into(), json!(input.project_id));
    metadata.insert("contractId".into(), json!(input.contract_id));
    metadata.insert("operationId".into(), json!(input.operation_id));
    sqlx::query("INSERT INTO poms.audit_log(id,event_type,target_type,target_id,operator_id,request_id,result,reason,before_snapshot,after_snapshot,metadata,occurred_at) VALUES($1,$2,$3,$4,$5,$6,'success',$7,$8,$9,$10,$11)")
        .bind(id).bind(&input.operation_id).bind(&input.target_type).bind(input.target_id.to_string()).bind(actor_id).bind(request_id)
        .bind(input.reason).bind(input.before).bind(input.after).bind(Value::Object(metadata)).bind(crate::auth::model::clock_now())
        .execute(&mut *session.connection).await?;
    session.state.trace.inserted("audit_log", &id.to_string());
    Ok(())
}

/// Synchronize only an already-loaded immutable snapshot after a typed INSERT.
/// Never detach other identities or erase a queued change set.
pub fn refresh_identity(
    session: &mut CommonSession<'_, '_>,
    table: crate::approval_common::schema::Table,
    id: Uuid,
    fresh: crate::approval_common::js::Data,
) -> Result<(), Error> {
    use crate::approval_common::{js::get, schema::Table};
    if table != Table::ContractTerm {
        return Err(Error::Internal);
    }
    let fresh_id = get(&fresh, "id")
        .as_text()
        .and_then(|v| Uuid::parse_str(&v.to_utf8_lossy()).ok());
    if fresh_id != Some(id) {
        return Err(Error::Internal);
    }
    for entity in &mut session.state.entities {
        let same = entity.managed
            && entity.table == table
            && get(&entity.data, "id")
                .as_text()
                .and_then(|v| Uuid::parse_str(&v.to_utf8_lossy()).ok())
                == Some(id);
        if !same {
            continue;
        }
        if entity.queued || entity.original.as_ref() != Some(&entity.data) {
            return Err(Error::Conflict(
                "Cannot refresh an identity with pending changes".into(),
            ));
        }
        entity.data = fresh.clone();
        entity.original = Some(fresh.clone());
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn monetary_capacity_is_exact_and_never_silently_rounded() {
        assert_eq!(
            money("9999999999999999.99").ok(),
            Some(999_999_999_999_999_999)
        );
        assert_eq!(money(" 000001.20 ").ok(), Some(120));
        for value in [
            "0",
            "-1",
            "+1",
            "1.001",
            "1e2",
            "NaN",
            "Infinity",
            "10000000000000000",
            ".1",
            "1.",
            "1,000.00",
        ] {
            assert!(money(value).is_err(), "{value}");
        }
        assert_eq!(nonnegative_money("0").ok(), Some(0));
        assert_eq!(ratio("0.1300").ok(), Some(1300));
        assert!(ratio("0.13001").is_err());
        assert!(ratio("1.0001").is_err());
        assert_eq!(money_string(123), "1.23");
    }
    #[test]
    fn canonical_hash_sorts_objects_and_preserves_ordered_arrays() {
        assert_eq!(
            canonical_hash(&json!({"b":2,"a":1})).ok(),
            canonical_hash(&json!({"a":1,"b":2})).ok()
        );
        assert_ne!(
            canonical_hash(&json!([1, 2])).ok(),
            canonical_hash(&json!([2, 1])).ok()
        );
    }
}

ee4061851330586758a3c5a7bf419e7aba187d27 blob 26951
//! Finite request-schema interpreter for the reviewed shared 37+30 closure.
//! Generated input combines current OpenAPI with statically admitted Shared
//! trim/default/refine rules. No Node runtime, database or transaction access.
use std::collections::BTreeSet;
use std::sync::OnceLock;

use axum::http::StatusCode;
use chrono::NaiveDate;
use serde_json::{Map, Number, Value, json};
use uuid::Uuid;

use crate::error::ApiError;

const INPUT: &str = include_str!("../../../../tools/rust-r4def/validation-input18.json");

fn manifest() -> Result<&'static Value, ApiError> {
    static PARSED: OnceLock<Option<Value>> = OnceLock::new();
    let input = PARSED
        .get_or_init(|| serde_json::from_str(INPUT).ok())
        .as_ref()
        .ok_or_else(ApiError::internal)?;
    if input.get("version").and_then(Value::as_u64) != Some(1)
        || input.get("operationCount").and_then(Value::as_u64) != Some(67)
    {
        return Err(ApiError::internal());
    }
    Ok(input)
}

fn failure(errors: Vec<Value>) -> ApiError {
    ApiError::object(
        StatusCode::BAD_REQUEST,
        json!({"statusCode":400,"message":"Validation failed","errors":errors}),
    )
}

fn kind(input: Option<&Value>) -> &'static str {
    match input {
        None => "undefined",
        Some(Value::Null) => "null",
        Some(Value::Bool(_)) => "boolean",
        Some(Value::Number(_)) => "number",
        Some(Value::String(_)) => "string",
        Some(Value::Array(_)) => "array",
        Some(Value::Object(_)) => "object",
    }
}

fn invalid_type(expected: &str, input: Option<&Value>, path: &[Value]) -> Value {
    json!({"expected":expected,"code":"invalid_type","path":path,
        "message":format!("Invalid input: expected {expected}, received {}",kind(input))})
}

fn custom(path: &[Value], message: &str) -> Value {
    json!({"code":"custom","path":path,"message":message})
}

fn trim_js(value: &str) -> &str {
    value.trim_matches(|character| {
        matches!(character,
        '\u{0009}'..='\u{000d}' | '\u{0020}' | '\u{00a0}' | '\u{1680}' |
        '\u{2000}'..='\u{200a}' | '\u{2028}' | '\u{2029}' | '\u{202f}' |
        '\u{205f}' | '\u{3000}' | '\u{feff}')
    })
}

fn bounded_decimal(value: &str, signed: bool, whole_limit: usize, scale: usize) -> bool {
    let value = if signed {
        value.strip_prefix('-').unwrap_or(value)
    } else {
        value
    };
    let (whole, fraction) = value
        .split_once('.')
        .map_or((value, None), |(whole, fraction)| (whole, Some(fraction)));
    !whole.is_empty()
        && whole.len() <= whole_limit
        && whole.bytes().all(|b| b.is_ascii_digit())
        && fraction.is_none_or(|fraction| {
            !fraction.is_empty()
                && fraction.len() <= scale
                && fraction.bytes().all(|b| b.is_ascii_digit())
        })
}

fn finite_pattern(kind: &str, value: &str) -> Option<bool> {
    Some(match kind {
        "currency-code" => value.len() == 3 && value.bytes().all(|b| b.is_ascii_uppercase()),
        "sha256" => {
            value.len() == 64
                && value
                    .bytes()
                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
        }
        "dictionary-code" => {
            value.bytes().next().is_some_and(|b| b.is_ascii_lowercase())
                && value
                    .bytes()
                    .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
        }
        "weight-six" => bounded_decimal(value, false, 12, 6),
        "bounded-money" => bounded_decimal(value, false, 16, 2),
        "signed-bounded-money" => bounded_decimal(value, true, 16, 2),
        _ => return None,
    })
}

fn valid_date(value: &str) -> bool {
    let bytes = value.as_bytes();
    bytes.len() == 10
        && bytes[4] == b'-'
        && bytes[7] == b'-'
        && bytes
            .iter()
            .enumerate()
            .all(|(index, byte)| [4, 7].contains(&index) || byte.is_ascii_digit())
        && NaiveDate::parse_from_str(value, "%Y-%m-%d").is_ok()
}

fn valid_datetime(value: &str) -> bool {
    let bytes = value.as_bytes();
    if bytes.len() < 20
        || !value.ends_with('Z')
        || bytes[10] != b'T'
        || bytes[13] != b':'
        || bytes[16] != b':'
        || !valid_date(&value[..10])
        || ![11, 12, 14, 15, 17, 18]
            .iter()
            .all(|index| bytes[*index].is_ascii_digit())
        || &bytes[11..13] > b"23".as_slice()
        || &bytes[14..16] > b"59".as_slice()
        || &bytes[17..19] > b"59".as_slice()
    {
        return false;
    }
    if bytes.len() != 20
        && (bytes[19] != b'.'
            || bytes.len() < 22
            || !bytes[20..bytes.len() - 1].iter().all(u8::is_ascii_digit))
    {
        return false;
    }
    // The admitted Shared regex permits arbitrary fractional precision. The
    // Gregorian/date and all time bytes are already checked; do not impose a
    // timestamp parser's storage precision on this request string.
    true
}

fn uuid(value: &str) -> Option<Uuid> {
    let bytes = value.as_bytes();
    if bytes.len() != 36
        || !bytes.iter().enumerate().all(|(index, byte)| {
            if [8, 13, 18, 23].contains(&index) {
                *byte == b'-'
            } else {
                byte.is_ascii_hexdigit()
            }
        })
    {
        return None;
    }
    let id = Uuid::parse_str(value).ok()?;
    if id.is_nil() || value == "ffffffff-ffff-ffff-ffff-ffffffffffff" {
        return Some(id);
    }
    ((b'1'..=b'8').contains(&bytes[14])
        && matches!(bytes[19], b'8' | b'9' | b'a' | b'A' | b'b' | b'B'))
    .then_some(id)
}

fn bound_issue(origin: &str, small: bool, bound: &Value, inclusive: bool, path: &[Value]) -> Value {
    let code = if small { "too_small" } else { "too_big" };
    let relation = match (small, inclusive) {
        (true, true) => ">=",
        (true, false) => ">",
        (false, true) => "<=",
        (false, false) => "<",
    };
    let description = match origin {
        "string" => format!("string to have {relation}{bound} characters"),
        "array" => format!("array to have {relation}{bound} items"),
        _ => format!("number to be {relation}{bound}"),
    };
    let mut result = json!({"origin":origin,"code":code,"inclusive":inclusive,"path":path,
        "message":format!("{}: expected {description}",if small {"Too small"} else {"Too big"})});
    result[if small { "minimum" } else { "maximum" }] = bound.clone();
    result
}

fn length_bounds(
    schema: &Value,
    length: usize,
    origin: &str,
    min: &str,
    max: &str,
    path: &[Value],
    errors: &mut Vec<Value>,
) {
    if let Some(bound) = schema.get(min).and_then(Value::as_u64)
        && (length as u128) < u128::from(bound)
    {
        errors.push(bound_issue(origin, true, &json!(bound), true, path));
    }
    if let Some(bound) = schema.get(max).and_then(Value::as_u64)
        && (length as u128) > u128::from(bound)
    {
        errors.push(bound_issue(origin, false, &json!(bound), true, path));
    }
}

fn merge(left: &mut Value, right: Value) {
    match (left, right) {
        (Value::Object(left), Value::Object(right)) => left.extend(right),
        (left, right) => *left = right,
    }
}

fn walk(
    schema: &Value,
    input: Option<&Value>,
    required: bool,
    path: &[Value],
    depth: usize,
    schemas: &Value,
    errors: &mut Vec<Value>,
) -> Result<Option<Value>, ApiError> {
    if depth > 64 {
        return Err(ApiError::internal());
    }
    if let Some(reference) = schema.get("$ref").and_then(Value::as_str) {
        let name = reference
            .strip_prefix("#/components/schemas/")
            .ok_or_else(ApiError::internal)?;
        let target = schemas.get(name).ok_or_else(ApiError::internal)?;
        let mut resolved = target.as_object().cloned().ok_or_else(ApiError::internal)?;
        for (key, value) in schema.as_object().ok_or_else(ApiError::internal)? {
            if key != "$ref" {
                resolved.insert(key.clone(), value.clone());
            }
        }
        return walk(
            &Value::Object(resolved),
            input,
            required,
            path,
            depth + 1,
            schemas,
            errors,
        );
    }
    let default;
    let input = if input.is_none() {
        if let Some(value) = schema.get("default") {
            default = value.clone();
            Some(&default)
        } else if !required {
            return Ok(None);
        } else {
            None
        }
    } else {
        input
    };
    if input.is_some_and(Value::is_null)
        && (schema.get("nullable") == Some(&Value::Bool(true))
            || schema.get("type") == Some(&json!("null"))
            || schema
                .get("type")
                .and_then(Value::as_array)
                .is_some_and(|values| values.contains(&json!("null"))))
    {
        return Ok(Some(Value::Null));
    }
    if let Some(types) = schema.get("type").and_then(Value::as_array) {
        let selected = types
            .iter()
            .filter_map(Value::as_str)
            .find(|expected| match *expected {
                "integer" => input
                    .and_then(Value::as_f64)
                    .is_some_and(|number| number.is_finite() && number.fract() == 0.0),
                "number" => input.is_some_and(Value::is_number),
                other => other == kind(input),
            });
        let Some(selected) = selected else {
            errors.push(invalid_type(
                &types
                    .iter()
                    .filter_map(Value::as_str)
                    .collect::<Vec<_>>()
                    .join("|"),
                input,
                path,
            ));
            return Ok(input.cloned());
        };
        let mut resolved = schema.as_object().cloned().ok_or_else(ApiError::internal)?;
        resolved.insert("type".into(), json!(selected));
        return walk(
            &Value::Object(resolved),
            input,
            required,
            path,
            depth + 1,
            schemas,
            errors,
        );
    }
    for keyword in ["anyOf", "oneOf"] {
        if let Some(branches) = schema.get(keyword).and_then(Value::as_array) {
            let mut attempts = Vec::new();
            let mut successes = Vec::new();
            for branch in branches {
                let mut branch_errors = Vec::new();
                let result = walk(
                    branch,
                    input,
                    required,
                    path,
                    depth + 1,
                    schemas,
                    &mut branch_errors,
                )?;
                if branch_errors.is_empty() {
                    successes.push(result);
                } else {
                    attempts.push(branch_errors);
                }
            }
            if successes.len() == 1 || (keyword == "anyOf" && !successes.is_empty()) {
                return Ok(successes.remove(0));
            }
            errors.push(json!({"code":"invalid_union","errors":attempts,"path":path,"message":"Invalid input"}));
            return Ok(input.cloned());
        }
    }
    let combined;
    let input = if let Some(parts) = schema.get("allOf").and_then(Value::as_array) {
        let mut result = Value::Object(Map::new());
        for part in parts {
            if let Some(value) = walk(part, input, required, path, depth + 1, schemas, errors)? {
                merge(&mut result, value);
            }
        }
        combined = result;
        Some(&combined)
    } else {
        input
    };
    let expected = schema.get("type").and_then(Value::as_str);
    let output = match expected {
        Some("object") => {
            let Some(value) = input.and_then(Value::as_object) else {
                errors.push(invalid_type("object", input, path));
                return Ok(input.cloned());
            };
            let properties = schema
                .get("properties")
                .and_then(Value::as_object)
                .ok_or_else(ApiError::internal)?;
            let mut result = Map::new();
            for (key, child) in properties {
                let mut child_path = path.to_vec();
                child_path.push(json!(key));
                let required = schema
                    .get("required")
                    .and_then(Value::as_array)
                    .is_some_and(|keys| keys.contains(&json!(key)));
                if let Some(value) = walk(
                    child,
                    value.get(key),
                    required,
                    &child_path,
                    depth + 1,
                    schemas,
                    errors,
                )? {
                    result.insert(key.clone(), value);
                }
            }
            if schema.get("x-r4-strict") == Some(&Value::Bool(true)) {
                let keys = value
                    .keys()
                    .filter(|key| !properties.contains_key(*key))
                    .cloned()
                    .collect::<Vec<_>>();
                if !keys.is_empty() {
                    errors.push(json!({"code":"unrecognized_keys","keys":keys,"path":path,"message":"Unrecognized object keys"}));
                }
            }
            // Ordinary objects retain their original strip behavior; reviewed
            // strict objects reject undeclared keys above.
            Value::Object(result)
        }
        Some("array") => {
            let Some(values) = input.and_then(Value::as_array) else {
                errors.push(invalid_type("array", input, path));
                return Ok(input.cloned());
            };
            length_bounds(
                schema,
                values.len(),
                "array",
                "minItems",
                "maxItems",
                path,
                errors,
            );
            let item = schema.get("items").ok_or_else(ApiError::internal)?;
            let mut result = Vec::new();
            for (index, value) in values.iter().enumerate() {
                let mut child_path = path.to_vec();
                child_path.push(json!(index));
                result.push(
                    walk(
                        item,
                        Some(value),
                        true,
                        &child_path,
                        depth + 1,
                        schemas,
                        errors,
                    )?
                    .unwrap_or(Value::Null),
                );
            }
            Value::Array(result)
        }
        Some("string") => {
            let Some(value) = input.and_then(Value::as_str) else {
                errors.push(invalid_type("string", input, path));
                return Ok(input.cloned());
            };
            let value = if schema.get("x-r4-trim") == Some(&Value::Bool(true)) {
                trim_js(value)
            } else {
                value
            };
            length_bounds(
                schema,
                value.encode_utf16().count(),
                "string",
                "minLength",
                "maxLength",
                path,
                errors,
            );
            let mut canonical = value.to_owned();
            if let Some(format) = schema.get("format").and_then(Value::as_str) {
                let valid = match format {
                    "uuid" => match uuid(value) {
                        Some(id) => {
                            canonical = id.to_string();
                            true
                        }
                        None => false,
                    },
                    "date" => valid_date(value),
                    "date-time" => valid_datetime(value),
                    _ => return Err(ApiError::internal()),
                };
                if !valid {
                    errors.push(json!({"origin":"string","code":"invalid_format","format":format,"path":path,
                        "message":format!("Invalid {}",if format=="date-time" {"ISO datetime"} else if format=="date" {"ISO date"} else {"UUID"})}));
                }
            }
            if let Some(scalar) = schema.get("x-r4-scalar").and_then(Value::as_str) {
                let (valid, message) = match scalar {
                    "positive-money" => (
                        super::money(value).is_ok(),
                        "Expected a positive amount within numeric(18,2)",
                    ),
                    "nonnegative-money" => (
                        super::nonnegative_money(value).is_ok(),
                        "Expected a nonnegative amount within numeric(18,2)",
                    ),
                    "ratio" => (
                        super::ratio(value).is_ok(),
                        "Expected a ratio between zero and one",
                    ),
                    _ => return Err(ApiError::internal()),
                };
                if !valid {
                    errors.push(custom(path, message));
                }
            } else if let Some(kind) = schema.get("x-r4-pattern-kind").and_then(Value::as_str) {
                if !finite_pattern(kind, value).ok_or_else(ApiError::internal)? {
                    errors.push(custom(path, "Value does not match the required format"));
                }
            } else if schema.get("pattern").is_some() && schema.get("format").is_none() {
                return Err(ApiError::internal());
            }
            Value::String(canonical)
        }
        Some("integer" | "number") => {
            let Some(value) = input
                .and_then(Value::as_f64)
                .filter(|number| number.is_finite())
            else {
                errors.push(invalid_type(expected.unwrap_or("number"), input, path));
                return Ok(input.cloned());
            };
            if expected == Some("integer") && value.fract() != 0.0 {
                errors.push(invalid_type("int", input, path));
            }
            for (minimum, exclusive, small) in [
                ("minimum", "exclusiveMinimum", true),
                ("maximum", "exclusiveMaximum", false),
            ] {
                let limit = schema
                    .get(exclusive)
                    .filter(|value| value.is_number())
                    .or_else(|| schema.get(minimum));
                if let Some(bound) = limit.and_then(Value::as_f64) {
                    let exclusive = schema
                        .get(exclusive)
                        .is_some_and(|value| value == &Value::Bool(true) || value.is_number());
                    let invalid = if small {
                        if exclusive {
                            value <= bound
                        } else {
                            value < bound
                        }
                    } else if exclusive {
                        value >= bound
                    } else {
                        value > bound
                    };
                    if invalid {
                        errors.push(bound_issue(
                            "number",
                            small,
                            limit.ok_or_else(ApiError::internal)?,
                            !exclusive,
                            path,
                        ));
                    }
                }
            }
            if expected == Some("integer")
                && value.fract() == 0.0
                && value.abs() <= 9_007_199_254_740_991.0
            {
                Value::Number(Number::from(value as i64))
            } else {
                input.cloned().ok_or_else(ApiError::internal)?
            }
        }
        Some("boolean") => {
            if !input.is_some_and(Value::is_boolean) {
                errors.push(invalid_type("boolean", input, path));
            }
            input.cloned().unwrap_or(Value::Null)
        }
        Some("null") => {
            if !input.is_some_and(Value::is_null) {
                errors.push(invalid_type("null", input, path));
            }
            Value::Null
        }
        None => input.cloned().unwrap_or(Value::Null),
        _ => return Err(ApiError::internal()),
    };
    if let Some(values) = schema.get("enum").and_then(Value::as_array)
        && !values.contains(&output)
    {
        errors.push(json!({"code":"invalid_value","values":values,"path":path,"message":"Invalid option: expected one of the declared values"}));
    }
    if let Some(value) = schema.get("const")
        && value != &output
    {
        errors.push(json!({"code":"invalid_value","values":[value],"path":path,"message":"Invalid input: expected the declared literal"}));
    }
    if let Some(rule) = schema.get("x-r4-at-least-one") {
        let keys = rule
            .get("keys")
            .and_then(Value::as_array)
            .ok_or_else(ApiError::internal)?;
        if !keys
            .iter()
            .filter_map(Value::as_str)
            .any(|key| output.get(key).is_some())
        {
            errors.push(custom(
                path,
                rule.get("message")
                    .and_then(Value::as_str)
                    .ok_or_else(ApiError::internal)?,
            ));
        }
    }
    if let Some(message) = schema
        .get("x-r4-unique-contract-ids")
        .and_then(Value::as_str)
        && let Some(values) = output.as_array()
    {
        let mut identities = BTreeSet::new();
        if values
            .iter()
            .filter_map(|value| value.get("contractId").and_then(Value::as_str))
            .any(|id| !identities.insert(id.to_ascii_lowercase()))
        {
            errors.push(custom(path, message));
        }
    }
    Ok(Some(output))
}

fn operation(operation_id: &str) -> Result<(&'static Value, &'static Value), ApiError> {
    let input = manifest()?;
    Ok((
        input
            .get("operations")
            .and_then(|operations| operations.get(operation_id))
            .ok_or_else(ApiError::internal)?,
        input.get("schemas").ok_or_else(ApiError::internal)?,
    ))
}

pub fn validate_body(operation_id: &str, raw: Option<&str>) -> Result<Value, ApiError> {
    let (operation, schemas) = operation(operation_id)?;
    let schema = operation.get("body").ok_or_else(ApiError::internal)?;
    if schema.is_null() {
        return Ok(json!({}));
    }
    let parsed = raw
        .map(serde_json::from_str::<Value>)
        .transpose()
        .map_err(|_| failure(vec![custom(&[], "Invalid JSON body")]))?;
    let mut errors = Vec::new();
    let output = walk(
        schema,
        parsed.as_ref(),
        operation.get("bodyRequired") == Some(&Value::Bool(true)),
        &[],
        0,
        schemas,
        &mut errors,
    )?;
    if errors.is_empty() {
        Ok(output.unwrap_or_else(|| json!({})))
    } else {
        Err(failure(errors))
    }
}

pub fn validate_query(operation_id: &str, raw_query: Option<&str>) -> Result<Value, ApiError> {
    let (operation, schemas) = operation(operation_id)?;
    let mut input = Map::new();
    for (key, value) in url::form_urlencoded::parse(raw_query.unwrap_or("").as_bytes()) {
        let value = Value::String(value.into_owned());
        match input.entry(key.into_owned()) {
            serde_json::map::Entry::Vacant(entry) => {
                entry.insert(value);
            }
            serde_json::map::Entry::Occupied(mut entry) => {
                if let Value::Array(values) = entry.get_mut() {
                    values.push(value);
                } else {
                    let previous = entry.get().clone();
                    entry.insert(Value::Array(vec![previous, value]));
                }
            }
        }
    }
    let mut errors = Vec::new();
    let output = walk(
        operation.get("query").ok_or_else(ApiError::internal)?,
        Some(&Value::Object(input)),
        true,
        &[],
        0,
        schemas,
        &mut errors,
    )?;
    if errors.is_empty() {
        Ok(output.unwrap_or_else(|| json!({})))
    } else {
        Err(failure(errors))
    }
}

#[cfg(test)]
mod tests {
    use super::{finite_pattern, validate_body};
    use serde_json::json;

    #[test]
    fn reviewed_pattern_boundaries_reject_exponents_signs_and_excess_scale() {
        assert_eq!(finite_pattern("currency-code", "CNY"), Some(true));
        assert_eq!(finite_pattern("currency-code", "cny"), Some(false));
        assert_eq!(finite_pattern("currency-code", "CN¥"), Some(false));
        assert_eq!(
            finite_pattern("weight-six", "999999999999.999999"),
            Some(true)
        );
        for value in ["1000000000000", "1.0000001", "1e3", "+1", " 1", "1.", "-1"] {
            assert_eq!(finite_pattern("weight-six", value), Some(false));
        }
        assert_eq!(
            finite_pattern("bounded-money", "9999999999999999.99"),
            Some(true)
        );
        assert_eq!(
            finite_pattern("bounded-money", "10000000000000000"),
            Some(false)
        );
        assert_eq!(
            finite_pattern("signed-bounded-money", "-9999999999999999.99"),
            Some(true)
        );
        assert_eq!(finite_pattern("signed-bounded-money", "-"), Some(false));
        assert_eq!(
            finite_pattern("dictionary-code", "travel-cost-2"),
            Some(true)
        );
        assert_eq!(finite_pattern("dictionary-code", "_travel"), Some(false));
    }

    #[test]
    fn self_confirmation_cannot_smuggle_an_actor_or_responsibility_override() {
        let base = json!({
            "summarySnapshotId":"00000000-0000-0000-0000-000000000000",
            "handoverBasisSnapshotId":"00000000-0000-0000-0000-000000000000",
            "expectedConfirmationVersion":1
        });
        let operation = "ProjectHandoverController_confirmProjectHandoverParticipant";
        assert!(validate_body(operation, Some(&base.to_string())).is_ok());
        for key in ["actorId", "userId", "responsibilities", "participantStatus"] {
            let mut body = base.clone();
            body[key] = json!("untrusted");
            assert!(validate_body(operation, Some(&body.to_string())).is_err());
        }
    }

    #[test]
    fn currency_only_invoice_correction_is_admitted_but_version_only_is_not() {
        let operation = "ContractFinanceController_updateInvoice";
        assert!(
            validate_body(
                operation,
                Some(r#"{"currencyCode":"CNY","expectedVersion":1}"#)
            )
            .is_ok()
        );
        assert!(validate_body(operation, Some(r#"{"expectedVersion":1}"#)).is_err());
        assert!(validate_body(operation, Some(r#"{"currencyCode":"cny"}"#)).is_err());
    }
}


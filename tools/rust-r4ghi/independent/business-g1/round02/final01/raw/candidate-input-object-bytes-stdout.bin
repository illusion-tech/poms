        "targetDto": "ConfirmReceiptRecordRequest in target-dto.schema.json, mandatory expectedVersion",
        "confirm": "pending-confirmation only; exact selected real same-contract activated terms + currency evidence + expected versions; derive cents_net=HALF_UP(gross_cents*10000/(10000+rate4)), tax=gross-net; insert immutable basis and CAS receipt confirmed in caller outerTX with audit/auth",
        "historicalCertification": "mode certify-existing-basis requires status confirmed and no existing basis; explicit original same-contract terms/currency evidence, actor/reason/evidence refs, scoped attachment/activation validation; do not change receiptAmount/date/status/confirmedAt/confirmedBy. CAS receipt row_version+1, append basis+create audit atomically. No infer-from-current-rate, no zero backfill.",
        "snapshotSelection": "UI default can nominate uniquely proven receipt-date effective snapshot. Otherwise operator must explicitly select actual previously activated terms and documentary evidence; server verifies identity/version/hash and actual approval lineage, never chooses latest/current silently. A legacy term missing tax/currency authority cannot be repaired by guessing in this command.",
        "currency": "Certified activation commercial baseline currency plus same-contract immutable-after-draft currency check; optional new term snapshot currency_code frozen by actual activation for future rows. Legacy rows remain null unless same-command explicit source evidence proves it, never migration mass backfill.",
        "immutable": "Single basis per receipt for this slice. Existing basis re-rate/correction needs a separately authorized correction semantic; reject instead of replacing current-rate basis. Historical operating contexts remain unknown until explicit new restatement consumes basis; no old context backfill."
      }
    },
    {
      "area": "B",
      "operationId": "existing contract term activation producer",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "On true activation freeze term.currency_code from actual linked CommercialReleaseBaseline and hash it. Legacy NULL remains NULL; no guessed current/latest tax/currency. Actual immutable term or actual commercial baseline rowVersion is currency authority; no fake ProjectHandoverContractBasis version."
    },
    {
      "area": "E/F",
      "operationId": "existing labor/source/stage/tax/allocation replacements",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": {
        "persistence": "Append project_cost_inclusion_decision + CAS project_cost_inclusion_head. Per-snapshot operating_snapshot_cost_member immutable; copying same actual decision into later snapshot does not reinclude or reprice it.",
        "directProducer": "UPDATE project_actual_cost_record SET record_status='included',is_included_in_project_cost=true,included_at=now(),included_by=actor,row_version=row_version+1 WHERE id=... AND row_version=expected AND record_status='confirmed' AND NOT is_included_in_project_cost RETURNING ...; exactly one row, after real qualification.",
        "includedMeaning": "Sticky consumed-ever fact; never reset flag/status to confirmed merely to bypass E/F guards. Live inclusion head can only change through explicit restatement when previously published inclusion changes. Replaced old record remains historical flag=true,status=replaced; original membership never changes.",
        "sharedProducer": "Do not flip confirmed shared pool source to included as full direct cost. CAS actual F result is_included_in_project_cost=true/included_at/by and increment result row_version, record causal metadata transition; membership consumes only result project share.",
        "exclusion": "Unconsumed candidate exclude creates reasoned classification only, no included cost flag; explicit registered/no-stage exclusion is pending/not-yet-applicable and H retains gap. New source candidates cannot disappear from exhaustive scope.",
        "ordinaryReplacement": "E direct labor replace, F stage/tax/whole-allocation replace and C source mutation must check actual consumed membership; normal paths return 409 operating_restatement_required if changing a consumed factual component. No fake reset/uninclude.",
        "restatementReplacement": "Existing operating-restatements handles live or period roots. Sealed internal RestatementPermit is produced only after true referenced snapshots/source hashes/versions and full affected-project set are locked. It allows actual E labor recalculation and F complete-batch replacement using real business inputs, fresh stage/source proof, predecessor links and all necessary G/H restatements atomically. It is never a client boolean.",
        "bound": "Unsupported non-labor source correction stays blocked until its real upstream producer exists; G accepts only actual corrected source IDs/versions, never correction money. Do not invent a refund/source row or certify a fixture."
      }
    },
    {
      "area": "D",
      "operationId": "ProjectHandoverController_prepareProjectHandover",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "Pre-change OwnerWrite first; verify actual approved activated contract/plan/pre-signing producer; insert stage handover or true handover requalification + project CAS in same outerTX. Never regress execution/acceptance/terminal and never authorize from body duties."
    },
    {
      "area": "D",
      "operationId": "existing handover current/material/self-confirm/finalize/rebaseline",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "Use same exact current (no latest fallback), project-scope proof and true self-confirmation. Current scope helper never substitutes for contract/source freshness and domain admission."
    },
    {
      "area": "Project",
      "operationId": "ProjectController_create",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "currentStage omitted or literal assessment only; advanced requested stage is400, no coercion. Server createdBy=actor, initial personal owner=actor; persist true project_ownership_origin already consumed, no future reset."
    },
    {
      "area": "Lead",
      "operationId": "LeadController_convertToProject",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "Preserve actual inherited lead owner/org and actual converting creator. New immutable ownership origin freezes initial state; only genuinely org-owned/never-personal origin can be unconsumed. Real conversion scope remains required; no new authorization from body."
    },
    {
      "area": "Project",
      "operationId": "ProjectController_reassignOwner",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "Pre-change OwnerWrite or I's precise unconsumed creator bootstrap. Active target has actual target-org membership; project CAS+true reassignment row+permanent origin consumption+audit atomic. Setting owner NULL later never revives bootstrap."
    },
    {
      "area": "Project",
      "operationId": "ProjectController_getById / ProjectController_getTimeline",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "Expose projectRowVersion/currentStageRecordId and genuine stage ledger events; completion event anchored once to actual completion. Explicit touched-read scope narrowing; do not claim all old R3/ABCDEF scope fixed."
    },
    {
      "area": "H preparation query",
      "operationId": "ProjectCostController_getProjectUnifiedAccounting",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root+G/H",
      "contract": "Default without real evaluation=>typed409 OperatingEvaluationNotReadyError. Explicit view=preparation=>200 typed preparation envelope even before first snapshot; officialCurrent is explicit null or real current view. Read-only collector+pure derive; preparation cannot create facts. Intent/period/receipt/restatement IDs typed. This overload is same HTTP operation, never counted twice."
    },
    {
      "area": "Shared infrastructure",
      "operationId": "attachment upload/complete/link, auth/sensitive/audit/summary",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "Consume actual existing authority; required events and audit/auth pending flush fail entire write; sensitive GET event failure emits no protected payload. No fixtures, new permissive scope, or stand-alone commits."
    }
  ],
  "ssot": {
    "sourceContext": "source-context.schema.json",
    "collector": "G",
    "policy": "H",
    "commonModelHashLoader": "Root",
    "sourceBeforeEffect": {
      "algorithm": "contract_support::canonical_hash of this exact object, with set-like arrays sorted kind/id/rowVersion/payloadHash",
      "fields": {
        "schemaVersion": 1,
        "projectId": "real scoped project UUID",
        "intent": "baseline-activation|snapshot-create|period-close|restatement|receipt-basis",
        "projectRowVersion": "positive real version",
        "head": "{rowVersion,baselinePackageId|null,currentSnapshotId|null}",
        "businessScope": "{mode,periodKey|null,businessCutoff,restatesSnapshotRef|null,periodEndSnapshotRef|null}",
        "sourceRows": "[{sourceKind,id,rowVersion,payloadHash,currentClassificationHeadRef|null}] for complete actual source/transitive evidence set before new writes"
      },
      "exclude": [
        "financial projection modes/user identity",
        "prepare generated UUID",
        "preparedAt/transport timestamps",
        "client-proposed decisions not yet committed",
        "new snapshot/context/random IDs",
        "policy conclusions"
      ],
      "compare": "After all actual scope/source locks but before G/E/F classification or correction writes, recompute and require request expectedInputHash equality; 409 on mismatch. New client decisions have their own exact expected target/decision versions, identity/scope/evidence validation.",
      "postProducer": "Only after actual classification IDs, direct included CAS and shared-result included CAS exist, collect final immutable context and compute H sourceHash factual whitelist. External expectedInputHash and internal evaluate expected_source_hash are deliberately different authorities."
    },
    "finalSourceHash": {
      "top": [
        "schemaVersion",
        "producerVersion",
        "projectId",
        "currency",
        "scopeHash",
        "baseline",
        "contracts",
        "receipts",
        "costs",
        "allocations",
        "taxTreatments",
        "pendingFacts",
        "unclassifiedSourceRefs",
        "upstreamCostConstraints",
        "scope",
        "laborLineage"
      ],
      "snapshot": [
        "mode",
        "knowledgeCutoff",
        "sourceWindowStart",
        "sourceWindowEnd",
        "periodKey",
        "businessTimezone",
        "periodEndSnapshotRef",
        "restatesSnapshotRef",
        "restatementStatus"
      ],
      "exclude": [
        "sourceHash",
        "contextId",
        "snapshot.id",
        "snapshot.rowVersion",
        "snapshot.version",
        "snapshot.snapshotAt",
        "snapshot.supersedesSnapshotId",
        "policyVersion",
        "policyHash",
        "formalEligibility",
        "metrics",
        "all evaluation/review/generated-result identifiers",
        "snapshot.restatementRef (this command output)",
        "snapshot.restatedSnapshotRef (this snapshot result)",
        "new paired snapshot.periodEndSnapshotRef (null at capture)"
      ],
      "algorithm": "Construct exact nested whitelist object, sort set-like arrays kind/id/rowVersion/payloadHash, then contract_support::canonical_hash. No arbitrary SELECT * JSON participates. Same factual source scope has same sourceHash regardless new generated IDs.",
      "evaluationHash": "canonical_hash({sourceHash,policyVersion,policyHash,normalizedDerivedOutput,verifiedReviewOverlayHash|null}); exclude generated DMER/OSER/binding/summary IDs and wall-clock timestamps. Review overlay hash binds real actor/evidence/source and immutable review content."
    },
    "payloadAndOutputHashes": {
      "schema": "source-context.schema.json",
      "canonicalization": "Exact sourceHashFactualWhitelist supersedes broad hash wording. Shared serializer and tests Root-owned. H independently recomputes derived metric assertions; payloadHash hashes the complete stored context excluding only its self-hash field.",
      "semantics": [
        "All fields required, absent explicit null. Unknown amount value=null+nonempty reason; known amount decimal string+null reason. Proven zero needs zeroProof and exact source/scope evidence.",
        "Known gross=net+tax in cents. Receipt cashGross=amounts.gross and net/tax from frozen confirmation contract basis, never current tax rate.",
        "Missing receipt basis or included hard source/tax/stage/classification/amount evidence => formalEligibility missing-evidence and official G/H publication rejects. Legacy/preview may expose unavailable state but cannot publish certified current summaries or releasable gates.",
        "Every registered cost has one explicit validated current include/exclude classification. Duplicate canonicalAccumulationKey across invoice/payment/procurement rejects. Allocated project share uses exact F frozen cents, not recomputed rounded ratio.",
        "Empty registered scope may prove a point-in-time aggregate zero only with exhaustive collector scope hash; this does not prove mature business data. Without actual classified cost-scope evidence, maturity remains insufficient even if registered sum is zero.",
        "All-excluded validated known records can prove included sum zero; unknown or missing hard facts cannot be hidden by an implicit exclude.",
        "containsLabor=yes if any transitive lineage labor, no only if all verified nonlabor, otherwise unknown; unknown uses strongest sensitive group."
      ],
      "sourceHashFactualWhitelist": {
        "top": [
          "schemaVersion",
          "producerVersion",
          "projectId",
          "currency",
          "scopeHash",
          "baseline",
          "contracts",
          "receipts",
          "costs",
          "allocations",
          "taxTreatments",
          "pendingFacts",
          "unclassifiedSourceRefs",
          "upstreamCostConstraints",
          "scope",
          "laborLineage"
        ],
        "snapshot": [
          "mode",
          "knowledgeCutoff",
          "sourceWindowStart",
          "sourceWindowEnd",
          "periodKey",
          "businessTimezone",
          "periodEndSnapshotRef",
          "restatesSnapshotRef",
          "restatementStatus"
        ],
        "exclude": [
          "sourceHash",
          "contextId",
          "snapshot.id",
          "snapshot.rowVersion",
          "snapshot.version",
          "snapshot.snapshotAt",
          "snapshot.supersedesSnapshotId",
          "policyVersion",
          "policyHash",
          "formalEligibility",
          "metrics",
          "all evaluation/review/generated-result identifiers",
          "snapshot.restatementRef (this command output)",
          "snapshot.restatedSnapshotRef (this snapshot result)",
          "new paired snapshot.periodEndSnapshotRef (null at capture)"
        ],
        "algorithm": "Construct exact nested whitelist object, sort set-like arrays kind/id/rowVersion/payloadHash, then contract_support::canonical_hash. No arbitrary SELECT * JSON participates. Same factual source scope has same sourceHash regardless new generated IDs.",
        "evaluationHash": "canonical_hash({sourceHash,policyVersion,policyHash,normalizedDerivedOutput,verifiedReviewOverlayHash|null}); exclude generated DMER/OSER/binding/summary IDs and wall-clock timestamps. Review overlay hash binds real actor/evidence/source and immutable review content."
      },
      "preparation": "Pure derive context may use server-preallocated IDs without business persistence; preparation knowledgeCutoff is explicit, stable and included in sourceHash. H pure derive never certifies current or writes. Final formal publication reloads source assertions and rejects changed sources.",
      "excludeStageSemantics": "Cost.stageAttributionRef/attributedStage nullable only for expressing real excluded not-yet-applicable/missing stage evidence. Include requires recordStatus confirmed/included, stageEvidenceState verified and exact nonnull stage refs plus all hard layers. Registered source explicitly excluded for a permitted stage-not-ready reason remains traceable with pendingFacts(requiredForFormalAccounting=false), preserves uncertainty and cannot become mature/normal. It does not waive confirmed receipt accounting basis or hard facts of an included source.",
      "arrayOrdering": {
        "contracts": "contractRef.id",
        "receipts": "receiptRef.id",
        "costs": "canonicalAccumulationKey,recognitionRole,sourceRef.id,costRef.id-or-null; shares sorted by actual F result identity",
        "allocations": "resultRef.id",
        "taxTreatments": "taxTreatmentRef.id",
        "pendingFacts": "kind then sourceRef.id",
        "sourceRefSets": "kind,id,rowVersion,payloadHash",
        "upstreamCostConstraints": "ruleId,reasonCode,sorted basis refs",
        "approvedChangeRefs": "preserve authoritative approved delta application chain order; never reorder commutative-looking business history arbitrarily"
      },
      "costRecognitionUniqueness": {
        "canonicalAccumulationKey": "Uniqueness among included primary economic measurement shares in this project snapshot only; not among excluded support rows or historical snapshots.",
        "sourceChainKey": "Separate chain constraint: payable commitment/procurement exception principal and its payment principals cannot both be included. Multiple genuine installment paymentIds under one payable remain separate primary economic units.",
        "supportingEvidence": "Invoice/tax/evidence support rows explicitly exclude with real reason and primaryCostRef; same sourceChainKey is not a duplicate principal.",
        "allocation": "Share key includes actual F source-set hash+project/result identity. Same source full principal and corresponding project allocation share cannot be counted simultaneously; lock/validate source-set overlap, not a rounded allocation ratio.",
        "rule": "These exact rules supersede the broad earlier duplicate canonicalAccumulationKey across invoice/payment/procurement wording."
      },
      "currency": "Preparation with no proven source currency or multi-currency has currency=null (and unavailable aggregate Triple.currency=null); never CNY/UNKNOWN placeholder. Only formalEligibility eligible forces a unique evidenced three-letter currency. Different source currencies reject formal publication unless a separately frozen actual conversion policy exists (none here).",
      "sharedShare": "No fabricated ProjectActualCostRecord. allocation-share costRef/recordStatus null, sourceRef is actual F SharedCostAllocationResult, allocationResultRef/source-set hash exact. allocationSourceMembers carries real source costs/stages/governance/labor refs. Included shares require all member hard eligibility/stage evidence valid; per-source refs remain authoritative, aggregate stageEvidenceState verified only when all members qualify. Share costType=null when representing actual allocation result (never invent a unified-cost enum); members retain actual costType/businessDate. Share businessDate is actual F result effective business date under G frozen window policy, not a guessed member date.",
      "outputRefCapturePolicy": "Only upstream facts enter sourceHash. New self/result restatedSnapshotRef/restatementRef/new-paired-periodEndSnapshotRef are null at immutable capture and never backfilled; result links use SQL FK/response. Existing restatesSnapshotRef and actual existing period root remain sources."
    },
    "baselineOnly": {
      "contextTable": "operating_baseline_source",
      "forbidden": "No fake OperatingSourceContext/snapshot/H evaluation for baseline-only activation",
      "sequence": "activateOperatingBaselinePackage validates only adopted estimate/approved transition/handover provenance and freezes operating_baseline_source; it does not require receipts/cost classifications or create a fake ProjectOperatingSnapshot/H evaluation. Its sourceContextId is a baseline evidence ID, not an OperatingSourceContext row. Snapshot creation separately applies the full G/H pipeline."
    },
    "dtoSources": {
      "G": "tools/rust-r4ghi/G/final-g1/target-dto.schema.json",
      "H": "tools/rust-r4ghi/H/final-g1/dto-delta01.json",
      "I-R5": "tools/rust-r4ghi/I/final-g1/contracts.json#components"
    }
  },
  "transaction": {
    "sequence": [
      "Discover complete impacted project set without acquiring a partial set of locks; sorted project UUID locks; rediscover and restart on new scope",
      "Lock head/baseline/contract/receipt and all source-family/source/cost/F governance rows in shared deterministic order; assert all versions and expectedInputHash",
      "Apply real receipt certification/labor/allocation correction producer calls only when explicitly requested and authorized; persist explicit classifications; CAS direct cost included transition; preserve actual source-state before/after proof",
      "Allocate target snapshot/context UUIDs server-side; collect exact post-producer immutable context and sourceRows; calculate exact primary facts; H pure derive owns action/readiness",
      "Reject formalEligibility missing-evidence; write G source context/members and snapshot with final action once at captured row version 1",
      "For period: write paired period anchor with exactly same source context; for restatement: append restatement+causal links and metadata-only old terminal supersede",
      "H evaluate reloads real new context/hash/v1, recomputes/asserts final facts/action and writes DMER/OSER/four binding/summary chains; no G facts writeback",
      "CAS project_operating_head/new period terminal pointers, required business audit/security/auth coflush, one outer COMMIT; any necessary write failure rolls back all"
    ],
    "lockOrder": [
      "Guard/session/CSRF + precise route permission before domain; preserve parsed raw body numeric token provenance.",
      "Resolve only minimal true FK identity; discover complete impacted project set WITHOUT partial project locks. Lock project UUIDs ascending; rediscover all affected sources/projects; restart outer transaction if expanded.",
      "Fresh active accounts/orgs/memberships in stable UUID order FOR SHARE after project locks; verify Owner/Part/duty/condition relation; no independent pool/connection.",
      "Acquire required existing rows using lockFamilyRank: handover/scope-source rows before operating head and baseline/contract/receipt; then assignment and stage/acceptance/completion/conditions/archive. Each family stable UUID order. Shared allocation operation/basis/result/source families precede member costs. Domain validation sequences never override the common lock rank; a coordinator prelocks the full relevant plan before calling borrowed helpers.",
      "Lock E/F source/governance/stage/tax/full allocation batch + inclusion decisions/heads + affected frozen members in fixed family rank and UUID order; compare complete versions/hash + expectedInputHash BEFORE requested producer side effects.",
      "After real source/certification/classification/CAS, collect final context, pure H derive, insert G final v1 once; evaluate reload snapshot v1+finalSourceHash; insert evidence/DMER/OSER/4 bindings/reasons/summaries; advance heads atomically.",
      "Write business audit, required sensitive security event, idempotency receipt, pending authentication coflush in same CommonSession/outerTX. One COMMIT; uncertain COMMIT remains unknown, never auto-replayed as proven failure."
    ],
    "lockFamilyRank": {
      "00": "complete impacted project IDs ascending; rediscover/restart on expansion",
      "10-12": "platform_user,org_unit,user_org_membership fresh shared locks; UUID order",
      "20-25": "handover,basis,confirmation_record,confirmation_participant,duty,receipt judgment freeze (scope proof first)",
      "30-36": "operating_head,baseline,contract,term,commercial baseline,receipt,receipt accounting basis",
      "37": "all E labor rate-family advisory keys (person/role) for complete source set, sorted lexical via existing family_locks; never acquire one family per source after cost locks",
      "38": "real labor rate versions/current family rows in stable UUID order",
      "39": "actual business source rows in registered Payable->Payment->Invoice->Expense family order, stable UUIDs",
      "40-42": "assignment,assignment participants,assignment freeze payload",
      "50-55": "stage,acceptance,completion,conditions,closure,archive",
      "60-63": "shared allocation operation,basis,result,source-snapshot full batch",
      "70-73": "actual cost,cost governance,stage attribution,tax treatment",
      "80-81": "inclusion decision/head; verify all source-set/primary-chain overlaps under prior source locks",
      "90-94": "immutable context/snapshot/period/restatement/evidence; existing predecessors first, inserted rows don't invert locks",
      "100-112": "DMER,OSER,signal review,current four-stage bindings,gate review,source/review summaries,command receipt"
    },
    "lockRule": "One Root-owned rank registry used by new G/H/I and touched E/F restatement branches; within family sort stable UUIDs. Borrowed helper may reacquire already-owned rows, never lock an earlier unowned family. Final source-set discovery after global batch locks; expansion restarts outer TX, no incremental project locking.",
    "noNestedTransactions": true,
    "noGSnapshotWritebackFromManualReview": true
  },
  "policy": {
    "version": "r4h-operating-v1",
    "maturity": [
      "insufficient if necessary effective contract/confirmed receipt basis/explicit classified cost scope/factual layer missing. Ordinary review cannot change this. Official eligibility guard applies separately.",
      "preliminary if necessary evidence exists but pending/unmapped/tax/allocation/restatement uncertainty remains, even when its qualitative materiality has been reviewed.",
      "mature only complete classified known current-scope sources with no pending gaps/corrections/restatements; maturity is not risk normality."
    ],
    "formulas": [
      "grossMarginNet=confirmedReceiptNet-includedCostNet; margin ratio denominator confirmedReceiptNet",
      "zero known receipt denominator=>null rate/zero-denominator; unknown=>null/missing-evidence; immature ratios explicitly unstable",
      "low receipt ratio exact comparison confirmed gross cash/effective contract gross <0.20, same frozen currency/gross layer; no tax-layer mixing",
      "extreme margin ratio <-1 or >1; exact -1/1 not extreme by this rule. No fabricated abnormal-jump threshold."
    ],
    "risk": [
      "Auto risk/alert for proven negative margin only when known facts, mature, receipt ratio>=0.20 and receipt net>0. Independent authoritative cost BLOCK survives regardless receipt ratio.",
      "Negative observed margin at low/zero receipts or immature data => qualitative-materiality-unassessed, unknown risk/signal and explicit manual review; preserve independent cost/formula/maturity/restatement actions.",
      "Any adverse positive cost variance or pending impact with only qualitative materiality adds unassessed review. No invented amount/percentage threshold. Verified manual review classifies only exact qualitative issues normal/attention/risk, not facts or maturity.",
      "normal only complete facts and no automatic risk/attention or unresolved qualitative issues. unknown never means normal or confirmed release."
    ],
    "ruleRows": [
      {
        "id": "H01",
        "code": "missing-hard-evidence",
        "project": "review",
        "stages": {
          "first": "prompt",
          "second": "block",
          "final": "block",
          "retention": "block"
        }
      },
      {

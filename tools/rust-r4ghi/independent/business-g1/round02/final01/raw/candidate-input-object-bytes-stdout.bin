const schema = { $schema: 'https://json-schema.org/draft/2020-12/schema', title: 'G target DTO proposal; not yet shared runtime contract', $defs: defs, routes };
const sources = [
  'tools/rust-r4ghi/H/final-g1/source-context.schema.json', 'tools/rust-r4ghi/H/final-g1/proposal01.json',
  'apps/poms-api/src/app/features/project-cost/project-cost.controller.ts', 'apps/poms-api/src/app/features/project-cost/project-cost.service.ts',
  'apps/poms-api/src/app/features/project-cost/project-cost.repository.ts', 'apps/poms-api/src/app/features/project-cost/project-actual-cost-record.entity.ts',
  'apps/poms-api-rust/src/project_actual_cost/mod.rs', 'apps/poms-api-rust/src/project_cost_governance/service.rs',
  'apps/poms-api-rust/src/contract_finance/mod.rs', 'apps/poms-api-rust/src/contracts/service.rs',
  'libs/shared/contracts/src/lib/shared-contracts.ts', 'libs/api/contracts/src/lib/project-cost/project-cost.dto.ts', 'libs/shared/api-spec/openapi.json',
  'docs/design/api-route-canonical-inventory.md', 'docs/design/phase2-project-unified-accounting-view-caliber.md',
  'docs/design/phase2-cost-source-to-project-record-mapping.md', 'docs/design/phase2-estimated-to-actual-cost-bridge.md',
].map(file => { const b = fs.readFileSync(path.join(root, file)); return { file, bytes: b.length, sha256: createHash('sha256').update(b).digest('hex') }; });
for (const [file, data] of [['proposal01.json', proposal], ['target-dto.schema.json', schema], ['sources01.json', { sourceBase: 'aaa4b16ac66092f0cb1dc6646a02cf14e80823ee', expectedModel: 'gpt-6.1-sol', expectedEffort: 'max', fastMode: 'unverified', sources }]]) fs.writeFileSync(path.join(out, file), JSON.stringify(data, null, 2) + '\n', { flag: 'wx' });
const names = new Set(Object.keys(defs));
function verify(v) { if (!v || typeof v !== 'object') return; if (v.$ref) assert(names.has(v.$ref.slice('#/$defs/'.length))); for (const c of Object.values(v)) verify(c); }
verify(schema); assert.equal(routes.length, 9); assert.equal(proposal.operationBudget.batch, 32);
console.log(JSON.stringify({ status: proposal.status, operations: routes.length, schemas: names.size, sourcePins: sources.length, publicBatchProposal: 32, noNewReceiptOrPreviewRoute: true }));


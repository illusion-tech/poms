    "/api/platform/identity-provider-oauth-grants:callback": {
      "get": {
        "operationId": "IdentityProviderOAuthGrantController_handleCurrentAdminProviderGrantCallback",
        "parameters": [
          {
            "name": "code",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": true,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 4096,
              "type": "string"
            }
          },
          {
            "name": "error",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 255,
              "type": "string"
            }
          },
          {
            "name": "error_description",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 2048,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "当请求未接受 text/html 时，返回当前管理员的授权摘要 JSON。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityProviderOAuthGrantSummary"
                }
              }
            }
          },
          "302": {
            "description": "当 Accept 为 text/html 且不包含 application/json 时，浏览器授权成功或失败都会重定向回 POMS 用户管理页面。",
            "headers": {
              "Location": {
                "description": "POMS 用户管理页面；query 参数包含 identityProviderGrant 结果。",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "处理外部身份提供商搜索授权 callback",
        "tags": [
          "Identity Provider OAuth Grant"
        ]
      }
    },

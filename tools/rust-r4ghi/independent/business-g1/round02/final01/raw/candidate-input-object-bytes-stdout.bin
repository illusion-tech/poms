        currentEffectiveDecisionSummary: z.string().trim().max(1000).nullable().optional(),
        blockingReasonSummary: z.string().trim().max(1000).nullable().optional(),
        missingPrerequisiteCount: z.number().int().min(0).max(9007199254740991).optional(),
        items: z.array(ContractReadinessPackageItemInputSchema).default([]).optional(),
        createdBy: z.uuid().nullable().optional(),
        updatedBy: z.uuid().nullable().optional(),
        amendment: ContractAmendmentPreparationInputSchema.optional(),
    })
    .strict()
    .meta({ id: "CreateContractReadinessPackageRequest" });


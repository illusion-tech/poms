                            && prepared["sourceReadinessId"] == m["readinessId"]
                            && prepared["sourceBaselineId"] == m["baselineId"]
                            && m["signedAmount"] == m["amountTaxInclusive"]
                            && m["planAmount"] == m["amountTaxInclusive"]
                            && m["planCurrencyCode"] == m["currencyCode"]
                            && m["planPayloadHash"] == plan_hash
                            && [
                                "amountTaxInclusive",
                                "amountTaxExclusive",
                                "taxRate",
                                "downPaymentRate",
                                "retentionRate",
                                "retentionDueDate",
                                "paymentTerms"
                            ]
                            .iter()
                            .all(|key| prepared[*key] == m[*key])
                            && prepared["receivablePlanSeeds"] == m["snapshotSeeds"]
                    );
                    if m["integrity"] == true {
                        let source = id(&m["sourceFacts"]["cost"], "id")?;
                        let frozen = freeze_scope_risks(session, project, source).await?;
                        if frozen["sourceVersion"] != m["sourceFacts"]["cost"]["version"] {
                            m["integrity"] = json!(false);
                        } else {
                            m["handoverFacts"] = frozen;
                        }
                    }
                }
                Err(
                    Error::BadRequest(_)
                    | Error::Conflict(_)
                    | Error::CodedConflict { .. }
                    | Error::NotFound(_),
                ) => {
                    m["integrity"] = json!(false);
                }
                Err(error) => return Err(error),
            }
        } else {
            m["integrity"] = json!(false);
        }
        if !member_ready(m) {
            blockers.push(format!(
                "合同 {} 的生效快照、精确审核或正式计划来源尚未齐备。",
                m["contractId"].as_str().unwrap_or("")
            ));
        }
    }
    let pending:bool=sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM poms.contract_handover_rebaseline_record WHERE project_id=$1 AND status IN ('processing','pending-effective'))").bind(project).fetch_one(&mut *session.connection).await?;
    if pending {
        blockers.push("再基线化仍在处理中。".into());
    }
    let inherited_ids: Vec<Uuid> = inherited
        .and_then(|v| v["materials"].as_array())
        .map(|rows| {
            rows.iter()
                .filter_map(|v| id(v, "attachmentId").ok())
                .collect()
        })
        .unwrap_or_default();
    let material_sql = r#"WITH groups AS (SELECT DISTINCT a.version_group_id FROM poms.attachment a WHERE a.id=ANY($2::uuid[]) OR EXISTS(
        SELECT 1 FROM poms.attachment_link l WHERE l.attachment_id=a.id AND l.status='active' AND
        ((l.target_type='project' AND l.target_id=$1) OR (l.target_type='lead' AND l.target_id=(SELECT source_lead_id FROM poms.project WHERE id=$1))
        OR (l.target_type='contract' AND l.target_id IN (SELECT id FROM poms.contract WHERE project_id=$1))
        OR (l.target_type='sales-follow-up' AND l.target_id IN (SELECT id FROM poms.sales_follow_up_record WHERE project_id=$1 OR lead_id=(SELECT source_lead_id FROM poms.project WHERE id=$1)))))
      ) SELECT jsonb_build_object('attachmentId',a.id,'versionGroupId',a.version_group_id,
        'contentHash',a.checksum_sha256,'securityLevel',a.security_level,'status',a.status,'version',a.version_no,
        'included',a.status='active' AND a.security_level IN ('normal','internal'))
      FROM groups g JOIN LATERAL (SELECT * FROM poms.attachment a WHERE a.version_group_id=g.version_group_id
        ORDER BY (a.status='active') DESC,a.is_final DESC,a.is_latest DESC,a.version_no DESC,a.id LIMIT 1) a ON true
      ORDER BY a.version_group_id"#;
    let materials: Vec<Value> = sqlx::query_scalar(material_sql)
        .bind(project)
        .bind(&inherited_ids)
        .fetch_all(&mut *session.connection)
        .await?;
    if lock && !materials.is_empty() {
        let ids: Vec<Uuid> = materials
            .iter()
            .map(|m| id(m, "attachmentId"))
            .collect::<Result<_, _>>()?;
        sqlx::query("SELECT id FROM poms.attachment WHERE id=ANY($1) ORDER BY id FOR SHARE")
            .bind(&ids)
            .fetch_all(&mut *session.connection)
            .await?;
        let locked_materials: Vec<Value> = sqlx::query_scalar(material_sql)
            .bind(project)
            .bind(&inherited_ids)
            .fetch_all(&mut *session.connection)
            .await?;
        if locked_materials != materials {
            return Err(changed());
        }
    }
    let hash = canonical_hash(
        &json!({"projectId":project,"salesOwnerUserId":p["owner_user_id"],"members":members,"materials":materials}),
    )?;
    Ok(Sources {
        project: p,
        members,
        materials,
        blockers,
        hash,
    })
}
async fn freeze_scope_risks(
    session: &mut CommonSession<'_, '_>,
    project: Uuid,
    package: Uuid,
) -> Result<Value, Error> {
    let version: Option<i32> = sqlx::query_scalar(
        "SELECT version FROM poms.project_technical_cost_package WHERE id=$1 AND project_id=$2",
    )
    .bind(package)
    .bind(project)
    .fetch_optional(&mut *session.connection)
    .await?;
    let version = version
        .filter(|v| *v > 0)
        .ok_or_else(|| Error::Conflict("历史技术范围与风险来源不存在或不属于本项目。".into()))?;
    let scopes:Vec<Value>=sqlx::query_scalar("SELECT jsonb_build_object('id',id,'packageId',package_id,'scopeType',scope_type,'label',label,'description',description,'sortOrder',sort_order) FROM poms.project_technical_scope_item WHERE package_id=$1 ORDER BY sort_order,id").bind(package).fetch_all(&mut *session.connection).await?;
    let risks:Vec<Value>=sqlx::query_scalar("SELECT jsonb_build_object('id',id,'packageId',package_id,'riskCategory',risk_category,'riskLevel',risk_level,'riskDescription',risk_description,'impactScope',impact_scope,'mitigationPlan',mitigation_plan,'ownerRole',owner_role,'riskStatus',risk_status,'blocksNextStage',blocks_next_stage,'sortOrder',sort_order) FROM poms.project_technical_risk_item WHERE package_id=$1 ORDER BY sort_order,id").bind(package).fetch_all(&mut *session.connection).await?;
    // No cost rows, amounts, person, quantity or rate fields are copied into confirmation material.
    Ok(
        json!({"sourcePackageId":package,"sourceVersion":version,"scopeItems":scopes,"riskItems":risks,"costBaselineReference":{"id":package,"version":version}}),
    )
}
pub(super) fn member_ready(m: &Value) -> bool {
    m["integrity"] != false
        && !m["snapshotId"].is_null()
        && m["snapshotStatus"] == "active"
        && m["preparationStatus"] == "activated"
        && m["activatedSnapshotId"] == m["snapshotId"]
        && !m["payloadHash"].is_null()
        && m["payloadHash"] == m["snapshotPayloadHash"]
        && m["approvalStatus"] == "approved"
        && m["reviewPayloadHash"] == m["payloadHash"]
        && (m["diffLevel"] == "prompt"
            || (m["diffLevel"] == "review-required" && m["reviewStatus"] == "approved"))
        && !m["planVersionId"].is_null()
        && m["planSnapshotId"] == m["snapshotId"]
        && m["planPreparationId"] == m["preparationId"]
        && m["planReadinessId"] == m["readinessId"]
        && !m["initRecordId"].is_null()
        && !m["snapshotSeeds"].is_null()
        && m["snapshotSeeds"] == m["planSeeds"]
}
pub(super) async fn basis(session: &mut CommonSession<'_, '_>, h: &Value) -> Result<Value, Error> {
    if h["producer_version"] != 1 {
        return Err(Error::Conflict(
            "历史移交缺少真实生产依据，需要正式重新准备。".into(),
        ));
    }
    let v:Value=sqlx::query_scalar("SELECT to_jsonb(b) FROM poms.project_handover_basis_snapshot b WHERE id=$1 AND project_id=$2").bind(id(h,"basis_snapshot_id")?).bind(id(h,"project_id")?).fetch_optional(&mut *session.connection).await?.ok_or(Error::Internal)?;
    if canonical_hash(&v["source_payload"])? != text(&v, "payload_hash")?
        || v["source_hash"] != h["source_payload_hash"]
    {
        return Err(Error::Conflict("移交依据内容校验失败。".into()));
    }
    for (column, kind, package, target) in [
        (
            "contract_summary_snapshot_id",
            "project",
            "contract-handover-confirmation",
            id(h, "project_id")?,
        ),
        (
            "summary_snapshot_id",
            "project-handover",
            "project-handover-confirmation",
            id(h, "id")?,
        ),
    ] {
        let row:Option<Value>=sqlx::query_scalar("SELECT jsonb_build_object('payload',p.payload,'payloadHash',p.payload_hash,'sourceHash',p.source_hash,'basisId',p.basis_snapshot_id,'contractSummaryId',p.contract_summary_snapshot_id) FROM poms.project_handover_summary_payload p JOIN poms.approval_summary_snapshot s ON s.id=p.summary_snapshot_id WHERE s.id=$1 AND s.target_type=$2 AND s.target_id=$3 AND s.approval_scenario_key='handover-confirmation' AND s.summary_package_key=$4 AND s.projection_level='handover-confirmation' AND s.export_policy='handover-controlled' AND p.project_id=$5")
            .bind(id(h,column)?).bind(kind).bind(target).bind(package).bind(id(h,"project_id")?).fetch_optional(&mut *session.connection).await?;
        let row = row.ok_or_else(|| Error::Conflict("移交摘要来源链不完整。".into()))?;
        if row["basisId"] != h["basis_snapshot_id"]
            || row["payloadHash"] != v["payload_hash"]
            || row["sourceHash"] != v["source_hash"]
            || canonical_hash(&row["payload"])? != text(&v, "payload_hash")?
            || (kind == "project-handover"
                && row["contractSummaryId"] != h["contract_summary_snapshot_id"])
        {
            return Err(Error::Conflict("移交摘要来源链不一致。".into()));
        }
    }
    Ok(v)
}
pub(super) async fn fresh(
    session: &mut CommonSession<'_, '_>,
    h: &Value,
) -> Result<Sources, Error> {
    let b = basis(session, h).await?;
    let s = collect(
        session,
        id(h, "project_id")?,
        true,
        Some(&b["source_payload"]),
    )
    .await?;
    let inactive:bool=sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM poms.project_handover_participant_role r LEFT JOIN poms.platform_user u ON u.id=r.participant_user_id WHERE r.handover_id=$1 AND (u.id IS NULL OR NOT u.is_active))")
        .bind(id(h,"id")?).fetch_one(&mut *session.connection).await?;
    let mut expected = std::collections::BTreeSet::new();
    let mut people = std::collections::BTreeSet::new();
    for user in b["source_payload"]["participants"]
        .as_array()
        .ok_or(Error::Internal)?
    {
        let user_id = id(user, "userId")?;
        people.insert(user_id);
        for role in user["responsibilities"].as_array().ok_or(Error::Internal)? {
            expected.insert((
                user_id,
                text(role, "roleKey")?.to_owned(),
                text(role, "responsibilitySummary")?.trim().to_owned(),
            ));
        }
    }
    let rows:Vec<(Uuid,String,String)>=sqlx::query_as("SELECT participant_user_id,role_key,responsibility_summary FROM poms.project_handover_participant_role WHERE handover_id=$1 AND confirmation_record_id=$2 ORDER BY participant_user_id,role_key")
        .bind(id(h,"id")?).bind(id(h,"confirmation_record_id")?).fetch_all(&mut *session.connection).await?;
    let actual: std::collections::BTreeSet<_> = rows.into_iter().collect();
    let actual_people:Vec<Uuid>=sqlx::query_scalar("SELECT participant_id FROM poms.confirmation_participant WHERE confirmation_record_id=$1 ORDER BY participant_id").bind(id(h,"confirmation_record_id")?).fetch_all(&mut *session.connection).await?;
    if expected != actual
        || actual_people
            .into_iter()
            .collect::<std::collections::BTreeSet<_>>()
            != people
    {
        return Err(Error::Conflict("实际确认职责与已固定材料不一致。".into()));
    }
    let counts:Option<(i32,i32,i64)>=sqlx::query_as("SELECT required_count,confirmed_count,(SELECT count(*) FROM poms.confirmation_participant p WHERE p.confirmation_record_id=c.id AND participant_status='confirmed') FROM poms.confirmation_record c WHERE id=$1 AND target_type='project-handover' AND confirmation_type='project-handover' AND target_id=$2 AND project_id=$3 FOR UPDATE")
        .bind(id(h,"confirmation_record_id")?).bind(id(h,"id")?).bind(id(h,"project_id")?).fetch_optional(&mut *session.connection).await?;
    if counts.is_none_or(|(required, confirmed, actual)| {
        usize::try_from(required).ok() != Some(people.len()) || i64::from(confirmed) != actual
    }) {
        return Err(Error::Conflict("实际确认进度与固定参与人不一致。".into()));
    }
    if inactive || !s.blockers.is_empty() || s.hash != text(h, "source_payload_hash")? {
        return Err(changed());
    }
    Ok(s)
}
/// Historical facts for F; confirmedAt is a fact, never an invented execution interval.
pub async fn load_handover_facts_in_session(
    session: &mut CommonSession<'_, '_>,
    project: Uuid,
    as_of: Option<chrono::DateTime<chrono::Utc>>,
) -> Result<Vec<Value>, Error> {
    Ok(sqlx::query_scalar(r#"SELECT jsonb_build_object('handoverId',h.id,'projectId',h.project_id,'status',h.status,'confirmedAt',h.confirmed_at,
      'confirmedBy',h.confirmed_by,'contractSummarySnapshotId',h.contract_summary_snapshot_id,'handoverSummarySnapshotId',h.summary_snapshot_id,
      'effectiveHandoverBaselineSnapshotId',h.effective_handover_baseline_snapshot_id,'handoverBasisSnapshotId',h.basis_snapshot_id,
      'handoverRebaselineRecordId',h.handover_rebaseline_record_id,'sourcePayloadHash',h.source_payload_hash,
      'contractMembers',(SELECT jsonb_agg(jsonb_build_object('contractId',m.contract_id,'termSnapshotId',m.term_snapshot_id,'readinessId',m.readiness_package_id,'planVersionId',m.plan_version_id) ORDER BY m.contract_id) FROM poms.project_handover_contract_basis m WHERE m.basis_snapshot_id=b.id)) FROM poms.project_handover h JOIN poms.project_handover_basis_snapshot b ON b.id=h.basis_snapshot_id
      WHERE h.project_id=$1 AND h.producer_version=1 AND h.confirmed_at IS NOT NULL AND ($2::timestamptz IS NULL OR h.confirmed_at<=$2) ORDER BY h.confirmed_at,h.id"#)
      .bind(project).bind(as_of).fetch_all(&mut *session.connection).await?)
}
#[cfg(test)]
mod tests {
    use super::*;
    fn chain_fixture() -> (Value, Vec<Value>, Vec<Value>) {
        let uid = |v| Uuid::from_u128(v);
        let previous = json!({"members":[{"contractId":uid(100),"snapshotId":uid(1)},{"contractId":uid(200),"snapshotId":uid(4)}]});
        let current = vec![
            json!({"contractId":uid(100),"snapshotId":uid(3),"sourceAmendmentId":uid(12)}),
            json!({"contractId":uid(200),"snapshotId":uid(5),"sourceAmendmentId":uid(21)}),
        ];
        let row = |contract, key, before, after, version, supersedes: Option<Uuid>| json!({"id":uid(key),"contract_id":uid(contract),"before_snapshot_id":uid(before),"after_snapshot_id":uid(after),"before_version":version,"after_version":version+1,"supersedes_id":supersedes,"status":"superseded","verified":true,"source_preparation_id":uid(key+1000),"source_review_id":uid(key+2000),"payload_hash":"frozen"});
        let rows = vec![
            row(100, 11, 1, 2, 1, None),
            row(100, 12, 2, 3, 2, Some(uid(11))),
            row(200, 21, 4, 5, 1, None),
        ];
        (previous, current, rows)
    }
    #[test]
    fn rebaseline_traces_every_changed_contract() {
        let (previous, current, rows) = chain_fixture();
        let chains = trace_amendment_chains(&previous, &current, &rows).unwrap();
        assert_eq!(chains.len(), 2);
        assert_eq!(chains[0]["amendments"].as_array().unwrap().len(), 2);
        assert_eq!(chains[1]["amendments"].as_array().unwrap().len(), 1);
    }
    #[test]
    fn rebaseline_retains_two_successive_activations_in_order() {
        let (previous, current, rows) = chain_fixture();
        let chains = trace_amendment_chains(&previous, &current, &rows).unwrap();
        assert_eq!(
            chains[0]["amendments"][0]["contractAmendmentId"],
            json!(Uuid::from_u128(11))
        );
        assert_eq!(
            chains[0]["amendments"][1]["contractAmendmentId"],
            json!(Uuid::from_u128(12))
        );
    }
    #[test]
    fn rebaseline_rejects_missing_mismatched_or_branched_history() {
        let (previous, current, mut rows) = chain_fixture();
        assert!(trace_amendment_chains(&previous, &current, &rows[1..]).is_err());
        rows[0]["contract_id"] = json!(Uuid::from_u128(999));
        assert!(trace_amendment_chains(&previous, &current, &rows).is_err());
        let (previous, current, mut rows) = chain_fixture();
        rows.push(rows[0].clone());
        assert!(trace_amendment_chains(&previous, &current, &rows).is_err());
        rows.pop();
        rows[0]["verified"] = json!(false);
        assert!(trace_amendment_chains(&previous, &current, &rows).is_err());
    }
    #[test]
    fn existing_contract_snapshot_changes_require_rebaseline_but_new_contracts_can_be_prepared() {
        let previous = json!({"members":[{"contractId":"a","snapshotId":"a1"}]});
        assert!(!contract_changed(
            &previous,
            &[
                json!({"contractId":"a","snapshotId":"a1"}),
                json!({"contractId":"b","snapshotId":"b1"})
            ]
        ));
        assert!(contract_changed(
            &previous,
            &[json!({"contractId":"a","snapshotId":"a2"})]
        ));
        assert!(contract_changed(
            &previous,
            &[json!({"contractId":"b","snapshotId":"b1"})]
        ));
    }
    #[test]
    fn readiness_requires_exact_formal_plan_not_any_same_contract_plan() {
        let m = json!({"snapshotId":"s","snapshotStatus":"active","preparationStatus":"activated","activatedSnapshotId":"s","payloadHash":"h","snapshotPayloadHash":"h","approvalStatus":"approved","reviewPayloadHash":"h","diffLevel":"prompt","planVersionId":"p","planSnapshotId":"other","planPreparationId":"prep","preparationId":"prep","planReadinessId":"r","readinessId":"r","initRecordId":"i"});
        assert!(!member_ready(&m));
        let mut exact = m;
        exact["planSnapshotId"] = json!("s");
        exact["snapshotSeeds"] = json!([{"nodeKey":"one","plannedAmount":"10.00"}]);
        exact["planSeeds"] = exact["snapshotSeeds"].clone();
        assert!(member_ready(&exact));
        exact["planSeeds"][0]["plannedAmount"] = json!("11.00");
        assert!(!member_ready(&exact));
    }
}

e175377a47c6925e13aed0f33ca9cd0a07324155 blob 32780
//! Six original project operations, consuming the real customer service and
//! the existing request-local authentication and audit infrastructure.

use std::{collections::BTreeMap, error::Error, fmt, sync::Arc};

use chrono::{DateTime, Utc};
use serde_json::{Value, json};
use sqlx::Connection;
use uuid::Uuid;

use super::{
    model::{
        CreateProject, ProjectListQuery, ReassignProjectOwner, UpdateProject, Wire, js, trim_js,
    },
    store::{self, ProjectRow},
};
use crate::{
    auth::{
        guards::RequestMetadata,
        js_json::JsString,
        model::{ResolvedSession, SessionFlush, UserReadSnapshot, clock_now},
        projection::{
            self, ProjectionInput, ProjectionRequestContext, ProjectionUser, StringField,
        },
        service::AuthService,
        store::flush_managed_session,
    },
    business_numbers::{BusinessNumberScope, BusinessNumberService},
    compat::{json::Field, scalars::js_iso_string},
    customers::service::{CustomersError, CustomersService},
    database::{Database, DbError},
    error::ApiError,
    shared::generated::{ProjectStage, SensitiveFieldPackageKey},
};
use axum::http::StatusCode;

#[derive(Debug)]
pub enum ProjectsError {
    NotFound(String),
    BadRequest(String),
    Conflict(String),
    Customer(CustomersError),
    Database(DbError),
    Internal,
}

impl ProjectsError {
    pub fn into_api_error(self) -> ApiError {
        match self {
            Self::NotFound(message) => ApiError::message(StatusCode::NOT_FOUND, message),
            Self::BadRequest(message) => ApiError::message(StatusCode::BAD_REQUEST, message),
            Self::Conflict(message) => ApiError::message(StatusCode::CONFLICT, message),
            Self::Customer(error) => error.into_api_error(),
            Self::Database(_) | Self::Internal => ApiError::internal(),
        }
    }
}

impl fmt::Display for ProjectsError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.write_str("project operation failed")
    }
}
impl Error for ProjectsError {}
impl From<DbError> for ProjectsError {
    fn from(error: DbError) -> Self {
        Self::Database(error)
    }
}
impl From<CustomersError> for ProjectsError {
    fn from(error: CustomersError) -> Self {
        Self::Customer(error)
    }
}

#[derive(Clone)]
pub struct ProjectsService {
    database: Database,
    customers: Arc<CustomersService>,
    auth: Arc<AuthService>,
}

impl ProjectsService {
    pub fn new(
        database: Database,
        customers: Arc<CustomersService>,
        auth: Arc<AuthService>,
    ) -> Self {
        Self {
            database,
            customers,
            auth,
        }
    }

    pub async fn create(
        &self,
        input: CreateProject,
        session: &ResolvedSession,
    ) -> Result<Wire, ProjectsError> {
        let CreateProject {
            project_name,
            customer_id,
            customer_project_no,
            current_stage,
            planned_sign_at,
        } = input;
        // Preserve source preflight before BEGIN; this is A's actual internal
        // customer producer contract, not a duplicate customer SQL predicate.
        let operator = self
            .require_user(&session.user.user_id.to_string(), session)
            .await?;
        let customer = self.customers.require_active_customer(&customer_id).await?;
        let customer_project_no = match customer_project_no {
            Field::Value(value) => {
                let value = trim_js(value);
                (!value.is_empty()).then_some(value)
            }
            Field::Missing | Field::Null => None,
        };
        let mut original_text = BTreeMap::from([("projectName".into(), project_name.clone())]);
        if let Some(value) = customer_project_no.as_ref() {
            original_text.insert("customerProjectNo".into(), value.clone());
        }
        let planned_sign_at = match planned_sign_at {
            Field::Value(value) => Some(value),
            Field::Missing | Field::Null => None,
        };
        let numbers = BusinessNumberService::new(self.database.clone());
        let pending = session.pending_flush.clone();
        let project = self
            .database
            .with_connection(move |connection| {
                Box::pin(async move {
                    let mut transaction = connection.begin().await?;
                    let result: Result<ProjectRow, sqlx::Error> = async {
                        // Native oracle02 and the independently accepted corrective:
                        // BEGIN(business), NEXT(independent physical connection), then
                        // project INSERT and pending-session UPDATE. A business failure
                        // rolls back the row/session but keeps the committed number.
                        let project_no = numbers
                            .next(BusinessNumberScope::Project, None)
                            .await
                            .map_err(|_| {
                                sqlx::Error::Protocol("project number persistence failed".into())
                            })?;
                        let now = clock_now();
                        let project = store::insert(
                            &mut transaction,
                            &store::NewProject {
                                project_no,
                                project_name: project_name.to_utf8_lossy(),
                                customer_id: customer.id,
                                customer_name: customer.display_name,
                                customer_project_no: customer_project_no
                                    .as_ref()
                                    .map(JsString::to_utf8_lossy),
                                current_stage: current_stage
                                    .unwrap_or(ProjectStage::Assessment)
                                    .as_str()
                                    .to_owned(),
                                owner_org_id: operator.primary_org_unit_id,
                                owner_user_id: operator.id,
                                planned_sign_at,
                                created_at: now,
                                updated_at: now,
                            },
                        )
                        .await?;
                        if let Some(pending) = pending.as_ref() {
                            flush_managed_session(&mut transaction, pending).await?;
                        }
                        Ok(project)
                    }
                    .await;
                    match result {
                        Ok(project) => {
                            transaction.commit().await?;
                            Ok(project)
                        }
                        Err(error) => {
                            transaction.rollback().await?;
                            Err(error)
                        }
                    }
                })
            })
            .await?;
        raw_summary(&project, &original_text)
    }

    pub async fn list(&self, input: ProjectListQuery) -> Result<Wire, ProjectsError> {
        let projects = self
            .database
            .with_connection(move |connection| {
                Box::pin(async move { store::list(connection, &input).await })
            })
            .await?;
        let users = projects
            .iter()
            .filter_map(|row| row.owner_user_id)
            .collect::<Vec<_>>();
        let orgs = projects
            .iter()
            .filter_map(|row| row.owner_org_id)
            .collect::<Vec<_>>();
        let ids = projects.iter().map(|row| row.id).collect::<Vec<_>>();
        let (users, orgs, signed) = tokio::try_join!(
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::user_names(connection, &users).await
                })),
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::org_names(connection, &orgs).await
                })),
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::latest_signed_at(connection, &ids).await
                })),
        )?;
        let mut result = projects.iter().map(|row| {
            let milestone = [row.closed_at, signed.get(&row.id).copied()].into_iter().flatten().max();
            Ok(json!({
                "id":row.id,"projectNo":row.project_no,"projectName":row.project_name,
                "customerId":row.customer_id,"customerName":row.customer_name,"customerProjectNo":row.customer_project_no,
                "currentStage":row.current_stage,"status":row.status,
                "ownerOrgName":row.owner_org_id.and_then(|id| orgs.get(&id)),
                "ownerName":row.owner_user_id.and_then(|id| users.get(&id)),
                "latestMilestoneAt":optional_iso(milestone)?,"createdAt":iso(row.created_at)?,
            }))
        }).collect::<Result<Vec<Value>, ProjectsError>>()?;
        result.sort_by(|left, right| {
            let a = left["latestMilestoneAt"].as_str();
            let b = right["latestMilestoneAt"].as_str();
            match (a, b) {
                (Some(a), Some(b)) if a != b => b.cmp(a),
                (Some(_), None) => std::cmp::Ordering::Less,
                (None, Some(_)) => std::cmp::Ordering::Greater,
                _ => right["createdAt"].as_str().cmp(&left["createdAt"].as_str()),
            }
        });
        Ok(Wire::value(Value::Array(result)))
    }

    pub async fn lookup(&self, project_no: JsString) -> Result<Wire, ProjectsError> {
        let supplied = project_no.to_utf8_lossy();
        let query = supplied.clone();
        let project = self
            .database
            .with_connection(move |connection| {
                Box::pin(async move { store::find_by_no(connection, &query).await })
            })
            .await?
            .ok_or_else(|| ProjectsError::NotFound(format!("Project no {supplied} not found")))?;
        Ok(Wire::value(summary(&project)?))
    }

    pub async fn get(
        &self,
        id: &str,
        session: &ResolvedSession,
        metadata: &RequestMetadata,
    ) -> Result<Wire, ProjectsError> {
        let project = self.require_project(id).await?;
        let user_ids = project.owner_user_id.into_iter().collect::<Vec<_>>();
        let org_ids = project.owner_org_id.into_iter().collect::<Vec<_>>();
        let project_id = project.id;
        let lead_id = project.source_lead_id;
        let (users, orgs, contracts, snapshot, bid, lead) = tokio::try_join!(
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::user_names(connection, &user_ids).await
                })),
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::org_names(connection, &org_ids).await
                })),
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::contracts(connection, project_id).await
                })),
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::approval_snapshot(connection, project_id).await
                })),
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::current_bid(connection, project_id).await
                })),
            self.database
                .with_connection(move |connection| Box::pin(async move {
                    store::lead(connection, lead_id).await
                })),
        )?;
        let latest = contracts.first();
        let input = ProjectionInput {
            field_package_key: SensitiveFieldPackageKey::ContractFinance,
            fields: vec![StringField {
                key: "field".into(),
                raw_value: latest.map(|row| row.signed_amount.clone()),
                display_text_when_full: latest
                    .map(|row| format!("{} {}", row.signed_amount, row.currency_code)),
                masked_display_text: None,
                denied_display_text: None,
            }],
            user: Some(ProjectionUser {
                sub: session.user.user_id,
                username: session.user.username.clone(),
                permissions: session
                    .user
                    .permissions
                    .iter()
                    .map(|value| value.as_ref().to_owned())
                    .collect(),
            }),
            target_type: "project".into(),
            target_id: project.id.to_string(),
            request_context: ProjectionRequestContext {
                request_id: metadata.request_id.clone(),
                path: metadata.path.clone(),
                method: metadata.method.clone(),
                ip: metadata.info.ip.clone(),
                user_agent: metadata.info.user_agent.clone(),
            },
            mode_when_unauthorized: None,
            masked_display_text: None,
            denied_display_text: None,
        };
        let mut projected = projection::plan(&input).map_err(|_| ProjectsError::Internal)?;
        if let Some(event) = projected.event {
            self.auth
                .record_security_event_with_session(event, session.pending_flush.as_ref())
                .await
                .map_err(|_| ProjectsError::Internal)?;
        }
        let signed_amount = projected
            .fields
            .remove("field")
            .ok_or(ProjectsError::Internal)?;
        let approval = match snapshot.as_ref() {
            Some(snapshot) => {
                json!({"summarySnapshotId":snapshot.id,"summaryPackageKey":snapshot.summary_package_key,"projectionLevel":snapshot.projection_level,"exportPolicy":snapshot.export_policy,"generatedAt":iso(snapshot.generated_at)?})
            }
            None => {
                json!({"summarySnapshotId":null,"summaryPackageKey":null,"projectionLevel":null,"exportPolicy":null,"generatedAt":null})
            }
        };
        let mut result = summary(&project)?;
        let fields = result.as_object_mut().ok_or(ProjectsError::Internal)?;
        let extra = json!({
            "ownerName":project.owner_user_id.and_then(|id| users.get(&id)),
            "ownerOrgName":project.owner_org_id.and_then(|id| orgs.get(&id)),
            "sourceLeadSummary":lead.as_ref().map(|row| json!({"id":row.id,"leadNo":row.lead_no,"leadName":row.lead_name,"customerId":row.customer_id,"customerName":row.customer_name,"status":row.status})),
            "stageSummary":{"currentStage":project.current_stage,"status":project.status,"plannedSignAt":optional_iso(project.planned_sign_at)?,"closedAt":optional_iso(project.closed_at)?,"closedReason":project.closed_reason,"blockingReasons":stage_reasons(&project)},
            "currentBidSummary":bid.as_ref().map_or_else(|| json!({"bidProcessId":null,"bidStatus":"not_configured","resultStatus":null,"tenderNo":null,"bidPackageNo":null,"summary":null}), |row| json!({"bidProcessId":row.id,"bidStatus":row.current_stage,"resultStatus":row.result_status,"tenderNo":row.tender_no,"bidPackageNo":row.bid_package_no,"summary":row.process_summary})),
            "currentContractSummary":{
                "activeContractCount":contracts.iter().filter(|row| row.status == "active").count(),
                "latestContractId":latest.map(|row| row.id),"latestContractNo":latest.map(|row| &row.contract_no),"latestContractStatus":latest.map(|row| &row.status),
                "signedAmountProjection":signed_amount,"currencyCode":latest.map(|row| &row.currency_code),
                "signedAt":optional_iso(latest.and_then(|row| row.signed_at))?,"currentSnapshotId":latest.and_then(|row| row.current_snapshot_id),
            },
            "currentApprovalSummary":approval,
            "currentConfirmationSummary":{"confirmationRecordId":null,"status":"not_configured","requiredCount":0,"confirmedCount":0,"pendingCount":0,"confirmedAt":null},
            "summarySnapshotId":snapshot.as_ref().map(|row| row.id),"projectionLevel":snapshot.as_ref().map(|row| &row.projection_level),"exportPolicy":snapshot.as_ref().map(|row| &row.export_policy),
            "allowedActions":allowed_actions(&project, session),"generatedAt":iso(clock_now())?,
        });
        fields.extend(extra.as_object().ok_or(ProjectsError::Internal)?.clone());
        Ok(Wire::value(result))
    }

    pub async fn update(
        &self,
        id: &str,
        input: UpdateProject,
        session: &ResolvedSession,
    ) -> Result<Wire, ProjectsError> {
        let mut project = self.require_project(id).await?;
        if !editable(&project) {
            return Err(ProjectsError::BadRequest(format!(
                "Project {id} cannot be edited in status {}",
                project.status
            )));
        }
        let mut changes = store::ProjectUpdate::default();
        let mut original_text = BTreeMap::new();
        if let Some(value) = input.project_name {
            if js(&project.project_name) != value {
                changes.project_name = Some(value.to_utf8_lossy());
            }
            project.project_name = value.to_utf8_lossy();
            original_text.insert("projectName".into(), value);
        }
        // Native witness01 name+missing customer retains its original DB row:
        // the preceding managed name assignment does not auto-flush here.
        if let Some(id) = input.customer_id {
            let customer = self.customers.require_active_customer(&id).await?;
            if project.customer_id != Some(customer.id) {
                changes.customer_id = Some(Some(customer.id));
            }
            if project.customer_name.as_ref() != Some(&customer.display_name) {
                changes.customer_name = Some(Some(customer.display_name.clone()));
            }
            project.customer_id = Some(customer.id);
            project.customer_name = Some(customer.display_name);
        }
        match input.customer_project_no {
            Field::Missing => {}
            Field::Null => {
                if project.customer_project_no.is_some() {
                    changes.customer_project_no = Some(None);
                }
                project.customer_project_no = None;
            }
            Field::Value(value) => {
                let value = trim_js(value);
                let value = (!value.is_empty()).then_some(value);
                if project.customer_project_no.as_ref().map(|value| js(value)) != value {
                    changes.customer_project_no = Some(value.as_ref().map(JsString::to_utf8_lossy));
                }
                project.customer_project_no = value.as_ref().map(JsString::to_utf8_lossy);
                if let Some(value) = value {
                    original_text.insert("customerProjectNo".into(), value);
                }
            }
        }
        match input.planned_sign_at {
            Field::Missing => {}
            Field::Null => {
                if project.planned_sign_at.is_some() {
                    changes.planned_sign_at = Some(None);
                }
                project.planned_sign_at = None;
            }
            Field::Value(value) => {
                if project
                    .planned_sign_at
                    .map(|value| value.timestamp_millis())
                    != Some(value.timestamp_millis())
                {
                    changes.planned_sign_at = Some(Some(value));
                }
                project.planned_sign_at = Some(value);
            }
        }
        if project.updated_by != Some(session.user.user_id) {
            changes.updated_by = Some(Some(session.user.user_id));
        }
        project.updated_by = Some(session.user.user_id);
        let dirty = changes.is_dirty();
        let at = clock_now();
        let version = self
            .flush_project(&project, changes, at, session.pending_flush.as_ref())
            .await?;
        if dirty {
            project.row_version = version;
            project.updated_at = at;
        }
        raw_summary(&project, &original_text)
    }

    pub async fn reassign(
        &self,
        id: &str,
        input: ReassignProjectOwner,
        session: &ResolvedSession,
    ) -> Result<Wire, ProjectsError> {
        let project = self.require_project(id).await?;
        if let Some(expected) = input.expected_version
            && i64::from(project.row_version) != expected
        {
            return Err(ProjectsError::Conflict(format!(
                "project version {expected} does not match current version {}",
                project.row_version
            )));
        }
        if !editable(&project) {
            return Err(ProjectsError::BadRequest(format!(
                "Project {id} cannot reassign owner in status {}",
                project.status
            )));
        }
        let target = self.require_user(&input.owner_user_id, session).await?;
        if !target.is_active {
            return Err(ProjectsError::BadRequest(format!(
                "Platform user {} is not active",
                input.owner_user_id
            )));
        }
        let next_org = match input.owner_org_id {
            Field::Missing => target.primary_org_unit_id.map(|value| value.to_string()),
            Field::Null => None,
            Field::Value(value) => Some(value),
        };
        if let Some(id) = next_org.as_ref() {
            let key = id.clone();
            let org = self
                .database
                .with_connection(move |connection| {
                    Box::pin(async move { crate::org_units::store::find(connection, &key).await })
                })
                .await?
                .ok_or_else(|| ProjectsError::NotFound(format!("Org unit {id} not found")))?;
            if !org.is_active {
                return Err(ProjectsError::BadRequest(format!(
                    "Org unit {id} is not active"
                )));
            }
        }
        // Keep original strict string identity, including valid uppercase input.
        let previous_user = project.owner_user_id.map(|value| value.to_string());
        let previous_org = project.owner_org_id.map(|value| value.to_string());
        if previous_user.as_deref() == Some(input.owner_user_id.as_str())
            && previous_org == next_org
        {
            return Err(ProjectsError::BadRequest(format!(
                "Project {id} already has the requested owner"
            )));
        }
        let owner_id =
            Uuid::parse_str(&input.owner_user_id).map_err(|_| ProjectsError::Internal)?;
        let org_id = next_org
            .as_ref()
            .map(|value| Uuid::parse_str(value))
            .transpose()
            .map_err(|_| ProjectsError::Internal)?;
        let record_id = random_uuid()?;
        let record = store::OwnerReassignmentRecord {
            id: record_id,
            project_id: project.id,
            previous_owner_org_id: project.owner_org_id,
            previous_owner_user_id: project.owner_user_id,
            new_owner_org_id: org_id,
            new_owner_user_id: owner_id,
            reason: trim_js(input.reason).to_utf8_lossy(),
            at: clock_now(),
            operator_id: session.user.user_id,
        };
        let mut changes = store::ProjectUpdate::default();
        if previous_user.as_deref() != Some(input.owner_user_id.as_str()) {
            changes.owner_user_id = Some(Some(owner_id));
        }
        if previous_org != next_org {
            changes.owner_org_id = Some(org_id);
        }
        if project.updated_by != Some(session.user.user_id) {
            changes.updated_by = Some(Some(session.user.user_id));
        }
        let pending = session.pending_flush.clone();
        let project_id = project.id;
        let version = project.row_version;
        let at = clock_now();
        self.database
            .with_connection(move |connection| {
                Box::pin(async move {
                    let mut transaction = connection.begin().await?;
                    let result: Result<(), sqlx::Error> = async {
                        // Native witness01: CREATE(history), UPDATE(managed session),
                        // UPDATE(project CAS), COMMIT. A CAS miss rolls all three back.
                        store::insert_reassignment(&mut transaction, &record).await?;
                        if let Some(pending) = pending.as_ref() {
                            flush_managed_session(&mut transaction, pending).await?;
                        }
                        if store::update(&mut transaction, project_id, version, &changes, at)
                            .await?
                            .is_none()
                        {
                            return Err(sqlx::Error::Protocol(
                                "project managed version conflict".into(),
                            ));
                        }
                        Ok(())
                    }
                    .await;
                    match result {
                        Ok(()) => {
                            transaction.commit().await?;
                            Ok(())
                        }
                        Err(error) => {
                            transaction.rollback().await?;
                            Err(error)
                        }
                    }
                })
            })
            .await?;
        Ok(Wire::value(json!({
            "targetId":project.id,"projectOwnerReassignmentRecordId":record_id,
            "previousOwnerUserId":project.owner_user_id,"previousOwnerOrgId":project.owner_org_id,
            "newOwnerUserId":input.owner_user_id,"newOwnerOrgId":next_org,"businessStatusAfter":project.status,
        })))
    }

    async fn flush_project(
        &self,
        project: &ProjectRow,
        changes: store::ProjectUpdate,
        at: DateTime<Utc>,
        pending: Option<&SessionFlush>,
    ) -> Result<i32, ProjectsError> {
        let id = project.id;
        let version = project.row_version;
        if !changes.is_dirty() && pending.is_none() {
            return Ok(version);
        }
        let pending = pending.cloned();
        Ok(self
            .database
            .with_connection(move |connection| {
                Box::pin(async move {
                    let mut transaction = connection.begin().await?;
                    let result: Result<i32, sqlx::Error> = async {
                        if let Some(pending) = pending.as_ref() {
                            flush_managed_session(&mut transaction, pending).await?;
                        }
                        if !changes.is_dirty() {
                            return Ok(version);
                        }
                        store::update(&mut transaction, id, version, &changes, at)
                            .await?
                            .ok_or_else(|| {
                                sqlx::Error::Protocol("project managed version conflict".into())
                            })
                    }
                    .await;
                    match result {
                        Ok(value) => {
                            transaction.commit().await?;
                            Ok(value)
                        }
                        Err(error) => {
                            transaction.rollback().await?;
                            Err(error)
                        }
                    }
                })
            })
            .await?)
    }

    async fn require_user(
        &self,
        id: &str,
        session: &ResolvedSession,
    ) -> Result<UserReadSnapshot, ProjectsError> {
        // Native witness01 project-create has no second user SELECT after
        // authorization: a fully initialized exact-key findOne is served by
        // this request's managed principal, including its primary organization.
        if id == session.user_snapshot.id.to_string() {
            return Ok(session.user_snapshot.clone());
        }
        let key = id.to_owned();
        let mut user = self
            .database
            .with_connection(move |connection| {
                Box::pin(async move { crate::users::store::find(connection, &key).await })
            })
            .await?
            .ok_or_else(|| ProjectsError::NotFound(format!("Platform user {id} not found")))?;
        // The existing R2D W07 identity-map witness applies to the same
        // PlatformUser findOne mapping: fresh null leaves a managed nullable
        // primary organization intact; non-null fresh values still overwrite.
        if user.id == session.user_snapshot.id && user.primary_org_unit_id.is_none() {
            user.primary_org_unit_id = session.user_snapshot.primary_org_unit_id;
        }
        Ok(user)
    }

    async fn require_project(&self, id: &str) -> Result<ProjectRow, ProjectsError> {
        let key = id.to_owned();
        self.database
            .with_connection(move |connection| {
                Box::pin(async move { store::find(connection, &key).await })
            })
            .await?
            .ok_or_else(|| ProjectsError::NotFound(format!("Project {id} not found")))
    }
}

fn iso(value: DateTime<Utc>) -> Result<String, ProjectsError> {
    js_iso_string(value).map_err(|_| ProjectsError::Internal)
}
fn optional_iso(value: Option<DateTime<Utc>>) -> Result<Option<String>, ProjectsError> {
    value.map(iso).transpose()
}
fn closed(project: &ProjectRow) -> bool {
    project.status == "closed"
        || matches!(
            project.current_stage.as_str(),
            "closed-lost" | "closed-terminated"
        )
}
fn editable(project: &ProjectRow) -> bool {
    matches!(project.status.as_str(), "active" | "blocked")
}
fn stage_reasons(project: &ProjectRow) -> Vec<&'static str> {
    let mut reasons = Vec::new();
    if project.status == "blocked" {
        reasons.push("project-status-blocked");
    }
    if closed(project) {
        reasons.push("project-closed");
    }
    reasons
}
fn allowed_actions(project: &ProjectRow, session: &ResolvedSession) -> Vec<&'static str> {
    let has = |permission: &str| {
        session
            .user
            .permissions
            .iter()
            .any(|value| value.as_ref() == permission)
    };
    let mut result = vec!["view-project-workspace"];
    if !closed(project) && has("project:write") {
        result.push("edit-project-basic-info");
    }
    if editable(project) && has("project:write") {
        result.push("reassign-project-owner");
    }
    if !closed(project)
        && matches!(
            project.current_stage.as_str(),
            "handover" | "execution" | "acceptance" | "completed"
        )
        && [
            "commission:assignments:manage",
            "commission:calculations:manage",
            "commission:payouts:manage",
            "commission:adjustments:manage",
            "commission:rule-versions:manage",
        ]
        .iter()
        .any(|value| has(value))
    {
        result.push("manage-project-commission");
    }
    result
}
fn summary(project: &ProjectRow) -> Result<Value, ProjectsError> {
    Ok(json!({
        "id":project.id,"projectNo":project.project_no,"projectName":project.project_name,"sourceLeadId":project.source_lead_id,
        "customerId":project.customer_id,"customerName":project.customer_name,"customerProjectNo":project.customer_project_no,
        "status":project.status,"currentStage":project.current_stage,"ownerOrgId":project.owner_org_id,"ownerUserId":project.owner_user_id,
        "plannedSignAt":optional_iso(project.planned_sign_at)?,"closedAt":optional_iso(project.closed_at)?,"closedReason":project.closed_reason,
        "rowVersion":project.row_version,"createdAt":iso(project.created_at)?,"createdBy":project.created_by,"updatedAt":iso(project.updated_at)?,"updatedBy":project.updated_by,
    }))
}

fn raw_summary(
    project: &ProjectRow,
    text: &BTreeMap<String, JsString>,
) -> Result<Wire, ProjectsError> {
    Ok(Wire::object(summary(project)?, text))
}

fn random_uuid() -> Result<Uuid, ProjectsError> {
    let mut bytes = [0_u8; 16];
    getrandom::fill(&mut bytes).map_err(|_| ProjectsError::Internal)?;
    bytes[6] = (bytes[6] & 0x0f) | 0x40;
    bytes[8] = (bytes[8] & 0x3f) | 0x80;
    Ok(Uuid::from_bytes(bytes))
}

73ee7ed869306d7839e361e14ccaec6f949f9c25 blob 15141
//! Project-only SQL primitives. Original migrations own all columns and DDL.
//! Read queries preserve the source predicates and its PostgreSQL NULL ordering.

use std::collections::HashMap;

use chrono::{DateTime, Utc};
use sqlx::{PgConnection, Postgres, QueryBuilder, Row, postgres::PgRow};
use uuid::Uuid;

use super::model::ProjectListQuery;

#[derive(Clone, Debug)]
pub struct ProjectRow {
    pub id: Uuid,
    pub project_no: String,
    pub project_name: String,
    pub source_lead_id: Option<Uuid>,
    pub customer_id: Option<Uuid>,
    pub customer_name: Option<String>,
    pub customer_project_no: Option<String>,
    pub status: String,
    pub current_stage: String,
    pub owner_org_id: Option<Uuid>,
    pub owner_user_id: Option<Uuid>,
    pub planned_sign_at: Option<DateTime<Utc>>,
    pub closed_at: Option<DateTime<Utc>>,
    pub closed_reason: Option<String>,
    pub row_version: i32,
    pub created_at: DateTime<Utc>,
    pub created_by: Option<Uuid>,
    pub updated_at: DateTime<Utc>,
    pub updated_by: Option<Uuid>,
}

macro_rules! project_select {
    () => {
        "SELECT id,project_no,project_name,source_lead_id,customer_id,customer_name,customer_project_no,\
         status,current_stage,owner_org_id,owner_user_id,planned_sign_at,closed_at,closed_reason,\
         row_version,created_at,created_by,updated_at,updated_by FROM poms.project "
    };
}

fn project(row: PgRow) -> Result<ProjectRow, sqlx::Error> {
    Ok(ProjectRow {
        id: row.try_get("id")?,
        project_no: row.try_get("project_no")?,
        project_name: row.try_get("project_name")?,
        source_lead_id: row.try_get("source_lead_id")?,
        customer_id: row.try_get("customer_id")?,
        customer_name: row.try_get("customer_name")?,
        customer_project_no: row.try_get("customer_project_no")?,
        status: row.try_get("status")?,
        current_stage: row.try_get("current_stage")?,
        owner_org_id: row.try_get("owner_org_id")?,
        owner_user_id: row.try_get("owner_user_id")?,
        planned_sign_at: row.try_get("planned_sign_at")?,
        closed_at: row.try_get("closed_at")?,
        closed_reason: row.try_get("closed_reason")?,
        row_version: row.try_get("row_version")?,
        created_at: row.try_get("created_at")?,
        created_by: row.try_get("created_by")?,
        updated_at: row.try_get("updated_at")?,
        updated_by: row.try_get("updated_by")?,
    })
}

pub async fn find(
    connection: &mut PgConnection,
    id: &str,
) -> Result<Option<ProjectRow>, sqlx::Error> {
    sqlx::query(concat!(
        project_select!(),
        "WHERE id=$1::text::uuid LIMIT 1"
    ))
    .bind(id)
    .fetch_optional(connection)
    .await?
    .map(project)
    .transpose()
}

pub async fn find_by_no(
    connection: &mut PgConnection,
    project_no: &str,
) -> Result<Option<ProjectRow>, sqlx::Error> {
    sqlx::query(concat!(project_select!(), "WHERE project_no=$1 LIMIT 1"))
        .bind(project_no)
        .fetch_optional(connection)
        .await?
        .map(project)
        .transpose()
}

pub async fn list(
    connection: &mut PgConnection,
    input: &ProjectListQuery,
) -> Result<Vec<ProjectRow>, sqlx::Error> {
    let mut query = QueryBuilder::<Postgres>::new(concat!(project_select!(), "WHERE TRUE"));
    if let Some(value) = input.status {
        query.push(" AND status=").push_bind(value.as_str());
    }
    if let Some(value) = input.current_stage {
        query.push(" AND current_stage=").push_bind(value.as_str());
    }
    if let Some(value) = input.owner_org_id.as_ref() {
        query
            .push(" AND owner_org_id=")
            .push_bind(value.clone())
            .push("::text::uuid");
    }
    if let Some(value) = input.keyword.as_ref() {
        let pattern = format!("%{}%", value.to_utf8_lossy());
        query
            .push(" AND (project_no ILIKE ")
            .push_bind(pattern.clone())
            .push(" OR project_name ILIKE ")
            .push_bind(pattern.clone())
            .push(" OR customer_name ILIKE ")
            .push_bind(pattern.clone())
            .push(" OR customer_project_no ILIKE ")
            .push_bind(pattern)
            .push(")");
    }
    query.push(" ORDER BY created_at DESC");
    query
        .build()
        .fetch_all(connection)
        .await?
        .into_iter()
        .map(project)
        .collect()
}

pub async fn user_names(
    connection: &mut PgConnection,
    ids: &[Uuid],
) -> Result<HashMap<Uuid, String>, sqlx::Error> {
    if ids.is_empty() {
        return Ok(HashMap::new());
    }
    sqlx::query("SELECT id,display_name FROM poms.platform_user WHERE id=ANY($1)")
        .bind(ids)
        .fetch_all(connection)
        .await?
        .into_iter()
        .map(|row| Ok((row.try_get("id")?, row.try_get("display_name")?)))
        .collect()
}

pub async fn org_names(
    connection: &mut PgConnection,
    ids: &[Uuid],
) -> Result<HashMap<Uuid, String>, sqlx::Error> {
    if ids.is_empty() {
        return Ok(HashMap::new());
    }
    sqlx::query("SELECT id,name FROM poms.org_unit WHERE id=ANY($1)")
        .bind(ids)
        .fetch_all(connection)
        .await?
        .into_iter()
        .map(|row| Ok((row.try_get("id")?, row.try_get("name")?)))
        .collect()
}

pub async fn latest_signed_at(
    connection: &mut PgConnection,
    ids: &[Uuid],
) -> Result<HashMap<Uuid, DateTime<Utc>>, sqlx::Error> {
    if ids.is_empty() {
        return Ok(HashMap::new());
    }
    let rows = sqlx::query("SELECT project_id,signed_at FROM poms.contract WHERE project_id=ANY($1) AND signed_at IS NOT NULL ORDER BY signed_at DESC,updated_at DESC")
        .bind(ids).fetch_all(connection).await?;
    let mut result = HashMap::new();
    for row in rows {
        result
            .entry(row.try_get("project_id")?)
            .or_insert(row.try_get("signed_at")?);
    }
    Ok(result)
}


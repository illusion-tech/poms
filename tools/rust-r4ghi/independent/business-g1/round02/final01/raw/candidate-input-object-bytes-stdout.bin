          }
        },
        "required": [
          "id",
          "name",
          "code",
          "description",
          "membershipType"
        ]
      },
      "UserOrgUnitMembershipType": {
        "type": "string",
        "enum": [
          "primary",
          "secondary"
        ]
      },
      "AuthSessionCsrfHint": {
        "type": "object",
        "properties": {
          "cookieName": {
            "type": "string",
            "minLength": 1
          },
          "headerName": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "cookieName",
          "headerName"
        ]
      },
      "CurrentAuthSessionView": {
        "type": "object",
        "properties": {

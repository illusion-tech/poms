  "components": {
    "schemas": {
      "LifecycleEvidenceRef": {
        "additionalProperties": false,
        "required": [
          "attachmentLinkId"
        ],
        "type": "object",
        "properties": {
          "attachmentLinkId": {
            "format": "uuid",
            "type": "string"
          }
        }
      },
      "FrozenLifecycleEvidence": {
        "additionalProperties": false,
        "required": [
          "attachmentLinkId",
          "attachmentId",
          "attachmentRowVersion",
          "checksumSha256",
          "fileName"
        ],
        "type": "object",
        "properties": {
          "attachmentId": {
            "format": "uuid",
            "type": "string"
          },
          "attachmentRowVersion": {
            "minimum": 1,
            "maximum": 2147483647,
            "type": "integer"
          },
          "checksumSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fileName": {
            "maxLength": 255,
            "minLength": 1,
            "x-trim": true,
            "type": "string"
          },
          "attachmentLinkId": {
            "format": "uuid",
            "type": "string"
          }
        }
      },
      "CommissionParticipantInput": {
        "allOf": [
          {
            "if": {
              "properties": {
                "weight": {
                  "const": 0
                }
              },
              "required": [
                "weight"
              ]
            },
            "else": {
              "properties": {
                "zeroWeightReason": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "zeroWeightReason": {
                  "maxLength": 1000,
                  "minLength": 1,
                  "x-trim": true,
                  "type": "string"
                }
              },
              "required": [
                "zeroWeightReason"
              ]
            }
          }
        ],
        "additionalProperties": false,
        "required": [
          "userId",
          "roleType",
          "weight",
          "responsibilitySummary"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "format": "uuid",
            "type": "string"
          },
          "responsibilitySummary": {
            "maxLength": 2000,
            "minLength": 1,
            "x-trim": true,
            "type": "string"
          },
          "zeroWeightReason": {
            "anyOf": [
              {
                "maxLength": 1000,
                "minLength": 1,
                "x-trim": true,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "roleType": {
            "maxLength": 64,
            "minLength": 1,
            "x-trim": true,
            "type": "string"
          },
          "weight": {
            "minimum": 0,
            "multipleOf": 1E-06,
            "maximum": 1,
            "type": "number",
            "x-exact-decimal-scale": 6
          },
          "displayName": {
            "deprecated": true,
            "type": "string",
            "description": "Accepted legacy hint only; canonical displayName is loaded server-side"
          }
        }
      },
      "CommissionParticipantRead": {
        "additionalProperties": false,
        "required": [
          "userId",
          "displayName",
          "roleType",
          "weight",
          "weightExact",
          "responsibilitySummary",
          "zeroWeightReason"
        ],
        "type": "object",
        "properties": {
          "weightExact": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0\\.[0-9]{6}|1\\.000000)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "userId": {
            "format": "uuid",
            "type": "string"
          },
          "responsibilitySummary": {

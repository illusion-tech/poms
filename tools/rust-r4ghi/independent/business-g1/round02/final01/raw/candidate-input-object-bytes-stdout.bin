          },
          "minItems": 0
        },
        "containsLabor": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "costType": {
          "type": "string",
          "enum": [
            "procurement",
            "invoice",
            "expense",
            "payment-fact",

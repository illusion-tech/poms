d7a2c5686670a77421014048a4a8e041b69109f9 blob 62822
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G target DTO proposal; not yet shared runtime contract",
  "$defs": {
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "rowVersion",
        "payloadHash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "rowVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ExpectedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "expectedVersion",
        "payloadHash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "MoneyFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge",
        "value",
        "unknownReasonCode",
        "evidenceRefs",
        "zeroProof"
      ],
      "properties": {
        "knowledge": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknownReasonCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 1000
        },
        "zeroProof": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "source-basis-value",
                "sum-known-members-zero",
                "exhaustive-classified-scope-zero"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "knowledge": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
              },
              "unknownReasonCode": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "unknownReasonCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "zeroProof": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "const": "0.00"
              }
            }
          },
          "then": {
            "properties": {
              "zeroProof": {
                "type": "string"

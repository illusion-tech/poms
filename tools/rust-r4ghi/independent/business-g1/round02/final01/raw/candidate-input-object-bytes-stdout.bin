export const ContractAmendmentPreparationInputSchema = z
    .object({ sourceSnapshotId: z.uuid(), reason: z.string().trim().min(1).max(1000), expectedContractVersion: z.number().int().min(1).max(9007199254740991) })
    .strict()
    .meta({ id: "ContractAmendmentPreparationInput" });

{
  "schemaVersion": 1,
  "status": "FINAL-G1-PROPOSAL-NOT-ADMITTED",
  "slice": "H #112; batch #110",
  "existingHttp": 8,
  "newPublicHttp": 0,
  "userDecisions": {
    "carrier": "User answers delivered by Root in chat; #115 is independent user-create-fix, not business decision carrier",
    "accepted": [
      "Minimum four existing R5 role operations plus two controlled execution/acceptance commands and real initial-stage lifecycle",
      "Receipt amount is gross cash; confirmation freezes traceable same-contract net/tax basis; legacy missing basis needs authorized correction before formal operating",
      "Explicit cost include/exclude with reason; server validates actual source/stage/currency/tax/version and derives totals"
    ],
    "rootAcceptedEnums": "known/unknown independent amount knowledge; signal/risk add normal/unknown; maturity unchanged; not evaluated uses evaluationStatus"
  },
  "interface": {
    "module": "project_operating_signals",
    "evaluate": "pub async fn evaluate_with_session(session: &mut CommonSession<'_, '_>, snapshot_id: Uuid, expected_row_version: i32, expected_source_hash: &str, actor: &Actor) -> Result<OperatingEvaluationRefs, Error>",
    "derive": "pub fn derive_operating_evaluation(context: &OperatingSourceContext, review: Option<&VerifiedMaterialityReview>) -> Result<OperatingEvaluationDraft, Error>",
    "readiness": "pub fn derive_cost_readiness(context: &OperatingSourceContext) -> Result<CostReadiness, Error>",
    "returns": {
      "snapshotId": "UUID",
      "sourceHash": "SHA256",
      "evaluationHash": "SHA256",
      "maturityEvaluationId": "UUID",
      "signalEvaluationId": "UUID",
      "signalRowVersion": "positive int",
      "bindingIds": "four-stage UUID record",
      "summarySnapshotIds": "four-stage UUID record",
      "currentActionLevel": "action",
      "policyVersion": "r4h-operating-v1",
      "certification": "verified|missing-evidence|legacy-unverified"
    },
    "sequence": [
      "G allocates snapshot UUID and authoritative collector builds typed context; no client conclusions.",
      "G calls H pure derive before INSERT; insert snapshot final facts/action once at v1 and immutable source context in same outerTX.",
      "G calls exact evaluate_with_session(snapshotId,1,sourceHash,actor); H reloads via caller session, locks project scope, checks schema/project/version/hash/formalEligibility and recomputes result.",
      "H asserts snapshot final facts/action equal policy output, inserts DMER/OSER/all four bindings/source summaries/reasons/evidence/idempotency. No write-back of G factual snapshot.",
      "Shared caller adapter flushes required audit/auth/security participants and COMMITs once. H never pools, begins or commits independently."
    ],
    "sharedOwner": "Root model/hash/context-load helper only; H is sole policy authority; G collector is sole source authority. Shared model has no business calculator."
  },
  "sourceContext": {
    "schema": "source-context.schema.json",
    "canonicalization": "Exact sourceHashFactualWhitelist supersedes broad hash wording. Shared serializer and tests Root-owned. H independently recomputes derived metric assertions; payloadHash hashes the complete stored context excluding only its self-hash field.",
    "semantics": [
      "All fields required, absent explicit null. Unknown amount value=null+nonempty reason; known amount decimal string+null reason. Proven zero needs zeroProof and exact source/scope evidence.",
      "Known gross=net+tax in cents. Receipt cashGross=amounts.gross and net/tax from frozen confirmation contract basis, never current tax rate.",
      "Missing receipt basis or included hard source/tax/stage/classification/amount evidence => formalEligibility missing-evidence and official G/H publication rejects. Legacy/preview may expose unavailable state but cannot publish certified current summaries or releasable gates.",
      "Every registered cost has one explicit validated current include/exclude classification. Duplicate canonicalAccumulationKey across invoice/payment/procurement rejects. Allocated project share uses exact F frozen cents, not recomputed rounded ratio.",
      "Empty registered scope may prove a point-in-time aggregate zero only with exhaustive collector scope hash; this does not prove mature business data. Without actual classified cost-scope evidence, maturity remains insufficient even if registered sum is zero.",
      "All-excluded validated known records can prove included sum zero; unknown or missing hard facts cannot be hidden by an implicit exclude.",
      "containsLabor=yes if any transitive lineage labor, no only if all verified nonlabor, otherwise unknown; unknown uses strongest sensitive group."
    ],
    "sourceHashFactualWhitelist": {
      "top": [
        "schemaVersion",
        "producerVersion",
        "projectId",
        "currency",
        "scopeHash",
        "baseline",
        "contracts",
        "receipts",
        "costs",
        "allocations",
        "taxTreatments",
        "pendingFacts",
        "unclassifiedSourceRefs",
        "upstreamCostConstraints",
        "scope",
        "laborLineage"
      ],
      "snapshot": [
        "mode",
        "knowledgeCutoff",
        "sourceWindowStart",
        "sourceWindowEnd",
        "periodKey",
        "businessTimezone",
        "periodEndSnapshotRef",
        "restatementRef",
        "restatesSnapshotRef",
        "restatedSnapshotRef",
        "restatementStatus"
      ],
      "exclude": [
        "sourceHash",
        "contextId",
        "snapshot.id",
        "snapshot.rowVersion",
        "snapshot.version",
        "snapshot.snapshotAt",
        "snapshot.supersedesSnapshotId",
        "policyVersion",
        "policyHash",
        "formalEligibility",
        "metrics",
        "all evaluation/review/generated-result identifiers"
      ],
      "algorithm": "Construct exact nested whitelist object, sort set-like arrays kind/id/rowVersion/payloadHash, then contract_support::canonical_hash. No arbitrary SELECT * JSON participates. Same factual source scope has same sourceHash regardless new generated IDs.",
      "evaluationHash": "canonical_hash({sourceHash,policyVersion,policyHash,normalizedDerivedOutput,verifiedReviewOverlayHash|null}); exclude generated DMER/OSER/binding/summary IDs and wall-clock timestamps. Review overlay hash binds real actor/evidence/source and immutable review content."
    },
    "preparation": "Pure derive context may use server-preallocated IDs without business persistence; preparation knowledgeCutoff is explicit, stable and included in sourceHash. H pure derive never certifies current or writes. Final formal publication reloads source assertions and rejects changed sources.",
    "excludeStageSemantics": "Cost.stageAttributionRef/attributedStage nullable only for expressing real excluded not-yet-applicable/missing stage evidence. Include requires recordStatus confirmed/included, stageEvidenceState verified and exact nonnull stage refs plus all hard layers. Registered source explicitly excluded for a permitted stage-not-ready reason remains traceable with pendingFacts(requiredForFormalAccounting=false), preserves uncertainty and cannot become mature/normal. It does not waive confirmed receipt accounting basis or hard facts of an included source.",
    "arrayOrdering": {
      "contracts": "contractRef.id",
      "receipts": "receiptRef.id",
      "costs": "canonicalAccumulationKey,recognitionRole,sourceRef.id,costRef.id-or-null; shares sorted by actual F result identity",
      "allocations": "resultRef.id",
      "taxTreatments": "taxTreatmentRef.id",
      "pendingFacts": "kind then sourceRef.id",
      "sourceRefSets": "kind,id,rowVersion,payloadHash",
      "upstreamCostConstraints": "ruleId,reasonCode,sorted basis refs",
      "approvedChangeRefs": "preserve authoritative approved delta application chain order; never reorder commutative-looking business history arbitrarily"
    },
    "costRecognitionUniqueness": {
      "canonicalAccumulationKey": "Uniqueness among included primary economic measurement shares in this project snapshot only; not among excluded support rows or historical snapshots.",
      "sourceChainKey": "Separate chain constraint: payable commitment/procurement exception principal and its payment principals cannot both be included. Multiple genuine installment paymentIds under one payable remain separate primary economic units.",
      "supportingEvidence": "Invoice/tax/evidence support rows explicitly exclude with real reason and primaryCostRef; same sourceChainKey is not a duplicate principal.",
      "allocation": "Share key includes actual F source-set hash+project/result identity. Same source full principal and corresponding project allocation share cannot be counted simultaneously; lock/validate source-set overlap, not a rounded allocation ratio.",
      "rule": "These exact rules supersede the broad earlier duplicate canonicalAccumulationKey across invoice/payment/procurement wording."
    },
    "currency": "Preparation with no proven source currency or multi-currency has currency=null (and unavailable aggregate Triple.currency=null); never CNY/UNKNOWN placeholder. Only formalEligibility eligible forces a unique evidenced three-letter currency. Different source currencies reject formal publication unless a separately frozen actual conversion policy exists (none here).",
    "sharedShare": "No fabricated ProjectActualCostRecord. allocation-share costRef/recordStatus null, sourceRef is actual F SharedCostAllocationResult, allocationResultRef/source-set hash exact. allocationSourceMembers carries real source costs/stages/governance/labor refs. Included shares require all member hard eligibility/stage evidence valid; per-source refs remain authoritative, aggregate stageEvidenceState verified only when all members qualify. Share costType=null when representing actual allocation result (never invent a unified-cost enum); members retain actual costType/businessDate. Share businessDate is actual F result effective business date under G frozen window policy, not a guessed member date."
  },
  "policy": {
    "version": "r4h-operating-v1",
    "maturity": [
      "insufficient if necessary effective contract/confirmed receipt basis/explicit classified cost scope/factual layer missing. Ordinary review cannot change this. Official eligibility guard applies separately.",
      "preliminary if necessary evidence exists but pending/unmapped/tax/allocation/restatement uncertainty remains, even when its qualitative materiality has been reviewed.",
      "mature only complete classified known current-scope sources with no pending gaps/corrections/restatements; maturity is not risk normality."
    ],
    "formulas": [
      "grossMarginNet=confirmedReceiptNet-includedCostNet; margin ratio denominator confirmedReceiptNet",
      "zero known receipt denominator=>null rate/zero-denominator; unknown=>null/missing-evidence; immature ratios explicitly unstable",
      "low receipt ratio exact comparison confirmed gross cash/effective contract gross <0.20, same frozen currency/gross layer; no tax-layer mixing",
      "extreme margin ratio <-1 or >1; exact -1/1 not extreme by this rule. No fabricated abnormal-jump threshold."
    ],
    "risk": [
      "Auto risk/alert for proven negative margin only when known facts, mature, receipt ratio>=0.20 and receipt net>0. Independent authoritative cost BLOCK survives regardless receipt ratio.",
      "Negative observed margin at low/zero receipts or immature data => qualitative-materiality-unassessed, unknown risk/signal and explicit manual review; preserve independent cost/formula/maturity/restatement actions.",
      "Any adverse positive cost variance or pending impact with only qualitative materiality adds unassessed review. No invented amount/percentage threshold. Verified manual review classifies only exact qualitative issues normal/attention/risk, not facts or maturity.",
      "normal only complete facts and no automatic risk/attention or unresolved qualitative issues. unknown never means normal or confirmed release."
    ],

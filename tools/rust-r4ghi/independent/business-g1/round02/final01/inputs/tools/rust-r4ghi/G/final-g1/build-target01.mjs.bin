import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';

const root = path.resolve(process.cwd());
assert.equal(root.replaceAll('\\', '/').toLowerCase(), 'e:/projects/worktrees/poms-r3hijk-next28/poms');
const out = path.join(root, 'tools/rust-r4ghi/G/final-g1');
fs.mkdirSync(out, { recursive: true });
const ref = name => ({ $ref: `#/$defs/${name}` });
const uuid = { type: 'string', format: 'uuid' }, hash = { type: 'string', pattern: '^[0-9a-f]{64}$' };
const positive = { type: 'integer', minimum: 1, maximum: 2147483647 }, revision = { type: 'integer', minimum: 0, maximum: 2147483647 };
const text = { type: 'string', minLength: 1, maxLength: 2000 }, date = { type: 'string', format: 'date' };
const nullable = schema => ({ anyOf: [schema, { type: 'null' }] });
const array = schema => ({ type: 'array', items: schema, maxItems: 1000 });
const object = properties => ({ type: 'object', additionalProperties: false, required: Object.keys(properties), properties });
const enumOf = values => ({ type: 'string', enum: values });
const money = { type: 'string', pattern: '^-?(?:0|[1-9][0-9]{0,15})\\.[0-9]{2}$' };
const period = { type: 'string', pattern: '^(?:[0-9]{4}-(?:0[1-9]|1[0-2])|[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3]))$' };
const defs = {};
defs.SourceRef = object({ kind: text, id: uuid, rowVersion: positive, payloadHash: hash });
defs.ExpectedRef = object({ kind: text, id: uuid, expectedVersion: positive, payloadHash: hash });
defs.MoneyFact = object({ knowledge: enumOf(['known', 'unknown']), value: nullable(money), unknownReasonCode: nullable(text), evidenceRefs: array(ref('SourceRef')), zeroProof: nullable(enumOf(['source-basis-value', 'sum-known-members-zero', 'exhaustive-classified-scope-zero'])) });
defs.MoneyFact.allOf = [
  { if: { properties: { knowledge: { const: 'known' } } }, then: { properties: { value: money, unknownReasonCode: { type: 'null' } } }, else: { properties: { value: { type: 'null' }, unknownReasonCode: text, zeroProof: { type: 'null' } } } },
  { if: { properties: { value: { const: '0.00' } } }, then: { properties: { zeroProof: { type: 'string' } } } },
  { if: { properties: { knowledge: { const: 'known' }, value: { not: { const: '0.00' } } } }, then: { properties: { zeroProof: { type: 'null' } } } },
];
defs.FormalEligibility = object({ status: enumOf(['eligible', 'missing-evidence']), blockingReasonCodes: array(text), missingEvidenceRefs: array(ref('SourceRef')) });

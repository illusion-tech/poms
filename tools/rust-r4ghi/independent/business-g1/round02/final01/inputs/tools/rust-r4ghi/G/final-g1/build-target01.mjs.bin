defs.FinancialProjection['x-reuse-registered-engine'] = 'Root maps the existing sensitive projection engine to this typed reversible group; no alternative authorization policy.';
defs.SourceFinancialGroup = object({ currency: nullable({ type: 'string', pattern: '^[A-Z]{3}$' }), net: ref('MoneyFact'), tax: ref('MoneyFact'), gross: ref('MoneyFact'), rate: nullable({ type: 'string', pattern: '^[0-9]\\.[0-9]{4}$' }), detailText: nullable(text) });
defs.SourceFinancialProjection = object({ mode: enumOf(['full', 'masked', 'denied']), displayText: { type: 'string' }, fieldPackageKeys: array(enumOf(['operating-finance', 'labor-cost-rate'])), value: nullable(ref('SourceFinancialGroup')) });
defs.CostDecisionInput = object({ target: ref('ExpectedRef'), expectedVersion: revision, decision: enumOf(['include', 'exclude']), recognitionRole: enumOf(['direct-source', 'allocation-share', 'tax-support', 'evidence-only']), reasonCode: enumOf(['actual-payment', 'actual-expense', 'executed-labor', 'approved-commitment-exception', 'duplicate-support', 'pending-confirmation', 'pending-monetary-layer', 'shared-source-delegated', 'outside-cutoff', 'other-evidenced']), reasonText: text, primaryCostRef: nullable(ref('ExpectedRef')), supportingSourceRefs: array(ref('ExpectedRef')), evidenceRefs: array(ref('ExpectedRef')) });
defs.LegacyAssertions = object({ originalBaselineCost: nullable(money), currentEffectiveBaselineCost: nullable(money), changePackageTotal: nullable(money), effectiveContractTotal: nullable(money), receivableConfirmedTotal: nullable(money), includedCostTotal: nullable(money), taxImpactPendingAmount: nullable(money), currentActionLevel: nullable(enumOf(['prompt', 'review', 'block'])), referencedBaselineVersion: nullable(text) });

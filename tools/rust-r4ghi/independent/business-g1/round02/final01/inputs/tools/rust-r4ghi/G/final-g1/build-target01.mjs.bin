defs.ActivateOperatingBaselinePackageRequest = object({ ...common, expectedCurrentPackageRef: nullable(ref('ExpectedRef')), originalAdoptedCostRef: ref('ExpectedRef'), selectedHandoverBasisRef: nullable(ref('ExpectedRef')), handoverRebaselineRef: nullable(ref('ExpectedRef')), approvedChangeRefs: array(ref('ExpectedRef')), reason: text });
defs.CreateProjectOperatingSnapshotRequest = object({ ...common, baselinePackageRef: ref('ExpectedRef'), snapshotMode: enumOf(['realtime', 'period-end']), periodKey: nullable(period), costDecisions: array(ref('CostDecisionInput')) });
defs.CreateProjectOperatingSnapshotRequest.allOf = [{ if: { properties: { snapshotMode: { const: 'period-end' } } }, then: { properties: { periodKey: period } }, else: { properties: { periodKey: { type: 'null' } } } }];
defs.CreatePeriodClosingSnapshotRequest = object({ ...common, baselinePackageRef: ref('ExpectedRef'), periodKey: period, expectedPeriodSnapshotRef: nullable(ref('ExpectedRef')), costDecisions: array(ref('CostDecisionInput')) });
defs.LaborCorrection = object({ supersededCostRef: ref('ExpectedRef'), rateRef: ref('ExpectedRef'), laborPeriodStart: date, laborPeriodEnd: date, actualHours: nullable({ type: 'string', pattern: '^[0-9]{1,8}(?:\\.[0-9]{1,2})?$' }), actualPersonDays: nullable({ type: 'string', pattern: '^[0-9]{1,8}(?:\\.[0-9]{1,2})?$' }), workSummary: text, attachmentRefs: array(ref('ExpectedRef')), stageEvidenceRefs: array(ref('ExpectedRef')), reason: text });
defs.AllocationShareInput = object({ projectId: uuid, allocationWeight: { type: 'string', pattern: '^[0-9]{1,16}(?:\\.[0-9]{1,6})?$' }, expectedCurrentResultRef: ref('ExpectedRef'), reason: text });
defs.AllocationCorrection = object({ basisRef: ref('ExpectedRef'), sourceCostRefs: array(ref('ExpectedRef')), projectShareItems: array(ref('AllocationShareInput')), reason: text });
defs.AffectedRestatementTarget = object({ projectId: uuid, expectedVersion: revision, restatesSnapshotRef: ref('ExpectedRef'), periodEndSnapshotRef: nullable(ref('ExpectedRef')), costDecisions: array(ref('CostDecisionInput')) });
defs.CreateOperatingRestatementRequest = object({ ...common, scope: enumOf(['live', 'period']), periodEndSnapshotRef: nullable(ref('ExpectedRef')), restatesSnapshotRef: ref('ExpectedRef'), restatementReason: text, restatementSummary: text, costDecisions: array(ref('CostDecisionInput')), laborCorrections: array(ref('LaborCorrection')), allocationCorrections: array(ref('AllocationCorrection')), affectedTargets: array(ref('AffectedRestatementTarget')), acknowledgedChangedSourceRefs: array(ref('ExpectedRef')) });
defs.CreateOperatingRestatementRequest.allOf = [{ if: { properties: { scope: { const: 'period' } } }, then: { properties: { periodEndSnapshotRef: ref('ExpectedRef') } }, else: { properties: { periodEndSnapshotRef: { type: 'null' } } } }];
defs.ReceiptBasisInput = object({ termSnapshotRef: ref('ExpectedRef'), currencyBasisRef: ref('ExpectedRef'), evidenceRefs: array(ref('ExpectedRef')), selectionPolicy: enumOf(['receipt-date-effective-terms', 'explicit-activated-terms-evidence']), reason: text });
defs.ConfirmReceiptRecordRequest = object({ inputVersion: { const: 'server-derived-v1' }, mode: enumOf(['confirm', 'certify-existing-basis']), expectedVersion: positive, expectedContractVersion: positive, basis: ref('ReceiptBasisInput') });
defs.SourceRow = object({ rowKind: enumOf(['contract', 'receipt', 'direct-cost', 'allocation-share', 'supporting-source', 'tax-treatment', 'baseline', 'stage-evidence']), sourceRef: ref('SourceRef'), sourceMembers: array(ref('SourceRef')), state: enumOf(['ready', 'pending', 'unclassified', 'legacy-unverified']), blockingReasonCodes: array(text), currentDecisionRef: nullable(ref('SourceRef')), canonicalAccumulationKey: nullable(text), sourceChainKey: nullable(text), containsLabor: enumOf(['yes', 'no', 'unknown']), allowedRecognitionRoles: array(enumOf(['direct-source', 'allocation-share', 'tax-support', 'evidence-only'])), primaryCostRef: nullable(ref('SourceRef')), sourceBusinessDate: nullable(date), sourceEffectiveBusinessDate: nullable(date), financialProjection: ref('SourceFinancialProjection') });
defs.EvaluationRefs = object({ maturityEvaluationId: uuid, signalEvaluationId: uuid, signalRowVersion: positive, bindingIds: object({ first: uuid, second: uuid, final: uuid, retention: uuid }), summarySnapshotIds: object({ first: uuid, second: uuid, final: uuid, retention: uuid }), evaluationHash: hash, policyVersion: { const: 'r4h-operating-v1' } });
defs.OperatingCommandResult = object({ targetId: uuid, targetType: enumOf(['OperatingBaselinePackage', 'ProjectOperatingSnapshot', 'PeriodClosingSnapshot', 'OperatingRestatementRecord']), resultStatus: { const: 'success' }, businessStatusAfter: { const: 'active' }, approvalRecordId: { type: 'null' }, confirmationRecordId: { type: 'null' }, todoItemIds: array(uuid), rowVersion: positive, newHeadVersion: positive, snapshotId: nullable(uuid), periodEndSnapshotId: nullable(uuid), restatementIds: array(uuid), sourceHash: nullable(hash), evaluationRefs: nullable(ref('EvaluationRefs')) });
const summary = { outputVersion: { const: 'server-derived-v1' }, id: uuid, projectId: uuid, rowVersion: positive, capturedRowVersion: positive, headVersion: revision, producerVersion: { const: 1 }, certification: { const: 'verified' }, sourceHash: hash, sourceContextId: uuid, sourcePayloadHash: hash, containsLabor: enumOf(['yes', 'no', 'unknown']), financialProjection: ref('FinancialProjection'), sourceRows: array(ref('SourceRow')), createdAt: { type: 'string', format: 'date-time' }, updatedAt: { type: 'string', format: 'date-time' } };
defs.OperatingBaselinePackageSummary = object({ ...summary, isCurrent: { type: 'boolean' }, status: enumOf(['active', 'superseded']), originalAdoptedCostRef: ref('SourceRef'), currentEffectiveCostRef: ref('SourceRef'), handoverBasisRef: nullable(ref('SourceRef')), handoverRebaselineRef: nullable(ref('SourceRef')), approvedChangeRefs: array(ref('SourceRef')), effectiveAt: { type: 'string', format: 'date-time' } });
defs.ProjectOperatingSnapshotSummary = object({ ...summary, snapshotMode: enumOf(['realtime', 'period-end', 'restated']), snapshotAt: { type: 'string', format: 'date-time' }, sourceWindowStart: { type: 'null' }, sourceWindowEnd: date, knowledgeCutoff: { type: 'string', format: 'date-time' }, businessTimezone: { const: 'Asia/Hong_Kong' }, status: enumOf(['active', 'superseded']), supersedesId: nullable(uuid), baselinePackageRef: ref('SourceRef'), periodEndSnapshotRef: nullable(ref('SourceRef')), restatementRef: nullable(ref('SourceRef')), currentActionLevel: enumOf(['prompt', 'review', 'block']), formalEligibility: ref('FormalEligibility'), evaluationStatus: { const: 'evaluated' }, evaluationRefs: ref('EvaluationRefs') });
defs.PeriodClosingSnapshotSummary = object({ ...summary, periodKey: period, periodStart: date, periodEnd: date, businessTimezone: { const: 'Asia/Hong_Kong' }, projectSnapshotRef: ref('SourceRef'), snapshotAt: { type: 'string', format: 'date-time' }, originalFrozenUnchanged: { const: true }, latestRestatementRef: nullable(ref('SourceRef')), status: enumOf(['active', 'superseded']) });
defs.OperatingRestatementSummary = object({ ...summary, scope: enumOf(['live', 'period']), periodEndSnapshotRef: nullable(ref('SourceRef')), restatesSnapshotRef: ref('SourceRef'), restatedSnapshotRef: ref('SourceRef'), rootSnapshotRef: ref('SourceRef'), causalitySourceRefs: array(ref('SourceRef')), affectedRestatementRefs: array(ref('SourceRef')), reasonProjection: ref('FinancialProjection'), handledAt: { type: 'string', format: 'date-time' }, handledBy: uuid, status: enumOf(['active', 'superseded']) });
defs.OperatingRestatementListView = array(ref('OperatingRestatementSummary'));

  operationBudget: { batch: 32, knownExistingOriginal: 25, stageNew: 2, conditionCloseNew: 1, minimumR5Existing: 4, GExisting: 9, GNew: 0, receiptBasisNew: 0, previewNew: 0, note: 'Existing C confirm gains explicit certify-existing-basis mode; existing H unified-accounting query gains preparation view. Root must freeze changed semantic contracts, not count them as new public routes. Any later split endpoint changes 32 and needs route registration.' },

  "exactPrimaryOpenapiSchemas": {
    "ReviewOperatingSignalEvaluationRequest": {
      "type": "object",
      "properties": {
        "reviewDecision": {
          "$ref": "#/components/schemas/OperatingSignalReviewDecision"
        },
        "resolvedDataMaturityLevel": {
          "$ref": "#/components/schemas/OperatingDataMaturityLevel"
        },
        "costActionRecommendation": {
          "$ref": "#/components/schemas/OperatingSnapshotActionLevel"
        },
        "referencedBaselineVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "referencedSnapshotVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "reviewComment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "nullable": true
        },
        "expectedVersion": {
          "type": "integer",
          "exclusiveMinimum": true,
          "maximum": 9007199254740991,
          "minimum": 0
        }
      },
      "required": [
        "reviewDecision",
        "resolvedDataMaturityLevel",
        "costActionRecommendation",
        "referencedBaselineVersion",
        "referencedSnapshotVersion"
      ]
    },
    "ReviewOperatingSignalEvaluationResult": {
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "signalEvaluationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "reviewRecordId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "taxImpactSummary": {
          "type": "string"
        },
        "dataMaturityLevel": {
          "$ref": "#/components/schemas/OperatingDataMaturityLevel"
        },
        "costActionRecommendation": {
          "$ref": "#/components/schemas/OperatingSnapshotActionLevel"
        },
        "currentActionLevel": {
          "$ref": "#/components/schemas/OperatingSnapshotActionLevel"
        },
        "referencedBaselineVersion": {
          "type": "string"
        },
        "referencedSnapshotVersion": {
          "type": "string"
        },
        "resultStatus": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "targetId",
        "signalEvaluationId",
        "reviewRecordId",
        "taxImpactSummary",
        "dataMaturityLevel",
        "costActionRecommendation",
        "currentActionLevel",
        "referencedBaselineVersion",
        "referencedSnapshotVersion",
        "resultStatus"
      ]
    },
    "OperatingSignalEvaluationView": {
      "type": "object",
      "properties": {
        "signalEvaluationId": {

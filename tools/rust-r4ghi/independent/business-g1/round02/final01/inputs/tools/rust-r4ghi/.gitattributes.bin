# Preserve the bytes of captured tools, source snapshots and audit evidence.
* -text
* whitespace=cr-at-eol
*.bin binary
*.patch binary
# Executed helper originals retain their existing final blank lines.
userfix/*.mjs whitespace=cr-at-eol,-blank-at-eof
# The sealed H design proposal is a preserved raw input.
H/final-g1/proposal01.md whitespace=cr-at-eol,-blank-at-eof

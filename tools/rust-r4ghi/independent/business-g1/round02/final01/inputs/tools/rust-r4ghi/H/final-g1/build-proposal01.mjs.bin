interface:{module:'project_operating_signals',evaluate:"pub async fn evaluate_with_session(session: &mut CommonSession<'_, '_>, snapshot_id: Uuid, expected_row_version: i32, expected_source_hash: &str, actor: &Actor) -> Result<OperatingEvaluationRefs, Error>",derive:'pub fn derive_operating_evaluation(context: &OperatingSourceContext, review: Option<&VerifiedMaterialityReview>) -> Result<OperatingEvaluationDraft, Error>',readiness:'pub fn derive_cost_readiness(context: &OperatingSourceContext) -> Result<CostReadiness, Error>',returns:{snapshotId:'UUID',sourceHash:'SHA256',evaluationHash:'SHA256',maturityEvaluationId:'UUID',signalEvaluationId:'UUID',signalRowVersion:'positive int',bindingIds:'four-stage UUID record',summarySnapshotIds:'four-stage UUID record',currentActionLevel:'action',policyVersion:'r4h-operating-v1',certification:'verified|missing-evidence|legacy-unverified'},sequence:['G allocates snapshot UUID and authoritative collector builds typed context; no client conclusions.','G calls H pure derive before INSERT; insert snapshot final facts/action once at v1 and immutable source context in same outerTX.','G calls exact evaluate_with_session(snapshotId,1,sourceHash,actor); H reloads via caller session, locks project scope, checks schema/project/version/hash/formalEligibility and recomputes result.','H asserts snapshot final facts/action equal policy output, inserts DMER/OSER/all four bindings/source summaries/reasons/evidence/idempotency. No write-back of G factual snapshot.','Shared caller adapter flushes required audit/auth/security participants and COMMITs once. H never pools, begins or commits independently.'],sharedOwner:'Root model/hash/context-load helper only; H is sole policy authority; G collector is sole source authority. Shared model has no business calculator.'},
sourceContext:{schema:'source-context.schema.json',canonicalization:'Use Root contract_support::canonical_hash. Sort set-like source arrays by kind/id/rowVersion/hash. Hash immutable factual subset excluding sourceHash itself, derived metrics/action/evaluation/review IDs and mutable current/lifecycle metadata; schema includes derived metric assertions which H recomputes from members.',semantics:['All fields required, absent explicit null. Unknown amount value=null+nonempty reason; known amount decimal string+null reason. Proven zero needs zeroProof and exact source/scope evidence.','Known gross=net+tax in cents. Receipt cashGross=amounts.gross and net/tax from frozen confirmation contract basis, never current tax rate.','Missing receipt basis or included hard source/tax/stage/classification/amount evidence => formalEligibility missing-evidence and official G/H publication rejects. Legacy/preview may expose unavailable state but cannot publish certified current summaries or releasable gates.','Every registered cost has one explicit validated current include/exclude classification. Duplicate canonicalAccumulationKey across invoice/payment/procurement rejects. Allocated project share uses exact F frozen cents, not recomputed rounded ratio.','Empty registered scope may prove a point-in-time aggregate zero only with exhaustive collector scope hash; this does not prove mature business data. Without actual classified cost-scope evidence, maturity remains insufficient even if registered sum is zero.','All-excluded validated known records can prove included sum zero; unknown or missing hard facts cannot be hidden by an implicit exclude.','containsLabor=yes if any transitive lineage labor, no only if all verified nonlabor, otherwise unknown; unknown uses strongest sensitive group.']},
policy:{version:'r4h-operating-v1',maturity:['insufficient if necessary effective contract/confirmed receipt basis/explicit classified cost scope/factual layer missing. Ordinary review cannot change this. Official eligibility guard applies separately.','preliminary if necessary evidence exists but pending/unmapped/tax/allocation/restatement uncertainty remains, even when its qualitative materiality has been reviewed.','mature only complete classified known current-scope sources with no pending gaps/corrections/restatements; maturity is not risk normality.'],formulas:['grossMarginNet=confirmedReceiptNet-includedCostNet; margin ratio denominator confirmedReceiptNet','zero known receipt denominator=>null rate/zero-denominator; unknown=>null/missing-evidence; immature ratios explicitly unstable','low receipt ratio exact comparison confirmed gross cash/effective contract gross <0.20, same frozen currency/gross layer; no tax-layer mixing','extreme margin ratio <-1 or >1; exact -1/1 not extreme by this rule. No fabricated abnormal-jump threshold.'],risk:['Auto risk/alert for proven negative margin only when known facts, mature, receipt ratio>=0.20 and receipt net>0. Independent authoritative cost BLOCK survives regardless receipt ratio.','Negative observed margin at low/zero receipts or immature data => qualitative-materiality-unassessed, unknown risk/signal and explicit manual review; preserve independent cost/formula/maturity/restatement actions.','Any adverse positive cost variance or pending impact with only qualitative materiality adds unassessed review. No invented amount/percentage threshold. Verified manual review classifies only exact qualitative issues normal/attention/risk, not facts or maturity.','normal only complete facts and no automatic risk/attention or unresolved qualitative issues. unknown never means normal or confirmed release.'],ruleRows,aggregate:'Project=max(costAction floor, all project candidates). Four gates independently max per-stage including explicit H09/H10 standalone-cost mappings; do not copy project action. Persist all reasons and flag all equal-max project/stage primaries; sort code/evidenceHash.',manual:'Ordinary review confirms or tightens. Never downgrade source floor/BLOCK or supply missing hard fact. Generic exception release excluded; requires separate authorized exception command/approval/expiry baseline.'},
reviews:{signal:['Require session/CSRF/finance action and source-derived sensitive-write permissions; expectedVersion/sourceHash/evaluationHash/requestKey all mandatory.','Lock project+evaluation, compare every source assertion, CAS OSER WHERE version+active and increment version even child-only review. System generated values stay immutable.','Append unique-active signal review with actor/rationale/source+effective hashes; regenerate all four current bindings/source summaries under effective overlay sameTX. Old binding reviews become historical/stale.'],gate:['Lock exact current project/stage/binding; validate source assertions, complete blocking codes and source summary exact target/project/stage/source/evaluation/policy hashes/package/projection/export.','bindingAction is pre-review assertion. acknowledge preserves action; tighten-review/block only increases severity. Decision is server assertion: block=>blocked, incomplete evidence/materiality=>review-required, otherwise confirmed when exact human duties satisfied.','Advice REVIEW may stay REVIEW after confirmed manual review; confirmed means review satisfied, not payout authorization. BLOCK cannot be confirmed away.','CAS binding; append single-active gate review and produce new reviewed summary+projection+payload. Request summarySnapshotId asserted pre-review source summary; response points to new reviewed summary.','Preallocate review ID in immutable summary payload then insert review FK to summary, avoiding FK cycle; never rewrite prior summary payload/projections.'],summary:{approvalScenarioKey:'commission-gate-review',summaryPackageKey:'project-operating-commission-gate-v1',projectionLevel:'commission-gate-review',exportPolicy:'internal-only',fieldRuleVersion:'r4h-operating-v1',targetType:'operating-signal-gate-binding',targetId:'exact binding UUID',identity:['projectId','gateStageType','snapshotId','sourceHash','policyVersion','policyHash','evaluationHash','signalEvaluationId','signalReviewRecordId','bindingId','bindingRowVersion','gateReviewRecordId|null','sourceSummarySnapshotId|null'],data:'Authorized field projections and internal immutable payload/hash only; e2e-v1 package never production.'},idempotency:'scope operation+targetScope+actor+requestKey. Hash validated body+source/evaluation/policy. Exact authenticated same-actor committed replay before stale CAS returns receipt, changed payload conflicts. Receipt/audit sameTX.'},
sensitive:{raw:'protected old raw compatibility fields literal null even privileged; originals only projections. Include free text, all reasons/evidence refs and reversible aggregate groups. No raw financial snapshots in audit/errors.',permissions:'route finance manage not sensitive grant; operating-finance sensitive read for protected access. Labor yes or unknown lineage requires both operating-finance and labor-cost-rate permissions; admin no bypass.',events:'Use same borrowed session; evaluate both registered packages and most restrictive group mode. Mandatory security/audit/summary/auth flush errors propagate. Sensitive GET required event failure returns no payload/raw fallback.'},

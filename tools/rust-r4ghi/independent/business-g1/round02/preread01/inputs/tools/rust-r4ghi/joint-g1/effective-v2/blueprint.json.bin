  "transaction": {
    "sequence": [
      "Discover complete impacted project set without acquiring a partial set of locks; sorted project UUID locks; rediscover and restart on new scope",
      "Lock head/baseline/contract/receipt and all source-family/source/cost/F governance rows in shared deterministic order; assert all versions and expectedInputHash",
      "Apply real receipt certification/labor/allocation correction producer calls only when explicitly requested and authorized; persist explicit classifications; CAS direct cost included transition; preserve actual source-state before/after proof",
      "Allocate target snapshot/context UUIDs server-side; collect exact post-producer immutable context and sourceRows; calculate exact primary facts; H pure derive owns action/readiness",
      "Reject formalEligibility missing-evidence; write G source context/members and snapshot with final action once at captured row version 1",
      "For period: write paired period anchor with exactly same source context; for restatement: append restatement+causal links and metadata-only old terminal supersede",
      "H evaluate reloads real new context/hash/v1, recomputes/asserts final facts/action and writes DMER/OSER/four binding/summary chains; no G facts writeback",
      "CAS project_operating_head/new period terminal pointers, required business audit/security/auth coflush, one outer COMMIT; any necessary write failure rolls back all"
    ],
    "lockOrder": [
      "Guard/session/CSRF + precise route permission before domain; preserve parsed raw body numeric token provenance.",
      "Resolve only minimal true FK identity; discover complete impacted project set WITHOUT partial project locks. Lock project UUIDs ascending; rediscover all affected sources/projects; restart outer transaction if expanded.",
      "Fresh active accounts/orgs/memberships in stable UUID order FOR SHARE after project locks; verify Owner/Part/duty/condition relation; no independent pool/connection.",
      "Acquire required existing rows using lockFamilyRank: handover/scope-source rows before operating head and baseline/contract/receipt; then assignment and stage/acceptance/completion/conditions/archive. Each family stable UUID order. Shared allocation operation/basis/result/source families precede member costs. Domain validation sequences never override the common lock rank; a coordinator prelocks the full relevant plan before calling borrowed helpers.",
      "Lock E/F source/governance/stage/tax/full allocation batch + inclusion decisions/heads + affected frozen members in fixed family rank and UUID order; compare complete versions/hash + expectedInputHash BEFORE requested producer side effects.",
      "After real source/certification/classification/CAS, collect final context, pure H derive, insert G final v1 once; evaluate reload snapshot v1+finalSourceHash; insert evidence/DMER/OSER/4 bindings/reasons/summaries; advance heads atomically.",
      "Write business audit, required sensitive security event, idempotency receipt, pending authentication coflush in same CommonSession/outerTX. One COMMIT; uncertain COMMIT remains unknown, never auto-replayed as proven failure."
    ],
    "lockFamilyRank": {
      "00": "complete impacted project IDs ascending; rediscover/restart on expansion",
      "10-12": "platform_user,org_unit,user_org_membership fresh shared locks; UUID order",
      "20-25": "handover,basis,confirmation_record,confirmation_participant,duty,receipt judgment freeze (scope proof first)",
      "30-36": "operating_head,baseline,contract,term,commercial baseline,receipt,receipt accounting basis",
      "37": "all E labor rate-family advisory keys (person/role) for complete source set, sorted lexical via existing family_locks; never acquire one family per source after cost locks",
      "38": "real labor rate versions/current family rows in stable UUID order",
      "39": "actual business source rows in registered Payable->Payment->Invoice->Expense family order, stable UUIDs",
      "40-42": "assignment,assignment participants,assignment freeze payload",
      "50-55": "stage,acceptance,completion,conditions,closure,archive",
      "60-63": "shared allocation operation,basis,result,source-snapshot full batch",
      "70-73": "actual cost,cost governance,stage attribution,tax treatment",
      "80-81": "inclusion decision/head; verify all source-set/primary-chain overlaps under prior source locks",
      "90-94": "immutable context/snapshot/period/restatement/evidence; existing predecessors first, inserted rows don't invert locks",
      "100-112": "DMER,OSER,signal review,current four-stage bindings,gate review,source/review summaries,command receipt"
    },
    "lockRule": "One Root-owned rank registry used by new G/H/I and touched E/F restatement branches; within family sort stable UUIDs. Borrowed helper may reacquire already-owned rows, never lock an earlier unowned family. Final source-set discovery after global batch locks; expansion restarts outer TX, no incremental project locking.",
    "noNestedTransactions": true,
    "noGSnapshotWritebackFromManualReview": true
  },
  "policy": {
    "version": "r4h-operating-v1",
    "maturity": [
      "insufficient if necessary effective contract/confirmed receipt basis/explicit classified cost scope/factual layer missing. Ordinary review cannot change this. Official eligibility guard applies separately.",
      "preliminary if necessary evidence exists but pending/unmapped/tax/allocation/restatement uncertainty remains, even when its qualitative materiality has been reviewed.",
      "mature only complete classified known current-scope sources with no pending gaps/corrections/restatements; maturity is not risk normality."
    ],
    "formulas": [
      "grossMarginNet=confirmedReceiptNet-includedCostNet; margin ratio denominator confirmedReceiptNet",
      "zero known receipt denominator=>null rate/zero-denominator; unknown=>null/missing-evidence; immature ratios explicitly unstable",
      "low receipt ratio exact comparison confirmed gross cash/effective contract gross <0.20, same frozen currency/gross layer; no tax-layer mixing",
      "extreme margin ratio <-1 or >1; exact -1/1 not extreme by this rule. No fabricated abnormal-jump threshold."
    ],
    "risk": [
      "Auto risk/alert for proven negative margin only when known facts, mature, receipt ratio>=0.20 and receipt net>0. Independent authoritative cost BLOCK survives regardless receipt ratio.",
      "Negative observed margin at low/zero receipts or immature data => qualitative-materiality-unassessed, unknown risk/signal and explicit manual review; preserve independent cost/formula/maturity/restatement actions.",
      "Any adverse positive cost variance or pending impact with only qualitative materiality adds unassessed review. No invented amount/percentage threshold. Verified manual review classifies only exact qualitative issues normal/attention/risk, not facts or maturity.",
      "normal only complete facts and no automatic risk/attention or unresolved qualitative issues. unknown never means normal or confirmed release."
    ],
    "ruleRows": [
      {
        "id": "H01",

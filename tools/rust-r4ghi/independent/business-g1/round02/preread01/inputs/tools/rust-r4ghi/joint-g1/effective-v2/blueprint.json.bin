    "aggregate": "Project=max(costAction floor, all project candidates). Four gates independently max per-stage including explicit H09/H10 standalone-cost mappings; do not copy project action. Persist all reasons and flag all equal-max project/stage primaries; sort code/evidenceHash.",
    "manual": "Manual materiality review may resolve unknown qualitative issues to an evidenced classification. It cannot replace automatic/proven normal-attention-risk findings, downgrade source floor/BLOCK, change maturity or supply missing hard facts. Generic exception downgrade excluded pending separate authorized approval/expiry baseline."
  },
  "reviews": {
    "signal": [
      "Require session/CSRF/finance action and source-derived sensitive-write permissions; expectedVersion/sourceHash/evaluationHash/requestKey all mandatory.",
      "Lock project+evaluation, compare every source assertion, CAS OSER WHERE version+active and increment version even child-only review. System generated values stay immutable.",
      "Append unique-active signal review with actor/rationale/source+effective hashes; regenerate all four current bindings/source summaries under effective overlay sameTX. Old binding reviews become historical/stale."
    ],
    "gate": [
      "Lock exact current project/stage/binding; validate source assertions, complete blocking codes and source summary exact target/project/stage/source/evaluation/policy hashes/package/projection/export.",
      "bindingAction is pre-review assertion. acknowledge preserves action; tighten-review/block only increases severity. Decision is server assertion: block=>blocked, incomplete evidence/materiality=>review-required, otherwise confirmed when exact human duties satisfied.",
      "Advice REVIEW may stay REVIEW after confirmed manual review; confirmed means review satisfied, not payout authorization. BLOCK cannot be confirmed away.",
      "CAS binding; append single-active gate review and produce new reviewed summary+projection+payload. Request summarySnapshotId asserted pre-review source summary; response points to new reviewed summary.",
      "Preallocate review ID in immutable summary payload then insert review FK to summary, avoiding FK cycle; never rewrite prior summary payload/projections."
    ],
    "summary": {
      "approvalScenarioKey": "commission-gate-review",
      "summaryPackageKey": "project-operating-commission-gate-v1",
      "projectionLevel": "commission-gate-review",
      "exportPolicy": "internal-only",
      "fieldRuleVersion": "r4h-operating-v1",
      "targetType": "operating-signal-gate-binding",
      "targetId": "exact binding UUID",
      "identity": [
        "projectId",
        "gateStageType",
        "snapshotId",
        "sourceHash",
        "policyVersion",
        "policyHash",
        "evaluationHash",
        "signalEvaluationId",
        "signalReviewRecordId",
        "bindingId",
        "bindingRowVersion",
        "gateReviewRecordId|null",
        "sourceSummarySnapshotId|null"
      ],
      "data": "Authorized field projections and internal immutable payload/hash only; e2e-v1 package never production."
    },
    "idempotency": "scope operation+targetScope+actor+requestKey. Hash validated body+source/evaluation/policy. Exact authenticated same-actor committed replay before stale CAS returns receipt, changed payload conflicts. Receipt/audit sameTX."
  },
  "period": {
    "timezone": "Asia/Hong_Kong (existing business pipeline); do not change DB timezone",
    "acceptedKeys": "Valid actual YYYY-MM or ISO YYYY-Www, reject impossible week 53 and future unfinished period",
    "accumulation": "Cumulative project inception through periodEnd; sourceWindowStart=null explicitly means all history, sourceWindowEnd=periodEnd. UI says cumulative, not period-only increment.",
    "capture": "knowledgeCutoff is actual coherent source collection time; normal closing uses then-known effective producers; original period context never rewritten",
    "laterFacts": "Restatement retains exact old business cutoff, advances knowledgeCutoff, names actual late/corrected producers; historical status/source histories must be reconstructible or publication rejects",
    "shared": "Normal freeze requires actual F result already effective and all real source members in scope. Explicit restatement may adopt later-effective full F batch when every member actually occurred by old cutoff, marked late-recognized with both dates. Cross-cutoff mixed batch cannot be partially inferred; needs actual F period-split producer or missing-evidence."
  },
  "baselineAmounts": "originalBaselineCost = earliest formally adopted PROJECT estimate net; handoverBaselineCost = exact adopted handover effective project estimate net (or original when no absorbed rebaseline); executionChangePackageTotal = sum approved post-execution successor net minus predecessor net once each; changePackageTotal compatibility = handoverBaselineCost-originalBaselineCost+executionChangePackageTotal; currentEffectiveBaselineCost=handoverBaselineCost+executionChangePackageTotal. Keep all components distinct in source payload/UI; original never overwritten.",
  "inclusion": {
    "persistence": "Append project_cost_inclusion_decision + CAS project_cost_inclusion_head. Per-snapshot operating_snapshot_cost_member immutable; copying same actual decision into later snapshot does not reinclude or reprice it.",
    "directProducer": "UPDATE project_actual_cost_record SET record_status='included',is_included_in_project_cost=true,included_at=now(),included_by=actor,row_version=row_version+1 WHERE id=... AND row_version=expected AND record_status='confirmed' AND NOT is_included_in_project_cost RETURNING ...; exactly one row, after real qualification.",
    "includedMeaning": "Sticky consumed-ever fact; never reset flag/status to confirmed merely to bypass E/F guards. Live inclusion head can only change through explicit restatement when previously published inclusion changes. Replaced old record remains historical flag=true,status=replaced; original membership never changes.",
    "sharedProducer": "Do not flip confirmed shared pool source to included as full direct cost. CAS actual F result is_included_in_project_cost=true/included_at/by and increment result row_version, record causal metadata transition; membership consumes only result project share.",
    "exclusion": "Unconsumed candidate exclude creates reasoned classification only, no included cost flag; explicit registered/no-stage exclusion is pending/not-yet-applicable and H retains gap. New source candidates cannot disappear from exhaustive scope.",
    "ordinaryReplacement": "E direct labor replace, F stage/tax/whole-allocation replace and C source mutation must check actual consumed membership; normal paths return 409 operating_restatement_required if changing a consumed factual component. No fake reset/uninclude.",
    "restatementReplacement": "Sealed four-kind permit; All real F/E source changes, classifications, all G contexts/snapshots/period/restatements, H evaluations/four gates/summaries, audit/security/pending-auth one borrowed CommonSession/outerTX. Capacity preinsert422 rolls everything back. Original published snapshots/context bytes never rewritten.",
    "bound": "Unsupported non-labor source correction stays blocked until its real upstream producer exists; G accepts only actual corrected source IDs/versions, never correction money. Do not invent a refund/source row or certify a fixture."
  },
  "receiptBasis": {
    "route": "Existing POST /api/receipt-records/{id}:confirm / ContractFinanceController_confirmReceiptRecord, 200",
    "targetDto": "ConfirmReceiptRecordRequest in target-dto.schema.json, mandatory expectedVersion",
    "confirm": "pending-confirmation only; exact selected real same-contract activated terms + currency evidence + expected versions; derive cents_net=HALF_UP(gross_cents*10000/(10000+rate4)), tax=gross-net; insert immutable basis and CAS receipt confirmed in caller outerTX with audit/auth",
    "historicalCertification": "mode certify-existing-basis requires status confirmed and no existing basis; explicit original same-contract terms/currency evidence, actor/reason/evidence refs, scoped attachment/activation validation; do not change receiptAmount/date/status/confirmedAt/confirmedBy. CAS receipt row_version+1, append basis+create audit atomically. No infer-from-current-rate, no zero backfill.",
    "snapshotSelection": "UI default can nominate uniquely proven receipt-date effective snapshot. Otherwise operator must explicitly select actual previously activated terms and documentary evidence; server verifies identity/version/hash and actual approval lineage, never chooses latest/current silently. A legacy term missing tax/currency authority cannot be repaired by guessing in this command.",
    "currency": "Certified activation commercial baseline currency plus same-contract immutable-after-draft currency check; optional new term snapshot currency_code frozen by actual activation for future rows. Legacy rows remain null unless same-command explicit source evidence proves it, never migration mass backfill.",
    "immutable": "Single basis per receipt for this slice. Existing basis re-rate/correction needs a separately authorized correction semantic; reject instead of replacing current-rate basis. Historical operating contexts remain unknown until explicit new restatement consumes basis; no old context backfill."
  },
  "policyIdentity": {
    "file": "policy-definition.json",
    "policyVersion": "r4h-operating-v1",
    "policyHash": "7e9cfcedc496bd5d4ffd6fc158371e3db069110798926c63a5156ee4614a1aec",
    "canonicalBytes": 4723,
    "algorithm": "same sorted-key/preserved-array compact JSON SHA-256 as contract_support::canonical_hash; Root/H must verify compiled policy constant against pinned artifact before G3"
  },
  "scope": {
    "version": "project-scope-v1-direct-relations",
    "source": "tools/rust-r4ghi/I/final-g1/refinements03.json",
    "freshActor": "actor.id=session.user.user_id=session.user_snapshot.id; DB platform_user active; guard permission exact; cached profile organization is not a grant",
    "membership": "fresh active user_org_membership, revoked_at IS NULL, type primary/secondary, JOIN org_unit.is_active=true",
    "OwnerRead": "project.owner_user_id=actor.id; old missing-org permits only non-sensitive anchor read",
    "OwnerWrite": "OwnerRead AND active project.owner_org_id AND actor has exact current membership in that org",
    "Part": "exact current producer_version=1 handover draft/confirmed + basis matching project/current sales owner + actual confirmation/participant/duty joins; verify frozen payload/hash",
    "ConfirmedDuty": "Part AND handover/confirmation/self participant all confirmed; EO also equals handover.execution_owner_user_id",
    "DelegatedWrite": "active project ownerOrg AND actor at least one active org membership AND exact required ConfirmedDuty; cross-department explicit duty permitted",
    "OwnCondition": "true parent-completion/condition/project match; v1 conditional completion; actor strictly condition.responsible_user_id; active membership+ownerOrg; own-task scope only",
    "Bootstrap": "Only the new explicit project_ownership_origin fact can authorize creator's first personal assignment. Direct create starts consumed. Never infer neverPersonal from current NULL, empty reassignment history, role, or org membership. Old missing-origin stays fail-closed.",
    "actions": {
      "read": "route permission AND (OwnerRead OR Part); condition-only returns only own completion/task minimal view",
      "draft": "commission:assignments:manage AND OwnerWrite",
      "freeze": "commission:assignments:manage AND (OwnerWrite OR DelegatedWrite+BA)",
      "execution-entry": "project:write AND DelegatedWrite+EO",
      "acceptance-entry/acceptance/completion": "project:write AND DelegatedWrite+EO consistent with true execution stage owner",
      "archive": "project:write AND (OwnerWrite OR DelegatedWrite+(EO OR BA))",
      "condition-close-own-only": "project:write AND OwnCondition; current owner/admin cannot act as responsible user",
      "prepare": "project:write AND OwnerWrite before applying requested participants",
      "participant-confirm": "project:read AND Part AND self-confirmation; preserve D7 permission",
      "handover-finalize/rebaseline": "project:write AND (OwnerWrite OR DelegatedWrite+BA)",
      "reassignOwner": "project:write AND pre-change OwnerWrite, OR precise unconsumed creator bootstrap from I final origin fact; lock old project before deciding",
      "operating-read": "contract:finance:manage AND (OwnerRead OR Part); no ConditionOnly finance expansion; exact sensitive projections still apply",
      "operating-write": "contract:finance:manage AND (OwnerWrite OR DelegatedWrite+ConfirmedDuty(finance) OR DelegatedWrite+BA); Root explicitly adopted in this assignment. BA is the actual current handover duty, never a platform roleKey",
      "first-assignment-anchor": "project:read AND exact CreatorFirstAssignmentOnly; strict minimal DTO, no finance/commission scope"
    },
    "denials": "same org/ancestor org/admin roleKey/is_system_role/project:write/finance permission alone grants no project scope; no manufactured new manager/setting/seed",
    "errors": {
      "outsideScope": 404,
      "insideScopeWrongAction": 403,
      "changedSourceOrCAS": 409,
      "invalidShape": 400,
      "databaseFailure": 500
    },
    "listFiltering": "SQL relation predicate before projection/pagination. OwnCondition-only filters conditions to own while whole-parent conditionStatus derives all real conditions.",
    "proof": "private nonserializable ProjectAccessProof, bound to actor/project/action/current facts and caller TX; never body-supplied responsibilities; no second connection/cache"
  },

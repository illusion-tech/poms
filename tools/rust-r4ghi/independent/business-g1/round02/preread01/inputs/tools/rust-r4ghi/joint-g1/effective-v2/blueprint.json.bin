  "supportingExistingOperations": [
    {
      "area": "C",
      "operationId": "ContractFinanceController_confirmReceiptRecord",
      "method": "POST",
      "canonical": "/receipt-records/{id}:confirm",
      "newHttp": false,
      "countDelta": 0,
      "dto": "ConfirmReceiptRecordRequest",
      "owner": "Root",
      "source": "tools/rust-r4ghi/G/final-g1/target-dto.schema.json#/$defs/ConfirmReceiptRecordRequest",
      "contract": {
        "route": "Existing POST /api/receipt-records/{id}:confirm / ContractFinanceController_confirmReceiptRecord, 200",
        "targetDto": "ConfirmReceiptRecordRequest in target-dto.schema.json, mandatory expectedVersion",
        "confirm": "pending-confirmation only; exact selected real same-contract activated terms + currency evidence + expected versions; derive cents_net=HALF_UP(gross_cents*10000/(10000+rate4)), tax=gross-net; insert immutable basis and CAS receipt confirmed in caller outerTX with audit/auth",
        "historicalCertification": "mode certify-existing-basis requires status confirmed and no existing basis; explicit original same-contract terms/currency evidence, actor/reason/evidence refs, scoped attachment/activation validation; do not change receiptAmount/date/status/confirmedAt/confirmedBy. CAS receipt row_version+1, append basis+create audit atomically. No infer-from-current-rate, no zero backfill.",
        "snapshotSelection": "UI default can nominate uniquely proven receipt-date effective snapshot. Otherwise operator must explicitly select actual previously activated terms and documentary evidence; server verifies identity/version/hash and actual approval lineage, never chooses latest/current silently. A legacy term missing tax/currency authority cannot be repaired by guessing in this command.",
        "currency": "Certified activation commercial baseline currency plus same-contract immutable-after-draft currency check; optional new term snapshot currency_code frozen by actual activation for future rows. Legacy rows remain null unless same-command explicit source evidence proves it, never migration mass backfill.",
        "immutable": "Single basis per receipt for this slice. Existing basis re-rate/correction needs a separately authorized correction semantic; reject instead of replacing current-rate basis. Historical operating contexts remain unknown until explicit new restatement consumes basis; no old context backfill."
      }
    },
    {
      "area": "B",
      "operationId": "existing contract term activation producer",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "On true activation freeze term.currency_code from actual linked CommercialReleaseBaseline and hash it. Legacy NULL remains NULL; no guessed current/latest tax/currency. Actual immutable term or actual commercial baseline rowVersion is currency authority; no fake ProjectHandoverContractBasis version."
    },
    {
      "area": "E/F",
      "operationId": "existing labor/source/stage/tax/allocation replacements",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": {
        "persistence": "Append project_cost_inclusion_decision + CAS project_cost_inclusion_head. Per-snapshot operating_snapshot_cost_member immutable; copying same actual decision into later snapshot does not reinclude or reprice it.",
        "directProducer": "UPDATE project_actual_cost_record SET record_status='included',is_included_in_project_cost=true,included_at=now(),included_by=actor,row_version=row_version+1 WHERE id=... AND row_version=expected AND record_status='confirmed' AND NOT is_included_in_project_cost RETURNING ...; exactly one row, after real qualification.",
        "includedMeaning": "Sticky consumed-ever fact; never reset flag/status to confirmed merely to bypass E/F guards. Live inclusion head can only change through explicit restatement when previously published inclusion changes. Replaced old record remains historical flag=true,status=replaced; original membership never changes.",
        "sharedProducer": "Do not flip confirmed shared pool source to included as full direct cost. CAS actual F result is_included_in_project_cost=true/included_at/by and increment result row_version, record causal metadata transition; membership consumes only result project share.",
        "exclusion": "Unconsumed candidate exclude creates reasoned classification only, no included cost flag; explicit registered/no-stage exclusion is pending/not-yet-applicable and H retains gap. New source candidates cannot disappear from exhaustive scope.",
        "ordinaryReplacement": "E direct labor replace, F stage/tax/whole-allocation replace and C source mutation must check actual consumed membership; normal paths return 409 operating_restatement_required if changing a consumed factual component. No fake reset/uninclude.",
        "restatementReplacement": "Existing operating-restatements handles live or period roots. Sealed internal RestatementPermit is produced only after true referenced snapshots/source hashes/versions and full affected-project set are locked. It allows actual E labor recalculation and F complete-batch replacement using real business inputs, fresh stage/source proof, predecessor links and all necessary G/H restatements atomically. It is never a client boolean.",
        "bound": "Unsupported non-labor source correction stays blocked until its real upstream producer exists; G accepts only actual corrected source IDs/versions, never correction money. Do not invent a refund/source row or certify a fixture."
      }
    },
    {
      "area": "D",
      "operationId": "ProjectHandoverController_prepareProjectHandover",
      "newHttp": false,
      "countDelta": 0,
      "owner": "Root",
      "contract": "Pre-change OwnerWrite first; verify actual approved activated contract/plan/pre-signing producer; insert stage handover or true handover requalification + project CAS in same outerTX. Never regress execution/acceptance/terminal and never authorize from body duties."
    },
    {
      "area": "D",

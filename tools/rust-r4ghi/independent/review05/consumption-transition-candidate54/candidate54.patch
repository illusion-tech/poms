+/// Composite allocation-source rows have no independent UUID. Preserve their
+/// existing cost-id/version plus full basis-bound factual hash identity.
+pub(crate) fn allocation_source_reference(
+    row: &Value,
+) -> Result<crate::project_operating_common::model::SourceRef, Error> {
+    serde_json::from_value(reference(Table::AllocationSource, row)?).map_err(|_| Error::Internal)

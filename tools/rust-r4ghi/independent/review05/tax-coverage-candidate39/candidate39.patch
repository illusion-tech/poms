+#[test]
+fn an_assessed_second_cost_does_not_turn_the_first_unassessed_tax_into_known_zero() {
+    let mut context = partially_assessed_tax_fixture();
+    assert_metrics(&context).expect("mixed coverage stays unknown");
+    let result = derive(&context);
+    assert_eq!(
+        result.cost_readiness.known_metric_states.tax_pending,
+        Knowledge::Unknown
+    );
+    assert_eq!(
+        result.cost_readiness.data_maturity_level,
+        OperatingDataMaturityLevel::Preliminary
+    );
+    assert!(
+        result
+            .all_reasons
+            .iter()
+            .any(|reason| reason.rule_id == "H02")
+    );
+    context.metrics.tax_pending_amount =
+        serde_json::from_value(amount(12_345)).expect("forged partial total");
+    refresh(&mut context);
+    assert!(assert_metrics(&context).is_err());
+}
+#[test]
+fn complete_distinct_cost_assessments_sum_real_pending_values_not_source_tax() {
+    let mut context = partially_assessed_tax_fixture();
+    let reference = source("AccountingTaxTreatmentSnapshot", 79);
+    context.costs[0]
+        .tax_treatment_refs
+        .push(serde_json::from_value(reference.clone()).expect("C1 relation"));
+    context.tax_treatments.push(serde_json::from_value(json!({"taxTreatmentRef":reference,"evidenceRefs":[source("CostGovernanceEvidence",80)],"deductibility":"pending","pendingAmount":amount(5_000),"recognizedAdjustmentNet":amount(0),"adjustmentOverlapKey":"tax:79","containsLabor":"no"})).expect("C1 actual assessment shape"));
+    context.metrics.tax_pending_amount =
+        serde_json::from_value(amount(17_345)).expect("exact actual pending sum");
+    refresh(&mut context);
+    assert_metrics(&context).expect("all taxed sources covered by actual distinct refs");
+    context.costs[0].tax_treatment_refs[0].row_version = 2;
+    refresh(&mut context);
+    assert!(assert_metrics(&context).is_err());
+    context.metrics.tax_pending_amount = unassessed_taxed_expense_fixture()
+        .metrics
+        .tax_pending_amount;
+    refresh(&mut context);
+    assert_metrics(&context).expect("stale ref is unknown, not coverage");
+}
+#[test]
+fn excluded_taxed_source_remains_in_the_frozen_tax_scope() {
+    let mut context = partially_assessed_tax_fixture();
+    context.costs[0].classification.decision =
+        serde_json::from_value(json!("exclude")).expect("exclude");
+    context.metrics.included_cost_amounts = context.costs[1].amounts.clone();
+    context.metrics.excluded_cost_amounts = context.costs[0].amounts.clone();
+    context.metrics.gross_margin_net = serde_json::from_value(amount(9_900_000)).expect("margin");
+    context.metrics.gross_margin_rate =
+        serde_json::from_value(ratio(9_900_000, 10_000_000)).expect("ratio");
+    context.metrics.cost_variance_net = serde_json::from_value(amount(-400_000)).expect("variance");
+    context.scope.included_cost_count = 1;
+    context.scope.excluded_cost_count = 1;
+    refresh(&mut context);
+    assert_metrics(&context).expect("excluded source tax does not disappear");
+    context.metrics.tax_pending_amount =
+        serde_json::from_value(amount(12_345)).expect("unrelated partial total");
+    refresh(&mut context);
+    assert!(assert_metrics(&context).is_err());
+}

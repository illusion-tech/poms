  "findings": [
    {
      "id": "IR110-01",
      "priority": "P2",
      "line": 43,
      "problem": "A masked actor can self-label present data full-null/not-applicable without comparison to the fully authorized same projection path. G non-Labor nodes are skipped entirely, so denied independent contract projection also passes the positive control.",
      "pureCounterexamples": {
        "fullMNonzeroAndFalseAbsentEAccepted": true,
        "noLaborGDeniedAccepted": true
      },
      "fix": "Pair M/E sameoperation/params/query by projection path. True absent exception must match actual full-side absence. Explicit independent no-Labor sources must remain Full under FinanceS, with same value; protect Labor/unknown derived group without overmasking those independent sources."
    },
    {
      "id": "IR110-02",
      "priority": "P2",
      "line": 52,
      "problem": "audit500 only checks missing financialProjection; extra financial/raw fields in the error pass. Generic faultAndRetry excludes audit/security/platform_user changes. Successful event details check only three literal raw-key names and accepts unknown nested raw operands.",
      "pureCounterexamples": {
        "leaky500WithOtherFinancialKeyAccepted": true,
        "nestedRawDetailsAccepted": true,
        "auditSecurityMutationExcludedByGenericBusinessFilter": true
      },
      "fix": "Use exact canonical internal500 body; separately verify failed full rollback with only the actual caller session exact raw-touch allowance, never audit/security blanket exemptions. Validate successful security_event details against exact SSOT allowed keys/types and no unknown/nested raw values."
    }
  ],

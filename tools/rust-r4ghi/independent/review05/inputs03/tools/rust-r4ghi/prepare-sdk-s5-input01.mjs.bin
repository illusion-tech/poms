// Prepare reviewable, immutable generator input. This tool does not commit.
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
const require=createRequire(import.meta.url),ts=require('typescript');
const root=process.cwd(),out='tools/openapi/checkpoints/r4ghi-s5';
assert(!fs.existsSync(out));
const oldBaseline=JSON.parse(fs.readFileSync('tools/openapi/shared-api-client-baseline.json'));
assert.equal(oldBaseline.sourceHead,'4f0ad88e78622a75b88b4e3cc72aded9da67458a');
execFileSync('git',['merge-base','--is-ancestor',oldBaseline.sourceHead,'HEAD']);
const head=execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
const config=ts.readConfigFile('apps/poms-api/tsconfig.app.json',ts.sys.readFile);
assert(!config.error);
const parsed=ts.parseJsonConfigFileContent(config.config,ts.sys,path.resolve('apps/poms-api'));
assert.equal(parsed.errors.length,0);
const program=ts.createProgram(parsed.fileNames,{...parsed.options,noEmit:true});
const errors=ts.getPreEmitDiagnostics(program).filter(d=>d.category===ts.DiagnosticCategory.Error);
assert.equal(errors.length,0,'Complete current API typecheck must pass before S5 input capture');
const protectedFiles=oldBaseline.protectedSources.map(x=>x.file);
assert.equal(protectedFiles.length,6);
const extras=['apps/poms-api/tsconfig.app.json','tsconfig.base.json','docs/design/rust-r4ghi/g1-online01.json','docs/design/rust-r4ghi/operation-map01.json','docs/design/rust-r4ghi/g2-public-delta01.json','docs/design/rust-r4ghi/g2-public-delta02.json','tools/rust-r4ghi/joint-g1/effective-v2/public-contracts.schema.json','tools/openapi/strict-jsonschema-oas30.cjs'];
const sources=program.getSourceFiles().map(f=>path.relative(root,f.fileName).replaceAll('\\','/')).filter(f=>!f.startsWith('../')&&!f.includes('/node_modules/')&&!f.startsWith('node_modules/')&&fs.statSync(f).isFile());
const files=[...new Set([...protectedFiles,...extras,...sources])].sort();
const sha=b=>createHash('sha256').update(b).digest('hex');
const spec=JSON.parse(fs.readFileSync('libs/shared/api-spec/openapi.json'));
const methods=new Set(['get','post','put','patch','delete','head','options','trace']);
const operations=Object.entries(spec.paths).flatMap(([p,verbs])=>Object.entries(verbs).filter(([m])=>methods.has(m)).map(([m,o])=>({method:m.toUpperCase(),path:p,operationId:o.operationId}))).sort((a,b)=>(a.path+' '+a.method).localeCompare(b.path+' '+b.method));
assert.equal(new Set(operations.map(o=>o.operationId)).size,296);assert.equal(operations.length,296);assert.equal(Object.keys(spec.paths).length,242);assert.equal(Object.keys(spec.components.schemas).length,689);
assert(spec.components.schemas.FullProjectDetailView.required.includes('executionAdmissionContext'));
fs.mkdirSync(out,{recursive:true});fs.writeFileSync(out+'/.gitattributes','* -text\n',{flag:'wx'});
const inputs=files.map((file,index)=>{const bytes=fs.readFileSync(file),snapshot='inputs/'+String(index+1).padStart(4,'0')+'.bin';fs.mkdirSync(path.dirname(out+'/'+snapshot),{recursive:true});fs.writeFileSync(out+'/'+snapshot,bytes,{flag:'wx'});return{file,snapshot,bytes:bytes.length,rawBytesSHA256:sha(bytes),normalizedTextSHA256:sha(Buffer.from(bytes.toString('utf8').replace(/\r\n/g,'\n')))};});
assert(inputs.every(p=>sha(fs.readFileSync(p.file))===p.rawBytesSHA256),'S5 sources moved during capture');
const manifest={kind:'G2-complete-SDK-input-candidate-not-product-G3',capturedAt:new Date().toISOString(),parentHead:head,permanentS4:oldBaseline.sourceHead,S5InputCommitPending:true,protectedSources:protectedFiles,inputs,inventory:{openapi:spec.openapi,paths:Object.keys(spec.paths).sort(),operations,schemas:Object.keys(spec.components.schemas).sort()},generator:oldBaseline.generator,handManagedMetadata:oldBaseline.client.metadata,typescript:{version:ts.version,currentApiTypeErrors:0},formalRustDelivered:240,G3Certified:false,G4Certified:false};
fs.writeFileSync(out+'/input-manifest01.json',JSON.stringify(manifest,null,2)+'\n',{flag:'wx'});
console.log(JSON.stringify({directory:out,inputs:inputs.length,counts:{paths:242,operations:296,schemas:689},S4Unchanged:true,commitCreated:false,productG3:false}));

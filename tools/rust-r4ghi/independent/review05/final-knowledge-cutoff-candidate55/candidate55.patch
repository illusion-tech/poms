+fn final_collection_window(
+    original: &OperatingBusinessWindow,
+    governed_write: bool,
+    completed_at: UtcInstant,
+) -> OperatingBusinessWindow {
+    let mut finalized = original.clone();
+    if governed_write {
+        finalized.knowledge_cutoff = completed_at;
+    }
+    finalized

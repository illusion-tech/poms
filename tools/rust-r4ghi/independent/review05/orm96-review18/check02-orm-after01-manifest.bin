          "constraints": [
            "{\"oid\":\"26109\",\"schema\":\"poms\",\"table_name\":\"acceptance_record\",\"conname\":\"acceptance_new_producer_check\",\"definition\":\"CHECK (producer_version = 0 OR producer_version = 1 AND source_stage_record_id IS NOT NULL AND source_payload_hash IS NOT NULL AND source_payload_hash::text ~ '^[0-9a-f]{64}$'::text AND confirmed_by IS NOT NULL AND confirmed_at IS NOT NULL AND (acceptance_type::text = ANY (ARRAY['stage-outcome'::character varying, 'stage-acceptance'::character varying, 'final-acceptance'::character varying]::text[])) AND (acceptance_result::text = ANY (ARRAY['accepted'::character varying, 'conditional'::character varying, 'rejected'::character varying]::text[])) AND (acceptance_result::text <> 'conditional'::text OR conditional_summary IS NOT NULL AND length(btrim(conditional_summary)) > 0))\"}",
            "{\"oid\":\"18752\",\"schema\":\"poms\",\"table_name\":\"acceptance_record\",\"conname\":\"acceptance_record_pkey\",\"definition\":\"PRIMARY KEY (id)\"}",
            "{\"oid\":\"18753\",\"schema\":\"poms\",\"table_name\":\"acceptance_record\",\"conname\":\"acceptance_record_project_id_foreign\",\"definition\":\"FOREIGN KEY (project_id) REFERENCES poms.project(id) ON UPDATE CASCADE ON DELETE RESTRICT\"}",
            "{\"oid\":\"26104\",\"schema\":\"poms\",\"table_name\":\"acceptance_record\",\"conname\":\"acceptance_record_source_stage_record_id_fkey\",\"definition\":\"FOREIGN KEY (source_stage_record_id) REFERENCES poms.project_stage_record(id) ON DELETE RESTRICT\"}",
            "{\"oid\":\"26509\",\"schema\":\"poms\",\"table_name\":\"acceptance_record\",\"conname\":\"fk_jghi_acceptance_stage_project\",\"definition\":\"FOREIGN KEY (source_stage_record_id, project_id) REFERENCES poms.project_stage_record(id, project_id) NOT VALID\"}",
            "{\"oid\":\"26476\",\"schema\":\"poms\",\"table_name\":\"acceptance_record\",\"conname\":\"uq_jghi_acceptance_project\",\"definition\":\"UNIQUE (id, project_id)\"}",
            "{\"oid\":\"20954\",\"schema\":\"poms\",\"table_name\":\"accounting_tax_treatment_snapshot\",\"conname\":\"accounting_tax_treatment_snapshot_governance_evidence_id_fkey\",\"definition\":\"FOREIGN KEY (governance_evidence_id) REFERENCES poms.cost_governance_evidence(id)\"}",
            "{\"oid\":\"17876\",\"schema\":\"poms\",\"table_name\":\"accounting_tax_treatment_snapshot\",\"conname\":\"accounting_tax_treatment_snapshot_project_id_foreign\",\"definition\":\"FOREIGN KEY (project_id) REFERENCES poms.project(id)\"}",

+    updatedAnchors: [{ table: 'project_completion_record', id: parentId, requestBinding: 'path:completionRecordId' }, { table: 'project_completion_condition', id: fresh.params.id, requestBinding: 'path:id' }] });
+  record.refreshedLoser = { phase: 'success-proof-pending', receipt: response.receiptId, before: response.before, after: response.after }; ctx.persist();
+  const closed = data(response); assert.equal(closed.completionConditionStatus, 'closed'); assert.notEqual(closed.closureRecordId, data(result.winner).closureRecordId);
+  const rows = await ctx.db(async c => (await c.query('SELECT condition_status,completion_result,row_version,(SELECT count(*)::int FROM poms.project_completion_condition c WHERE c.completion_record_id=p.id AND c.status=\'closed\') closed_count,(SELECT count(*)::int FROM poms.project_completion_condition_closure r WHERE r.completion_record_id=p.id) closure_count FROM poms.project_completion_record p WHERE p.id=$1::uuid AND p.project_id=$2::uuid', [parentId, prepared.projectId])).rows);
+  assert.equal(rows.length, 1); assert.equal(rows[0].condition_status, 'closed'); assert.equal(rows[0].completion_result, 'conditional-completed'); assert.equal(rows[0].closed_count, 2); assert.equal(rows[0].closure_count, 2);
+  record.refreshedLoser.phase = 'verified'; record.result = { kind: 'actual-A07-two-different-tasks-parent-CAS-and-server-aggregate', projectId: prepared.projectId, parentId, race: result.proof,
+    explicitFreshParentRetry: response.receiptId, finalActual: rows, actualTwoOriginalCASRequestsHadOnlyOneWinner: true, finalAggregateAfterBothActualClosuresOnly: true,
+    originalConditionalResultAndA05MoneyUnchanged: true, oldProducerViewWritten: false, G3Certified: false, G4Certified: false }; ctx.persist(); return record.result;
+}
diff --git a/tools/rust-r4ghi/business/run-lifecycle57.mjs b/tools/rust-r4ghi/business/run-lifecycle57.mjs
new file mode 100644
--- /dev/null
+++ b/tools/rust-r4ghi/business/run-lifecycle57.mjs
@@ -0,0 +1,27 @@
+#!/usr/bin/env node
+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+import { pathToFileURL } from 'node:url';
+import { createContext, FIXED } from './context.mjs';
+import { sha, segment, safeFailure } from './pure.mjs';
+export async function main(argv = process.argv.slice(2)) {
+  if (argv.length === 1 && argv[0] === '--help') { console.log('Root only: run-lifecycle57.mjs EPOCH RUN same-task|cross-parent|sensitive-get|prepare-two-task|different-tasks; current actual retained consumer context and source pins required. No import/help I/O.'); return; }
+  assert.equal(argv.length, 3); const epoch = segment(argv[0]), run = segment(argv[1]), mode = argv[2];
+  assert(['same-task', 'cross-parent', 'sensitive-get', 'prepare-two-task', 'different-tasks'].includes(mode)); assert.equal(process.platform, 'linux');
+  const lock = `${FIXED.private}/business/${epoch}/${run}/driver.lock`; assert(!fs.existsSync(lock), 'Wait for Root102/lifecycle/UI driver to end');
+  const ctx = createContext({ epoch, run }); fs.writeFileSync(lock, JSON.stringify({ pid: process.pid, mode: `lifecycle57-${mode}` }) + '\n', { flag: 'wx', mode: 0o600 });
+  let label;
+  try {
+    assert(ctx.state.baseline && !ctx.state.activeFault && !ctx.state.blockedObservation && !ctx.state.cleaned);
+    const pins = JSON.parse(fs.readFileSync(new URL('./lifecycle-sources57.json', import.meta.url)));
+    for (const pin of pins) assert.equal(ctx.pins.find(value => value.file === pin.file)?.sha256, pin.sha256, `Actual A07 source changed: ${pin.file}`);
+    const { ownSameTask57, crossParent57, sensitiveGet57 } = await import('./lifecycle-cases57.mjs');
+    const { prepareTwoTask57, differentTasks57 } = await import('./lifecycle-two-task57.mjs');
+    label = ctx.next(`a07-${mode}`); ctx.persist(); ctx.artifact(`${label}-intent.json`, { kind: 'Root-actual-A07-mode-intent', mode, sourcePins: ctx.pins, helperPins: ctx.helperPins });
+    const result = await ({ 'same-task': ownSameTask57, 'cross-parent': crossParent57, 'sensitive-get': sensitiveGet57, 'prepare-two-task': prepareTwoTask57, 'different-tasks': differentTasks57 }[mode])(ctx);
+    const receipt = ctx.artifact(`${label}-complete.json`, result, { kind: 'actual-A07-mode-complete', mode, G3Certified: false, G4Certified: false }); console.log(JSON.stringify({ status: 'completed', mode, receipt, G3Certified: false, G4Certified: false }));
+  } catch (error) {
+    const original = ctx.artifact(`${ctx.next('a07-partial')}.json`, { name: error.name, message: error.message, stack: error.stack, mode }); console.error(JSON.stringify({ ...safeFailure(error), mode, original })); process.exitCode = 1;
+  } finally { const owner = JSON.parse(fs.readFileSync(lock)); assert.equal(owner.pid, process.pid); fs.unlinkSync(lock); }
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) await main();
diff --git a/tools/rust-r4ghi/business/lifecycle57.test.mjs b/tools/rust-r4ghi/business/lifecycle57.test.mjs
new file mode 100644
--- /dev/null
+++ b/tools/rust-r4ghi/business/lifecycle57.test.mjs
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { exactPath } from './pure.mjs';
+import { lifecycleConsumer57, ownTask57, taskBody57 } from './lifecycle-consumer57.mjs';
+import { blockedByControl } from './creator-proofs.mjs';
+const a = '11111111-1111-4111-8111-111111111111', b = '22222222-2222-4222-8222-222222222222', c = '33333333-3333-4333-8333-333333333333';
+test('A07 dual UUID request never substitutes child for parent', () => {
+  assert.equal(exactPath('/api/project-completion-records/{completionRecordId}/conditions/{id}:close', { completionRecordId: a, id: b }), `/api/project-completion-records/${a}/conditions/${b}:close`);
+});
+test('task body uses actual minimal own-list parent and child CAS, with no FullProject read', async () => {
+  const calls = [], body = { scopeKind: 'own-condition-only', projectId: a, items: [{ completionRecordId: b, completionRowVersion: 4, ownTasks: [{ conditionId: c, conditionRowVersion: 2, responsibleUserId: 'actor', status: 'pending' }] }] };
+  const ctx = { state: { fixtures: { project: { id: a } }, actors: { unrelated: { id: 'actor' } } } }, api = { request: async (...args) => { calls.push(args); return { body, receiptId: 'actual' }; } };
+  const result = await taskBody57(ctx, api, 'unrelated', b, a); assert.equal(result.body.expectedCompletionVersion, 4); assert.equal(result.body.expectedConditionVersion, 2);
+  assert.deepEqual(result.params, { completionRecordId: b, id: c }); assert.equal(calls.length, 1); assert.equal(calls[0][0], 'ProjectController_listProjectCompletionRecords');
+  assert.throws(() => ownTask57({ body }, 'other', b));
+});
+test('consumer check upload and closure metadata never mutate retained Own/A05 producer fixtures', () => {
+  const state = { fixtures: { uiFixtureViews23: { own: { original: true } }, a05Boundaries26: { original: true } }, owned: {}, actors: {} }, before = JSON.stringify(state.fixtures);
+  let serialized; const root = { state, persist: () => { serialized = JSON.stringify(state); } }, view = lifecycleConsumer57(root, 'same-task', a);
+  view.ctx.state.fixtures.uploads.example = { actualReceipt: 'real-upload' }; view.ctx.persist();
+  assert.equal(JSON.stringify(state.fixtures), before); assert(serialized.includes('actualReceipt')); assert.equal(view.ctx.state.owned, state.owned);
+  assert.throws(() => { view.ctx.state.fixtures = {}; });
+});
+test('two real waiters may be blocked indirectly by the project lock ahead of controlled parent', () => {
+  const graph = [{ pid: 1, blocked_by: [9] }, { pid: 2, blocked_by: [1] }, { pid: 3, blocked_by: [] }];
+  assert(blockedByControl(1, graph, 9)); assert(blockedByControl(2, graph, 9)); assert(!blockedByControl(3, graph, 9));
+});

        "type": "object",
        "properties": {
          "providerType": {
            "$ref": "#/components/schemas/AttachmentStorageProviderType"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "enabled": {
            "type": "boolean"
          },
          "isDefault": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "nullable": true
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "nullable": true

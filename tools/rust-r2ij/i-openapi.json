        "required": [
          "id",
          "providerType",
          "displayName",
          "status",
          "enabled",
          "isDefault",
          "endpoint",
          "region",
          "bucket",
          "keyPrefix",
          "forcePathStyle",
          "accessKeyConfigured",
          "secretAccessKeyConfigured",
          "credentialsUpdatedAt",
          "rowVersion",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy"

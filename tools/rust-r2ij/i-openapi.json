          "bucket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "nullable": true
          },
          "keyPrefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "nullable": true
          },
          "forcePathStyle": {
            "type": "boolean"
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "providerType",
          "displayName"
        ]
      },
      "AttachmentStorageProviderConfigDetail": {
        "$ref": "#/components/schemas/AttachmentStorageProviderConfigSummary"
      },
      "UpdateAttachmentStorageProviderConfigRequest": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/AttachmentStorageProviderConfigStatus"
          },
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "nullable": true
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "nullable": true
          },
          "bucket": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "nullable": true
          },
          "keyPrefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "nullable": true
          },
          "forcePathStyle": {
            "type": "boolean"
          },
          "accessKeyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "nullable": true
          },
          "secretAccessKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "nullable": true
          },
          "expectedVersion": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          }
        }
      },
      "TestAttachmentStorageProviderConnectionRequest": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          }
        }
      },
      "AttachmentStorageProviderConnectionTestResult": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AttachmentStorageProviderConnectionTestStatus"
          },
          "message": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "status",
          "message",
          "checkedAt"
        ]
      },
      "AttachmentStorageProviderConnectionTestStatus": {
        "type": "string",
        "enum": [
          "success",
          "failed"
        ]
      },
      "SetDefaultAttachmentStorageProviderRequest": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "pomsSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "poms_session"
      },
      "pomsCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }

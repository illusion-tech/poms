// Root execution: exact preserve/verify/unlink only after reviewed DB restoration.
import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
import{connect}from'./db33.mjs';import{environment103,captureDB103,stopped103}from'./E/cleanup-wrapper103/io123.mjs';import{planOwnedObjects70,assertObjectUnlinkAdmission70,assertOwnedObjectsCleared70,snapshotFingerprint70,normalizeCatalog70}from'./E/cleanup70/core70.mjs';
assert.equal(process.platform,'linux');assert.equal(process.argv[2],'--root-execute');const receiptFile=process.argv[3],receiptSHA=process.argv[4],planFile=process.argv[5],planSHA=process.argv[6];
const win='/mnt/e/projects/worktrees/poms-r3hijk-next28/poms',priv='/home/wangzishi/.local/share/poms-r4def/private',sha=b=>createHash('sha256').update(b).digest('hex'),read=f=>JSON.parse(fs.readFileSync(f)),pin=f=>{const b=fs.readFileSync(f);return{file:f,bytes:b.length,rawBytesSha256:sha(b)}};
assert.equal(receiptFile,win+'/tmp/rust-r4def/root/cleanup-wrapper125a-149/receipt125a.json');assert.equal(planFile,priv+'/cleanup-wrapper125a-146/bundle125a.json');assert.equal(planSHA,'cc30d11364b018e41e4379c0a1844124d37e7d38e089cc8384f05a667b6f15ee');assert.equal(pin(receiptFile).rawBytesSha256,receiptSHA);assert.equal(pin(planFile).rawBytesSha256,planSHA);
const application=read(receiptFile),bundle=read(planFile);assert.equal(application.mode,'apply');assert(!application.failure);assert.equal(bundle.instanceId,'0c945ec2-e3ec-4705-8bd3-660a46e8cafc');assert.equal(bundle.namespace,'poms-r4def');
for(const backend of['native','rust']){const r=application.reports.find(r=>r.backend===backend);assert(r?.outerCommitAcknowledged);assert.equal(r.deletedRows,backend==='rust'?2673:0);assert.equal(r.restoredBorrowedOriginals,backend==='rust'?3:0);assert.equal(r.actualTwoNoOps.length,2);for(const n of r.actualTwoNoOps){assert(n.baselineExact);assert.equal(n.tables,120);assert.equal(n.rows,532);}}
const out=win+'/tmp/rust-r4def/root/objects148',privateOut=priv+'/cleanup70-objects148';assert(!fs.existsSync(out)&&!fs.existsSync(privateOut));fs.mkdirSync(out);fs.mkdirSync(privateOut,{mode:0o700});
const scopeReview=win+'/tools/rust-r4def/independent-final131/scope138-review131.json';assert.equal(pin(scopeReview).rawBytesSha256,'e78c2f0398757854b95a9bbbc850caa9e3b3e7b8942b364f8e7889eef8473f8b');
const inventoryFile=priv+'/cleanup70-objects132/inventory132.json';assert.equal(pin(inventoryFile).rawBytesSha256,'07d0cc4a785c033b76f82f4c8c848015db38d7d0b855395e0629c701f3e096f5');const inv=read(inventoryFile),intents=read(priv+'/cleanup70-objects132/intents132.json');assert.equal(inv.files.length,62);assert.equal(intents.length,62);
const provenance=read(win+'/tmp/rust-r4def/root/object-provenance136/projection136.json');for(const object of provenance.objects)for(const row of object.rowBindings){assert(bundle.databases.rust.ownership.ledger.rows.some(r=>r.table===row.table&&r.primaryKey.id===row.id),'Every bound parent must be in the reviewed exact owned ledger');}
const env=await environment103();env.expectedBaselineTimeZone='Etc/GMT-8';const stopped=await stopped103(env,bundle.UIReceipts);const baselineReadbacks=[];
for(const backend of['native','rust']){const c=await connect(backend);try{const a=await captureDB103(c,backend,env),p=bundle.databases[backend].plan;assert.equal(a.appConnections.length,0);assert.equal(a.otherWriters.length,0);assert.equal(snapshotFingerprint70(a.liveRows,a.catalog),p.baselineGraphHash);assert.equal(normalizeCatalog70(a.catalog).structuralHash,p.catalogHash);assert.deepEqual(a.guards,p.guards);const f=privateOut+'/'+backend+'-before-objects-current.json';fs.writeFileSync(f,JSON.stringify(a,null,2)+'\n',{flag:'wx',mode:0o600});baselineReadbacks.push({backend,baselineExact:true,tables:120,rows:532,receipt:pin(f)});}finally{await c.end();}}
function ancestors(f){for(let d=path.dirname(f);d!=='/';d=path.dirname(d)){const s=fs.lstatSync(d);assert(s.isDirectory()&&!s.isSymbolicLink());assert.equal(fs.realpathSync(d),d);}}
function inspect(f){ancestors(f);const s=fs.lstatSync(f);assert(s.isFile()&&!s.isSymbolicLink()&&s.nlink===1);assert.equal(fs.realpathSync(f),f);const b=fs.readFileSync(f);return{path:f,realPath:f,regular:true,symlink:false,parentSymlinks:false,nlink:s.nlink,dev:s.dev,ino:s.ino,bytes:b.length,sha256:sha(b)};}
function liveFiles(){const files=[];function visit(d){ancestors(d);assert(!fs.lstatSync(d).isSymbolicLink());for(const x of fs.readdirSync(d,{withFileTypes:true})){assert(!x.isSymbolicLink());const f=d+'/'+x.name;if(x.isDirectory())visit(f);else files.push(inspect(f));}}for(const root of inv.objectRoots)visit(root);return files.sort((a,b)=>a.path.localeCompare(b.path,'en'));}
function sameInventory(actual){assert.equal(actual.length,inv.files.length);for(const f of inv.files){const a=actual.find(a=>a.path===f.path);assert(a);for(const k of['dev','ino','nlink','bytes','sha256'])assert.equal(a[k],f[k]);}}
sameInventory(liveFiles());const recomputed=planOwnedObjects70({instanceId:inv.instanceId,namespace:inv.namespace,objectRoots:inv.objectRoots,baselineFiles:[],liveFiles:inv.files,evidenceArchiveRoot:priv+'/cleanup70-preserved-objects132',ownershipReceiptId:inventoryFile});assert.deepEqual(recomputed,intents);
const copies=[],unlinkReceipts=[];for(const intent of intents){assert(!fs.existsSync(intent.destination));fs.mkdirSync(path.dirname(intent.destination),{recursive:true,mode:0o700});ancestors(intent.destination);const current=inspect(intent.source);for(const k of['dev','ino','bytes','sha256'])assert.equal(current[k],intent.expected[k]);fs.copyFileSync(intent.source,intent.destination,fs.constants.COPYFILE_EXCL);fs.chmodSync(intent.destination,0o600);const copied={...inspect(intent.destination),createdExclusively:true};assert.equal(copied.sha256,intent.expected.sha256);assert.equal(copied.bytes,intent.expected.bytes);copies.push(copied);}
fs.writeFileSync(privateOut+'/actual-exclusive-copies148.json',JSON.stringify({copies,originalInventory:pin(inventoryFile),DBApplication:pin(receiptFile),actualStopped:stopped,baselineReadbacks},null,2)+'\n',{flag:'wx',mode:0o600});sameInventory(liveFiles());
for(let i=0;i<intents.length;i++){const intent=intents[i],copied=inspect(intent.destination);copied.createdExclusively=true;assertObjectUnlinkAdmission70(intent,{live:inspect(intent.source),copied,DBBaselinesRestored:true,allAPIsStopped:stopped.records.every(r=>r.originalProcessGone),receiptId:privateOut+'/actual-exclusive-copies148.json'});fs.unlinkSync(intent.source);assert(!fs.existsSync(intent.source));const r={path:intent.source,unlinked:true,receiptId:privateOut+'/'+i+'-unlink148.json'};fs.writeFileSync(r.receiptId,JSON.stringify(r)+'\n',{flag:'wx',mode:0o600});unlinkReceipts.push(r);}
const terminal=assertOwnedObjectsCleared70({intents,copiedFiles:copies,unlinkReceipts,liveFiles:liveFiles(),receiptId:privateOut+'/actual-exclusive-copies148.json'});for(const c of copies){const a=inspect(c.path);assert.equal(a.sha256,c.sha256);assert.equal(a.bytes,c.bytes);}
const result={kind:'actual-owned-object-cleanup148',capturedAt:new Date().toISOString(),namespace:inv.namespace,instanceId:inv.instanceId,originalInventory:pin(inventoryFile),review:pin(scopeReview),DBApplication:pin(receiptFile),reviewedPlan:pin(planFile),baselineReadbacks,objects:inv.files.map((f,index)=>({index,pathSHA256:sha(f.path),bytes:f.bytes,sha256:f.sha256,exclusiveCopyVerified:true,literalUnlinkAcknowledged:true})),preservedCopies:copies.length,liveRegularFiles:0,objectRootsRetained:inv.objectRoots,privateEvidenceAndVolumeRetained:true,terminal,recursiveDeleteUsed:false,unknownAttemptEvidencePreserved:true,G3Certified:false,G4Certified:false};fs.writeFileSync(out+'/receipt148.json',JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({preservedCopies:copies.length,objectsUnlinked:unlinkReceipts.length,liveFiles:0,DBBaselinesVerified:2,recursiveDelete:false}));

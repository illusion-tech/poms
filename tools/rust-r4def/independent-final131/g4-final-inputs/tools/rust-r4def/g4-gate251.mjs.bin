// Fresh final-review gates after Final metadata is actually on main.
import fs from'node:fs';import assert from'node:assert/strict';import{execFileSync}from'node:child_process';import{createHash}from'node:crypto';
const expected=process.argv[2];assert(/^[0-9a-f]{40}$/.test(expected));const gh=a=>execFileSync('gh',a,{encoding:'utf8',maxBuffer:16000000}).trim(),sha=b=>createHash('sha256').update(b).digest('hex'),plan=JSON.parse(fs.readFileSync('tools/rust-r4def/closeout/payload186/plan186.json')),out='tmp/rust-r4def/root/g4gate251';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});assert.equal(gh(['api','repos/illusion-tech/poms/git/ref/heads/main','--jq','.object.sha']),expected);const issues={},edges=[];for(const n of[106,107,108,109,101,57]){const raw=gh(['issue','view',String(n),'--json','number,state,body,comments,url']),v=JSON.parse(raw);assert.equal(v.state,[101,57].includes(n)?'OPEN':'CLOSED');assert.equal(v.body.trimEnd(),fs.readFileSync(plan.bodies[n].file,'utf8').trimEnd());assert.equal(v.comments.filter(c=>c.body.includes('<!-- poms-r4def-closeout183 -->')).length,1);fs.writeFileSync(out+'/'+n+'.json',raw+'\n',{flag:'wx'});issues[n]={state:v.state,bodySHA256:sha(Buffer.from(v.body)),comments:v.comments.length,file:out+'/'+n+'.json',rawBytesSha256:sha(Buffer.from(raw+'\n'))};}for(const[child,parent]of plan.requiredEdges){const raw=gh(['api','repos/illusion-tech/poms/issues/'+child+'/parent']),v=JSON.parse(raw);assert.equal(v.number,parent);assert.equal(v.state.toUpperCase(),issues[parent].state);fs.writeFileSync(out+'/'+child+'-parent.json',raw+'\n',{flag:'wx'});edges.push({child,parent,parentState:v.state.toUpperCase()});}const record={kind:'actual-fresh-final-G4-gates251',capturedAt:new Date().toISOString(),finalMetadataMain:expected,issues,edges,allSixBodyStateCommentGatesMatch:true,onlyBatchFourClosed:true,parentsRemainOpen:true,IssueMutation:false};fs.writeFileSync(out+'/receipt251.json',JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({freshSixGates:true,finalMetadataMain:expected,IssueMutation:false}));

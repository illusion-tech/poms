// Execute only the exact independently approved186 payload and then read it back.
import fs from'node:fs';import assert from'node:assert/strict';import{execFileSync}from'node:child_process';import{createHash}from'node:crypto';
assert.equal(process.argv[2],'--root-execute');const reviewFile=process.argv[3],reviewSHA=process.argv[4],sha=b=>createHash('sha256').update(b).digest('hex'),read=f=>JSON.parse(fs.readFileSync(f));assert(reviewFile.startsWith('tools/rust-r4def/independent-final131/')&&reviewFile.endsWith('.json'));assert.equal(sha(fs.readFileSync(reviewFile)),reviewSHA);const review=read(reviewFile),planFile='tools/rust-r4def/closeout/payload186/plan186.json',planRaw=fs.readFileSync(planFile),plan=JSON.parse(planRaw);assert.equal(sha(planRaw),'38ae4f7e88cfd386a69684dfd7baec62aa948523db04a6a251465800a87f96c0');assert.equal(review.precloseApproved,true);assert.equal(review.payloadSHA256,sha(planRaw));assert.deepEqual(review.closeOrder,[107,108,109,106]);assert.deepEqual(review.mustRemainOpen,[101,57]);const out='tmp/rust-r4def/root/online196';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const gh=a=>execFileSync('gh',a,{encoding:'utf8',maxBuffer:16000000}).trim(),view=n=>JSON.parse(gh(['issue','view',String(n),'--json','number,title,state,body,comments,url']));const remote=gh(['api','repos/illusion-tech/poms/git/ref/heads/main','--jq','.object.sha']);assert.equal(remote,plan.readyMetadataCommit);const before={},records={};let phase='admission';
try{for(const n of[106,107,108,109,101,57]){const v=view(n);assert.equal(v.state,'OPEN');assert.equal(sha(Buffer.from(v.body)),plan.before[n].bodySHA256);assert.equal(sha(fs.readFileSync(plan.bodies[n].file)),plan.bodies[n].rawBytesSha256);before[n]=v;fs.writeFileSync(out+'/'+n+'-before.json',JSON.stringify(v,null,2)+'\n',{flag:'wx'});}for(const[child,parent]of plan.requiredEdges){const raw=gh(['api','repos/illusion-tech/poms/issues/'+child+'/parent']);assert.equal(JSON.parse(raw).number,parent);fs.writeFileSync(out+'/'+child+'-parent-before.json',raw+'\n',{flag:'wx'});}fs.writeFileSync(out+'/admission.json',JSON.stringify({reviewFile,reviewSHA,payloadSHA256:sha(planRaw),readyMetadataMain:remote,allSixOpenAndBodyHashesMatch:true},null,2)+'\n',{flag:'wx'});
 for(const n of[107,108,109,106,101,57]){phase='patch-'+n;const current=view(n);assert.equal(current.state,'OPEN');assert.equal(sha(Buffer.from(current.body)),plan.before[n].bodySHA256);if(n===106){const children=JSON.parse(gh(['api','repos/illusion-tech/poms/issues/106/sub_issues']));assert.deepEqual(children.map(c=>c.number).sort((a,b)=>a-b),[107,108,109]);assert(children.every(c=>c.state==='closed'));}const target=fs.readFileSync(plan.bodies[n].file,'utf8'),closing=plan.closeOrder.includes(n),patch={body:target,...(closing?{state:'closed',state_reason:'completed'}:{})},file=out+'/'+n+'-patch.json';fs.writeFileSync(file,JSON.stringify(patch)+'\n',{flag:'wx'});const response=gh(['api','--method','PATCH','repos/illusion-tech/poms/issues/'+n,'--input',file]);fs.writeFileSync(out+'/'+n+'-patch-response.json',response+'\n',{flag:'wx'});let after=view(n);assert.equal(after.state,closing?'CLOSED':'OPEN');assert.equal(after.body.trimEnd(),target.trimEnd());const commentText=fs.readFileSync(plan.comment.file,'utf8');assert.equal(sha(Buffer.from(commentText)),plan.comment.rawBytesSha256);const prior=after.comments.filter(c=>c.body.includes('<!-- poms-r4def-closeout183 -->'));assert(prior.length<2);let url=prior[0]?.url;if(!url)url=gh(['issue','comment',String(n),'--body-file',plan.comment.file]);after=view(n);assert.equal(after.state,closing?'CLOSED':'OPEN');assert.equal(after.body.trimEnd(),target.trimEnd());assert(after.comments.some(c=>c.body.trimEnd()===commentText.trimEnd()));fs.writeFileSync(out+'/'+n+'-after.json',JSON.stringify(after,null,2)+'\n',{flag:'wx'});records[n]={state:after.state,bodyMatches:true,bodySHA256:sha(Buffer.from(after.body)),comment:url,readback:true};console.log(JSON.stringify({issue:n,...records[n]}));}
 phase='native-tree-final';const edges=[];for(const[child,parent]of plan.requiredEdges){const raw=gh(['api','repos/illusion-tech/poms/issues/'+child+'/parent']),v=JSON.parse(raw);assert.equal(v.number,parent);assert.equal(v.state.toUpperCase(),records[parent].state);fs.writeFileSync(out+'/'+child+'-parent-after.json',raw+'\n',{flag:'wx'});edges.push({child,parent,parentState:v.state.toUpperCase()});}const receipt={kind:'actual-six-Issue-R4DEF-closeout-online196',capturedAt:new Date().toISOString(),readyMetadataCommit:remote,implementationCommit:plan.implementationCommit,preclose:{file:reviewFile,rawBytesSha256:reviewSHA},payload:{file:planFile,rawBytesSha256:sha(planRaw)},issues:records,nativeEdges:edges,closeOrder:[107,108,109,106],sixIssueBodiesCommentsAndNativeTreeMatchApprovedPlan:true,fullR4RemainsIncomplete:true,r5AndLaterRemainOutOfScope:true,actualFinalIndependentG4StillPending:true,G4Certified:false};fs.writeFileSync(out+'/receipt196.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({onlineReadbackComplete:true,onlyClosed:[107,108,109,106],parentsOpen:[101,57]}));
}catch(e){fs.writeFileSync(out+'/failure.json',JSON.stringify({phase,name:e.name,message:e.message,records,automaticRetryForbidden:true,liveReconciliationRequired:true},null,2)+'\n',{flag:'wx'});throw e;}

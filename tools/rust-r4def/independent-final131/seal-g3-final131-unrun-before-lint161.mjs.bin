function rel(f){let s=f.replaceAll('\\','/');if(s.startsWith('//wsl.localhost/Debian/'))s='/'+s.slice('//wsl.localhost/Debian/'.length);if(s.startsWith(root+'/'))s='/mnt/e/projects/worktrees/poms-r3hijk-next28/poms/'+s.slice(root.length+1);if(s.includes('/private/'))return{private:true,file:s};const p='/mnt/e/projects/worktrees/poms-r3hijk-next28/poms/';if(s.startsWith(p))s=s.slice(p.length);assert(!path.isAbsolute(s)&&!s.includes('..'));return{file:s};}

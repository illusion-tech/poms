# This slice's support code and immutable receipts retain their certified bytes.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.bin binary
*.patch binary
# Console originals keep their significant trailing blank lines.
*.log -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

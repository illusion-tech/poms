// Actual fixed-commit binding, before main integration; only read-only Git.
import fs from'node:fs';import assert from'node:assert/strict';import{execFileSync}from'node:child_process';import{createHash}from'node:crypto';
const sha=b=>createHash('sha256').update(b).digest('hex'),git=a=>execFileSync('git',a,{encoding:'utf8',maxBuffer:16000000}).trim(),head=git(['rev-parse','HEAD']),stage=JSON.parse(fs.readFileSync('tmp/rust-r4def/root/staged-product163/receipt163.json')),s4='4f0ad88e78622a75b88b4e3cc72aded9da67458a';assert(head.startsWith('d6c3cff8'));git(['merge-base','--is-ancestor',s4,head]);git(['merge-base','--is-ancestor','565661b9113372de4da6662a4a692fbfd2296dd6',head]);
const changed=execFileSync('git',['diff','--diff-filter=ACMRT','--name-only','-z',head+'^',head],{encoding:'utf8'}).split('\0').filter(Boolean),product=stage.pins.map(p=>p.file),files=[...new Set([...changed,...product])].sort(),out=execFileSync('git',['cat-file','--batch'],{input:Buffer.from(files.map(f=>head+':'+f).join('\n')+'\n'),encoding:null,maxBuffer:128000000});let offset=0;const pins=[];for(const file of files){const end=out.indexOf(10,offset),m=/^([0-9a-f]{40}) blob (\d+)$/.exec(out.subarray(offset,end).toString());assert(m);const n=Number(m[2]),b=out.subarray(end+1,end+1+n);assert.equal(out[end+1+n],10);offset=end+2+n;const current=fs.readFileSync(file);assert(b.equals(current),'Fixed blob/raw mismatch: '+file);const p=stage.pins.find(p=>p.file===file);if(p)assert.equal(sha(b),p.currentRawSHA256);pins.push({file,gitBlob:m[1],bytes:b.length,rawBytesSha256:sha(b),productBinding:!!p});}assert.equal(offset,out.length);for(const p of stage.deleted)assert.equal(git(['ls-tree','--name-only',head,'--',p.file]),'');
const client=git(['ls-tree','-r','--name-only',head,'--','libs/shared/api-client']).split('\n').filter(Boolean);assert.equal(client.length,616);const g3='tools/rust-r4def/independent-final131/g3-final131.json';assert.equal(sha(fs.readFileSync(g3)),'5fc5301a86a2cdc0709fb43ed824da797056bfaa3910844424b4e378a9c67094');
const dir='tmp/rust-r4def/root/fixed-commit167';assert(!fs.existsSync(dir));fs.mkdirSync(dir,{recursive:true});const record={kind:'actual-fixed-implementation-commit167',capturedAt:new Date().toISOString(),implementationCommit:head,permanentS4:s4,S4IsAncestor:true,mainBase:'565661b9113372de4da6662a4a692fbfd2296dd6',exactCurrentRawProductBindings:708,clientFiles:616,changedFiles:changed.length,allInspectedCommitBlobsEqualRaw:true,uniqueDeleted:stage.deleted,independentG3:{file:g3,rawBytesSha256:sha(fs.readFileSync(g3))},pins,rootConsoleWhitespacePolicy:'Scoped tools *.log preserves certified blank console EOF; root six S4 sources unchanged',mainIntegrated:false,G4Certified:false};fs.writeFileSync(dir+'/receipt167.json',JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({implementationCommit:head,productByteBindings:708,allChangedBlobsEqualRaw:true,inspectedFiles:pins.length,clientFiles:616,S4IsAncestor:true,receiptSHA256:sha(fs.readFileSync(dir+'/receipt167.json'))}));

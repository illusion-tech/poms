const counts='本批收口后，正式交付镜像将更新为Rust240、R4累计67/92、剩25（经营17＋验收/完工/归档8）；本次操作中的实际G4终审与Seal仍需最后核对，当前不宣称完整R4或R5完成。#101/#57始终OPEN。';
for(const n of[106,107,108,109]){const source=fs.readFileSync('tools/rust-r4def/E/closeout177/body'+n+'.md','utf8'),paragraphs=source.split(/\r?\n\r?\n/);let text=paragraphs.map(p=>p.startsWith('状态：')?status:p.startsWith('待Root填实的G4载体：')?evidence:p.startsWith('正式口径受G4约束：')?counts:p).join('\n\n');text=text.replace('- [ ] 生命周期原字节归档、Ready/main、独立preclose许可及六Issue实际线上读回。','- [x] 生命周期原字节归档与Ready/main；独立关闭许可在执行前核实，实际线上读回由关闭事务后确认。');assert(!/\{\{[^}]+\}\}/.test(text));const file=out+'/body'+n+'.md';fs.writeFileSync(file,text,{flag:'wx'});bodies[n]={file,rawBytesSha256:sha(Buffer.from(text))};}
const r2=fs.readFileSync('tools/rust-r4def/E/closeout177/append57.md','utf8').split(/\r?\n\r?\n/).find(p=>p.startsWith('- [ ] 既有R2补缺：'));assert(r2?.includes('500'));
for(const n of[101,57]){const actual=JSON.parse(fs.readFileSync('tmp/rust-r4def/root/github-g3-174/'+n+'-after.json')),original=actual.body,marker='<!-- poms-r4def-g4-current-batch -->';assert(!original.includes(marker));const block=`${marker}\n\n本批R4DEF（D7/E11/F12共30入口）已完成实现、验收、清理和main/归档；按独立关闭许可仅收口 #107/#108/#109 后再 #106。当前就绪治理提交 [${ready.slice(0,8)}](https://github.com/illusion-tech/poms/commit/${ready})；[归档及状态](${url('docs/design/rust-r4def-delivery-status.json')})。Final docs/main和实际G4/Seal仍须按顺序核对，不以preclose代替末次读回。\n\n${counts}\n\n${n===57?r2+'\n\n':''}总体 #57 与R4父 #101 保持OPEN，原未完成清单全部保留；完整R4阶段验收、R5–R7、部署切流/性能和S3/真实lost-COMMIT-ACK未被本批认证。\n\n<!-- /poms-r4def-g4-current-batch -->`;const text=original+'\n\n'+block+'\n',file=out+'/body'+n+'.md';fs.writeFileSync(file,text,{flag:'wx'});assert(text.startsWith(original));bodies[n]={file,rawBytesSha256:sha(Buffer.from(text)),originalParentPrefixSHA256:sha(Buffer.from(original))};}
for(const n of[106,107,108,109,101,57]){const v=JSON.parse(fs.readFileSync('tmp/rust-r4def/root/github-g3-174/'+n+'-after.json'));assert.equal(v.state,'OPEN');before[n]={bodySHA256:sha(Buffer.from(v.body)),state:'OPEN'};}
const comment=`已按非作者G4关闭许可执行本批线上收口准备/动作；固定实现 d6c3cff8、Ready治理 ${ready} 和原字节归档可复查。本批范围仅30入口；实际六Issue正文/评论/原生父子树读回、Final docs/main及末次独立G4/Seal继续封存。#101/#57保持OPEN，完整R4和R5–R7未完成。\n\n<!-- poms-r4def-closeout183 -->\n`;fs.writeFileSync(out+'/comment.md',comment,{flag:'wx'});const plan={kind:'Root-concrete-R4DEF-preclose-payload183',createdAt:new Date().toISOString(),implementationCommit:'d6c3cff84dd96c981bab075d3f4aca3e98c76c4b',readyMetadataCommit:ready,approvalGranted:false,remoteMutation:false,closeOrder:[107,108,109,106],mustRemainOpen:[101,57],bodies,before,comment:{file:out+'/comment.md',rawBytesSha256:sha(Buffer.from(comment))},requiredEdges:[[106,101],[107,106],[108,106],[109,106],[101,57]],executionPrerequisites:['Actual metadata182 publication main=ready SHA and9149 raw/Git archive bindings','Independent preclose approval of this exact plan hash','Fresh live body hashes and native edges equal before; stop on drift'],pendingAfterOnlineClosure:['Final docs/main','Independent actualG4 terminal review','Seal, truthful final body/checklist update and final online readback'],postSealAllowedUpdates:['Replace only the pending actualG4 status paragraph with verified finalG4/Seal facts','Check only the final G4/Seal checkbox after actual proof','Update only the managed parent block to actual certified67/92 andRust240; preserve original parent prefix and R2 unchecked followup'],officialCountsNotCertifiedByThisPayload:true};fs.writeFileSync(out+'/plan183.json',JSON.stringify(plan,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({plan:out+'/plan183.json',rawBytesSha256:sha(fs.readFileSync(out+'/plan183.json')),sixBodiesMaterialized:true,noTokens:true,GitHubMutation:false}));

import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const sha=b=>createHash('sha256').update(b).digest('hex'),out='tools/rust-r4def/closeout/payload183',ready='e5f13b05a47766a4c6a3aa13b7fc7a39799b3e76',url=p=>'https://github.com/illusion-tech/poms/blob/'+ready+'/'+p,archiveSHA='34d87feaddef23ace0b5210063794798bcd1a2447b66e432b5db50ba922b3732';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const bodies={},before={};
const status='状态：本批实现、验收、精确清理、main及生命周期归档均已完成；按非作者G4关闭许可进行本批线上收口。Final docs/main、六Issue末次读回和独立actual G4/Seal仍按既定顺序封存，本正文不提前认证末次G4结果。';

// Offline public exact-PK ledger, hashes and commands; no raw rows or credentials.
import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const root='/mnt/e/projects/worktrees/poms-r3hijk-next28/poms',privateDir='/home/wangzishi/.local/share/poms-r4def/private/cleanup-wrapper125a-146',sha=b=>createHash('sha256').update(b).digest('hex'),read=f=>JSON.parse(fs.readFileSync(f)),pin=f=>{const b=fs.readFileSync(f);return{file:f,bytes:b.length,rawBytesSha256:sha(b)}};
const bundle=read(privateDir+'/bundle125a.json');assert.equal(pin(privateDir+'/bundle125a.json').rawBytesSha256,'cc30d11364b018e41e4379c0a1844124d37e7d38e089cc8384f05a667b6f15ee');const idx=read(privateDir+'/actual-normalized-producer-index.json');
const databases=Object.fromEntries(['native','rust'].map(backend=>{const e=bundle.databases[backend];assert.equal(e.ownership.unclaimed.length,0);assert(!e.executionIneligible);assert(e.plan.planHash);return[backend,{scope:e.scope,counts:e.ownership.counts,exactPKLedger:e.ownership.ledger,baselineDrift:e.ownership.baselineDrift,counters:e.ownership.counters,sealedLiveGraphHash:e.plan.sealedLiveGraphHash,baselineGraphHash:e.plan.baselineGraphHash,planHash:e.plan.planHash,expectedDeleted:e.plan.expectedDeleted,expectedRestored:e.plan.expectedRestored,operationsByKind:Object.fromEntries([...new Set(e.plan.operations.map(o=>o.kind))].map(k=>[k,e.plan.operations.filter(o=>o.kind===k).length])),borrowedRestores:e.plan.operations.filter(o=>o.kind.startsWith('restore-')).map(o=>({kind:o.kind,table:o.table,primaryKey:o.primaryKey,columns:o.columns,expectedBefore:o.expectedBefore,expectedAfter:o.expectedAfter})),allTables:e.plan.allTables}];}));
assert.equal(databases.rust.exactPKLedger.rows.length,2673);const actualCommands=idx.HTTP.map(r=>({receiptId:r.receiptId,operationId:r.operationId,method:r.method,path:r.path,status:r.status,requestId:r.requestId,actorId:r.actorId,startedAt:r.startedAt,completedAt:r.completedAt,source:r.source,receiptPins:r.receiptPins}));
const result={kind:'actual-offline-exact-owned-cleanup-ledger147',capturedAt:new Date().toISOString(),namespace:bundle.namespace,instanceId:bundle.instanceId,reviewedPrivateBundle:pin(privateDir+'/bundle125a.json'),originalPlanReceipt:pin(root+'/tmp/rust-r4def/root/cleanup-wrapper125a-146/receipt125a.json'),databases,actualCommands,allReceiptPins:bundle.receiptPins,UIReceipts:bundle.UIReceipts.map(u=>({receiptId:u.receiptId,closed:u.closed,exchanges:u.exchanges.length})),planNotApply:true,DBDMLOrHTTP:0,rawRowsPasswordsTokensStorageKeysPublished:false};
const out=root+'/tmp/rust-r4def/root/cleanup-ledger147';fs.mkdirSync(out);fs.writeFileSync(out+'/ledger147.json',JSON.stringify(result,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({file:out+'/ledger147.json',rawBytesSha256:pin(out+'/ledger147.json').rawBytesSha256,bytes:fs.statSync(out+'/ledger147.json').size,ledgerRows:databases.rust.exactPKLedger.rows.length,unclaimed:0,operations:databases.rust.operationsByKind,restores:databases.rust.borrowedRestores.map(r=>({table:r.table,columns:r.columns})),execution:false}));

// Root-only guarded fast-forward integration; no deploy, force push, reset or cleanup.
import fs from'node:fs';import assert from'node:assert/strict';import{execFileSync}from'node:child_process';import{createHash}from'node:crypto';
assert.equal(process.argv[2],'--root-execute');const reviewFile=process.argv[3],reviewSHA=process.argv[4];assert(reviewFile.startsWith('tools/rust-r4def/independent-final131/')&&reviewFile.endsWith('.json'));const sha=b=>createHash('sha256').update(b).digest('hex');assert.equal(sha(fs.readFileSync(reviewFile)),reviewSHA);const root=process.cwd(),main='E:/projects/poms',implementation='d6c3cff84dd96c981bab075d3f4aca3e98c76c4b',base='565661b9113372de4da6662a4a692fbfd2296dd6',s4='4f0ad88e78622a75b88b4e3cc72aded9da67458a',out='tmp/rust-r4def/root/main168';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const git=(cwd,args)=>execFileSync('git',args,{cwd,encoding:'utf8',maxBuffer:16000000}).trim();
assert.equal(git(root,['rev-parse','HEAD']),implementation);assert.equal(git(main,['branch','--show-current']),'main');assert.equal(git(main,['status','--porcelain']),'');assert.equal(git(main,['rev-parse','HEAD']),base);assert.equal(git(root,['ls-remote','origin','refs/heads/main']).split(/\s+/)[0],base);assert.equal(git(root,['ls-remote','origin','refs/heads/codex/poms-r4def-next28']).split(/\s+/)[0],implementation);git(root,['merge-base','--is-ancestor',s4,implementation]);
fs.writeFileSync(out+'/before.json',JSON.stringify({kind:'actual-main-FF-admission168',capturedAt:new Date().toISOString(),main,mainHead:base,mainClean:true,remoteMain:base,publishedImplementation:implementation,reviewFile,reviewSHA,S4Ancestor:true},null,2)+'\n',{flag:'wx'});
git(main,['fetch','origin','main']);assert.equal(git(main,['rev-parse','origin/main']),base);assert.equal(git(main,['status','--porcelain']),'');git(main,['merge','--ff-only','--quiet',implementation]);assert.equal(git(main,['rev-parse','HEAD']),implementation);assert.equal(git(main,['status','--porcelain']),'');
const p=JSON.parse(fs.readFileSync('tmp/rust-r4def/root/staged-product163/receipt163.json'));for(const pin of p.pins)assert.equal(sha(fs.readFileSync(main+'/'+pin.file)),pin.currentRawSHA256);for(const d of p.deleted)assert(!fs.existsSync(main+'/'+d.file));git(main,['merge-base','--is-ancestor',s4,'HEAD']);git(main,['push','origin','main']);const remote=git(main,['ls-remote','origin','refs/heads/main']).split(/\s+/)[0];assert.equal(remote,implementation);
const record={kind:'actual-implementation-main-integration168',capturedAt:new Date().toISOString(),implementationCommit:implementation,mainCommit:implementation,remoteMain:remote,mainIntegrated:true,mainClean:true,fastForwardOnly:true,productRawBindingsVerified:708,uniqueDeletionVerified:true,permanentS4:s4,S4Ancestor:true,independentFixedCommitReview:{file:reviewFile,rawBytesSha256:reviewSHA},forcePushResetDeployOrServiceStart:false,G4Certified:false};fs.writeFileSync(out+'/receipt168.json',JSON.stringify(record,null,2)+'\n',{flag:'wx'});fs.writeFileSync('tools/rust-r4def/closeout/main168.json',fs.readFileSync(out+'/receipt168.json'),{flag:'wx'});console.log(JSON.stringify({mainIntegrated:true,mainCommit:implementation,remoteMain:remote,productRawBindingsVerified:708,mainClean:true}));

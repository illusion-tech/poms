// Resume after168's local FF: normalize only proven checkout CRLF, then publish.
import fs from'node:fs';import assert from'node:assert/strict';import{execFileSync}from'node:child_process';import{createHash}from'node:crypto';
assert.equal(process.argv[2],'--root-execute');const root=process.cwd(),main='E:/projects/poms',implementation='d6c3cff84dd96c981bab075d3f4aca3e98c76c4b',base='565661b9113372de4da6662a4a692fbfd2296dd6',s4='4f0ad88e78622a75b88b4e3cc72aded9da67458a',out='tmp/rust-r4def/root/main168b',sha=b=>createHash('sha256').update(b).digest('hex'),config=['-c','http.version=HTTP/1.1','-c','http.lowSpeedLimit=1024','-c','http.lowSpeedTime=45','-c','http.postBuffer=33554432','-c','pack.threads=2'];const git=(cwd,a,encoding='utf8')=>execFileSync('git',[...config,...a],{cwd,encoding,maxBuffer:32000000});assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});assert.equal(git(root,['rev-parse','HEAD']).trim(),implementation);assert.equal(git(main,['rev-parse','HEAD']).trim(),implementation);assert.equal(git(main,['branch','--show-current']).trim(),'main');assert.equal(git(main,['status','--porcelain']).trim(),'');const beforeRemote=git(root,['ls-remote','origin','refs/heads/main']).trim().split(/\s+/)[0];assert([base,implementation].includes(beforeRemote));assert.equal(git(root,['ls-remote','origin','refs/heads/codex/poms-r4def-next28']).trim().split(/\s+/)[0],implementation);
const stage=JSON.parse(fs.readFileSync('tmp/rust-r4def/root/staged-product163/receipt163.json')),mismatches=[];for(const p of stage.pins){const raw=fs.readFileSync(main+'/'+p.file);if(sha(raw)!==p.currentRawSHA256){const b=git(root,['show',implementation+':'+p.file],null);assert.equal(sha(b),p.currentRawSHA256);assert(Buffer.from(raw.toString('utf8').replaceAll('\r\n','\n')).equals(b),'Material main checkout drift: '+p.file);mismatches.push({file:p.file,before:raw,after:b});}}
fs.writeFileSync(out+'/admission169.json',JSON.stringify({kind:'actual-main168-local-FF-checkout-line-ending-correction',capturedAt:new Date().toISOString(),implementationCommit:implementation,localMainAlreadyFastForwarded:true,remoteBefore:beforeRemote,gitStatusClean:true,mismatches:mismatches.map(m=>({file:m.file,beforeBytes:m.before.length,beforeRawSHA256:sha(m.before),afterBytes:m.after.length,afterLiteralBlobSHA256:sha(m.after),exactCRLFtoLFOnly:true})),before168Preserved:true,noGitObjectsOrContractsChanged:true},null,2)+'\n',{flag:'wx'});
for(let i=0;i<mismatches.length;i++){const m=mismatches[i];fs.writeFileSync(out+'/'+i+'-before.bin',m.before,{flag:'wx'});fs.writeFileSync(main+'/'+m.file,m.after);}for(const p of stage.pins)assert.equal(sha(fs.readFileSync(main+'/'+p.file)),p.currentRawSHA256);for(const d of stage.deleted)assert(!fs.existsSync(main+'/'+d.file));assert.equal(git(main,['status','--porcelain']).trim(),'');git(main,['merge-base','--is-ancestor',s4,'HEAD']);git(main,['push','origin','main']);const remote=git(root,['ls-remote','origin','refs/heads/main']).trim().split(/\s+/)[0];assert.equal(remote,implementation);
const record={kind:'actual-implementation-main-integration168',capturedAt:new Date().toISOString(),implementationCommit:implementation,mainCommit:implementation,remoteMain:remote,mainIntegrated:true,mainClean:true,fastForwardOnly:true,productRawBindingsVerified:708,uniqueDeletionVerified:true,permanentS4:s4,S4Ancestor:true,independentFixedCommitReview:{file:'tools/rust-r4def/independent-final131/fixed167-review131.json',rawBytesSha256:'02fc334fcb9745264765de727f4fda64162ab8ae63cda08ab5056dc54faf840a'},lineEndingOnlyCheckoutCorrections:mismatches.map(m=>m.file),correctionReceipt:out+'/admission169.json',forcePushResetDeployOrServiceStart:false,G4Certified:false};fs.writeFileSync('tmp/rust-r4def/root/main168/receipt168.json',JSON.stringify(record,null,2)+'\n',{flag:'wx'});fs.writeFileSync('tools/rust-r4def/closeout/main168.json',JSON.stringify(record,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({mainIntegrated:true,remoteMain:remote,all708RawExact:true,checkoutCRLFCorrections:mismatches.map(m=>m.file),mainClean:true}));

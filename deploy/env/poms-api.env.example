# 将本文件复制到服务器的 /srv/poms/test/shared/poms-api.env。
# 将所有 <replace-me> 占位符替换为真实值。
# 不要提交真实密钥。

NODE_ENV=production
HOST=127.0.0.1
PORT=3333
CORS_ORIGIN=https://poms-test.illusiontech.cn
JWT_SECRET=<replace-me>
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=900
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
AUTH_SESSION_LAST_SEEN_THROTTLE_SECONDS=60
AUTH_COOKIE_PATH=/api
AUTH_COOKIE_SECURE=true

DB_CONNECT=true
DATABASE_URL=
DB_HOST=121.37.83.210
DB_PORT=5432
DB_DATABASE=poms_test
DB_USER=poms_test_app
DB_PASSWORD=<new-strong-password>
DB_SCHEMA=poms
DB_DEBUG=false
MIGRATIONS_TABLE_NAME=poms_migrations

POMS_ATTACHMENT_LOCAL_ROOT=/srv/poms/test/shared/uploads

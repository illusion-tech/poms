# Copy this file to /srv/poms/test/shared/poms-api.env on the server.
# Replace every <replace-me> placeholder with a real value.
# Do not commit real secrets.

NODE_ENV=production
HOST=127.0.0.1
PORT=3333
CORS_ORIGIN=https://poms-test.illusiontech.cn
JWT_SECRET=<replace-me>
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=900
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
AUTH_SESSION_LAST_SEEN_THROTTLE_SECONDS=60
AUTH_COOKIE_PATH=/api
AUTH_COOKIE_SECURE=true

DB_CONNECT=true
DATABASE_URL=<replace-me>
DB_SCHEMA=poms
DB_DEBUG=false
MIGRATIONS_TABLE_NAME=poms_migrations

POMS_ATTACHMENT_MAX_SIZE_MB=50
POMS_ATTACHMENT_LOCAL_ROOT=/srv/poms/test/shared/uploads

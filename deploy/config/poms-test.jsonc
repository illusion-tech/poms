{
    // 测试环境非敏感部署配置。不要在这里放数据库密码、JWT secret、OBS AK/SK。
    "env": "test",
    "domain": "poms-test.illusiontech.cn",
    "baseDir": "/srv/poms/test",
    "apiPort": 3333,
    "pm2Name": "poms-api-test",
    "archivePrefix": "poms-test",
    "remoteHost": "root@121.36.34.169",
    "remoteTmpDir": "/tmp/poms",
    "remoteDeployDir": "/opt/poms/deploy",
    "remotePm2ConfigPath": "/opt/poms/deploy/pm2/poms-api-test.ecosystem.config.cjs",
    "remoteNginxAvailablePath": "/etc/nginx/sites-available/poms-test.conf",
    "remoteNginxEnabledPath": "/etc/nginx/sites-enabled/poms-test.conf",
    "remoteSslCertPath": "/etc/nginx/ssl/poms-test/fullchain.pem",
    "remoteSslKeyPath": "/etc/nginx/ssl/poms-test/privkey.pem",

    "adminBrowserDistDir": "dist/apps/poms-admin/browser",
    "apiDistDir": "dist/apps/poms-api",
    "releaseArchiveDir": "dist/releases",
    "stagingDir": "dist/deploy-stage",

    "pm2ConfigPath": "deploy/pm2/poms-api-test.ecosystem.config.cjs",
    "nginxSiteName": "poms-test.conf",
    "nginxSiteTemplatePath": "deploy/nginx/sites-available/poms-test.conf",
    "nginxSitesAvailableDir": "/etc/nginx/sites-available",
    "nginxSitesEnabledDir": "/etc/nginx/sites-enabled",

    "migrationEnvFile": "deploy/private/poms-test.env",
    "migrationCheckAfterUp": true

{
    "name": "shared-contracts",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/shared/contracts/src",
    "projectType": "library",
    "tags": ["scope:shared", "type:contracts"],
    "targets": {
        "build": {
            "executor": "@nx/js:tsc",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/out-tsc/libs/shared/contracts",
                "rootDir": "libs/shared/contracts/src",
                "outputFileName": "index.js",
                "main": "libs/shared/contracts/src/index.ts",
                "tsConfig": "libs/shared/contracts/tsconfig.lib.json",
                "assets": []
            }
        }
    }
}

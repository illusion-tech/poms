{
    "imports": {
        "@std/fs": "jsr:@std/fs@^1",
        "@std/jsonc": "jsr:@std/jsonc@^1",
        "@std/path": "jsr:@std/path@^1.1.4"
    },
    "tasks": {
        "format:md": "deno run --allow-read --allow-write tools/format-md-tables.ts docs/",
        "format:md:check": "deno run --allow-read tools/format-md-tables.ts --check docs/",
        "check:enum-like-strings": "deno run --allow-read tools/check-enum-like-strings.ts",
        "deploy:check": "deno check deploy/scripts/build-release.ts deploy/scripts/push-release.ts deploy/scripts/rollback-release.ts deploy/scripts/verify-release.ts deploy/scripts/preflight-remote.ts",
        "deploy:lint": "deno lint deploy/scripts tools",
        "deploy:build-test": "deno run --allow-read=deploy,dist --allow-write=dist --allow-run=corepack,git,tar --allow-env deploy/scripts/build-release.ts --config deploy/config/poms-test.jsonc",
        "deploy:preflight-test": "deno run --allow-read=deploy --allow-run=ssh deploy/scripts/preflight-remote.ts --config deploy/config/poms-test.jsonc",
        "deploy:push-test": "deno run --allow-read=deploy,dist --allow-run=scp,ssh,corepack --allow-env deploy/scripts/push-release.ts --config deploy/config/poms-test.jsonc",
        "deploy:rollback-test": "deno run --allow-read=deploy --allow-run=ssh deploy/scripts/rollback-release.ts --config deploy/config/poms-test.jsonc",
        "deploy:verify-test": "deno run --allow-read=deploy --allow-net=poms-test.illusiontech.cn --allow-run=curl deploy/scripts/verify-release.ts --config deploy/config/poms-test.jsonc",
        "deploy:ci": "deno task deploy:check && deno task deploy:lint"
    },
    "allowScripts": ["npm:@nestjs/core@11.1.21", "npm:@openapitools/openapi-generator-cli@2.34.0", "npm:@parcel/watcher@2.5.6", "npm:@scarf/scarf@1.4.0", "npm:@swc/core@1.15.40", "npm:esbuild@0.19.12", "npm:esbuild@0.27.3", "npm:esbuild@0.28.0", "npm:lmdb@3.5.1", "npm:msgpackr-extract@3.0.4", "npm:nx@22.6.5", "npm:unrs-resolver@1.12.2"]
}

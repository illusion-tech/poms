{
    "biome.enabled": true,
    "biome.requireConfiguration": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.biome": "explicit",
        "source.organizeImports.biome": "explicit"
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "deno.enable": false,
    "deno.config": "./deno.jsonc",
    "deno.enablePaths": [
        "deploy/scripts",
        "tools/check-enum-like-strings.ts",
        "tools/format-md-tables.ts"
    ],
    "cSpell.words": [
        "atts",
        "authlayout",
        "blockviewer",
        "chartjs",
        "chrr",
        "clawback",
        "collapsable",
        "confirmdialog",
        "Confirmers",
        "cutover",
        "ecommerce",
        "emptymessage",
        "Feishu",
        "fullchain",
        "iconfield",
        "ilike",
        "illusiontech",
        "inputicon",
        "inputnumber",
        "inputtext",
        "INSTOCK",
        "Kimi",
        "loadingbody",
        "LOWSTOCK",
        "middot",
        "openapitools",
        "OUTOFSTOCK",
        "overlaybadge",
        "pgcrypto",
        "pipefail",
        "presales",
        "presigning",
        "primeclt",
        "primeicons",
        "primeng",
        "primeui",
        "primeuix",
        "privkey",
        "radiobutton",
        "rebaseline",
        "rebaselines",
        "recalc",
        "rightmenu",
        "sectioncard",
        "SSOT",
        "styleclass",
        "timestamptz",
        "toggleswitch",
        "Topbar",
        "uikit",
        "unallowed",
        "usermanagement",
        "worktree",
        "writeback",
        "wrongpassword"
    ],
    "chat.tools.terminal.autoApprove": {
        "pnpm": true
    }
}

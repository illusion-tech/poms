import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{spawnSync,execFileSync}from'node:child_process';import{createHash}from'node:crypto';
const archiveCommit=process.argv[2],implementation='a2995dfb187a70064d2e54ce336a72c24974721a',out='tmp/rust-r4abc/root/g4-plan65',pub='docs/design/archive/slices/rust-r4abc/g4-plan65';assert(/^[a-f0-9]{40}$/.test(archiveCommit));assert(!fs.existsSync(out)&&!fs.existsSync(pub));fs.mkdirSync(out,{recursive:true});fs.mkdirSync(pub,{recursive:true});assert.equal(execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),archiveCommit);const sha=b=>createHash('sha256').update(b).digest('hex');const ids=[103,104,105,102,101,57],query='query{repository(owner:"illusion-tech",name:"poms"){'+ids.map(n=>'i'+n+':issue(number:'+n+'){number state body url subIssues(first:100){nodes{number state}}}').join(' ')+'}}',input=out+'/input65.json';fs.writeFileSync(input,JSON.stringify({query},null,2)+'\n',{flag:'wx'});const r=spawnSync('gh',['api','graphql','--input',input],{encoding:null,windowsHide:true,timeout:60000,maxBuffer:8000000});fs.writeFileSync(out+'/stdout-original.bin',r.stdout||Buffer.alloc(0),{flag:'wx'});fs.writeFileSync(out+'/stderr-original.bin',r.stderr||Buffer.alloc(0),{flag:'wx'});assert.equal(r.status,0);const value=JSON.parse(r.stdout);assert(!value.errors);const before=value.data.repository;for(const n of ids)assert.equal(before['i'+n].state,'OPEN');assert(before.i57.subIssues.nodes.some(x=>x.number===101));assert(before.i101.subIssues.nodes.some(x=>x.number===102));assert.deepEqual(before.i102.subIssues.nodes.map(x=>x.number).sort(),[103,104,105]);
const base='https://github.com/illusion-tech/poms/blob/main/docs/design/archive/slices/rust-r4abc/',links=`[实际验收](${base}validation-checkpoint57.md)、[独立G3](${base}g3-independent08.json.bin)、[固定提交](${base}fixed-commit09.json.bin)、[main复核](${base}main-integration10.json.bin)、[原字节归档](${base}archive-origin-map63.json)`;
const common=`实施提交 [a2995dfb](https://github.com/illusion-tech/poms/commit/${implementation})，归档候选提交 [${archiveCommit.slice(0,8)}](https://github.com/illusion-tech/poms/commit/${archiveCommit})；永久S3 4f78bd48保留。${links}。\n\n验收：Rust310通过/54历史ignored，Native74套863项，Angular59套411项；必要写故障59项实命中并完整113表回滚/重试，6锁屏障及跨项目锁负例，Linux同构建续跑链/Windows完整原UI。163早期负例仅有界等价复用，原失败/partial/ignored/Native参考不升格。\n\n清理：1004自有行精确清理，3借用原件恢复；两库113表/各529原seed及catalog/ACL精确恢复、两次noop，2对象86B原字节保留、运行副本0；自有API/浏览器/Native/PG停止，卷/private保留，3作者工作树可恢复归档。\n`;
const scopes={103:'签约就绪9入口，真实R3成本/竞标/报价来源，合同级baseline/diff/readiness与prepared真实产物；A09只消费Active有效快照。',104:'合同9入口，草稿/基本信息/查询、精确准备版本送审、R2真实指定审批人批准与原子Active快照；没有bug级复刻Node假初始化。',105:'合同资金19入口，正数两位金额/容量、同项目Active合同及应付归属、累计/allowedActions、可变Payable/Invoice的typedUUID成本映射读取约束；不生产成本40或财务19项新UI。',102:'A9+B9+C19联合37入口，真实准备→精确审核绑定→原子有效快照→正式应收计划及资金事实。每合同独立金额/条款/节点，不把项目报价复制或自动分摊、不强制合计，来源与差异可审计。'};
const actions=[];for(const n of[103,104,105,102]){const body=`状态：Done / 本批独立G4线上收口，完整R4与总体保持开放。\n\n${n===102?'父#101，总体#57；原生子项#103/#104/#105。':'父#102，上级#101，总体#57。'}\n\n交付：${scopes[n]}\n\n- [x] G0：原生父子Issue及明确边界\n- [x] 联合G1：canonical/DTO/DDL/同事务协议及四项用户裁决冻结\n- [x] 实现与独占文件交付\n- [x] 统一候选真实生产者、故障/并发/权限/原UI验收与自有环境终态\n- [x] 非作者G3、固定提交和main实际集成复核\n- [x] 独立G4关闭许可、归档及线上本地读回（最终实际签署另附）\n\n${common}\n不包含完整R4、项目移交、实际成本40、经营验收完工归档、R5–R7、上游作者UI/财务19UI、新机制Native符合性、部署切流或性能。#101/#57保持Open。\n`;const comment=`G4 线上收口已执行，按本批独立关闭许可关闭 #${n}；最终独立实际读回签署随收口索引另附。\n\n${common}\n仅认证本Issue交付边界，#101/#57继续Open；未认领完整R4或后续阶段。\n`;actions.push({issue:n,desiredState:'CLOSED',body,comment});}
const parent101=`状态：Doing / OPEN。首批37入口及#102/#103/#104/#105已收口，完整R4尚未完成。最后核验2026-11-04（Asia/Tokyo）。\n\n总体#57；依赖R3 #85已完成。R4完整范围包括合同签约与资金、项目移交/回款判断冻结、实际成本与经营、验收/完工/归档及相应内部/审批消费。90项历史阶段映射尚须在后续切片对当前controller/spec/canonical与既有Rust去重重核，不能由本批推导完整交付。\n\n- [x] R3阶段G4已交付\n- [x] 首批#102：A#103/B#104/C#105联合37入口及必要真实内部消费G4\n- [ ] 其余移交/实际成本40/经营/验收完工归档子片G4\n- [ ] R4真实生产者完整阶段闭环及独立G3/G4\n\n${common}\n本阶段和#57保持Open；后续切片必须复核归属并冻结自己的G1，再推进实现及实际消费验收。\n`;
actions.push({issue:101,desiredState:'OPEN',body:parent101,comment:`R4首批 #102/#103/#104/#105已按各自独立G4收口；本阶段维持Open。\n\n${common}\n剩余移交、实际成本40、经营验收完工归档及完整R4集成不计完成。\n`});
const parent57=`状态：**Doing / OPEN**。R0/R1/R2/R3已完成；R4进行中，首批37入口已G4收口；R5–R7继续Todo。最后核验2026-11-04（Asia/Tokyo）。\n\n- [x] R0 #58：迁移基线、契约、数据和环境\n- [x] R1 #60：应用、认证、SQLx与跨平台基础\n- [x] R2 #67：108/108操作及R2M阶段验收；#61裁决已收口\n- [x] R3 #85：58/58公共HTTP及#97非HTTP/审批/完整阶段集成G4\n- [ ] R4 #101：合同、资金、移交、成本与执行；首批#102及#103/#104/#105共37入口已收口，完整阶段保持Doing\n- [ ] R5：提成全链路，依赖完整R4\n- [ ] R6：迁移/发布接管与回滚演练，依赖R5\n- [ ] R7：统一切换、观察和旧后端退出，依赖R6与正式切换授权\n\n当前Rust公开surface累计210（既有173+本批37），共享契约完整291 operations/595 schemas、client586文件；不把共享schema或已有最小只读适配计作尚未迁移的业务producer。\n\n${common}\n后续仍为R4移交、实际成本40、经营核算/验收完工归档及完整阶段验收，再推进R5–R7。新Rust以业务语义、正确性和合理性为准，不追Node缺陷级对齐。无生产部署、切流或性能结论；总体Issue继续Open。\n`;
actions.push({issue:57,desiredState:'OPEN',body:parent57,comment:`已维护总体状态：仅新增本批37入口正式收口，R4仍Doing，R5–R7仍Todo，本Issue保持Open。\n\n${common}\n累计技术surface210不代表完整R4或整体迁移完成。\n`});
const plan={kind:'concrete-six-Issue-G4-closeout-plan',createdAt:new Date().toISOString(),implementationCommit:implementation,archiveCommit,scope:{closeOnly:[103,104,105,102],keepOpen:[101,57]},sourceBefore:Object.fromEntries(ids.map(n=>[n,{state:before['i'+n].state,body:before['i'+n].body,bodySha256:sha(Buffer.from(before['i'+n].body)),subIssues:before['i'+n].subIssues.nodes}])),actions,executionOrder:[103,104,105,102,101,57],requireIndependentPreclosePass:true,actualWriteApplied:false,G4Certified:false};fs.writeFileSync(pub+'/plan65.json',JSON.stringify(plan,null,2)+'\n',{flag:'wx'});for(const file of fs.readdirSync(out))fs.copyFileSync(out+'/'+file,pub+'/'+file+'.bin',fs.constants.COPYFILE_EXCL);console.log(JSON.stringify({planSha256:sha(fs.readFileSync(pub+'/plan65.json')),close:[103,104,105,102],keepOpen:[101,57],concreteBodiesAndComments:6,actualWriteApplied:false}));

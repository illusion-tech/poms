import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';const sha=b=>createHash('sha256').update(b).digest('hex');for(const[name,expected]of[['fixed-commit09.json','d35b98a9006a07dca3dafcb5b4a7a2d9525942990ca05e1ba5e6043d77673924'],['fixed-commit09-blobs.json','1f407dfadb9df49f3f367b32f59dedd465cf5503a3ca4a6eb7d13bae408145b0']]){const b=fs.readFileSync('tmp/rust-r4abc/independent/'+name);assert.equal(sha(b),expected);fs.writeFileSync('docs/design/rust-r4abc/'+name+'.bin',b,{flag:'wx'});}console.log(JSON.stringify({independentFixedOriginalsPreserved:2,productChanges:0}));

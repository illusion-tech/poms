import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{spawnSync,execFileSync}from'node:child_process';const sha=b=>createHash('sha256').update(b).digest('hex'),raw=fs.readFileSync('tmp/rust-r4abc/independent/g3-independent08.json');assert.equal(sha(raw),'4abaab087cd553341427e7f608bf9aaeda86d061c6bc4727e7437871dbb1ad0b');const review=JSON.parse(raw);assert(JSON.stringify(review).includes('Pass'));const manifest=JSON.parse(fs.readFileSync('docs/design/rust-r4abc/final-source53.json','utf8'));for(const p of manifest.products)assert.equal(sha(fs.readFileSync(p.file)),p.rawBytesSha256,p.file);const base='docs/design/rust-r4abc';fs.writeFileSync(base+'/g3-independent08.json.bin',raw,{flag:'wx'});fs.writeFileSync(base+'/g3-authority60.json',JSON.stringify({kind:'actual-independent-G3-admission',review:{file:base+'/g3-independent08.json.bin',rawBytesSha256:sha(raw)},sourceManifestSha256:'5ee6a7f3ab7893e5e840e879ecb18f993f8c6910ccd7ac5066ea511acae81db1',validationSha256:'7336469c939c046a966b62353d0d87807b609dbcf3101b11e7d2212ba290eaeb',supplementSha256:'0bc46818a401c666e5468da2421894ea4e84137abd4033d6bb76a77844922d86',G3Certified:true,allowed:'fixed implementation commit on codex/poms-r4abc-first37 only',mainAuthorizedByThisRecord:false,G4Certified:false,issuesRemainOpen:[103,104,105,102,101,57]},null,2)+'\n',{flag:'wx'});
const message='feat(contract): 交付 R4 首批合同与资金主链\n\n- 签约就绪9、合同9、资金19入口；每合同独立金额及可审计来源，不以Node缺陷级对齐为目标\n- 真实准备版本、精确审核绑定、原子生效快照及正式应收计划；必要业务、审计和会话同事务\n- 保留永久S3输入提交4f78bd48及原六道生成来源保护，不squash；完整595 schemas与586 client\n- Rust310通过及54历史ignored；Native74套863项，Angular59套411项；真实59故障、6锁屏障及跨项目负例、两平台UI\n- 1004自有行精确清理，原seed/catalog/ACL恢复且二次noop；对象原字节与私有证据保留，运行态已停止\n- 独立G3: 4abaab087cd553341427e7f608bf9aaeda86d061c6bc4727e7437871dbb1ad0b，固定提交/main/G4仍待各自复核\n\nRefs #102, #103, #104, #105, #101, #57\n';fs.writeFileSync('tmp/rust-r4abc/implementation-commit60.txt',message,{flag:'wx'});const add=spawnSync('git',['add','--',base+'/g3-independent08.json.bin',base+'/g3-authority60.json'],{windowsHide:true});assert.equal(add.status,0);const checked=spawnSync('git',['diff','--cached','--check'],{windowsHide:true});assert.equal(checked.status,0);console.log(JSON.stringify({G3Adopted:true,sourceProductsStillExact:manifest.products.length,commitMessageReady:true}));

import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{execFileSync,spawnSync}from'node:child_process';import{createHash}from'node:crypto';
const root=process.cwd().replaceAll('\\','/'),primary='E:/projects/poms',head=process.argv[2],out='tmp/rust-r4abc/root/main-integration64';assert.equal(root,'E:/projects/worktrees/poms-r3hijk-next28/poms');assert(/^[a-f0-9]{40}$/.test(head));assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex'),blob=b=>createHash('sha1').update(Buffer.from('blob '+b.length+'\0')).update(b).digest('hex'),commands=[];
function git(cwd,args){const r=spawnSync('git',args,{cwd,encoding:null,windowsHide:true,timeout:120000,maxBuffer:32000000}),index=commands.length+1;fs.writeFileSync(out+'/'+index+'-stdout-original.bin',r.stdout||Buffer.alloc(0),{flag:'wx'});fs.writeFileSync(out+'/'+index+'-stderr-original.bin',r.stderr||Buffer.alloc(0),{flag:'wx'});commands.push({cwd,args,exitCode:r.status});fs.writeFileSync(out+'/progress.json',JSON.stringify({head,commands},null,2)+'\n');assert.equal(r.status,0,'Exact Git operation failed; original streams retained');return r.stdout;}
assert.equal(git(primary,['rev-parse','--show-toplevel']).toString().trim().replaceAll('\\','/'),primary);assert.equal(git(primary,['rev-parse','--abbrev-ref','HEAD']).toString().trim(),'main');assert.equal(git(root,['rev-parse','HEAD']).toString().trim(),head);assert.equal(git(primary,['status','--porcelain','--untracked-files=no']).toString(),'');const beforeHead=git(primary,['rev-parse','HEAD']).toString().trim(),remoteBefore=git(root,['ls-remote','origin','refs/heads/main']).toString().trim().split('\t')[0];assert.equal(beforeHead,remoteBefore);git(root,['merge-base','--is-ancestor',beforeHead,head]);git(root,['merge-base','--is-ancestor','4f78bd486ca2118e4700bae560cb25ff08c4b47d',head]);
function tree(ref){return new Map(git(primary,['ls-tree','-rz',ref]).toString('utf8').split('\0').filter(Boolean).map(line=>{const at=line.indexOf('\t'),fields=line.slice(0,at).split(' ');return[line.slice(at+1),{mode:fields[0],oid:fields[2]}]}));}
const oldTree=tree(beforeHead),newTree=tree(head),before=[];for(const[file,item]of oldTree){const full=path.resolve(primary,file).replaceAll('\\','/');assert(full.toLowerCase().startsWith((primary+'/').toLowerCase()));assert(fs.existsSync(full));const stat=fs.lstatSync(full),bytes=stat.isSymbolicLink()?Buffer.from(fs.readlinkSync(full)):fs.readFileSync(full),record={file,...item,bytes:bytes.length,rawBytesSha256:sha(bytes),rawMatchesGitBlob:blob(bytes)===item.oid,unchangedInIntegration:newTree.get(file)?.oid===item.oid};if(!record.rawMatchesGitBlob){const saved=out+'/primary-originals/'+file+'.bin';fs.mkdirSync(path.dirname(saved),{recursive:true});fs.writeFileSync(saved,bytes,{flag:'wx'});record.savedOriginal=saved;record.onlyCRLFRepresentation=blob(Buffer.from(bytes.toString('utf8').replace(/\r\n/g,'\n')))===item.oid;}before.push(record);}fs.writeFileSync(out+'/primary-before64.json',JSON.stringify({beforeHead,before},null,2)+'\n',{flag:'wx'});
git(primary,['merge','--ff-only',head]);assert.equal(git(primary,['rev-parse','HEAD']).toString().trim(),head);const preserved=[];for(const p of before.filter(p=>p.unchangedInIntegration)){const full=path.join(primary,p.file),s=fs.lstatSync(full);let b=s.isSymbolicLink()?Buffer.from(fs.readlinkSync(full)):fs.readFileSync(full);if(sha(b)!==p.rawBytesSha256){assert(p.savedOriginal&&!s.isSymbolicLink(),'Never overwrite changed semantic content');fs.copyFileSync(p.savedOriginal,full);b=fs.readFileSync(full);}assert.equal(sha(b),p.rawBytesSha256);if(p.savedOriginal)preserved.push({file:p.file,rawBytesSha256:p.rawBytesSha256,onlyCRLFRepresentation:p.onlyCRLFRepresentation});}
const m=JSON.parse(fs.readFileSync('docs/design/rust-r4abc/final-source53.json','utf8'));for(const p of m.products){const b=fs.readFileSync(path.join(primary,p.file));assert.equal(sha(Buffer.from(b.toString('utf8').replace(/\r\n/g,'\n'))),p.normalizedTextSha256,p.file+' primary product');}assert.equal(git(primary,['status','--porcelain','--untracked-files=no']).toString(),'');git(primary,['push','origin','main']);const remote=git(root,['ls-remote','origin','refs/heads/main']).toString().trim().split('\t')[0];assert.equal(remote,head);fs.writeFileSync(out+'/receipt64.json',JSON.stringify({kind:'exact-fast-forward-primary-main-integration',beforeHead,implementationCommit:head,remoteMain:remote,commands,all949ProductsMatchReviewedNormalizedText:true,allUnchangedPrimaryFilesKeepOriginalRawBytes:true,rawRepresentationsPreserved:preserved,unchangedFiles:before.filter(p=>p.unchangedInIntegration).length,primaryClean:true,permanentS3AncestorPreserved:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({main:head,fastForward:true,products:949,unchangedRawFiles:before.filter(p=>p.unchangedInIntegration).length,preservedRepresentations:preserved.length,primaryClean:true}));

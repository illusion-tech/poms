import fs from'node:fs';import assert from'node:assert/strict';import{spawnSync}from'node:child_process';import{createHash}from'node:crypto';const out='tmp/rust-r4abc/root/online-g3-62',sha=b=>createHash('sha256').update(b).digest('hex');assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});let n=0;const calls=[];function api(label,args,body){const prefix=out+'/'+String(++n).padStart(2,'0')+'-'+label;if(body){fs.writeFileSync(prefix+'-input.json',JSON.stringify(body,null,2)+'\n',{flag:'wx'});args=[...args,'--input',prefix+'-input.json'];}const r=spawnSync('gh',['api',...args],{encoding:null,windowsHide:true,timeout:60000,maxBuffer:8000000});for(const s of['stdout','stderr'])fs.writeFileSync(prefix+'-'+s+'-original.bin',r[s]||Buffer.alloc(0),{flag:'wx'});calls.push({label,args,exitCode:r.status});assert.equal(r.status,0,'Preserve partial; inspect live state before retry');const value=JSON.parse(r.stdout);assert(!value.errors);return value;}
const ids=[103,104,105,102,101,57],query='query{repository(owner:"illusion-tech",name:"poms"){'+ids.map(i=>'i'+i+':issue(number:'+i+'){number state body url}').join(' ')+'}}',before=api('before',['graphql'],{query}).data.repository;for(const i of ids)assert.equal(before['i'+i].state,'OPEN');const marker='<!-- r4abc-g3-a2995dfb -->',bodies=[];
for(const i of ids){let body=before['i'+i].body;assert(!body.includes(marker));if([103,104,105,102].includes(i)){body=body.replace(/^状态：[^\n]*/, '状态：Doing / 独立G3已通过；固定提交、main与G4待复核。').replace('- [ ] 实现及独占文件交付','- [x] 实现及独占文件交付').replace('- [ ] 统一候选真实生产者、故障/并发/权限/原UI验收与自有环境终态','- [x] 统一候选真实生产者、故障/并发/权限/原UI验收与自有环境终态');}
body+='\n'+marker+'\n当前首批统一候选及实际验收完成，非作者 G3 Pass（开放P0/P1/P2均0），实现分支提交 `a2995dfb187a70064d2e54ce336a72c24974721a`；固定提交/main/G4仍分别待审，本Issue维持Open。\n本批仅37入口（A9/B9/C19），整体Rust公开操作技术可用210；完整R4、实际成本40、移交经营验收完工归档及R5–R7未因此完成，#101/#57保持Open。\n';bodies.push({issue:i,body});api('body-'+i,['repos/illusion-tech/poms/issues/'+i,'--method','PATCH'],{body});}
const comment='独立 G3 已通过，仅准许本候选固定提交；尚未集成 main 或关闭 Issue。\n\n- 实现：[a2995dfb](https://github.com/illusion-tech/poms/commit/a2995dfb187a70064d2e54ce336a72c24974721a)，S3永久祖先4f78bd48保留。\n- [独立G3原件](https://github.com/illusion-tech/poms/blob/a2995dfb187a70064d2e54ce336a72c24974721a/docs/design/rust-r4abc/g3-independent08.json.bin)，SHA256 `4abaab087cd553341427e7f608bf9aaeda86d061c6bc4727e7437871dbb1ad0b`。\n- [实际验收边界](https://github.com/illusion-tech/poms/blob/a2995dfb187a70064d2e54ce336a72c24974721a/docs/design/rust-r4abc/validation-checkpoint57.md)：Rust310/54历史ignored、Native863、Angular411；59必要写故障/6锁屏障/外项目锁负例及Linux续跑链、Windows完整原UI，旧失败/partial与Native参考不升格。\n- 1004自有行清理，113表seed/catalog/ACL恢复及两次noop，运行对象0、自有运行态停止；卷/private保留。\n- 仅#103/#104/#105/#102可在各自独立G4后关闭，#101/#57持续Open。\n';const c=api('comment-102',['repos/illusion-tech/poms/issues/102/comments','--method','POST'],{body:comment});const after=api('after',['graphql'],{query}).data.repository;for(const b of bodies){assert.equal(after['i'+b.issue].state,'OPEN');assert.equal(after['i'+b.issue].body,b.body);}fs.writeFileSync(out+'/receipt62.json',JSON.stringify({kind:'actual-six-Issue-G3-progress-readback',bodies,comment:{issue:102,id:c.id,url:c.html_url,body:comment},calls,allSixRemainOpen:true,implementationCommit:'a2995dfb187a70064d2e54ce336a72c24974721a',G4Certified:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({G3ProgressSynced:6,comment:c.html_url,allRemainOpen:true}));

import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const root=process.cwd().replaceAll('\\','/'),active='docs/design/rust-r4abc',archive='docs/design/archive/slices/rust-r4abc',oldBaseline='docs/design/rust-r4abc-first37-baseline.md',newBaseline='docs/design/archive/slices/rust-r4abc-first37-baseline.md',out='tmp/rust-r4abc/root/archive-writeback63';assert.equal(root,'E:/projects/worktrees/poms-r3hijk-next28/poms');assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const sha=b=>createHash('sha256').update(b).digest('hex'),pin=file=>{const b=fs.readFileSync(file);return{file,bytes:b.length,rawBytesSha256:sha(b)}};
function within(relative){const resolved=path.resolve(root,relative).replaceAll('\\','/');assert(resolved.toLowerCase().startsWith((root+'/').toLowerCase()));return resolved;}
for(const p of[active,archive,oldBaseline,newBaseline])within(p);assert(!fs.existsSync(archive)&&!fs.existsSync(newBaseline));assert(!fs.lstatSync(active).isSymbolicLink());assert(fs.realpathSync(path.dirname(archive)).replaceAll('\\','/').toLowerCase().startsWith(root.toLowerCase()+'/'));
const m=JSON.parse(fs.readFileSync(active+'/final-source53.json','utf8'));assert(!m.compilationInputs.some(p=>p===oldBaseline||p.startsWith(active+'/')),'Production compilation inputs never move for lifecycle archive');
const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>{assert(!e.isSymbolicLink());return e.isDirectory()?walk(d+'/'+e.name):[d+'/'+e.name]});const before=[...walk(active),oldBaseline].map(pin);fs.renameSync(active,archive);fs.renameSync(oldBaseline,newBaseline);const origins=[];for(const p of before){const target=p.file===oldBaseline?newBaseline:archive+p.file.slice(active.length);assert.equal(pin(target).rawBytesSha256,p.rawBytesSha256);origins.push({logicalOrigin:p.file,storedAt:target,bytes:p.bytes,rawBytesSha256:p.rawBytesSha256});}
fs.writeFileSync(archive+'/archive-origin-map63.json',JSON.stringify({kind:'actual-raw-byte-preserving-R4-lifecycle-archive',createdAt:new Date().toISOString(),origins,files:origins.length,allRawBytesEqual:true,productionCompilationInputsMoved:0},null,2)+'\n',{flag:'wx'});
const note='\n\n### 2026-11-04 R4 首批独立 G3、实现与主线集成\n\nR4 首批 [#102](https://github.com/illusion-tech/poms/issues/102) 的 A#103/B#104/C#105 共37入口已完成真实实现及验收，[独立 G3](archive/slices/rust-r4abc/g3-independent08.json.bin) Pass、固定提交复核和main集成已完成；实现为 `a2995dfb187a70064d2e54ce336a72c24974721a`，S3 `4f78bd48` 永久祖先保留。当前为 **G4Ready，尚不标Done或关闭**，仅具体四项G4方案可在独立许可和实际读回后收口，#101/#57维持Open。\n\n[验收索引](archive/slices/rust-r4abc/validation-checkpoint57.md)、[原字节归档](archive/slices/rust-r4abc/archive-origin-map63.json)和[后续范围](rust-r4-scope-and-dependencies.md)分别保留真实边界：Rust310/54历史ignored，Native863，Angular411，59真实写故障、6屏障并发及跨项目锁负例、Linux续跑链与Windows完整原UI；1004自有行及借用原件恢复、两次noop、对象原字节和卷/private保留，运行态已停止。整体Rust技术surface210，本批37尚待正式G4计交付；完整R4、成本40、移交经营验收完工归档、R5–R7及部署切流不因此完成。旧G1/Pending/失败/partial文句只保留原时点，当前进度以本条及GitHub为准。\n';
const docs=['docs/design/backend-rust-migration-plan.md','docs/design/rust-migration-execution-tracker.md','docs/design/phase2-development-execution-tracker.md','docs/design/poms-design-progress.md','docs/design/README.md'];const edited=[];
for(const file of docs){assert(!m.compilationInputs.includes(file));const old=fs.readFileSync(file),saved=out+'/before/'+path.basename(file)+'.bin';fs.mkdirSync(path.dirname(saved),{recursive:true});fs.writeFileSync(saved,old,{flag:'wx'});let t=old.toString('utf8').replace(/^\*\*最后更新\*\*:\s*[^\r\n]*/m,'**最后更新**: 2026-11-04').replaceAll('(rust-r4abc-first37-baseline.md)','(archive/slices/rust-r4abc-first37-baseline.md)');if(file.endsWith('backend-rust-migration-plan.md'))t=t.replace('R4首批G0/G1进行中','R4首批37入口已集成/G4Ready');if(file.endsWith('rust-migration-execution-tracker.md'))t=t.replace('R4首批#101/#102进入G0/G1','R4首批#102实现已集成、G4Ready，#101保持Doing');t+=note;fs.writeFileSync(file,t);edited.push(pin(file));}
const scope='# R4 范围与后续依赖\n\n最后更新：2026-11-04。阶段父 [#101](https://github.com/illusion-tech/poms/issues/101)、总体 [#57](https://github.com/illusion-tech/poms/issues/57) 保持 Open。当前首批 #102 为 G4Ready，正式关闭许可和线上读回待完成。\n\n## 首批边界\n\nA#103签约就绪9、B#104合同9、C#105资金19，共37公开入口；Runtime累计210，完整共享契约291 operations/595 schemas、client586文件。实际合同准备→精确审核绑定→原子生效快照→正式应收计划，以及独立合同金额、来源差异、正数两位金额和付款归属均已实现验收。详见[归档验收](archive/slices/rust-r4abc/validation-checkpoint57.md)。\n\n## 尚未交付的阶段范围\n\n项目移交与回款判断冻结、实际成本40入口、经营核算与风险视图、验收/完工/归档、相应内部/审批机制，以及完整R4阶段集成验收仍须各自建片、复核操作归属并冻结G1；不能因本批或R2已有最小事实读取适配而计完成。R5完整提成还依赖后续真实成本/经营/冻结事实；R6/R7接管与切流另需自己的验收和授权。\n\n本批合同/有效快照/计划和资金事实可以作为后续冻结输入。移交与成本领域可在接口及共享资源归属明确后并行准备；实际消费验收必须依赖真实上游交付，不以合成映射fixture替代成本producer。新增作者UI或财务UI、生产部署和性能均未被本批认领。\n';assert(!fs.existsSync('docs/design/rust-r4-scope-and-dependencies.md'));fs.writeFileSync('docs/design/rust-r4-scope-and-dependencies.md',scope,{flag:'wx'});
fs.writeFileSync('docs/design/rust-r4abc-delivery-status.json',JSON.stringify({kind:'GitHub-mirrored-R4-first37-delivery-index',updatedAt:new Date().toISOString(),implementationCommit:'a2995dfb187a70064d2e54ce336a72c24974721a',stage:'G4Ready',newPublicOperations:37,officialNewDeliveredBeforeOnlineG4:0,technicalRustOperations:210,issues:{103:'OPEN',104:'OPEN',105:'OPEN',102:'OPEN',101:'OPEN',57:'OPEN'},archive:'archive/slices/rust-r4abc/archive-origin-map63.json',fullR4Complete:false,G4Certified:false},null,2)+'\n',{flag:'wx'});
fs.writeFileSync(out+'/receipt63.json',JSON.stringify({kind:'actual-lifecycle-archive-and-G4Ready-writeback',origins:archive+'/archive-origin-map63.json',files:origins.length,allRawBytesEqual:true,docs:edited,sourceProductsUnchanged:true,GitHubCloseApplied:false,keepOpen:[101,57]},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({archivedFiles:origins.length,allRawBytesEqual:true,docs:docs.length,stage:'G4Ready',issuesNotClosed:true}));

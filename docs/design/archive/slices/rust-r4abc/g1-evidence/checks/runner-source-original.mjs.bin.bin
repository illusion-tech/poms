import fs from 'node:fs';import assert from 'node:assert/strict';import{spawnSync}from'node:child_process';import{createHash}from'node:crypto';
const out='tmp/rust-r4abc/root/g1-static-checks01';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});
const pin=file=>{const b=fs.readFileSync(file);return{file,bytes:b.length,rawBytesSha256:createHash('sha256').update(b).digest('hex')}};
const manifest='docs/design/rust-r4abc/g1-candidate-manifest01.json',before=pin(manifest);const commands=[];
for(const[name,exe,args]of [['diff-check','git',['diff','--check']],['all-markdown','E:/.cargo/bin/deno.exe',['task','format:md:check']]]){
const startedAt=new Date().toISOString();const r=spawnSync(exe,args,{encoding:null,windowsHide:true,timeout:120000,maxBuffer:16000000});const stdout=out+'/'+name+'-stdout-original.bin',stderr=out+'/'+name+'-stderr-original.bin';fs.writeFileSync(stdout,r.stdout||Buffer.alloc(0),{flag:'wx'});fs.writeFileSync(stderr,r.stderr||Buffer.alloc(0),{flag:'wx'});commands.push({name,exe,args,startedAt,completedAt:new Date().toISOString(),exitCode:r.status,errorName:r.error?.name??null,stdout:pin(stdout),stderr:pin(stderr)});}
assert.deepEqual(pin(manifest),before);fs.copyFileSync('tmp/rust-r4abc/root/g1-static-checks01.mjs',out+'/runner-source-original.mjs.bin',fs.constants.COPYFILE_EXCL);
const receipt={kind:'R4-G1-current-metadata-static-checks',candidate:before,commands,candidateManifestUnchanged:true,productOrRuntimeExecuted:false,passed:commands.every(x=>x.exitCode===0),runner:pin(out+'/runner-source-original.mjs.bin')};fs.writeFileSync(out+'/receipt01.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({receipt:pin(out+'/receipt01.json'),passed:receipt.passed}));assert(receipt.passed);

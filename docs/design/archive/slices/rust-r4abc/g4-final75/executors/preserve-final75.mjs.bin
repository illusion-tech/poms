import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const base='docs/design/archive/slices/rust-r4abc',out=base+'/g4-final75',sha=b=>createHash('sha256').update(b).digest('hex');assert(!fs.existsSync(out));const live=fs.readFileSync('tmp/rust-r4abc/independent/g4-actual12-live-readback.json');assert.equal(sha(live),'b931ff289f1cf007e0b2241ca485eb8a517ec469e4982dcbbf3c014972e79235');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(d+'/'+e.name):[d+'/'+e.name]),needles=JSON.parse(fs.readFileSync('tmp/rust-r4abc/private/privacy-needles56.json','utf8')).map(s=>Buffer.from(s)),pending=[];for(const folder of ['tmp/rust-r4abc/root/metadata-online7268','tmp/rust-r4abc/root/final-writeback73','tmp/rust-r4abc/root/preservation-audit74'])for(const file of walk(folder)){const b=fs.readFileSync(file);assert(!needles.some(n=>b.includes(n)));pending.push({file,dest:out+'/root/'+file.slice('tmp/rust-r4abc/root/'.length)+'.bin',b});}for(const file of['tmp/rust-r4abc/final-writeback73.mjs','tmp/rust-r4abc/preservation-audit74.mjs','tmp/rust-r4abc/preserve-online72.mjs','tmp/rust-r4abc/preserve-final75.mjs']){const b=fs.readFileSync(file);assert(!needles.some(n=>b.includes(n)));pending.push({file,dest:out+'/executors/'+path.basename(file)+'.bin',b});}pending.push({file:'tmp/rust-r4abc/independent/g4-actual12-live-readback.json',dest:out+'/independent-live-readback12.json.bin',b:live});fs.mkdirSync(out,{recursive:true});const origins=[];for(const p of pending){fs.mkdirSync(path.dirname(p.dest),{recursive:true});fs.writeFileSync(p.dest,p.b,{flag:'wx'});origins.push({logicalOrigin:p.file,storedAt:p.dest,bytes:p.b.length,rawBytesSha256:sha(p.b)});}fs.writeFileSync(out+'/origin-map75.json',JSON.stringify({kind:'final-independent-G4-original-and-ordinary-writeback-preservation',origins,allRawBytesEqual:true,privateDataPublished:false,productChanges:0,IssueWrites:0},null,2)+'\n',{fl
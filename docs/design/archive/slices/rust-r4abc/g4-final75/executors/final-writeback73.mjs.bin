import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const expected=process.argv[2],archive='docs/design/archive/slices/rust-r4abc',sha=b=>createHash('sha256').update(b).digest('hex'),raw=fs.readFileSync('tmp/rust-r4abc/independent/g4-actual12.json');assert(/^[a-f0-9]{64}$/.test(expected));assert.equal(sha(raw),expected);const review=JSON.parse(raw);assert.equal(review.decision,'Pass');const out='tmp/rust-r4abc/root/final-writeback73';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});fs.writeFileSync(archive+'/g4-actual12.json.bin',raw,{flag:'wx'});const online=JSON.parse(fs.readFileSync(archive+'/g4-online66/receipt66.json','utf8'));assert(online.allBodiesCommentsExactPlan&&online.G4OnlineApplied);const statusFile='docs/design/rust-r4abc-delivery-status.json',s=JSON.parse(fs.readFileSync(statusFile,'utf8'));delete s.officialNewDeliveredBeforeOnlineG4;Object.assign(s,{stage:'G4Certified',officialNewDelivered:37,technicalRustOperations:210,updatedAt:new Date().toISOString(),finalIndependentActualReviewPending:false,independentActualG4:{file:'archive/slices/rust-r4abc/g4-actual12.json.bin',rawBytesSha256:expected},fullR4Complete:false,G4Certified:true});fs.writeFileSync(statusFile,JSON.stringify(s,null,2)+'\n');
const note='\n\n### 2026-11-04 R4 首批独立实际 G4 终审 Pass\n\n[最终非作者实际G4签署](archive/slices/rust-r4abc/g4-actual12.json.bin) Pass，仅认证A9/B9/C19首批37入口；#103/#104/#105/#102 Closed，#101/#57持续Open，完整R4和R5–R7仍未完成。实际实现a2995dfb、永久S3、固定提交/main、原字节归档和六Issue正文/comment/state/native tree读回一致，949产品原字节无变。\n\n当前正式新增交付37，Rust公开surface累计210。最终签署与当前状态的普通metadata写回不改任何产品、Issue正文/状态或既有1390原件；54历史ignored、163有界复用、失败/partial/Native参考与未认领范围保留原标签。\n';const files=['docs/design/backend-rust-migration-plan.md','docs/design/rust-migration-execution-tracker.md','docs/design/phase2-development-execution-tracker.md','docs/design/poms-design-progress.md','docs/design/README.md'];for(const file of files){const old=fs.readFileSync(file,'utf8');fs.writeFileSync(out+'/'+path.basename(file)+'.before.bin',old,{flag:'wx'});let t=old.replace('R4首批37入口线上收口/最终独立签署待附','R4首批37入口独立G4通过；完整R4仍Doing').replace('R4首批#102已线上收口、最终独立签署待附，#101保持Doing','R4首批#102独立G4完成，#101保持Doing');t+=note;fs.writeFileSync(file,t);}const scope='docs/design/rust-r4-scope-and-dependencies.md';let t=fs.readFileSync(scope,'utf8').replace('当前首批 #102/#103/#104/#105 已按许可实际线上关闭，最终独立实际签署待附；完整 R4 仍未完成。','当前首批 #102/#103/#104/#105 已完成独立实际 G4 并关闭；新增37入口正式交付，完整 R4 仍未完成。');fs.writeFileSync(scope,t);const index='docs/design/archive/slices/rust-r4abc-closeout.md';t=fs.readFileSync(index,'utf8').replace('当前：G4OnlineApplied，最终独立实际签署待附。','当前：本批独立实际 G4 终审 Pass，仅首批37入口；#101/#57保持Open。');t+='\n\n## 最终实际签署\n\n[非作者实际G4终审](rust-r4abc/g4-actual12.json.bin) Pass，SHA256 `'+expected+'`。正文、评论、状态、native树、固定提交/main及所有边界已核；只完成#103/#104/#105/#102。949产品与既有原件不变，完整R4及后续阶段保持开放。\n';fs.writeFileSync(index,t);
const m=JSON.parse(fs.readFileSync(archive+'/final-source53.json','utf8'));for(const p of m.products)assert.equal(sha(fs.readFileSync(p.file)),p.rawBytesSha256);fs.writeFileSync(archive+'/g4-actual-authority73.json',JSON.stringify({kind:'actual-independent-first37-G4-authority',review:{file:archive+'/g4-actual12.json.bin',rawBytesSha256:expected},implementationCommit:'a2995dfb187a70064d2e54ce336a72c24974721a',closedOnly:[103,104,105,102],keepOpen:[101,57],officialNewDelivered:37,fullR4Complete:false,all949ProductsUnchanged:true,G4Certified:true},null,2)+'\n',{flag:'wx'});fs.writeFileSync(out+'/receipt73.json',JSON.stringify({kind:'ordinary-final-independent-signature-and-current-index-writeback',reviewSha256:expected,onlyMetadata:true,productChanges:0,IssueWrites:0,currentStage:'G4Certified',officialNewDelivered:37,fullR4Complete:false},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({independentActualG4Adopted:true,officialNewDelivered:37,parentsOpen:true,productChanges:0,IssueWrites:0}));

import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';const archive='docs/design/archive/slices/rust-r4abc',sha=b=>createHash('sha256').update(b).digest('hex'),resolve=file=>file.startsWith('docs/design/rust-r4abc/')?archive+file.slice('docs/design/rust-r4abc'.length):file,out='tmp/rust-r4abc/root/preservation-audit74';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});let records=0;const maps=[archive+'/archive-origin-map63.json',archive+'/g2-evidence56/origin-map56.json',archive+'/g4-evidence66/origin-map66.json',archive+'/validation-supplement59.json',archive+'/g4-derived72/origin-map72.json',archive+'/g4-online66/receipt66.json'];const summaries=[];
for(const file of maps){const m=JSON.parse(fs.readFileSync(file,'utf8'));let count=0;for(const p of m.origins){const at=resolve(p.storedAt);assert.equal(sha(fs.readFileSync(at)),p.rawBytesSha256,at);records++;count++;}summaries.push({file,records:count,allRawBytesEqual:true});}const source=JSON.parse(fs.readFileSync(archive+'/final-source53.json','utf8'));for(const p of source.products)assert.equal(sha(fs.readFileSync(p.file)),p.rawBytesSha256);const receipt=JSON.parse(fs.readFileSync(archive+'/g4-online66/receipt66.json','utf8'));assert(receipt.allBodiesCommentsExactPlan&&receipt.nativeParentRelationsVerified);const status=JSON.parse(fs.readFileSync('docs/design/rust-r4abc-delivery-status.json','utf8'));assert(status.G4Certified&&status.officialNewDelivered===37&&!status.fullR4Complete);fs.writeFileSync(out+'/receipt74.json',JSON.stringify({kind:'final-preservation-original-byte-and-product-audit',maps:summaries,records,allRawBytesEqual:true,productsRawUnchanged:source.products.length,currentG4Certified:true,officialNewDelivered:37,parentsOpen:[101,57],rootPrivateEvidenceNotPublished:true,productionInputsMoved:0},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({originalReferencesVerified:records,allRawBytesEqual:true,productsUnchanged:source.products.length,G4Certified:true}));

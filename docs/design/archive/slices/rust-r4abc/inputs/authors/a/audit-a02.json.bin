  "upstreamR3": {
    "actualTables": ["project_technical_cost_package", "project_bid_commercial_process", "project_pricing_margin_review", "project_pricing_margin_condition_item", "approval_summary_snapshot"],
    "availableRefs": "All three R3 version stores expose current/by-id with parsed UUID; writers lock poms.project and CAS supersede under same TX; share that serialization instead of reading latest on another connection.",
    "nativeCurrentGap": "A only checks project and own baseline/diff. A.quotation_review_id is unvalidated nullable UUID. R3 released/conditional-release needs an existing commercial_release_baseline FK and summary references. No quotation-review ApprovalType/handler exists in current Shared/Rust approval source.",
    "nonCyclicProductionProposal": [
      "Real cost/bid current versions exist.",
      "A01 creates an immutable draft project commercial-terms source candidate; it does not grant readiness or claim release. Current pricing-pending inputs, if present, are server-read and captured; caller cannot set effective/ready/diff decisions.",
      "Existing R3 pricing create records a released/conditional-release current version referencing that existing draft baseline ID, after existing R3 current cost/bid checks; no need to require a released pricing row before creating that referenced draft.",
      "A05 locks project/selected contract and reads actual current cost/bid/pricing, conditions and linked summary. It validates the project pricing baseline FK, source freshness and project source payload, readyForContracting and required conditions; separately freezes explicit selected-contract amounts/terms/typed seeds, computes and audits differences against the commercial source, and derives contract-bound readiness. Contract amounts are independent: no project-total copying, allocation, sum-equality or hard budget. The source baseline promotion and source-bound package remain atomic; blocked actual source/diff/review facts cannot be overridden by body flags.",
      "A05 first persists the real contract-specific diff and a derived blocked/review-required package when review is needed. A04 explicitly names contractId+diffResultId, records required decisions against that exact diff and recomputes its associated current package guard/status under the same TX. A08 then binds explicit contractId, checks its draft/source/package versions and approved computed diff and produces immutable prepared terms. B review binds one exact prepared version; B activation never swaps to project-latest terms.",
      "A09 consumes only that contract's active snapshot frozen typed seeds after B activation and writes its real plan/version/nodes/init record atomically."
    ],
    "fieldChangesProposed": ["baseline.source_pricing_margin_review_id real FK and explicit currency; legacy quotationReviewId cannot be an arbitrary business truth", "draft project baseline immutable payload hash; released pricing refers to the same project source payload", "package explicit contractId and independently specified contractCoreTerms/typed seed payload hash", "package source refs for cost/bid/pricing IDs/versions and summary context, instead of only summaries", "contract-specific diff input version/contract ID and computed auditable field values; differences are evaluated under the frozen review rules, not a forced equality", "body packageStatus/guard/missingCount/diffLevel become derived or consistency assertions", "typed contract seeds freeze in readiness and travel unchanged through prepared/active snapshot to plan"],
    "revalidation": "if current source changes before preparation/approval/activation, reject stale chain and require explicit new preparation/review; do not auto-switch an approved binding"
  },
  "proposedBusinessModel": {
    "status": "Root shared-contract/DDL review required; no product file changed",
    "preferredPreparationPersistence": {
      "table": "contract_term_preparation",
      "reason": "Root explicitly chose this separate real preparation table; ContractTermSnapshot keeps only active/superseded/voided and is produced with a different UUID at activation.",
      "fields": ["id UUID PK", "contract_id/project_id", "version int positive", "is_current", "supersedes_id self FK", "status prepared|superseded|activated", "source_readiness_id/source_baseline_id/source_diff_result_id", "source cost/bid/pricing IDs and versions", "contract_row_version_at_preparation", "currency_code", "amount_tax_inclusive/exclusive numeric(18,2)", "tax_rate/down_payment_rate/retention_rate numeric(5,4)", "payment_terms", "retention_due_date date", "payload_hash", "prepared_at/by", "activated_snapshot_id nullable FK", "activated_at/by nullable", "row_version"],
      "constraints": ["UNIQUE(contract_id,version)", "one current preparation per contract", "UNIQUE(contract_id,source_readiness_id,payload_hash) idempotency identity", "cross-project/contract/source equality in TX and composite FKs where practical", "immutable terms/source/seeds after insertion; status transitions only via CAS", "prepared rows are never current active contract snapshots"],
      "reprepare": "Draft contract only, no pending review bound to old preparation; source/input changes produce version+1 and supersede old prepared row inside the same TX. Rejected review may produce a new explicit preparation. Pending/approved binding cannot silently follow latest preparation.",
      "initializationResult": "Root froze preparationId as the unified field; identify preparationId/preparedVersion/status=prepared, sourceReadinessId, contractId and rowVersion. snapshotId is null until a real active snapshot exists. The package initializedContractSnapshotId must never hold a preparationId."
    },
    "reviewBinding": {
      "preferredTable": "contract_review_binding",
      "fields": ["approval_record_id UNIQUE FK", "contract_id FK", "preparation_id FK", "prepared_payload_hash", "bound_at/by"],
      "reason": "Current ApprovalRecord has no JSON payload or prepared-version field; a real immutable binding avoids relying on latest lookup or widening all approval record shapes.",
      "submit": "B submitContractReview must choose and persist an explicit preparation, validate it belongs to the draft contract, and bind it in the same approval/todo/contract/session/audit TX.",
      "decision": "approve/reject reads the binding and exact preparation/source facts; decision cannot approve some later package/version. Root owns the existing CommonSession approval handler extension.",
      "activate": "lock exact approved binding, preparation and contract; validate source chain, create active ContractTermSnapshot with source_preparation_id, copy immutable terms/seeds, set Contract.current_snapshot_id/status, set preparation activated, record necessary success audit and flush pending session, one TX. A failure after snapshot INSERT leaves neither active snapshot nor active contract nor activated preparation nor success audit/session mutation."
    },
    "typedSeed": {
      "proposedFields": { "nodeKey": "trimmed nonempty <=64, unique in source payload", "label": "trimmed nonempty <=128", "plannedAmount": "positive exact decimal18,2", "plannedDate": "valid YYYY-MM-DD", "isRetentionNode": "boolean", "sortOrder": "nonnegative integer, unique per source payload", "note": "optional <=1000" },
      "source": "explicit per-contract commercial terms entered through Root-owned DTO/UI and frozen in the contract-bound readiness package with real project commercial source references and auditable differences; not copied from project totals, not allocated automatically, not parsed from paymentTerms prose or readiness.summary",
      "validation": ["nonempty nodes", "sum(plannedAmount) equals frozen selected-contract inclusive total exactly in cents", "duplicate nodeKey/sortOrder rejected", "date validity checked without timezone conversion", "retention nodes/amounts conform to frozen retention terms and due date", "Root freezes any within-contract cent rounding rule before using ratio-derived amounts; no implicit rounding, project allocation or invented date"],
      "immutability": "copy/hash through prepared terms and active snapshot; A09 request cannot replace amount/date/node content"
    },
    "formalPlan": {
      "versionTable": "receivable_plan_version",
      "versionFields": ["id", "contract_id", "snapshot_id", "source_readiness_id", "source_preparation_id", "version", "is_current", "supersedes_id", "status", "payload_hash", "initialized_at/by", "row_version"],
      "nodeTable": "receivable_plan_node",
      "nodeFields": ["id", "plan_version_id", "node_key", "label", "planned_amount numeric(18,2)", "planned_date date", "is_retention_node", "sort_order", "status"],
      "initRecordTable": "receivable_plan_init_record",
      "constraints": ["version UNIQUE(contract_id,version)", "one current plan per contract", "UNIQUE(contract_id,snapshot_id) for initial production identity", "node UNIQUE(plan_version_id,node_key)", "node UNIQUE(plan_version_id,sort_order)", "FKs to real contract/snapshot/preparation/readiness", "positive amounts/valid enum/nonnegative order CHECKs"],
      "guard": "Active contract + selected current active snapshot + exact readiness/preparation/source binding + typed seeds frozen at activation; no caller plan rewrite",
      "idempotency": "same contract/snapshot/source-payload returns the already persisted version/nodes/init record without new version, timestamps or duplicate success audit; any conflicting payload is a conflict, not a silent overwrite",
      "versionReplacement": "only explicit later approved snapshot/rebaseline can create a new version and supersede prior current plan atomically; initial A09 must not rewrite an active plan from mutable text",
      "scopeLimit": "do not add a plan prerequisite to ordinary ReceiptRecord creation to hide the former marker gap; C's receipt command keeps its user-approved contract/amount rules"
    },
    "sharedInterfaces": [
      { "name": "derive_current_readiness_source", "borrowedContext": "&mut PgConnection plus actor/request context", "input": ["ProjectId", "optional explicit ContractId/draftVersion"], "returns": ["typed source chain ids+versions", "currency/amounts/rates/seeds", "computed prerequisites", "computed diff and required reviews"], "transaction": "caller owns project lock and TX; no own connection or commit" },
      { "name": "resolve_preparation_for_review", "borrowedContext": "&mut PgConnection or caller CommonSession", "input": ["ContractId", "PreparationId", "expected contract/preparation versions"], "returns": ["immutable prepared payload/hash", "source chain", "typed seeds"], "transaction": "B submit owns lock/TX; A resolver does not mutate or create a fallback" },
      { "name": "load_approved_preparation_for_activation", "borrowedContext": "&mut CommonSession", "input": ["ApprovalRecordId", "ContractId"], "returns": ["approved exact binding", "prepared payload", "source freshness verdict"], "transaction": "B activate owns one TX; Root owns shared approval handler/schema changes" },
      { "name": "initialize_formal_receivable_plan", "borrowedContext": "&mut PgConnection plus actor/session/request context", "input": ["ReadinessId", "ContractId", "SnapshotId", "expected versions"], "returns": ["persisted PlanVersionId", "initRecordId", "version/status/rowVersion"], "transaction": "A09 or Root-owned plan adapter owns one TX; flush session/audit before commit" }
    ],
    "queryContract": "Proposed ContractReadinessCurrentQuery has contractId?:UUID. A05 package/diff explicitly bind contractId, current partial UNIQUE(project_id,contract_id). A07 with contractId validates project ownership and returns that contract's current detail; without query: zero current packages->404, exactly one distinct contract->same detail for compatibility, multiple distinct contracts->409 contract_selection_required with candidateContractIds. UI chooses a contract using B lookup and re-requests explicitly. A06 historical by package ID is unchanged. Never choose first/latest arbitrary contract; GET remains business no-op.",
    "multiContractAllocation": "User final decision: each contract has independent explicit amounts/terms/typed seeds. Project commercial baseline is an auditable source/comparison; no project-total copy, no automatic allocation, no contract-sum=project-quote constraint and no hard budget. Package/diff/init bind contractId. Once Active, A09 uses its frozen snapshot/seeds and must not require project R3 pricing to remain current after unrelated later contract pricing."
  },

    "requiredFailurePoints": ["baseline/diff/items", "review record/diff CAS", "readiness/source refs/items", "preparation/seeds/init record", "approval binding/todo", "active snapshot/contract/preparation activated", "plan version/nodes/init record", "necessary success audit", "managed session flush"],

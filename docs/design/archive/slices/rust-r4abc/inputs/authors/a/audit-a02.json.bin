    "globalGuardOrder": ["SessionAuthGuard", "AuthCsrfGuard", "PermissionsGuard"],
    "currentSuccessAudit": "no recordAuditLog call in A service; review record is not a runtime audit",
    "newAtomicBoundary": "source/status/UUID/CAS checks, parent/child/output writes, necessary success audit, pending session flush and commit/rollback stay in one borrowed TX",

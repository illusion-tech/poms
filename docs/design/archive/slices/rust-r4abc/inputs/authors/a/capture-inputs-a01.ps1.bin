$ErrorActionPreference = 'Stop'
$taskRoot = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../../..'))
$outputRoot = [IO.Path]::GetFullPath($PSScriptRoot)
if (-not $outputRoot.StartsWith(($taskRoot.TrimEnd([IO.Path]::DirectorySeparatorChar) + [IO.Path]::DirectorySeparatorChar), [StringComparison]::OrdinalIgnoreCase)) { throw 'Output must stay inside the assigned workspace directory.' }
$sources = [ordered]@{
    definition = @(
        'docs/design/backend-rust-migration-plan.md',
        'docs/design/api-route-canonical-inventory.md',

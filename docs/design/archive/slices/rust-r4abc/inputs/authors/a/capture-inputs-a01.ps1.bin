        'apps/poms-api/src/app/features/project-handover/project-handover-query.service.ts',
        'apps/poms-api/src/app/features/project/project.service.ts',
        'apps/poms-api/src/app/features/project/project-pricing-margin-review.entity.ts',
        'apps/poms-api/src/migrations/Migration20260405113000_init_contract_readiness_chain.ts',
        'apps/poms-api/src/migrations/Migration20260422031100_add_contract_term_snapshot_core_fields.ts',
        'apps/poms-api/src/migrations/Migration20260322233000_init_contract.ts',
        'apps/poms-api/src/migrations/Migration20260327170000_init_contract_finance_facts.ts',

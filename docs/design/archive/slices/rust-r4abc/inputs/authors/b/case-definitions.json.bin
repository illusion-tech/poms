{
  "kind": "R4B-pure-case-definitions-no-runner-no-execution",
  "status": "defined-not-run",
  "baseline": "1730f304c1cf5600721f80b6c06feec24269d387",
  "schemaDecision": "Root selected independent contract_term_preparation, contract_review_binding, preparationId and snapshot.source_preparation_id; exact column/DTO/seed/hash shapes must freeze before these symbolic requests become executable inputs",
  "requirements": {
    "backend": "actual original Native reference and actual Rust candidate, separate fresh isolated same-origin databases; known Native defects labeled reference-only",
    "noFabricatedProducer": "Contract must come from B POST /contracts; prepared terms from A real R3-derived command; approval from B submit then existing R2 decision; Active from B activate; no seeded/prewritten active/prepared/approval success",
    "originalUi": "use existing Angular routes, generated clients, auth/CSRF stores and actual server; no page.route/fulfill/mock data in acceptance",
    "caseIdentity": "Root allocates typed run/case/actor/project identities and before-absence proofs, owns every environment and actual execution",
    "commonEvidence": ["exact request/response with secrets redacted", "all touched row snapshots before and after including versions/dates", "actual SQL transaction/write-order witness when needed", "acknowledged outer COMMIT or full rollback proof", "source and executed binary/client fingerprints", "new-row ownership separate from borrowed seed/auth principals", "failure/partial/uncertified labels retained"],
    "notEvidence": ["a test file existing", "a pure case definition", "mock unit success", "static route count", "a generic common-framework golden result", "a UUID reservation marker"]
  },
  "recipes": [
    { "id": "R-project", "purpose": "real owned project and R3 signing prerequisites", "steps": ["Root authenticates owned actor and creates actual customer/project using delivered routes", "R3 technical cost package + applicable bid/commercial process + pricing/margin review produce real current facts", "read back exact typed project/customer/cost/pricing IDs and versions; preserve owned/borrowed boundaries"], "output": ["ProjectId", "R3 source IDs and versions"] },
    { "id": "R-draft", "requires": ["R-project"], "steps": ["POST /api/contracts {projectId,signedAmount:'188000.00',currencyCode:'CNY',customerContractNo:caseScopedText}", "assert201/draft/currentSnapshotId null/rowVersion1 and generated CT number", "record contract + same-TX sequence allocation COMMIT receipt"], "output": ["ContractId", "contractRowVersion", "contractNo"] },
    { "id": "R-prepared", "requires": ["R-draft"], "steps": ["A derives readiness from actual frozen R3 sources", "POST A initializeContractSnapshot with explicit contractId, that contract's independent terms/typed receivable nodes and expected readiness version using final Root-frozen DTO", "assert a real immutable contract-level preparation row with six terms/date/source/difference lineage; not merely marker UUID or project quotation copied onto every contract", "read back per-contract version and source versions"], "output": ["PreparationId", "preparationVersion", "preparationRowVersion", "source lineage"] },
    { "id": "R-pending", "requires": ["R-prepared"], "steps": ["POST /api/contracts/{ContractId}:submitReview with selected preparationId, expected contract version and comment using final Root-frozen DTO", "assert same-TX contract pending-review + approval pending + one high/open todo + immutable prepared binding + required audit", "read original R2 approval and me/todos routes"], "output": ["ApprovalId", "TodoId", "boundPreparationId", "contractRowVersion"] },
    { "id": "R-approved", "requires": ["R-pending"], "steps": ["authenticate actual assigned approver through original auth", "POST existing R2 /api/approval-records/{ApprovalId}:approve with approval expectedVersion", "assert approval approved/todo completed, contract still pending-review with unchanged contract version when no-op", "read back exact preparation binding and required audit"], "output": ["approvedApprovalId", "approvedPreparationId", "contractRowVersion"] },
    { "id": "R-active", "requires": ["R-approved"], "steps": ["POST /api/contracts/{ContractId}:activate with expected contract version", "assert contract Active, exact new active snapshot sourcePreparationId/binding lineage, preparation activated, required audit and pending session committed atomically", "GET contract detail, standalone snapshot and exact-number lookup; all identify same active snapshot"], "output": ["ActiveContractId", "ActiveSnapshotId", "PreparationId", "source lineage", "outerCommitReceipt"] }
  ],
  "cases": [
    { "id": "B-route-01-list", "recipe": "R-draft", "action": "GET /api/contracts using no filters, projectId, each status, keyword exact/internal/external and mixed filters", "assert": ["array contract summary and source createdAt DESC", "filter keyword only internal/external contract numbers", "no per-row duplicate project queries required by contract semantics", "masked event count equals non-null signed amount rows"] },
    { "id": "B-route-02-create", "recipe": "R-project", "action": "actual R-draft creation with omitted status/currency/customerContractNo/dates", "assert": ["201, draft, CNY, normalized nullable fields, generated stable CT number", "one committed contract and exact sequence advance", "server-created/updated actor and required audit are same command"] },
    { "id": "B-route-03-detail", "recipe": "R-active", "action": "GET /api/contracts/{ContractId}", "assert": ["200 with currentTermSnapshot and same active snapshot ID", "projectName/customerName from actual project", "one contract projection batch plus one snapshot batch when masked", "all amount/rate values remain JSON strings"] },
    { "id": "B-route-04-patch", "recipe": "R-draft", "action": "PATCH /api/contracts/{ContractId} valid signedAmount/customerContractNo/currency/date-only/date-time", "assert": ["200 and persisted normalized values", "exact one contract version increment for real mutation", "required audit and pending session same TX", "new changes invalidate or require a new prepared version according to final Root rule"] },
    { "id": "B-route-05-approval", "recipe": "R-approved", "action": "GET /api/contracts/{ContractId}/approval-record", "assert": ["latest real approval, correct title/targetStatus/allowedActions from R2 projection", "same selected preparation binding surfaced as Root freezes", "empty history404 rather than fabricated approval"] },
    { "id": "B-route-06-submit", "recipe": "R-prepared", "action": "actual R-pending command", "assert": ["200 submitted/pending-review and real approval/todo IDs", "prepared binding exact same contract/project/version", "no unrelated confirmation row", "no snapshot marked Active yet"] },
    { "id": "B-route-07-activate", "recipe": "R-approved", "action": "actual R-active command", "assert": ["200 activated/active and approvalRecordId from selected approved attempt", "one Active snapshot and exact contract.currentSnapshotId", "all six terms + retentionDate copied without float/rounding", "no formal receivable plan fabricated by activation"] },
    { "id": "B-route-08-lookup", "recipe": "R-active", "action": "GET /api/contracts:lookup?contractNo=actualNumber plus plus/%2B/Unicode/space/repeated/bracket/unknown query cases", "assert": ["exact query equality; required contractNo string with no trim or coerce", "same detail projection and original URL/encoded query audit context", "operationId ContractController_getByNo unchanged", "removed old /contracts/no/number route remains absent"] },
    { "id": "B-route-09-snapshot", "recipe": "R-active", "action": "GET /api/contract-term-snapshots/{ActiveSnapshotId}", "assert": ["200 immutable terms and source identities", "one six-field projection audit at most, nulls not hidden", "404 for missing snapshot", "active read never returns preparation as if effective snapshot"] },
    { "id": "B-draft-only-create", "recipe": "R-project", "vectors": ["status=active", "status=pending-review", "status=terminated", "status=completed"], "action": "POST contract with otherwise valid payload", "assert": ["400 business state bypass rejected", "no contract/sequence/required audit success partial write"], "native": "known Native bypass may succeed; reference-only, not Rust oracle" },
    { "id": "B-amount-maximum", "recipe": "R-project", "vectors": ["0.01", "1", "000001.20", "9007199254740993.01", "9999999999999999.99"], "action": "POST contract valid positive exact decimals", "assert": ["exact numeric18,2 persistence and string projection", "no binary64 rounding", "normalization to database scale is explicitly documented"] },
    { "id": "B-amount-invalid", "recipe": "R-project", "vectors": ["0", "0.00", "-0.01", "1.005", "10000000000000000.00", "1e3", "NaN", "Infinity", "+1.00", ".50", "1.", "0x10", "1,000.00", ""], "action": "POST and PATCH contract amount", "assert": ["400 before data write", "no silent numeric storage rounding or PG500 for ordinary invalid business input", "no number sequence consumption on failed create"] },
    { "id": "B-amount-json-type", "recipe": "R-project", "vectors": [188000, null, true, {}, []], "action": "POST signedAmount with non-string JSON", "assert": ["400; no coerce", "same required command rollback invariants"] },
    { "id": "B-dates-separate", "recipe": "R-draft", "vectors": ["retentionDueDate=2028-02-29", "retentionDueDate=null", "signedAt=2026-12-31T23:59:59.123Z", "signedAt=null"], "action": "create/patch/prepare/approve/activate/read through real chain", "assert": ["date-only survives session timezone and browser display unchanged", "instant retained as UTC ISO milliseconds", "date-only not constructed through UTC midnight conversion", "snapshot retains selected preparation date"] },
    { "id": "B-dates-invalid", "recipe": "R-draft", "vectors": ["retentionDueDate=2027-02-29", "retentionDueDate=2026-01-01T00:00:00Z", "signedAt=2026-01-01", "signedAt=not-a-date"], "action": "POST/PATCH validated request", "assert": ["400 without truncation acceptance", "no mutation or active snapshot creation"] },
    { "id": "B-patch-tristate", "recipe": "R-draft", "action": "omit nullable fields; then explicit null clear; then set actual values; unknown-only body; null nonnullable amount/currency", "assert": ["missing and null distinguishable", "unknown-only body fails at-least-one recognized field rule", "empty customerContractNo fails before service normalization", "no accidental null currency/amount"] },
    { "id": "B-patch-noop", "recipe": "R-draft", "action": "PATCH same stored semantic values with server actor unchanged", "assert": ["no business version or updatedAt bump", "request pending auth may flush once under explicit Root policy", "no duplicate preparation/review/snapshot", "no synthetic business dirty field to force a flush"] },
    { "id": "B-patch-status-guard", "recipe": "R-pending", "action": "PATCH pending-review then Active contract", "assert": ["400 state guard", "no amount/date/actor changed", "all preparation/approval lineage remains intact"] },
    { "id": "B-server-actor", "recipe": "R-draft", "action": "attempt caller createdBy/updatedBy of another principal or null", "assert": ["Root-frozen reject-or-ignore compatibility policy with authoritative session actor", "actual command audit and created/updated actor cannot impersonate supplied UUID"], "requiresFreeze": "DTO compatibility policy for legacy actor fields" },
    { "id": "B-uuid-typed", "recipe": "R-prepared", "vectors": ["same UUID uppercase spelling", "different real project's ContractId", "PreparationId substituted for ContractId", "other contract same-project preparation", "other project same-number-like text"], "action": "read/submit/activate typed identities", "assert": ["valid UUID equality uses typed value", "wrong type/contract/project source fails", "no canonicalization creates cross-domain adoption", "raw external contract number remains opaque exact string"] },
    { "id": "B-submit-missing-prepared", "recipe": "R-draft", "action": "submit missing/null/nonexistent/foreign/voided-or-superseded preparation", "assert": ["reject; no contract pending-review, approval, todo or success audit", "a readiness marker UUID without actual producer row never counts"] },
    { "id": "B-submit-expected-version", "recipe": "R-prepared", "vectors": ["omitted", "current", "stale", "null", "0", "-1", "1.5", "string-number"], "action": "POST submitReview", "assert": ["positive-number/current succeeds; omission preserves optional API but internal CAS remains", "stale409", "invalid DTO values400", "failure has zero partial common/domain/auth commit"] },
    { "id": "B-reject-reprepare-resubmit", "recipe": "R-pending", "action": "real R2 reject; PATCH corrected draft; A prepare next immutable version; B resubmit; real R2 approve; activate", "assert": ["old approval rejected/todo canceled and contract draft", "old prepared terms retained without mutation", "new approval binds new prepared version only", "new active snapshot references approved replacement and source chain", "old rejected attempt can never authorize activation"] },
    { "id": "B-approve-noop", "recipe": "R-pending", "action": "existing R2 approve with current assigned principal", "assert": ["approval approved/todo completed", "contract pending-review status unchanged and no contract version bump", "required decision audit and pending auth in same TX", "no early activation or receivable plan"] },
    { "id": "B-review-assignee", "recipe": "R-pending", "action": "real other authorized project writer attempts approve/reject", "assert": ["403 assignment guard", "approval/todo/contract/preparation/binding unchanged", "existing R2 behavior reused rather than surrogate success"] },
    { "id": "B-review-replay", "recipe": "R-approved", "action": "repeat approve/reject on already decided real approval", "assert": ["reject processed-state command", "no new snapshots or audit success", "contract remains pending-review until its separate activation"] },
    { "id": "B-binding-integrity", "recipe": "R-pending", "action": "Root-owned fault case uses mismatched/missing prepared binding in isolated fixture only", "assert": ["actual R2 consume refuses malformed R4 attempt and rolls back approval/todo mutation", "no generic handler success without actual R4 preparation", "fixture mutation not counted as producer acceptance"] },
    { "id": "B-prepared-immutable-after-submit", "recipe": "R-pending", "action": "try A reinitialize/edit selected preparation or B switch selected terms while review pending", "assert": ["frozen payload not overwritten", "conflicting action rejects or produces separate version per Root rule", "existing pending approval remains bound to exact original version"] },
    { "id": "B-activate-no-approval", "recipe": "R-prepared", "action": "activate draft; then activate pending but unapproved; test rejected history", "assert": ["state/approval guard reject", "no Active snapshot/contract or success audit"] },
    { "id": "B-activate-exact-attempt", "recipe": "R-approved", "action": "prepare a later different version without approving it; attempt activation", "assert": ["only actually approved exact attempt can become active", "never use arbitrary historical approved record or project latest terms", "source validity rule freezes whether superseded upstream source blocks, without changing bound payload"] },
    { "id": "B-activate-core-terms", "recipe": "R-approved", "action": "Root isolated fault fixture missing/null/overflow ratio/core terms or wrong source lineage", "assert": ["reject activation, full rollback", "A normal real producer already rejects invalid terms", "no baseline strings cast through f64 or default-zero substitution"] },
    { "id": "B-multi-contract-project", "recipe": "R-project", "action": "create two actual draft contracts for one project with different independent amounts/terms/receivable nodes, separately prepare/review/approve/activate", "assert": ["different contract-level PreparationId and ActiveSnapshotId", "each pointer and binding refers to its own contract", "one Active snapshot per contract, two across project allowed", "no conflict from project-wide reserved UUID", "initial snapshot.version1 independent from preparation.version"] },
    { "id": "B-independent-contract-amounts", "recipe": "R-project", "action": "project quotation188000.00; actual contracts100000.00 and70000.00 with independent dates/terms/nodes and auditable differences", "assert": ["no project total copied to both contracts", "no automatic allocation or sum-equals-project rejection", "each approved preparation and Active snapshot preserves its contract-specific amounts/conditions", "actual source, difference assessment and required review remain traceable", "formal plans consume their own active contract's typed seed, not a project-wide invented split"] },
    { "id": "B-frozen-payload-conflict", "recipe": "R-approved", "action": "Root-owned isolated preexisting snapshot identity/payload collision during activation", "assert": ["cross-contract identity conflict rejected", "same-contract different frozen terms never overwritten", "any allowed exact retry leaves immutable original terms/version unchanged", "same outer TX restores preparation/contract/audit/auth on conflict"] },
    { "id": "B-double-submit-race", "recipe": "R-prepared", "action": "two actual concurrent submit requests synchronize after read/precondition and compete", "assert": ["one real pending attempt/todo for contract and selected version", "loser conflict/invalid state, no duplicate approval or binding", "both responses agree with committed DB state and no partial auth/audit"] },
    { "id": "B-edit-submit-race", "recipe": "R-prepared", "action": "PATCH draft and submitReview compete on same loaded contract version", "assert": ["serial valid outcome or one conflict; never approve different terms than edited/prepared record", "necessary changes/binding/audit all rollback for loser", "status cannot revert from pending-review due stale patch"] },
    { "id": "B-double-activate-race", "recipe": "R-approved", "action": "two actual same expectedVersion activation requests compete", "assert": ["one active contract/snapshot, one activation success or Root-frozen exact idempotence", "loser cannot leave spare Active snapshot or consumed preparation", "one active unique index preserved", "COMMIT and row-version receipts exact"] },
    { "id": "B-approve-reject-race", "recipe": "R-pending", "action": "actual R2 approve and reject of same approval/version compete", "assert": ["one decision wins via real CAS", "todo, contract status, binding and audit reflect one complete decision", "no late success rewrites an activated/newer contract"] },
    { "id": "B-source-change-race", "recipe": "R-approved", "action": "A source replacement/review validity change competes with activation", "assert": ["Root-frozen source-validity rule enforced under same transaction lock/version", "no mixture of old reviewed terms and new baseline metadata", "failure restores entire preparation/snapshot/contract/audit/auth write set"] },
    { "id": "B-sequence-concurrent-create", "recipe": "R-project", "action": "actual concurrent contract creates in same scope/year and UTC-year boundary", "assert": ["unique stable CT numbers and atomic upsert", "year derives from UTC runtime instant rather than connection timezone", "no max+1 or f64 numbering", "source sequence rows owned only according to exact allocation proof"] },
    { "id": "B-sequence-rollback", "recipe": "R-project", "action": "fault after same-TX number allocation before contract success", "assert": ["sequence and contract both rolled back to before state", "no separate next() reservation connection", "absence of gapless guarantee does not excuse unintended independent commit"] },
    { "id": "B-fault-submit-todo", "recipe": "R-prepared", "action": "Root injects exact owned PostgreSQL failure on todo INSERT", "assert": ["contract draft, no approval/binding/todo/success audit commit", "pending-auth database row unchanged", "failure event separate if required and explicitly classified"] },
    { "id": "B-fault-submit-binding", "recipe": "R-prepared", "action": "failure on review-binding INSERT after common rows staged", "assert": ["no pending contract/approval/todo partial commit", "selected preparation remains prepared", "no create ownership receipts published"] },
    { "id": "B-fault-consume-domain", "recipe": "R-pending", "action": "Root injects actual contract/prepared binding lookup or domain write failure during R2 decision", "assert": ["approval remains pending and todo open", "contract/preparation unchanged", "same CommonSession and pending auth rollback", "generic common-only test not accepted as this real producer/consumer check"] },
    { "id": "B-fault-activate-snapshot", "recipe": "R-approved", "action": "actual snapshot INSERT/constraint failure", "assert": ["contract remains pending-review/currentSnapshot null", "preparation not activated", "no success audit or extra auth commit"] },
    { "id": "B-fault-activate-contract-cas", "recipe": "R-approved", "action": "actual contract CAS failure after snapshot staged", "assert": ["snapshot insert/activation and preparation marker rollback", "no orphan Active snapshot", "approval remains approved, permitting valid retry per frozen rule"] },
    { "id": "B-fault-required-audit", "recipe": "R-approved", "action": "failure on necessary audit_log INSERT after activation rows staged", "assert": ["state/snapshot/preparation/pending-auth all rollback", "no successful response or post-commit audit substitute"], "coverageAlso": ["draft create", "draft patch", "submit", "decision"] },
    { "id": "B-fault-managed-auth", "recipe": "R-approved", "action": "stale pending-auth row_version or owned auth write denial in activation coflush", "assert": ["entire necessary write transaction fails/rolls back", "no duplicate pending session consumption or second connection", "Root reports existing error classification truthfully"] },
    { "id": "B-outer-rollback", "recipe": "R-prepared", "action": "Root internal owned harness encloses actual service call in outer transaction, then rolls back", "assert": ["nested savepoint release not counted as outer commit", "all new contract/common/preparation/snapshot/audit/auth rows restored", "no in-memory WriteTrace ownership receipt published before acknowledged outer COMMIT"] },
    { "id": "B-commit-uncertain", "recipe": "R-approved", "action": "Root safely injects lost COMMIT acknowledgement where feasible in isolated run", "assert": ["result marked unknown/incomplete until separate reconciliation", "no fabricated rollback certainty or row ownership certificate", "failure/partial evidence retained"], "required": "only if Root elects supported fault route; otherwise explicit not-run limitation, no invented evidence" },
    { "id": "B-sensitive-full-masked-null", "recipe": "R-active", "action": "original full-authorized and read-only no-sensitive users call list/detail/lookup/snapshot and masked write response", "assert": ["full values are exact strings, no sensitive events for full access", "masked values null with correct Chinese display and reason/package", "contract signed amount targetType contract; snapshot targetType ContractSnapshot", "six-term batch keys exclude nulls; actual URL/query/request ID/method retained", "no raw amount/payment terms in public security event"] },
    { "id": "B-guard-matrix", "recipe": "R-active", "vectors": ["no session", "expired", "revoked", "disabled account", "no project permission", "read-only", "write-only", "missing CSRF", "wrong CSRF", "valid principal"], "action": "all nine effective entry routes", "assert": ["same shared guard protocol and status policy", "GET permission project:read, mutations project:write + CSRF", "denial security events and session side effects accurately classified", "no business mutation on denial"] },
    { "id": "B-transport-entry", "recipe": "R-active", "vectors": ["case-insensitive registered route where existing transport permits", "single trailing slash", "HEAD for GET", "wrong method", "malformed percent ID", "old lookup path", "slash action alias"], "action": "exercise actual Root transport before and after route wiring", "assert": ["effective entry cannot bypass permission/CSRF", "canonical nine operation identities unchanged", "no unapproved alias", "HTML error wording or extra Zod issues not treated as business correctness gates"] },
    { "id": "B-C-active-producer", "recipe": "R-active", "action": "C actual receipt/payable/output invoice/payment use B committed ActiveContractId", "assert": ["same typed contract/project facts and source receipts", "Active+same project guards held through C transaction", "payable contract equality enforced for payment", "B snapshot provenance demonstrated without extra blanket snapshot gate on all nineteen finance routes"] },
    { "id": "B-C-draft-denial", "recipe": "R-draft", "action": "C attempts selected contract financial writes requiring Active", "assert": ["reject draft, cross-project, foreign UUID", "no finance/source mapping/audit/auth partial success", "then real preparation/review/activation unblocks same legitimate scenario"] },
    { "id": "B-A-formal-plan-order", "recipe": "R-prepared", "action": "A attempts formal receivable plan before approval/activation, then after R-active", "assert": ["before Active+effective snapshot rejected", "after activation uses exact active snapshot/contract IDs and amount/date conditions", "plan ID reservation alone never certified as formal plan"] },
    { "id": "B-ui-original-full-chain", "recipe": "R-project", "action": "actual original Angular contract list -> project picker -> create -> detail; original readiness page creates contract-bound preparation; original detail submit -> actual approver/todo decision -> activate", "assert": ["real generated clients and real PG row transitions", "visible current prepared/reviewed/active version and terms lineage", "original pages reload to committed facts", "no route.fulfill/mock responses", "C original finance page can select active result"] },
    { "id": "B-ui-original-reject", "recipe": "R-pending", "action": "actual assigned approver rejects from original page; owner edits and reprepares/reviews again", "assert": ["rejected todo closed, draft actions restored", "old/new prepared versions not confused", "approval and activation actions match real current user/status", "stale second tab produces actionable conflict without fake success"] },
    { "id": "B-ui-original-sensitive", "recipe": "R-active", "action": "original contract list/detail read-only masked user and full user; no permission user", "assert": ["masked amount/terms use projection UI, read-only controls follow actual permissions", "prepared row never labeled active", "date-only display unchanged", "404/version/CSRF errors visible through existing UI"] },
    { "id": "B-ownership-cleanup", "recipe": "R-active", "action": "Root performs final all-table reference closure, exact owned-row cleanup and repeat no-change proof", "assert": ["new B/A/C rows linked by real creation/COMMIT receipts", "borrowed fixed approver and seed definitions never deleted/mutated", "logical UUID and JSON references inspected", "number allocation rollback/lease restoration accurately distinguished", "no active owners/listeners left while preserved volumes/private are retained"] }
  ]
}

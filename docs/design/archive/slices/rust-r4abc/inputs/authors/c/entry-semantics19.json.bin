  "commonPerEntry": {
    "guard": "cookie session -> unsafe-method CSRF -> contract:finance:manage",
    "dto": "exact shared-contracts schema via createZodDto; unknown fields stripped",
    "identifier": "path string at transport, typed UUID in domain; mapping source_id uses canonical loaded entity UUID",
    "amount": "Root unsigned ordinary checked Decimal, finance18,2 with <=2 fractional places; base>0/tax>=0; syntax/number validation400; exact tax tuple inequality422 proposal",
    "version": "optional expectedVersion is positive integer; stale is409; all mutations CAS loaded row_version even when caller omitted version",
    "errors": "schema type/shape400; missing legitimate target404; invalid business state422; stale/CAS409; guard401/403. Native SQL exception HTTP status was not observed. Root owns final common mapping.",
    "transaction": "Each actual write command: one caller-owned TX for business + mandatory authenticated-actor audit_log + required managed session flush. Native had no finance business audit; target intentionally fixes this by user ruling. No approval/todo/cost inserts.",
    "session": "pre-existing auth raw touch separate; pending managed session joins business flush; GET may touch auth but no finance-domain writes",
    "rootOwnership": "common HTTP path/method/HEAD/OPTIONS/URI normalization, Cargo/lib/router, shared error/schema/UI/migration and all actual execution",
    "audit": "entityType Receipt/Payable/Payment/Invoice, actual UUID entityId, full operationId action, authenticated actor and safe before/after/reason; exact serde Root-owned; no-op PATCH no business version/audit"
  },
  "entries": [
    {
      "method": "GET",

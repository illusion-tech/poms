export const concurrencyCases = [
  { id: 'C-C01', scenario: 'same receipt confirm twice with same expectedVersion', barrier: 'both ready before source lock', expected: 'one success and one409; one confirmation, no duplicate write' },
  { id: 'C-C02', scenario: 'same invoice/payable mutation with same expectedVersion', barrier: 'competing commands target same source row', expected: 'one committed transition; loser409; exact final version/traces' },
  { id: 'C-C03', scenario: 'same payment confirm twice', expected: 'one success and one409; amount counted once' },
  { id: 'C-C04', scenario: 'payable100; confirmed20; two different recorded payments50+50, both would leave stale view partially-paid', expected: 'one confirm succeeds; other recomputes exact total120 and rejects422; final sum70 not120', targetCorrectnessOnly: true, note: 'Critical unchanged-status optimistic-dirty gap; explicit payable lock required' },
  { id: 'C-C05', scenario: 'payable100; two pending payments40+60; concurrent confirm', expected: 'serialized valid confirmations both succeed; exact100 completed; no false oversettlement' },
  { id: 'C-C06', scenario: 'createPayment vs voidPayable with zero earlier payment', expected: 'one serial order: void first -> create422; create first -> void422; never both commit incompatible facts' },
  { id: 'C-C07', scenario: 'update commitment vs confirmPayment', expected: 'payable lock serializes; confirm checks latest exact amount and lawful state; no overpay/lost update' },
  { id: 'C-C08', scenario: 'closePayable vs confirmPayment', expected: 'one serial order; close first blocks confirm; confirm first preserves paid sum when close follows; no partial graph' },
  { id: 'C-C09', scenario: 'current mapping insertion vs source mutation', currentScope: 'prepared guard reference only; no real cost producer in this batch', expected: 'no claim of real production concurrency proof; later producer must lock same source protocol', deferredProducer: true },
  { id: 'C-C10', scenario: 'session revoked/changed during pending managed flush after business changes', expected: 'managed session CAS failure rolls back all required business writes; independently committed auth raw touch labelled separately' },
];


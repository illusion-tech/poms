  { id: 'C-PRODUCER-01', owner: 'Root R3', action: 'Produce real customer/project/technical-cost/bid-commercial/pricing facts through frozen R3 service/HTTP chain', bind: 'project; pricing/readiness source versions', forbid: 'pre-created active contract fixture' },
  { id: 'C-PRODUCER-02', owner: 'B', action: 'POST /api/contracts; draft for actual project', bind: 'contractDraft.id; rowVersion' },
  { id: 'C-PRODUCER-03', owner: 'A', action: 'Real readiness current package from R3-derived readiness; initialize terms with explicit contractDraft.id', bind: 'contractTermPreparation.id/version; snapshotId remains null', forbid: 'UUID marker labelled real active snapshot' },
  { id: 'C-PRODUCER-04', owner: 'B with R2 real handler', action: 'Submit exact prepared version -> approval/to-do -> actual approve', bind: 'approved preparation identity and review version', assert: 'same reviewed contract and preparation, not replacement substituted after review' },
  { id: 'C-PRODUCER-05', owner: 'B', action: 'Activate reviewed contract; same TX prepared->effective active snapshot and CAS contract active/currentSnapshotId', bind: 'activeContract.id/projectId/status; activeSnapshot.id/sourcePreparationId', assert: 'real persisted snapshot ID differs from preparation ID; no seed active shortcut' },
  { id: 'C-PRODUCER-06', owner: 'A optional separate formal-plan case', action: 'Initialize real receivable_plan_version/nodes/init_record only after Active valid snapshot', bind: 'formalPlanVersion/nodes/initRecord', assert: 'sum exact contract amount; actual rows exist', note: 'Not a hard prerequisite for C receipt creation' },
];

export const primaryFinanceFlow = [
  { id: 'C-H01', operation: 'ContractFinanceController_createReceipt', path: '/api/contracts/${activeContract.id}/receipt-records', body: { receiptAmount: '100000.00', receiptDate: '2026-11-03T00:15:20.123Z' }, status: 201, bind: 'receipt', assert: ['contract/project from actual active entity', 'pending-confirmation', 'manual source default', 'confirmedAt/By=null', 'rowVersion=1', 'no cost insert'] },
  { id: 'C-H02', operation: 'ContractFinanceController_confirmReceipt', path: '/api/receipt-records/${receipt.id}:confirm', body: { expectedVersion: '${receipt.rowVersion}' }, status: 200, bind: 'confirmedReceipt', assert: ['confirmed', 'authenticated actor UUID', 'server confirmedAt', 'one rowVersion transition', 'no commission or cost auto-production'] },
  { id: 'C-H03', operation: 'ContractFinanceController_listReceipts', path: '/api/contracts/${activeContract.id}/receipt-records', status: 200, assert: ['bare array', 'created receipt present', 'datetime not sliced', 'receipt_date desc, created_at desc'] },
  { id: 'C-H04', operation: 'ContractFinanceController_createPayable', path: '/api/projects/${project.id}/payable-records', body: { contractId: '${activeContract.id}', vendorName: '供应商甲', costCategory: 'implementation', payableDescription: '实施采购', amountExcludingTax: '100.00', taxAmount: '13.00', amountIncludingTax: '113.00', expectedPaymentDate: '2026-11-30' }, status: 201, bind: 'payable', assert: ['recorded', 'CNY', 'attachmentCount=0', 'three separate exact money fields', 'zero settled sum', 'no cost insert'] },
  { id: 'C-H05', operation: 'ContractFinanceController_updatePayable', path: '/api/payable-records/${payable.id}', body: { evidenceSummary: '订单与交付凭据', expectedVersion: '${payable.rowVersion}' }, status: 200, bind: 'updatedPayable', assert: ['recorded', 'changed evidence persisted', 'missing fields retained', 'actual confirmed settled sum'] },
  { id: 'C-H06', operation: 'ContractFinanceController_createPayment', path: '/api/projects/${project.id}/payment-records', body: { payableRecordId: '${payable.id}', amountExcludingTax: '40.00', taxAmount: '5.20', amountIncludingTax: '45.20', paymentDate: '2026-11-03T00:20:00.000Z', costCategory: 'implementation' }, status: 201, bind: 'paymentFirst', assert: ['contract inherited from payable', 'currency inherited', 'recorded', 'confirmation fields null', 'source manual', 'no cost insert'] },
  { id: 'C-H07', operation: 'ContractFinanceController_confirmPayment', path: '/api/payment-records/${paymentFirst.id}:confirm', body: { expectedVersion: '${paymentFirst.rowVersion}' }, status: 200, assert: ['confirmed payment', 'payable partially-paid', 'confirmed sum40.00', 'same transaction', 'actor/time persisted'] },
  { id: 'C-H08', operation: 'ContractFinanceController_listPayments', path: '/api/projects/${project.id}/payment-records', status: 200, assert: ['bare array', 'three money values and datetime preserved', 'payment_date desc, created_at desc'] },
  { id: 'C-H09', operation: 'ContractFinanceController_listPayables', path: '/api/projects/${project.id}/payable-records', status: 200, assert: ['payable partially-paid', 'settledAmountExcludingTax=40.00', 'only confirmed payments sum'] },
  { id: 'C-H10', operation: 'ContractFinanceController_getPayable', path: '/api/payable-records/${payable.id}', status: 200, assert: ['settledAmountExcludingTax=40.00', 'allowedActions includes close', 'no update/voided when payment linked', 'reflects actual executable rules'] },
  { id: 'C-H11', operation: 'ContractFinanceController_closePayable', path: '/api/payable-records/${payable.id}:close', body: { reason: '不再采购剩余部分', comment: '保留已付事实', expectedVersion: '${currentPayable.rowVersion}' }, status: 200, assert: ['closed/time/reason newline comment', 'settled remains40.00', 'payment remains confirmed', 'no physical deletion', 'future payment create/confirm blocked'] },
  { id: 'C-H12', operation: 'ContractFinanceController_createPayable', fixture: 'independent unpaid payable through real create', bodyProfile: 'validPayable', status: 201, bind: 'unpaidPayable' },
  { id: 'C-H13', operation: 'ContractFinanceController_voidPayable', path: '/api/payable-records/${unpaidPayable.id}:void', body: { reason: '重复采购承诺', expectedVersion: '${unpaidPayable.rowVersion}' }, status: 200, assert: ['voided/time/reason', 'no payment and mapping', 'retained row', 'allowedActions empty'] },
  { id: 'C-H14', operation: 'ContractFinanceController_createInvoice', path: '/api/projects/${project.id}/invoice-records', body: { contractId: '${activeContract.id}', invoiceType: 'output', invoiceNumber: '${run.uniqueInvoiceNumber}', invoiceAmount: '188000.00', invoiceDate: '2026-11-03' }, status: 201, bind: 'outputInvoice', assert: ['draft/none', 'exception and close fields explicit null', 'contract/project real active binding'] },
  { id: 'C-H15', operation: 'ContractFinanceController_updateInvoice', path: '/api/invoice-records/${outputInvoice.id}', body: { status: 'issued', expectedVersion: '${outputInvoice.rowVersion}' }, status: 200, bind: 'issuedInvoice', assert: ['issued', 'money/date preserved'] },
  { id: 'C-H16', operation: 'ContractFinanceController_markInvoiceException', path: '/api/invoice-records/${outputInvoice.id}:markException', body: { reason: '票面金额待核', comment: '已联系开票方', expectedVersion: '${issuedInvoice.rowVersion}' }, status: 200, bind: 'openExceptionInvoice', assert: ['status exception', 'exceptionStatus open', 'reason newline comment', 'resolution null', 'only resolve-exception action'] },
  { id: 'C-H17', operation: 'ContractFinanceController_resolveInvoiceException', path: '/api/invoice-records/${outputInvoice.id}:resolveException', body: { resolution: '核验通过', comment: '凭据归档', expectedVersion: '${openExceptionInvoice.rowVersion}' }, status: 200, bind: 'resolvedInvoice', assert: ['status remains exception', 'exceptionStatus resolved', 'original reason retained', 'resolution newline comment', 'actions update/mark-exception/close'] },
  { id: 'C-H18', operation: 'ContractFinanceController_updateInvoice', path: '/api/invoice-records/${outputInvoice.id}', body: { status: 'verified', expectedVersion: '${resolvedInvoice.rowVersion}' }, status: 200, bind: 'verifiedResolvedInvoice', assert: ['PATCH remains executable', 'verified/resolved', 'exception reason and resolution retained', 'output invoice cannot serve input-invoice cost producer'] },
  { id: 'C-H19', operation: 'ContractFinanceController_closeInvoiceRecord', path: '/api/invoice-records/${outputInvoice.id}:close', body: { reason: '发票流程收口', expectedVersion: '${verifiedResolvedInvoice.rowVersion}' }, status: 200, assert: ['closed', 'closure trace', 'exception history retained', 'allowedActions empty'] },
  { id: 'C-H20', operation: 'ContractFinanceController_getInvoice', path: '/api/invoice-records/${outputInvoice.id}', status: 200, assert: ['explicit nulls and retained history', 'allowedActions agrees with closed domain state'] },
  { id: 'C-H21', operation: 'ContractFinanceController_listInvoices', path: '/api/projects/${project.id}/invoice-records', status: 200, assert: ['bare array', 'invoice_date desc, created_at desc', 'business date unchanged'] },
];

export const guardsAndContracts = [
  { id: 'C-G01', applyTo: 'all19 operations', input: 'missing session cookie', expected: '401 session_missing; zero finance writes' },
  { id: 'C-G02', applyTo: 'all19 operations', input: 'expired/revoked/disabled-account session', expected: '401 exact existing code and required security audit; zero finance writes' },
  { id: 'C-G03', applyTo: 'all19 operations', input: 'valid session without contract:finance:manage', expected: '403 permission_denied with event; zero finance writes' },
  { id: 'C-G04', applyTo: '13 unsafe operations', input: 'missing/mismatched/foreign-session CSRF header or cookie', expected: '403 csrf_failed and event; no domain calls/writes' },
  { id: 'C-G05', applyTo: '6 GET operations', input: 'valid permitted session without CSRF', expected: 'success; auth touch observed independently' },
  { id: 'C-G06', applyTo: 'each frozen path', input: 'wrong method, HEAD, OPTIONS, uppercase route literal, one/two trailing slash, encoded action, malformed URI component', expectedPolicy: 'Root shared HTTP baseline; preserve operationId/canonical uniqueness; do not count HEAD as extra operation' },
  { id: 'C-G07', applyTo: 'all request DTOs', input: 'null/array/primitive body, invalid field type, absent required field, disallowed null', expected: '400 original validation protocol; no finance mutation' },
  { id: 'C-G08', applyTo: 'all request DTOs', input: 'valid payload plus unknown fields including status/actor/system timestamps where not permitted', expected: 'unknown keys stripped; no unauthorized persistence' },
  { id: 'C-G09', applyTo: 'payable/invoice PATCH', input: 'empty or only expectedVersion after unknown strip', expected: '400 at least one updatable field' },
  { id: 'C-G10', applyTo: '4 parent lists', input: 'valid UUID absent parent', expected: '200 [] without invented parent404' },
  { id: 'C-G11', applyTo: 'detail/mutation/creates needing existing parent', input: 'valid UUID absent target', expected: '404 controlled target message' },
  { id: 'C-G12', applyTo: 'body UUID fields', input: 'malformed UUID, numeric JSON, empty string', expected: '400 Zod UUID protocol; null allowed only explicitly nullable fields' },
  { id: 'C-G13', applyTo: 'UUID domain comparisons and detail mapping queries', input: 'uppercase representation of the same valid UUID', expected: 'same domain identity/association and mapping guard; canonical loaded entity UUID for source_id', targetCorrectnessOnly: true, nativeRisk: 'raw string comparison/mapping query bug not acceptance oracle' },
  { id: 'C-G14', applyTo: 'path UUID values', input: 'malformed UUID vs percent-decode failure', expectedPolicy: 'Root explicit safe path/URI error mapping; no claim of observed Native status' },
];

export const versionAndRetryCases = {
  versionedOperations: ['confirmReceipt', 'updatePayable', 'closePayable', 'voidPayable', 'updateInvoice', 'markInvoiceException', 'resolveInvoiceException', 'closeInvoiceRecord', 'confirmPayment'],
  cases: [
    { id: 'C-V01', applyTo: 'all9 versioned operations', input: 'stale expectedVersion with otherwise valid state', expected: '409; unchanged finance rows/versions/traces' },
    { id: 'C-V02', applyTo: 'all9 versioned operations', input: 'stale expectedVersion and invalid terminal state', expected: '409 version guard precedes state422' },
    { id: 'C-V03', applyTo: 'all9 versioned operations', input: 'omitted expectedVersion', expected: 'legal DTO; lock/CAS against loaded row version still enforced' },
    { id: 'C-V04', applyTo: 'all9 versioned operations', input: 'expectedVersion null/0/-1/1.5/string', expected: '400 schema; no write' },
    { id: 'C-V05', applyTo: 'confirmReceipt/confirmPayment/close/void', input: 'repeat after success with original supplied version', expected: '409; no duplicate transition' },
    { id: 'C-V06', applyTo: 'confirmReceipt/confirmPayment/close/void', input: 'repeat after success with latest or omitted version', expected: '422 illegal state; no duplicate transition' },
    { id: 'C-V07', applyTo: 'payable/invoice PATCH', input: 'same values with valid version and pending managed session', expected: 'No business row_version/updated_at change and no business audit by user ruling; Root preserves required managed-session boundary separately' },
    { id: 'C-V08', applyTo: '4 creates', input: 'failure injected before commit then retry', expected: 'full transaction rollback first; one successful new entity on retry' },
    { id: 'C-V09', applyTo: 'receipt/payable/payment create', input: 'commit succeeded but response lost then blindly retry', expected: 'no exactly-once guarantee exists; no idempotency key; preserve ambiguity/read-back requirement', excludedFromIdempotentAcceptance: true },
    { id: 'C-V10', applyTo: 'invoice create', input: 'same invoiceNumber retry after original committed', expected: '409 unique invoice_no and no duplicate entity' },
  ],
};

export const moneyCases = {
  policy: 'Root proposed unified decimal syntax/number validation400, finance state422; exact tax sum mismatch422 proposal; final joint G1 owns exact error shape',
  amountFields: ['receiptAmount', 'invoiceAmount', 'amountExcludingTax', 'taxAmount', 'amountIncludingTax'],
  accepted: [
    { value: '0.01', for: 'positive base/inclusive or tax', expected: 'exact one cent' },
    { value: '0001.20', for: 'all money', expected: 'exact1.20; leading zeros allowed by Root common syntax' },
    { value: ' 10.20 ', for: 'all money', expected: 'trim then exact10.20' },
    { value: '9999999999999999.99', for: 'all money', expected: 'numeric18,2 maximum accepted with no f64 conversion' },
    { value: '9007199254740991.99', for: 'all money', expected: 'exact cents retained beyond safe JS integer' },
    { value: '0', for: 'taxAmount only', expected: 'known zero tax, distinct from null' },
    { excluding: '0.10', tax: '0.20', including: '0.30', expected: 'exact equality; no tolerance needed' },
    { excluding: '10.00', tax: null, including: null, expected: 'unknown tax/inclusive stay null' },
    { excluding: '10.00', tax: '1.00', including: null, expected: 'known tax and unknown inclusive allowed, no inference' },
    { excluding: '10.00', tax: null, including: '11.00', expected: 'unknown tax allowed, no inference' },
  ],
  rejected: [
    { values: ['0', '0.00', '-0', '-1.00'], for: 'positive receipt/invoice/excluding/inclusive', expectedStatus: 400, note: 'ordinary negative adjustments deferred to explicit later flow' },
    { values: ['-0.01'], for: 'taxAmount', expectedStatus: 400 },
    { values: ['1.001', '0.0001', '9999999999999999.999'], for: 'all money', expectedStatus: 400, note: 'no DB silent rounding' },
    { values: ['10000000000000000', '10000000000000000.00'], for: 'all money', expectedStatus: 400, note: 'exact numeric18,2 capacity check' },
    { values: ['NaN', 'Infinity', '-Infinity', '1e2', '0x10', '+1', '1,000.00', '.5', '1.', ''], for: 'all money', expectedStatus: 400, note: 'Root ordinary unsigned decimal syntax, not JS Number grammar' },
    { values: [1, 1.5, null, true], for: 'nonnull money fields', expectedStatus: 400 },
    { excluding: '10.00', tax: '1.00', including: '11.01', expectedStatus: 422, note: 'valid strings but inconsistent resulting business money tuple; Root final freeze owns rule' },
  ],
  checkedAggregation: [
    { input: ['0.10', '0.20'], expectedSum: '0.30' },
    { input: ['9007199254740991.98', '0.01'], expectedSum: '9007199254740991.99' },
    { input: 'confirmed rows only; exclude recorded/draft/voided', expected: 'settled sum matches database facts on list/detail/mutation responses' },
  ],
  laterCostRange: { financeValue: '100000000000.00', finance: 'valid18,2', laterCost15Scale4: 'out of range; later producer must reject without truncation/partial commit', notCurrentBatchProducerTest: true },
};


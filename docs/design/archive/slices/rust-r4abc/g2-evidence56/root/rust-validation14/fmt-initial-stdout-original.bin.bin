 fn uuid(value: &str) -> Option<Uuid> {
-    let bytes=value.as_bytes();
-    if bytes.len()!=36 || !bytes.iter().enumerate().all(|(index,byte)| {
-        if [8,13,18,23].contains(&index) { *byte==b'-' } else { byte.is_ascii_hexdigit() }
-    }) { return None; }
-    let id=Uuid::parse_str(value).ok()?;
-    if id.is_nil() || value=="ffffffff-ffff-ffff-ffff-ffffffffffff" { return Some(id); }
-    ((b'1'..=b'8').contains(&bytes[14]) && matches!(bytes[19],b'8'|b'9'|b'a'|b'A'|b'b'|b'B')).then_some(id)
+    let bytes = value.as_bytes();
+    if bytes.len() != 36
+        || !bytes.iter().enumerate().all(|(index, byte)| {
+            if [8, 13, 18, 23].contains(&index) {
+                *byte == b'-'
+            } else {
+                byte.is_ascii_hexdigit()
+            }
+        })
+    {
+        return None;
+    }
+    let id = Uuid::parse_str(value).ok()?;
+    if id.is_nil() || value == "ffffffff-ffff-ffff-ffff-ffffffffffff" {
+        return Some(id);
+    }
+    ((b'1'..=b'8').contains(&bytes[14])
+        && matches!(bytes[19], b'8' | b'9' | b'a' | b'A' | b'b' | b'B'))
+    .then_some(id)
 }
 

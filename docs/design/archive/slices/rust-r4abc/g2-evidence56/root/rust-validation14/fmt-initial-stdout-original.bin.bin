+pub fn router(auth: AuthHttpState, database: Database) -> Router {
+    let mut router = Router::new();
+    let paths = operations()
+        .iter()
+        .map(|op| collapsed(&op.path))
+        .collect::<BTreeSet<_>>();
+    for path in paths {
+        router = router.route(&path, any(dispatch));
+    }
     router.layer(Extension(database)).with_state(auth)
 }
-pub async fn normalize_uri(mut request:Request,next:Next)->Response{
-    let selected=operation(request.method(),request.uri().path()).map(|(_,m)|m)
-        .or_else(||operations().iter().find_map(|op|matched(&op.path,request.uri().path())));
-    if let Some(matched)=selected{
-        if let Some(id)=&matched.id && decode_uri_component(id).is_err(){return ApiError::message(StatusCode::BAD_REQUEST,format!("Failed to decode param '{id}'")).into_response();}
-        if matched.canonical!=request.uri().path(){
-            if request.extensions().get::<OriginalUri>().is_none(){let original=request.uri().clone();request.extensions_mut().insert(OriginalUri(original));}
-            let mut parts=request.uri().clone().into_parts();let path=match request.uri().query(){Some(query)=>format!("{}?{query}",matched.canonical),None=>matched.canonical};
-            parts.path_and_query=path.parse().ok();match Uri::from_parts(parts){Ok(uri)=>*request.uri_mut()=uri,Err(_)=>return ApiError::internal().into_response()}
+pub async fn normalize_uri(mut request: Request, next: Next) -> Response {
+    let selected = operation(request.method(), request.uri().path())
+        .map(|(_, m)| m)
+        .or_else(|| {
+            operations()
+                .iter()
+                .find_map(|op| matched(&op.path, request.uri().path()))
+        });
+    if let Some(matched) = selected {
+        if let Some(id) = &matched.id
+            && decode_uri_component(id).is_err()
+        {
+            return ApiError::message(
+                StatusCode::BAD_REQUEST,
+                format!("Failed to decode param '{id}'"),
+            )
+            .into_response();
         }
+        if matched.canonical != request.uri().path() {
+            if request.extensions().get::<OriginalUri>().is_none() {
+                let original = request.uri().clone();
+                request.extensions_mut().insert(OriginalUri(original));
+            }
+            let mut parts = request.uri().clone().into_parts();
+            let path = match request.uri().query() {
+                Some(query) => format!("{}?{query}", matched.canonical),
+                None => matched.canonical,
+            };
+            parts.path_and_query = path.parse().ok();
+            match Uri::from_parts(parts) {
+                Ok(uri) => *request.uri_mut() = uri,
+                Err(_) => return ApiError::internal().into_response(),
+            }
+        }
     }
     next.run(request).await
 }

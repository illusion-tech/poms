-    else {("ready","allowed")}
+fn package_state(
+    source_blockers: &[String],
+    level: &str,
+    review_status: &str,
+) -> (&'static str, &'static str) {
+    if !source_blockers.is_empty() || level == "reapproval-required" || review_status == "rejected"
+    {
+        ("blocked", "blocked")
+    } else if level == "review-required" && review_status != "approved" {
+        ("conditional", "review-required")
+    } else {
+        ("ready", "allowed")
+    }
 }
 

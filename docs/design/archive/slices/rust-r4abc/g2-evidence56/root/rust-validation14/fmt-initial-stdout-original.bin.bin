+fn operation(method: &Method, path: &str) -> Option<(Operation, Matched)> {
+    operations()
+        .iter()
+        .filter(|op| {
+            op.method == method.as_str() || (*method == Method::HEAD && op.method == "GET")
+        })
+        .find_map(|op| matched(&op.path, path).map(|m| (op.clone(), m)))
 }
-fn collapsed(template:&str)->String{

-fn summary(value:&Value)->Value {
-    if value.is_null(){return Value::Null;}
-    let raw=value.as_str().map(str::to_owned).unwrap_or_else(||value.to_string());
-    let mut units=0;let mut result=String::new();
-    for c in raw.chars(){units+=c.len_utf16();if units>1000{break;}result.push(c);}
+fn summary(value: &Value) -> Value {
+    if value.is_null() {
+        return Value::Null;
+    }
+    let raw = value
+        .as_str()
+        .map(str::to_owned)
+        .unwrap_or_else(|| value.to_string());
+    let mut units = 0;
+    let mut result = String::new();
+    for c in raw.chars() {
+        units += c.len_utf16();
+        if units > 1000 {
+            break;
+        }
+        result.push(c);
+    }
     json!(result)
 }
 fn push(items: &mut Vec<DiffItem>, key: &str, old: Value, new: Value, level: &'static str) {

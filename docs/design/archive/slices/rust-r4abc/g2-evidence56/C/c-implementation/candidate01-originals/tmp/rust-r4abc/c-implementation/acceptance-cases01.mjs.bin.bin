    { operations: ['confirmReceipt'], actualWriteOrder: ['receipt CAS status/actor/time/version', 'mandatory audit INSERT', 'Root required final auth flush', 'Root outerCOMMIT'], faultEach: true, expected: 'all business/actor/time/version/audit/auth rollback; retry exactly one valid transition' },
    { operations: ['updatePayable', 'closePayable', 'voidPayable'], actualWriteOrder: ['payable CAS', 'read actual aggregate', 'mandatory audit INSERT', 'Root required final auth flush', 'Root outerCOMMIT'], faultEach: true, expected: 'all values/status/history/version/audit restore; all payments/mappings unchanged' },
    { operations: ['updateInvoice', 'markInvoiceException', 'resolveInvoiceException', 'closeInvoiceRecord'], actualWriteOrder: ['invoice CAS incl global unique invoice_no', 'mandatory audit INSERT', 'Root required final auth flush', 'Root outerCOMMIT'], faultEach: true, expected: 'business and exception/closure history/version/audit restore; unique or unknown SQL errors retain Root mapping' },
    { operations: ['confirmPayment'], actualWriteOrder: ['optional changed payable progress CAS', 'payment confirmation CAS', 'read actual new settled sum', 'mandatory Payment audit INSERT with related payable before/after', 'Root required final auth flush', 'Root outerCOMMIT'], faultEach: true, expected: 'payment/payable/progress/sum/actor/time/version/audit/auth whole graph rollback. If payable status text stays partially-paid no progress CAS, but lock+fresh exact SUM still mandatory.' },

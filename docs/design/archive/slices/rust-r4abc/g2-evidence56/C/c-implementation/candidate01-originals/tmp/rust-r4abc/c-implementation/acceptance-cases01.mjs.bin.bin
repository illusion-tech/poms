  { id: 'C-B12', apply: 'UUID path/body', input: 'malformed UUID', expected: 'Root400; domain receives typed ID; no unsafe source_id SQLcast' },
  { id: 'C-B13', apply: 'source scope', input: 'selected contract/payable in other project', expected: '404; project lock before domain source rows; no wrong-scope writes' },
  { id: 'C-B14', apply: 'receipt/create-payable/bound-invoice/create-or-confirm-payment', input: 'nonempty selected/inherited contract not Active', expected: '422; no snapshot/plan hard gate added' },

  { id: 'C-B19', apply: 'confirmPayment', input: 'contract becomes nonActive or binding incompatible after record created', expected: '422 within same Project/Contract/Payable/Payment lock/TX; no confirmation/audit' },
  { id: 'C-B20', apply: 'payment', input: 'currency differs from bound payable', expected: '422 existing payable currency rule; do not add contract-currency gate' },
  { id: 'C-B21', apply: 'payable', input: 'any linked payment, including pending recorded', expected: 'void422 and no voided action; close still allowed in nonterminal state if not mapped' },

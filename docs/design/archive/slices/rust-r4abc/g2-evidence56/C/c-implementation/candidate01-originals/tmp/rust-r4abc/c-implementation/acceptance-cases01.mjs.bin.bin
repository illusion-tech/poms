  { id: 'C-RACE04', setup: 'payable100 confirmed20 and two recorded payments50+50', commands: 'controlled parallel confirm', expected: 'one success sum70; other reaggregates under lock and422 because120>100; no unchanged-status dirty loophole' },
  { id: 'C-RACE05', setup: 'payable100 and recorded40+60', commands: 'controlled parallel confirm', expected: 'both valid serial order; exactly100/completed; two payment audits with correct related snapshots' },
  { id: 'C-RACE06', commands: 'createPayment vs unpaid payable void', expected: 'one legal order: void first create422, create first void422; never incompatible commits' },
  { id: 'C-RACE07', commands: 'commitment PATCH vs confirmPayment', expected: 'Project/Payable serialization; latest exact amount used, no oversettlement/lost update' },
  { id: 'C-RACE08', commands: 'closePayable vs confirmPayment', expected: 'close first confirm422; confirm first close preserves actual paid sum; atomic audit graph' },
  { id: 'C-RACE09', commands: 'session changes/revokes before pending managed auth flush', expected: 'required final auth failure rolls business+related progress+audit back; preceding independent raw touch labelled separately' },
  { id: 'C-RACE10', commands: 'future real cost producer vs source mutation', expected: 'deferred real producer proof; later producer must share Project/source protocol; current prepared guard test not mislabeled' },
];


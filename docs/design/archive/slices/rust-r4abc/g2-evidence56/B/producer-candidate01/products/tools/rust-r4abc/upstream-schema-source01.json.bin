  "recursiveInputSchemas": {
    "CreateCustomerRequest": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "legalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "nullable": true
        },
        "shortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "nullable": true
        },
        "ownerOrgId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "nullable": true
        },
        "ownerUserId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "nullable": true
        },
        "sourceChannel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "nullable": true
        },
        "remark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "nullable": true
        }
      },
      "required": [
        "displayName"
      ]
    },
    "CreateProjectRequest": {
      "type": "object",
      "properties": {
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "customerId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "customerProjectNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "nullable": true
        },
        "currentStage": {
          "$ref": "#/components/schemas/ProjectStage"
        },
        "plannedSignAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "nullable": true
        }
      },
      "required": [
        "projectName",
        "customerId"
      ]
    },
    "CreateProjectBidCommercialProcessRequest": {
      "type": "object",
      "properties": {
        "bidMode": {
          "type": "string",
          "enum": [
            "public-tender",
            "invitation",
            "comparison",
            "commercial-negotiation",
            "competitive-negotiation",
            "direct-commercial",
            "not-required"
          ]
        },
        "currentStage": {
          "type": "string",
          "enum": [
            "not-started",
            "preparation",
            "submitted",
            "negotiating",
            "result-confirmed",
            "closed"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "pending",
            "participate",
            "no-bid",
            "not-required"
          ]
        },
        "resultStatus": {
          "type": "string",
          "enum": [
            "pending",
            "won",
            "lost",
            "cancelled",
            "not-applicable"
          ]
        },
        "processSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "decisionSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "nullable": true
        },
        "resultSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "nullable": true
        },
        "tenderNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "nullable": true
        },
        "bidPackageNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "nullable": true
        },
        "ownerRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "nullable": true
        },
        "materialItems": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ProjectBidCommercialMaterialItemInput"
          }
        },
        "timelineItems": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ProjectBidCommercialTimelineItemInput"
          }
        }
      },
      "required": [
        "bidMode",
        "currentStage",
        "decision",
        "resultStatus",
        "processSummary"
      ]
    },
    "CreateProjectPricingMarginReviewRequest": {
      "type": "object",
      "properties": {
        "technicalCostPackageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "bidCommercialProcessId": {
          "type": "string",
          "format": "uuid",

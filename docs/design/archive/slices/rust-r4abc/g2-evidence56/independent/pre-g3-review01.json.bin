  "findings": [
    {
      "id": "PRE-G3-01",
      "priority": "P1",
      "module": "A",
      "title": "Do not turn generic summary metadata into an invented pricing approval gate",
      "file": "apps/poms-api-rust/src/contract_readiness/source.rs",
      "lines": {
        "start": 98,
        "end": 114
      },
      "sourceSha256": "b50f0649cfa3ad0e2b497c9a13e6c6d5292eb5c60889e60a3ccbcf019abcb957",
      "trigger": "A valid actual current R3 released/conditional-release pricing reference points to an existing summary record whose active status, target scope or scenario/package/projection/export metadata does not satisfy the newly invented A checks.",
      "defect": "The01 collector adds active summary plus project/contract/lead target and full metadata equality as contracting authorization. The frozen G1 uses the real R3 pricing decision/ready/blockers/conditions and cost/bid/baseline/amount/currency facts; it explicitly does not claim a quotation approval handler. Current Rust contains the delivered create_summary_snapshot_with_session mechanism but no business caller producing this alleged quotation approval chain.",
      "impact": "The documented real producer chain can remain blocked behind an unsupported approval prerequisite or be tempted to use a seeded/random summary as false approval proof.",
      "requiredCorrection": "Retain a real existing summary reference and lineage as required by the original R3 contract; remove A-invented approval qualification. Root may use the delivered R2 internal summary producer to create a real non-HTTP artifact before real R3 HTTP release, accurately labeled as a summary artifact rather than quotation approval.",
      "authority": [
        "docs/design/rust-r4abc-first37-baseline.md sections3-5",
        "fixed G1 real producer order and no quotation handler boundary",
        "apps/poms-api-rust/src/project_pricing_margin/service.rs references/create",
        "apps/poms-api-rust/src/approval_common/service.rs create_summary_snapshot_with_session"
      ],
      "evidenceClass": "static code/call-site inspection only; no runtime failure claimed",
      "rootDisposition": "Root confirmed and assigned A bounded02 correction; original01 is preserved",
      "resolutionVerifiedByReviewer": false,
      "status": "Confirmed-remediation-in-progress"
    },
    {
      "id": "PRE-G3-02",
      "priority": "P1",
      "module": "A",
      "title": "Applicable bid with pending result can currently reach prepared and active contract",
      "file": "apps/poms-api-rust/src/contract_readiness/source.rs",
      "lines": {
        "start": 57,
        "end": 73
      },
      "sourceSha256": "b50f0649cfa3ad0e2b497c9a13e6c6d5292eb5c60889e60a3ccbcf019abcb957",
      "trigger": "Real current applicable bid process uses a participating decision, result_status=pending, no material blockers; the actual R3 pricing command subsequently stores released and ready_for_contracting=true.",
      "defect": "The01 source collector excludes lost/cancelled results and pending/no-bid decisions, but on pricing_path=bid excludes only not-applicable rather than pending. The R3 pricing ready flag itself does not prove that the applicable bid result was formed.",
      "impact": "A05 can mark the package ready, A08 can prepare and B can approve/activate before an applicable bid has won.",
      "requiredCorrection": "For the bid pricing path require the exact current referenced applicable bid result=won; keep direct-commercial/not-required replacement rules separate. Include a real participating+pending negative vector with R3 ready=true, plus won and direct-commercial positive vectors.",
      "authority": [
        "docs/design/phase2-presigning-contract-readiness-workspace.md:119-124",
        "docs/design/rust-r4abc-first37-baseline.md actual source prerequisites",
        "apps/poms-api-rust/src/project_pricing_margin/service.rs ready derivation",
        "apps/poms-api-rust/src/project_bid_commercial/service.rs blocker derivation"
      ],
      "evidenceClass": "static reachable-state analysis only; no runtime reproduction claimed",
      "rootDisposition": "Root confirmed and assigned A bounded02 correction; original01 is preserved",
      "resolutionVerifiedByReviewer": false,
      "status": "Confirmed-remediation-in-progress"
    }
  ],

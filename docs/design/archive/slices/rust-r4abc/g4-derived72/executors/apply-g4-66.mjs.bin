import fs from'node:fs';import assert from'node:assert/strict';import{spawnSync,execFileSync}from'node:child_process';import{createHash}from'node:crypto';
const archive='docs/design/archive/slices/rust-r4abc',planFile=archive+'/g4-plan65/plan65.json',expectedPlan='062404d37afe1f6c490a86720d1faea76f0cba97d08c4e800b759ab46ffd3ef0',permitSha=process.argv[2],out='tmp/rust-r4abc/root/g4-online66',pub=archive+'/g4-online66',sha=b=>createHash('sha256').update(b).digest('hex');assert(/^[a-f0-9]{64}$/.test(permitSha));assert.equal(sha(fs.readFileSync(planFile)),expectedPlan);const plan=JSON.parse(fs.readFileSync(planFile,'utf8')),permitFile=archive+'/g4-preclose11.json.bin';assert.equal(sha(fs.readFileSync(permitFile)),permitSha);assert.equal(JSON.parse(fs.readFileSync(permitFile,'utf8')).decision,'Pass');assert.deepEqual(plan.scope.closeOnly,[103,104,105,102]);assert.deepEqual(plan.scope.keepOpen,[101,57]);assert(!fs.existsSync(out)&&!fs.existsSync(pub));fs.mkdirSync(out,{recursive:true});const source=JSON.parse(fs.readFileSync(archive+'/final-source53.json','utf8'));for(const p of source.products)assert.equal(sha(fs.readFileSync(p.file)),p.rawBytesSha256);const localHead=execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();assert.equal(execFileSync('git',['ls-remote','origin','refs/heads/main'],{encoding:'utf8'}).trim().split('\t')[0],localHead);
const calls=[],applied=[];let sequence=0;function api(label,args,body){const prefix=out+'/'+String(++sequence).padStart(2,'0')+'-'+label;if(body!==undefined){fs.writeFileSync(prefix+'-input.json',JSON.stringify(body,null,2)+'\n',{flag:'wx'});args=[...args,'--input',prefix+'-input.json'];}const r=spawnSync('gh',['api',...args],{encoding:null,windowsHide:true,timeout:60000,maxBuffer:16000000});for(const stream of['stdout','stderr'])fs.writeFileSync(prefix+'-'+stream+'-original.bin',r[stream]||Buffer.alloc(0),{flag:'wx'});calls.push({label,args,exitCode:r.status});fs.writeFileSync(out+'/progress.json',JSON.stringify({calls,applied},null,2)+'\n');assert.equal(r.status,0,'Unknown/failed external action: inspect actual state before any retry');const v=JSON.parse(r.stdout);assert(!v.errors);return v;}
const query='query{repository(owner:"illusion-tech",name:"poms"){'+plan.executionOrder.map(n=>'i'+n+':issue(number:'+n+'){number state body url comments(last:30){nodes{databaseId body url}} subIssues(first:100){nodes{number state}}}').join(' ')+'}}';
try{const before=api('before',['graphql'],{query}).data.repository;for(const n of plan.executionOrder){assert.equal(before['i'+n].state,plan.sourceBefore[n].state);assert.equal(sha(Buffer.from(before['i'+n].body)),plan.sourceBefore[n].bodySha256);}assert.deepEqual(before.i102.subIssues.nodes.map(x=>x.number).sort(),[103,104,105]);
 for(const action of plan.actions){if(action.issue===102){const child=api('batch-children-before-close',['repos/illusion-tech/poms/issues/102/sub_issues']);assert.deepEqual(child.map(c=>c.number).sort(),[103,104,105]);assert(child.every(c=>c.state==='closed'));}const body={body:action.body,state:action.desiredState.toLowerCase()};if(action.desiredState==='CLOSED')body.state_reason='completed';const issue=api('issue-'+action.issue,['repos/illusion-tech/poms/issues/'+action.issue,'--method','PATCH'],body);assert.equal(issue.state,action.desiredState.toLowerCase());assert.equal(issue.body,action.body);const comment=api('comment-'+action.issue,['repos/illusion-tech/poms/issues/'+action.issue+'/comments','--method','POST'],{body:action.comment});assert.equal(comment.body,action.comment);applied.push({issue:action.issue,state:issue.state,body:action.body,comment:{id:comment.id,url:comment.html_url,body:comment.body}});}
 const after=api('after',['graphql'],{query}).data.repository;for(const action of plan.actions){const current=after['i'+action.issue],actual=applied.find(x=>x.issue===action.issue);assert.equal(current.state,action.desiredState);assert.equal(current.body,action.body);const comment=current.comments.nodes.find(c=>c.databaseId===actual.comment.id);assert(comment&&comment.body===action.comment);}assert(after.i57.subIssues.nodes.some(n=>n.number===101&&n.state==='OPEN'));assert(after.i101.subIssues.nodes.some(n=>n.number===102&&n.state==='CLOSED'));assert(after.i102.subIssues.nodes.every(n=>n.state==='CLOSED'));
 fs.mkdirSync(pub,{recursive:true});const origins=[];for(const name of fs.readdirSync(out)){const src=out+'/'+name,dest=pub+'/'+name+'.bin';fs.copyFileSync(src,dest,fs.constants.COPYFILE_EXCL);origins.push({logicalOrigin:src,storedAt:dest,bytes:fs.statSync(dest).size,rawBytesSha256:sha(fs.readFileSync(dest))});}const receipt={kind:'actual-six-Issue-G4-online-application-and-exact-readback',createdAt:new Date().toISOString(),plan:{file:planFile,rawBytesSha256:expectedPlan},permit:{file:permitFile,rawBytesSha256:permitSha},publishedMetadataHead:localHead,implementationCommit:plan.implementationCommit,actions:applied,after,calls,origins,closedOnly:[103,104,105,102],keptOpen:[101,57],allBodiesCommentsExactPlan:true,nativeParentRelationsVerified:true,G4OnlineApplied:true,finalIndependentActualReviewPending:true,G4Certified:false};fs.writeFileSync(pub+'/receipt66.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({closed:[103,104,105,102],open:[101,57],allBodiesCommentsExact:true,nativeRelations:true,finalActualReviewPending:true}));
}catch(error){fs.writeFileSync(out+'/failed66.json',JSON.stringify({kind:'G4-online-partial-retained',errorName:error.name,message:error.message,calls,applied,doNotBlindlyRepeat:true},null,2)+'\n',{flag:'wx'});throw error;}

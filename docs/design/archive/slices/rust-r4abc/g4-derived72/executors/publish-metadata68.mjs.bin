import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{spawnSync,execFileSync}from'node:child_process';import{createHash}from'node:crypto';
const root=process.cwd().replaceAll('\\','/'),primary='E:/projects/poms',[label,messageFile]=process.argv.slice(2);assert.equal(root,'E:/projects/worktrees/poms-r3hijk-next28/poms');assert(/^[a-z0-9-]{1,28}$/.test(label));assert(messageFile.startsWith('tmp/rust-r4abc/'));const out='tmp/rust-r4abc/root/metadata-'+label+'68';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const commands=[],sha=b=>createHash('sha256').update(b).digest('hex');function git(cwd,args){const r=spawnSync('git',args,{cwd,encoding:null,windowsHide:true,timeout:180000,maxBuffer:16000000}),i=commands.length+1;fs.writeFileSync(out+'/'+i+'-stdout-original.bin',r.stdout||Buffer.alloc(0),{flag:'wx'});fs.writeFileSync(out+'/'+i+'-stderr-original.bin',r.stderr||Buffer.alloc(0),{flag:'wx'});commands.push({cwd,args,exitCode:r.status});assert.equal(r.status,0,'Exact metadata Git operation failed; inspect retained originals');return r.stdout.toString('utf8');}
const source=JSON.parse(fs.readFileSync('docs/design/archive/slices/rust-r4abc/final-source53.json','utf8'));for(const p of source.products)assert.equal(sha(fs.readFileSync(p.file)),p.rawBytesSha256);const changes=git(root,['diff','--name-only']).trim().split(/\r?\n/).filter(Boolean);assert(changes.every(p=>p.startsWith('docs/design/')),'Ordinary metadata cannot carry product changes');assert.equal(git(primary,['status','--porcelain','--untracked-files=no']),'');const beforeMain=git(primary,['rev-parse','HEAD']).trim();assert.equal(git(root,['ls-remote','origin','refs/heads/main']).trim().split('\t')[0],beforeMain);
git(root,['add','-A','--','docs/design']);assert(git(root,['diff','--cached','--name-only']).trim().split(/\r?\n/).filter(Boolean).every(p=>p.startsWith('docs/design/')));git(root,['diff','--cached','--check']);git(root,['commit','--quiet','--file',messageFile]);const head=git(root,['rev-parse','HEAD']).trim();git(root,['push','origin','codex/poms-r4abc-first37']);git(root,['merge-base','--is-ancestor',beforeMain,head]);git(primary,['merge','--ff-only',head]);const old=JSON.parse(fs.readFileSync('tmp/rust-r4abc/root/main-integration64/primary-before64.json','utf8'));for(const p of old.before.filter(p=>p.savedOriginal)){const current=sha(fs.readFileSync(path.join(primary,p.file)));assert.equal(current,p.rawBytesSha256,p.file+' existing raw representation');}for(const p of source.products)assert.equal(sha(fs.readFileSync(path.join(primary,p.file))),p.rawBytesSha256,p.file+' primary product');assert.equal(git(primary,['status','--porcelain','--untracked-files=no']),'');git(primary,['push','origin','main']);assert.equal(git(root,['ls-remote','origin','refs/heads/main']).trim().split('\t')[0],head);assert.equal(git(root,['status','--porcelain']),'');fs.writeFileSync(out+'/receipt68.json',JSON.stringify({kind:'metadata-only-main-publication',label,beforeMain,commit:head,commands,all949ProductsRawUnchanged:true,all17PrimaryRepresentationsPreserved:true,primaryClean:true,RootClean:true,remoteMainExact:head,permanentS3AncestorPreserved:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({label,commit:head,metadataOnly:true,productsUnchanged:949,primaryClean:true,remoteMainExact:true}));

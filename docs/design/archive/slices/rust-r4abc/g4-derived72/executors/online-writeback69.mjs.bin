import fs from'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';const archive='docs/design/archive/slices/rust-r4abc',receiptFile=archive+'/g4-online66/receipt66.json',r=JSON.parse(fs.readFileSync(receiptFile,'utf8')),sha=b=>createHash('sha256').update(b).digest('hex'),out='tmp/rust-r4abc/root/online-writeback69';assert(r.G4OnlineApplied&&r.allBodiesCommentsExactPlan&&r.nativeParentRelationsVerified);assert.deepEqual(r.closedOnly,[103,104,105,102]);assert.deepEqual(r.keptOpen,[101,57]);assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const links=r.actions.map(a=>'[#'+a.issue+']('+a.comment.url+')').join('、'),note='\n\n### 2026-11-04 R4 首批实际线上 G4 收口\n\n'+links+' 已按[具体六Issue方案](archive/slices/rust-r4abc/g4-plan65/plan65.json)与[独立关闭许可](archive/slices/rust-r4abc/g4-preclose11.json.bin)实际执行，仅#103/#104/#105/#102关闭，#101/#57持续Open。[原始线上读回](archive/slices/rust-r4abc/g4-online66/receipt66.json)逐字核正文/评论及原生父子关系。当前为 **G4OnlineApplied，最终非作者实际终审待附**；本条覆盖旧G4Ready候选时点，不把完整R4或总体标Done。\n\n源码、936实际构建输入及949生产文件均未因纯元数据操作改变；原163负例仅有界复用、54ignored和Linux41/42 partial及Native参考仍保留原标签。后续移交/成本40/经营验收完工归档及R5–R7尚未完成。\n';const docs=['docs/design/backend-rust-migration-plan.md','docs/design/rust-migration-execution-tracker.md','docs/design/phase2-development-execution-tracker.md','docs/design/poms-design-progress.md','docs/design/README.md'];for(const file of docs){const old=fs.readFileSync(file,'utf8');fs.writeFileSync(out+'/'+path.basename(file)+'.before.bin',old,{flag:'wx'});let next=old.replace('R4首批37入口已集成/G4Ready','R4首批37入口线上收口/最终独立签署待附').replace('R4首批#102实现已集成、G4Ready，#101保持Doing','R4首批#102已线上收口、最终独立签署待附，#101保持Doing');next+=note;fs.writeFileSync(file,next);}
const statusFile='docs/design/rust-r4abc-delivery-status.json',status=JSON.parse(fs.readFileSync(statusFile,'utf8'));Object.assign(status,{stage:'G4OnlineApplied',updatedAt:new Date().toISOString(),issues:Object.fromEntries(r.actions.map(a=>[a.issue,a.state.toUpperCase()])),onlineReadback:'archive/slices/rust-r4abc/g4-online66/receipt66.json',finalIndependentActualReviewPending:true,G4Certified:false});fs.writeFileSync(statusFile,JSON.stringify(status,null,2)+'\n');const scope='docs/design/rust-r4-scope-and-dependencies.md';let t=fs.readFileSync(scope,'utf8');t=t.replace('当前首批 #102 为 G4Ready，正式关闭许可和线上读回待完成。','当前首批 #102/#103/#104/#105 已按许可实际线上关闭，最终独立实际签署待附；完整 R4 仍未完成。');fs.writeFileSync(scope,t);const index='docs/design/archive/slices/rust-r4abc-closeout.md';t=fs.readFileSync(index,'utf8').replace('当前：G4Ready。','当前：G4OnlineApplied，最终独立实际签署待附。');t+='\n\n## 线上实际读回\n\n仅#103/#104/#105/#102已关闭，#101/#57保持Open。[具体方案](rust-r4abc/g4-plan65/plan65.json)、[关闭许可](rust-r4abc/g4-preclose11.json.bin)、[六项原始线上读回](rust-r4abc/g4-online66/receipt66.json)逐字一致；最终实际签署另附。\n';fs.writeFileSync(index,t);
const m=JSON.parse(fs.readFileSync(archive+'/final-source53.json','utf8'));for(const p of m.products)assert.equal(sha(fs.readFileSync(p.file)),p.rawBytesSha256);fs.writeFileSync(out+'/receipt69.json',JSON.stringify({kind:'GitHub-first-exact-online-state-local-mirror',GitHubReadbackSha256:sha(fs.readFileSync(receiptFile)),issues:status.issues,stage:status.stage,all949ProductsUnchanged:true,fullR4Complete:false,finalActualReviewPending:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({localMirrorUpdated:6,stage:'G4OnlineApplied',productsUnchanged:949,parentsOpen:true}));

          "id",
          "projectId",
          "acceptanceType",
          "acceptanceResult",
          "status",
          "scopeSummary",
          "evidenceSummary",
          "comment",
          "confirmationRecordId",
          "confirmedAt",
          "confirmedBy",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy",
          "rowVersion"
        ],
        "type": "object"
      },

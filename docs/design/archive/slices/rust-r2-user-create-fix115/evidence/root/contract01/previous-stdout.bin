    "/api/projects/{projectId}/actual-cost-records": {
      "get": {
        "operationId": "ProjectCostController_listProjectActualCostRecords",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sourceType",
            "required": false,
            "schema": {
              "enum": [
                "payment-record",
                "invoice-record",
                "expense-record",
                "payable-record",
                "labor"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "recordStatus",
            "required": false,
            "schema": {
              "enum": [
                "draft",
                "registered",
                "confirmed",
                "included",
                "voided",
                "replaced"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "costType",
            "required": false,
            "schema": {
              "enum": [
                "procurement",
                "invoice",
                "expense",
                "payment-fact",
                "labor"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectActualCostRecordListView"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "获取项目实际成本记录列表",
        "tags": [
          "Project Cost"
        ]
      },
      "post": {
        "operationId": "ProjectCostController_createProjectActualCostRecord",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "mapping": {
                    "expense": "#/components/schemas/CreateExpenseProjectActualCostRecordRequest",
                    "invoice": "#/components/schemas/CreateInvoiceProjectActualCostRecordRequest",
                    "labor": "#/components/schemas/CreateLaborProjectActualCostRecordRequest",
                    "payment-fact": "#/components/schemas/CreatePaymentFactProjectActualCostRecordRequest",
                    "procurement": "#/components/schemas/CreateProcurementProjectActualCostRecordRequest"
                  },
                  "propertyName": "costType"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CreatePaymentFactProjectActualCostRecordRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CreateInvoiceProjectActualCostRecordRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CreateExpenseProjectActualCostRecordRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CreateProcurementProjectActualCostRecordRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CreateLaborProjectActualCostRecordRequest"
                  }
                ],
                "title": "CreateProjectActualCostRecordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "创建项目统一实际成本记录",
        "tags": [
          "Project Cost"
        ]
      }
    },

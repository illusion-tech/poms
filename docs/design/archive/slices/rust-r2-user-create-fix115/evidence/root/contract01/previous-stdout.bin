          "value": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "UserOrgUnitMembershipType": {
        "enum": [
          "primary",
          "secondary"
        ],
        "type": "string"
      },
      "UserOrgUnitSummary": {
        "properties": {
          "code": {
            "nullable": true,
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          },
          "membershipType": {
            "$ref": "#/components/schemas/UserOrgUnitMembershipType"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "code",
          "description",
          "membershipType"
        ],
        "type": "object"
      },
      "VoidAttachmentRequest": {
        "properties": {
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "VoidExpenseRecordRequest": {
        "properties": {
          "comment": {
            "maxLength": 1000,
            "minLength": 1,
            "nullable": true,
            "type": "string"
          },
          "expectedVersion": {
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "VoidPayableRecordRequest": {
        "properties": {
          "comment": {
            "maxLength": 1000,
            "minLength": 1,
            "nullable": true,
            "type": "string"
          },
          "expectedVersion": {
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "VoidProjectArchiveRecordRequest": {
        "properties": {
          "comment": {
            "maxLength": 1000,
            "nullable": true,
            "type": "string"
          },
          "expectedVersion": {
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "VoidSalesFollowUpRecordRequest": {
        "properties": {
          "comment": {
            "maxLength": 1000,
            "nullable": true,
            "type": "string"
          },
          "expectedVersion": {
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "reason",
          "expectedVersion"
        ],
        "type": "object"
      },
      "WinProbabilityLevel": {
        "enum": [
          "high",
          "medium",
          "low",
          "unknown"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "pomsCsrf": {
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "pomsSession": {
        "in": "cookie",
        "name": "poms_session",
        "type": "apiKey"
      }
    }
  },

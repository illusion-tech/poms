  "constraints": [
    {
      "table_name": "attachment",
      "conname": "attachment_pkey",
      "contype": "p",
      "convalidated": true,
      "condeferrable": false,
      "condeferred": false,
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "attachment",
      "conname": "chk_attachment_security_level",
      "contype": "c",
      "convalidated": true,
      "condeferrable": false,
      "condeferred": false,
      "definition": "CHECK (((security_level)::text = ANY ((ARRAY['normal'::character varying, 'internal'::character varying, 'sensitive'::character varying, 'confidential'::character varying, 'restricted'::character varying])::text[])))"
    },
    {
      "table_name": "attachment",
      "conname": "chk_attachment_status",
      "contype": "c",
      "convalidated": true,
      "condeferrable": false,
      "condeferred": false,
      "definition": "CHECK (((status)::text = ANY ((ARRAY['active'::character varying, 'voided'::character varying, 'deleted'::character varying, 'failed'::character varying])::text[])))"
    },
    {
      "table_name": "attachment_download_package",
      "conname": "attachment_download_package_handover_id_foreign",
      "contype": "f",
      "convalidated": true,
      "condeferrable": false,
      "condeferred": false,
      "definition": "FOREIGN KEY (handover_id) REFERENCES poms.project_handover(id) ON UPDATE CASCADE ON DELETE CASCADE"
    },
    {
      "table_name": "attachment_download_package",
      "conname": "attachment_download_package_project_id_foreign",
      "contype": "f",
      "convalidated": true,
      "condeferrable": false,
      "condeferred": false,
      "definition": "FOREIGN KEY (project_id) REFERENCES poms.project(id) ON UPDATE CASCADE ON DELETE RESTRICT"
    },
    {
      "table_name": "attachment_download_package",
      "conname": "chk_adp_status",
      "contype": "c",

  "candidateViewFieldDeltas": {
    "SharedCostAllocationBasisSummary": {
      "remove": [
        "basisSummary"
      ],
      "add": {
        "basisSummaryProjection": {
          "$ref": "#/components/schemas/SensitiveStringFieldProjection"
        },
        "financialProjection": {
          "$ref": "#/components/schemas/SensitiveStringFieldProjection"
        },
        "currency": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            {
              "type": "null"
            }
          ]
        },
        "measurementBasis": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "excluding-tax",
                "tax",
                "including-tax"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceId": {
          "oneOf": [

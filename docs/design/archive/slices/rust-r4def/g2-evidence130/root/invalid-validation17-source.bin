  const declaration = declarations.get(`${name}Schema`);
  assert(declaration, `No current Shared schema declaration for ${name}`);
  components[name] = decorate(spec.components.schemas[name], annotation(declaration, name));
  if (scalarKinds[name]) assert(components[name]['x-r4-scalar'] === scalarKinds[name], `Missing exact scalar refinement ${name}`);

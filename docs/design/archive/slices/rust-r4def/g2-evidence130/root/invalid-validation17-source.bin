const supported = new Set(['$ref','type','properties','required','items','allOf','anyOf','oneOf','nullable','enum','const','minimum','maximum','exclusiveMinimum','exclusiveMaximum','minLength','maxLength','minItems','maxItems','default','format','pattern','additionalProperties','description','title','example','examples','deprecated','readOnly','writeOnly','x-r4-trim','x-r4-scalar','x-r4-at-least-one','x-r4-unique-contract-ids','x-r4-strict','x-r4-pattern-kind','discriminator']);

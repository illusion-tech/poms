  "priorFindingCoverage": [
    {
      "prior": "K53-P1-01",
      "disposition": "addressed-by-proposal-only; current-runtime-failure-not-yet-fixed",
      "design": "Complete纯规划、无validating预提交/无catch reflush，单Tx内early strict CAS撤旧unique槽→Attachment/真实Links→必要audit/auth/Session.completed；early entity只写一次。",
      "vectors": [
        "K55-17-nonfinal-preserves-old-final",
        "K55-18-mark-final-and-clear-final",
        "K55-19-void-then-append",
        "K55-24-failure-at-each-necessary-write",
        "K55-25-create-session-and-mutation-audit-failures",
        "K55-31-raw-context-and-no-repeat-early-update"
      ]
    },
    {
      "prior": "K54-P1-01",
      "disposition": "addressed-in-exact-proposal",
      "design": "实际一次有界buffer和SHA写入新UUID+attempt nonce final，active Attachment不再绑定可写staging；晚到proxy/旧presigned仅改staging。旧引用staging守卫、abort commit后独立引用probe和仅删staging补齐遗留/删除边界。",

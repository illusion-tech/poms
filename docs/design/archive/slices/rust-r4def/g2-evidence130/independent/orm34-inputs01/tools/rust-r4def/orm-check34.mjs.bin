import fs from 'node:fs';import assert from 'node:assert/strict';import{spawnSync}from'node:child_process';import{createRequire}from'node:module';import{createHash}from'node:crypto';
import{connect,priv,root,win}from'./db33.mjs';
const require=createRequire(root+'/package.json'),{parse}=require('dotenv'),out=win+'/tmp/rust-r4def/root/orm-check34';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});
const pin=file=>{const b=fs.readFileSync(file);return{file,bytes:b.length,sha256:createHash('sha256').update(b).digest('hex')}};
const writePrivate=(f,v)=>{assert(f.startsWith(priv+'/'));fs.writeFileSync(f,v,{flag:'wx',mode:0o600})};
const db=await connect();await db.end();const app=parse(fs.readFileSync(priv+'/rust.env')),owner={...app,DB_USER:'poms_r0e_owner',DB_PASSWORD:fs.readFileSync(priv+'/owner-password','utf8')};
const ownerPath=priv+'/orm-owner34.env';writePrivate(ownerPath,Object.entries(owner).map(([k,v])=>k+'='+v).join('\n')+'\n');
const secrets=[...Object.entries(app),...Object.entries(owner)].filter(([k])=>/PASSWORD|SECRET|STATE_KEY/.test(k)).map(([,v])=>v).filter(Boolean);
const commands=[];
for(const[principal,envFile]of[['owner',ownerPath],['app',priv+'/rust.env']])for(const[mode,args]of[['migration-check',['migration:check']],['schema-dump',['schema:update','--dump']]]){
 const name=principal+'-'+mode,env={HOME:process.env.HOME,PATH:process.execPath.slice(0,process.execPath.lastIndexOf('/'))+':/usr/local/bin:/usr/bin:/bin',POMS_ENV_FILE:envFile,MIKRO_ORM_CLI_TS_CONFIG_PATH:'tsconfig.base.json',NODE_OPTIONS:'--experimental-vm-modules',NO_COLOR:'1'};
 const result=spawnSync(process.execPath,[root+'/node_modules/@mikro-orm/cli/cli.js',...args,'--config','apps/poms-api/src/mikro-orm.config.ts'],{cwd:root,env,encoding:null,timeout:120000,maxBuffer:32000000});
 const streams={};for(const key of['stdout','stderr']){const raw=result[key]||Buffer.alloc(0),p=priv+'/orm34-'+name+'-'+key+'.bin';writePrivate(p,raw);let safe=raw.toString('utf8');for(const secret of secrets)safe=safe.replaceAll(secret,'<REDACTED>');assert(!secrets.some(s=>safe.includes(s)));const file=out+'/'+name+'-'+key+'-redacted.txt';fs.writeFileSync(file,safe,{flag:'wx'});streams[key]={privateOriginal:pin(p),publicRedacted:pin(file)};}
 const row={principal,mode,args,exitCode:result.status,error:result.error?.name??null,streams,DDLExecuted:false};commands.push(row);console.log(JSON.stringify({principal,mode,exitCode:result.status,DDLExecuted:false}));
}
fs.writeFileSync(out+'/receipt34.json',JSON.stringify({kind:'actual-MikroORM7-discovery-schema-dump-migration-check',commands,classificationPending:true,applicationACLUnchanged:true,DDLExecuted:false},null,2)+'\n',{flag:'wx'});

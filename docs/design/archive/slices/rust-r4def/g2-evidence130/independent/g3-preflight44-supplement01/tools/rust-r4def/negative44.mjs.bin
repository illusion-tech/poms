import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{createApiHarness}from'./api-harness32.mjs';import{connect}from'./db33.mjs';
const h=createApiHarness(),c=await connect(),actors=JSON.parse(fs.readFileSync(h.priv+'/actors33.json')).actors;
for(const key of['denied','full'])await h.login(actors[key]);
const project=JSON.parse(fs.readFileSync(h.priv+'/upstream36.json')).project.id;
const map=JSON.parse(fs.readFileSync(h.win+'/tools/rust-r4def/combined-operation-map16.json')).operations.filter(o=>['D','E','F'].includes(o.group));assert.equal(map.length,30);
const sha=s=>createHash('sha256').update(s).digest('hex');
async function graph(label){const{rows:tables}=await c.query("SELECT table_name FROM information_schema.tables WHERE table_schema='poms' AND table_type='BASE TABLE' ORDER BY table_name");assert.equal(tables.length,120);const rows={};await c.query('BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY');for(const{table_name:t}of tables){assert(/^[a-z][a-z0-9_]*$/.test(t));rows[t]=(await c.query(`SELECT to_jsonb(t)::text value FROM poms."${t}" t ORDER BY to_jsonb(t)::text COLLATE "C"`)).rows.map(r=>r.value)}await c.query('COMMIT');fs.writeFileSync(h.priv+'/negative44-'+label+'.json',JSON.stringify(rows)+'\n',{flag:'wx',mode:0o600});return rows;}
const before=await graph('before'),results=[];
try{for(const o of map){for(const [kind,actor,meta,status]of[['anonymous','anonymous',{},401],['permission','denied',{},403],...(!['GET','HEAD','OPTIONS'].includes(o.method)?[['csrf-omitted','full',{csrf:'omit'},403],['csrf-wrong','full',{csrf:'wrong'},403]]:[])]){const r=await h.request(o.operationId,project,o.method==='GET'?null:{},actor,meta);assert.equal(r.status,status,`${kind} ${o.operationId}: ${r.receiptId}`);results.push({operationId:o.operationId,kind,status:r.status,receiptId:r.receiptId})}}
 const after=await graph('after');for(const table of Object.keys(before))if(!['auth_session','security_event'].includes(table))assert.deepEqual(after[table],before[table],table+' must not change on authorization rejection');
 fs.writeFileSync(h.out+'/negative44.json',JSON.stringify({kind:'actual-30-operation-auth-permission-CSRF-matrix',operations:map.length,results,allPassed:true,businessTablesUnchanged:118,authSecurityTablesExplicitlyAllowed:['auth_session','security_event'],securityEventsBefore:before.security_event.length,securityEventsAfter:after.security_event.length,beforeDigests:Object.entries(before).map(([table,rows])=>({table,count:rows.length,sha256:sha(JSON.stringify(rows))})),afterDigests:Object.entries(after).map(([table,rows])=>({table,count:rows.length,sha256:sha(JSON.stringify(rows))}))},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({operations:30,actualRejects:results.length,allPassed:true,businessTablesUnchanged:118}));
}finally{await c.end()}

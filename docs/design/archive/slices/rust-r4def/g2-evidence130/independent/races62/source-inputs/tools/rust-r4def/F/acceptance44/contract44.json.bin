  "schemas": {
    "ConfirmAccountingTaxTreatmentRequest": {
      "type": "object",
      "properties": {
        "taxTreatmentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "deductibilityStatus": {
          "$ref": "#/components/schemas/AccountingTaxDeductibilityStatus"
        },
        "taxImpactAmount": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^-?[0-9]{1,16}(?:\\.[0-9]{1,2})?$"
        },
        "taxImpactSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "taxPendingFlag": {
          "default": false,
          "type": "boolean"
        },
        "taxImpactPendingAmount": {
          "default": "0",
          "type": "string",
          "maxLength": 19,
          "pattern": "^[0-9]{1,16}(?:\\.[0-9]{1,2})?$"
        },
        "basisSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "nullable": true
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "sourceReferences": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/R4FGovernanceEvidence"
          }
        }
      },
      "required": [
        "taxTreatmentType",
        "deductibilityStatus",
        "taxImpactAmount",
        "taxImpactSummary",
        "currency",
        "sourceReferences"
      ],
      "additionalProperties": false
    },
    "ReplaceAccountingTaxTreatmentRequest": {
      "type": "object",
      "properties": {
        "taxTreatmentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "deductibilityStatus": {
          "$ref": "#/components/schemas/AccountingTaxDeductibilityStatus"
        },
        "taxImpactAmount": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^-?[0-9]{1,16}(?:\\.[0-9]{1,2})?$"
        },
        "taxImpactSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "taxPendingFlag": {
          "default": false,
          "type": "boolean"
        },
        "taxImpactPendingAmount": {
          "default": "0",
          "type": "string",
          "maxLength": 19,
          "pattern": "^[0-9]{1,16}(?:\\.[0-9]{1,2})?$"
        },
        "basisSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "nullable": true
        },
        "expectedVersion": {
          "type": "integer",
          "exclusiveMinimum": true,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "sourceReferences": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/R4FGovernanceEvidence"
          }
        },
        "replacementReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "taxTreatmentType",
        "deductibilityStatus",
        "taxImpactAmount",
        "taxImpactSummary",
        "currency",
        "sourceReferences",
        "replacementReason"
      ],
      "additionalProperties": false
    },
    "ReclassifyCostStageAttributionRequest": {
      "type": "object",
      "properties": {
        "newAttributedStage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lockedBySnapshotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "nullable": true
        },
        "reclassifyReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "comment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "nullable": true
        },
        "expectedVersion": {
          "type": "integer",
          "exclusiveMinimum": true,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "attributionEvidence": {
          "$ref": "#/components/schemas/R4FGovernanceEvidence"
        }
      },
      "required": [
        "newAttributedStage",
        "reclassifyReason",
        "attributionEvidence"
      ],
      "additionalProperties": false
    },
    "ConfirmCostStageAttributionRequest": {
      "type": "object",
      "properties": {
        "stageAttributionMode": {
          "$ref": "#/components/schemas/ConfirmCostStageAttributionMode"
        },
        "attributedStage": {
          "type": "string",
          "minLength": 1,

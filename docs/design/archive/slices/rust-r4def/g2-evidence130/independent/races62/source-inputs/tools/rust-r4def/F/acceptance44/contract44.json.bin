    "ConfirmSharedCostAllocationBasisRequest": {
      "type": "object",
      "properties": {
        "basisType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sourceCostRecordIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "allocationMethod": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "projectShareItems": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/R4FSharedCostAllocationShareItem"
          }
        },
        "basisSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "nullable": true
        },
        "comment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "nullable": true
        },
        "measurementBasis": {
          "type": "string",
          "enum": [
            "excluding-tax",
            "tax",
            "including-tax"
          ]
        },
        "expectedSourceVersions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/R4FCostSourceVersion"
          }
        }
      },
      "required": [
        "basisType",
        "sourceCostRecordIds",
        "allocationMethod",
        "projectShareItems",
        "measurementBasis",
        "expectedSourceVersions"
      ],
      "additionalProperties": false
    },
    "ReplaceSharedCostAllocationResultRequest": {
      "type": "object",
      "properties": {
        "allocatedAmount": {
          "type": "string",
          "maxLength": 19,
          "pattern": "^[0-9]{1,16}(?:\\.[0-9]{1,2})?$"
        },
        "allocationRatio": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "nullable": true
        },
        "allocationSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "nullable": true
        },
        "replacementReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "comment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "nullable": true
        },
        "expectedVersion": {
          "type": "integer",
          "exclusiveMinimum": true,
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "projectShareItems": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/R4FSharedCostAllocationShareItem"
          }
        },
        "expectedBasisVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "replacementReason",
        "projectShareItems",
        "expectedBasisVersion"
      ],
      "additionalProperties": false
    },
    "R4FSourceEvidence": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "source"
          ]
        },
        "sourceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "businessDate": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "kind",
        "sourceType",
        "sourceId",
        "sourceVersion",
        "businessDate",
        "reason"
      ],
      "additionalProperties": false
    },
    "R4FManualAssessmentEvidence": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [

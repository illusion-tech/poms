// Rechecks only read-only observations; no successful business command is replayed.
import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{connect,win}from'./db33.mjs';
const out=win+'/tmp/rust-r4def/root/proof-E42';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});
const original=JSON.parse(fs.readFileSync(win+'/tmp/rust-r4def/root/api32/E41-result.json')),item=original.cases.find(x=>x.id==='E21-14'),stage=original.cases.find(x=>x.id==='E21-13').observations[0].evidenceId,c=await connect();
const stable=v=>Array.isArray(v)?v.map(stable):v&&typeof v==='object'?Object.fromEntries(Object.keys(v).sort().map(k=>[k,stable(v[k])])):v;
const hash=v=>createHash('sha256').update(JSON.stringify(stable(v))).digest('hex');let n=0;
async function read(id){const{rows}=await c.query('SELECT * FROM poms.cost_governance_evidence WHERE id=$1',[id]);assert.equal(rows.length,1);const row=rows[0];assert.equal(row.payload_hash,hash(row.frozen_payload));fs.writeFileSync(out+'/'+(++n)+'-'+id+'.json',JSON.stringify({kind:'actual-read-only-PG-source-proof',row},null,2)+'\n',{flag:'wx'});return row}
try{await c.query('BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY');const results=[];let previousId=stage;
for(const o of item.observations){const row=await read(o.evidenceId),proof=row.frozen_payload.sourceVersionTransitions.find(p=>p.costRecordId===o.costRecordId),previous=await read(previousId),anchor=previous.frozen_payload.sourceVersionTransitions.find(p=>p.costRecordId===o.costRecordId);assert(proof&&anchor);
 for(const[k,v]of Object.entries(o.expected)){if(['confirmedPaymentNetTotal','capturedConfirmedPaymentNetTotal'].includes(k))continue;assert.deepEqual(proof[k],v,k)}
 const captured=row.frozen_payload.sources.find(s=>s.cost.id===o.costRecordId).cost.source_basis;assert.equal(captured.sourceRowVersion,1);assert.equal(proof.capturedPayloadHash,hash(captured.sourcePayload));assert.equal(proof.currentPayloadHash,hash(proof.sourcePayload));assert.equal(proof.sourcePayload.row_version,proof.currentVersion);assert.equal(proof.sourcePayload.confirmed_payment_amount_excluding_tax_total,o.expected.confirmedPaymentNetTotal);assert.equal(captured.sourcePayload.confirmed_payment_amount_excluding_tax_total,'0.00');assert.equal(proof.previousCertifiedVersion,anchor.currentVersion);assert.equal(proof.previousPayloadHash,anchor.currentPayloadHash);assert.equal(proof.capturedPayloadHash,anchor.capturedPayloadHash);
 results.push({evidenceId:o.evidenceId,previousEvidenceId:previousId,capturedVersion:proof.capturedVersion,previousCertifiedVersion:proof.previousCertifiedVersion,currentVersion:proof.currentVersion,confirmedPaymentNetTotal:proof.sourcePayload.confirmed_payment_amount_excluding_tax_total,passed:true});previousId=o.evidenceId;}
await c.query('COMMIT');fs.writeFileSync(out+'/receipt42.json',JSON.stringify({kind:'E21-14-read-only-reverification',originalE41Preserved:true,originalE41ObserverFailure:'Root fixed-name wx collision when re-reading an already-observed previous evidence ID',successfulHTTPReplayed:0,businessWrites:0,results,allPassed:true},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({passed:results.length,businessHTTPReplayed:0,businessWrites:0}));}finally{await c.end()}

  "findings": [
    {
      "id": "K86-P1-01",
      "priority": "P1",
      "title": "New clean-Link global guard rejects generic handover auto-links after they commit",
      "file": "apps/poms-api-rust/src/attachments/store.rs",
      "locations": [
        {
          "file": "apps/poms-api-rust/src/attachments/handover.rs",
          "line": 595,
          "detail": "New auto-Link constructor omits unlinked_by/unlinked_at; linked values are real business source."
        },
        {
          "file": "apps/poms-api-rust/src/attachments/handover.rs",
          "line": 602,
          "detail": "save commits the new Link/selection, then k_audit invokes generic flush in the same request."
        },
        {
          "file": "apps/poms-api-rust/src/attachments/store.rs",
          "line": 538,
          "detail": "insert returns id (plus version only for versioned tables); does not hydrate omitted default columns."
        },
        {
          "file": "apps/poms-api-rust/src/attachments/store.rs",
          "line": 1466,
          "detail": "K86 now rechecks all Link entities, including clean auto-Link just marked committed."
        },
        {
          "file": "apps/poms-api-rust/src/attachments/store.rs",
          "line": 950,
          "detail": "same_proof requires equal object length; incomplete8-field baseline differs from full10-field to_jsonb."
        }
      ],
      "staticTrigger": "Fresh real attachment eligible for handover refresh, without an existing project-handover/handover Link. The refresh creates a Link with DB-null defaults omitted from the managed JSON, commits via save, then attempts its required audit flush.",
      "result": "After the first commit, Entity::mark_committed preserves the constructor data plus returned id. The new K86 all-clean-Link check compares this incomplete original with the full PG tuple, so changed_source is certain for this shape and the subsequent workflow returns409 without its intended success audit. This is static control-flow/DDL reasoning, not an executed HTTP case.",
      "scope": "A new regression in the generic K writer reached by the two-file store change. It is not a demand to certify all handover/package multi-phase atomicity.",
      "requiredCorrection": "Within the authorized service/store files, either hydrate complete Link originals from actual INSERT RETURNING / a real locked hydrate, or preserve strict clean-Link validation only for explicitly captured first-Link intent while keeping the prior dirty/new semantics for unrelated generic clean children. Do not globally discard real NULL fields or weaken first-source/no-op tuple comparison.",
      "requiredValidation": [
        "Fresh real attachment→handover refresh creates a new auto-Link and its required audit succeeds; do not only reuse K71 existing auto-links.",
        "Two original no-op Link/unlink controlled PG barrier proofs still meet K56-P2-01.",
        "K55 complete/abort/immutable-object behavior remains source/runtime unchanged and all fixed source pins bind the resulting candidate."
      ]
    }
  ],

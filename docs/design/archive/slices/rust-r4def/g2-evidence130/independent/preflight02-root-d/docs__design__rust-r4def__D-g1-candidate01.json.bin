  "proposedBusinessValidation": {
    "prepare": [
      "four required duties present",
      "one execution owner equals executionOwnerUserId",
      "sales-owner equals actual current project owner",
      "unique users and unique per-user duties",
      "finance role present if explicitly financeConfirmationRequired",
      "all selected users active",
      "project:write and exact expected project/current source version",
      "no participant is preconfirmed"
    ],
    "participant": [
      "actor identity exclusively from session",
      "only own assigned immutable duties",
      "summary/basis/confirmation version match",
      "one common participant/todo per person",
      "lock and re-read complete current contract/snapshot/plan/actual attachment sources before any confirmation write",
      "source-changed returns 409 source_changed with zero participant/count/todo/audit changes",
      "same-version duplicate idempotent only while complete sources unchanged; stale or source-changed duplicate conflict",
      "no early finalization"
    ],
    "final": [
      "all actual distinct people confirmed",
      "exact all-duties set",
      "source/basis/summary versions match",
      "prepared receipt mode selected and valid",
      "required attachment material versions valid",
      "no unclosed effective rebaseline",
      "freeze and audit in same outer transaction",
      "no execution bypass"
    ],
    "money": [
      "two decimals exact, no silent DB rounding",
      "each contract independent",
      "no project quote hard total or automatic allocation",
      "sum by currency only"
    ],
    "historicalSources": [
      "trace from current active snapshot to its then-approved preparation/review/readiness/plan",
      "do not require historical source still is_current",
      "new pending amendment preserves old effective facts"
    ],
    "safeSourceSummaries": [
      "BasisItem.summary constant template only: registered type, UUID, canonical version/status",
      "no raw cost/risk/finance/labor payload, rates, hours or free explanation",
      "affected items and generated blockers/impact summaries use same safe policy",
      "detailed actual materials remain behind field-package projection"
    ]
  },
  "controlledAmendment": {
    "publicOperationCountIncrease": 0,
    "routeReuse": [
      {
        "method": "POST",
        "path": "/api/approval-records/{id}:approve",
        "operationId": "ApprovalController_approveRecord"
      },
      {
        "method": "POST",
        "path": "/api/approval-records/{id}:reject",
        "operationId": "ApprovalController_rejectRecord"
      },
      {
        "method": "POST",
        "path": "/api/contracts/{id}:submitReview",
        "operationId": "ContractController_submitReview"
      },
      {
        "method": "POST",
        "path": "/api/contracts/{id}:activate",
        "operationId": "ContractController_activate"
      },
      {
        "method": "POST",
        "path": "/api/contract-readiness-packages",
        "operationId": "ContractReadinessController_createContractReadinessPackage"
      },
      {
        "method": "POST",
        "path": "/api/contract-readiness-packages/{id}:initializeContractSnapshot",
        "operationId": "ContractReadinessController_initializeContractSnapshot"
      },
      {
        "method": "POST",
        "path": "/api/contract-readiness-packages/{id}:initializeReceivablePlan",
        "operationId": "ContractReadinessController_initializeReceivablePlan"
      }
    ],
    "formalDraftRoutesNotImplemented": [
      "POST /contract-amendments/{id}:submit",
      "POST /contract-amendments/{id}:activate"
    ],
    "formalDocumentsMustReflectReuse": [
      "docs/design/interface-command-design.md",
      "docs/design/interface-openapi-dto-design.md"
    ],
    "statuses": [
      "draft",
      "submitted",
      "approved",
      "effective",
      "superseded",
      "voided"
    ],
    "rejectMeaning": "void amendment, keep original contract active; preserve original exact approval history",
    "activation": [
      "exact amendment/preparation/approval/source-snapshot/hash binding",
      "contract remains Active while reviewing",
      "new independent candidate amount need not equal old signedAmount",
      "new snapshot version+1 and old snapshot status superseded atomically",
      "new plan/nodes/init record via same-session internal producer in same activation transaction",
      "old activated preparation remains status activated while is_current may become false",
      "old receivable nodes/receipt references retained",
      "old pending handover material becomes source-changed after switch"
    ]
  },
  "schemaCandidate": {
    "file": "docs/design/rust-r4def/D-schema-candidate01.sql",
    "rawBytesSha256": "92177258692cca42130a39491ef335358a5d31670806028443662b62bbe6a926",
    "executed": false,
    "sourceScalePolicy": "legacy producer_version NULL remains uncertified; no fake backfill",
    "tablesAdded": [
      "project_handover_basis_snapshot",
      "project_handover_contract_basis",
      "project_handover_basis_item",
      "project_handover_summary_payload",
      "project_handover_participant_role"
    ],
    "summaryDefinitions": {
      "registration": "versioned domain migration, not test-only r4_summary_producer or seed prerequisite",
      "scenario": "handover-confirmation",
      "packages": [
        "contract-handover-confirmation",
        "project-handover-confirmation"
      ],
      "projection": "handover-confirmation",
      "exportPolicy": "handover-controlled",
      "fieldRuleVersion": "r4d-v1"
    },
    "aggregateBasis": "new basis ID covers all members; old term snapshot FK is compatibility anchor only",
    "compatibilityAnchor": "initial: lowest contract UUID; rebaseline: exact amendment after snapshot"
  },
  "transactionProtocol": {
    "source": "docs/design/rust-r4def/protocol01.md",
    "externalOwner": "Root execution_support::http",
    "signature": "execute(&mut CommonSession, operation_id, id:Option<Uuid>, query:&Value, body:&Value, actor:&Actor) -> Result<Value, Error>",
    "oneOuterTransaction": true,
    "noAdditionalPoolConnection": true,
    "noSwallowedRequiredFailure": true,
    "audit": "contract_support::audit; actual actor/request/project/source IDs/hash/status/version",
    "lockOrder": [
      "all affected project UUIDs ascending",
      "contract IDs ascending",
      "preparation/readiness/snapshot/plan sources",
      "handover/basis/rebaseline/freeze",
      "confirmation/participants"
    ],
    "securityProjection": "same-session actual actor and necessary security audit; no fabricated sensitive permission"
  },
  "downstreamF": {
    "signature": "load_handover_facts_in_session(session, project_id, as_of?)",
    "fields": [
      "handoverId",
      "projectId",
      "status",
      "confirmedAt",
      "confirmedBy",
      "contractSummarySnapshotId",
      "handoverSummarySnapshotId",
      "effectiveHandoverBaselineSnapshotId",
      "handoverBasisSnapshotId",
      "handoverRebaselineRecordId",
      "sourcePayloadHash",
      "contractMembers"
    ],
    "noInventedStageIntervals": true,
    "precontractCostDoesNotRequireHandover": true
  },
  "attachments": {
    "initialPreparation": "same-session read of actual attachment sources; no persisted R2 selection prerequisite",
    "materialFingerprint": [
      "attachment version UUID",
      "content hash",
      "effective/security state",
      "inclusion/exclusion meaning"
    ],
    "excludedFromFingerprint": [
      "selection ID",
      "selection rowVersion/updatedAt",
      "automatic handover link ID",
      "duplicate sourceRef"
    ],
    "regeneration": "preserve actual manually included material across new handover IDs; changed facts require new confirmation",
    "r2Consumption": "actual D-produced handover ID through existing real R2 checklist/refresh/package/download",
    "noIndependentK5TransactionInD": true
  },
  "currentUI": {
    "file": "apps/poms-admin/src/app/features/project/project-contract-handover.ts",
    "observedStatic": "read views plus real R2 attachment scan/package/download; no prepare/self-confirm/final-confirm controls",
    "requiredAdditions": [
      "available user picker and explicit per-user duties",
      "source version and receipt mode",
      "own confirmation only",
      "explicit final confirmation",
      "real controlled amendment and rebaseline",
      "R5 freeze pending presentation",
      "no stale response overwrite on project change"
    ],
    "runtimeVerified": false
  },
  "verificationScenarios": [
    {
      "id": "D-V01",
      "scenario": "完整 spec/canonical/current AST 5操作和新增候选路由独立登记、无重复HTTP计数",
      "requiredEvidence": "固定源SHA、生成diff、operationId/method/path/权限/status对齐",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V02",
      "scenario": "从真实R3/R4ABC生产两份独立金额合同、精确审核、active snapshot、正式plans，再准备移交",
      "requiredEvidence": "HTTP/DB来源链，禁止种入D draft或confirmed参与人；合同总额无需等于项目报价",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V03",
      "scenario": "任一合同未基线批准、无snapshot、plan不匹配、source hash变化",
      "requiredEvidence": "项目汇总blocked且定位具体contract，零准备/确认副作用",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V04",
      "scenario": "明确执行/销售/商务/售前和条件财务职责；无效用户/缺角色/未授权指派",
      "requiredEvidence": "真实用户/职责映射，明确400/403及零副作用",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V05",
      "scenario": "不同真实会话逐一自确认，冒充userId/全名单代确认、非参与人、重复确认",
      "requiredEvidence": "本人变更/本人todo，403/409，counts准确",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V06",
      "scenario": "最后一人已同意但材料版本过期/旧summary/未完成再基线化",
      "requiredEvidence": "不终结；旧同意不自动继承新材料",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V07",
      "scenario": "最终确认完整链及回款模式freeze；缺模式、未知模式、current freeze冲突",
      "requiredEvidence": "真实confirmed记录/freeze/audit同链；失败整体回滚",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V08",
      "scenario": "没有R5角色冻结时移交事实已确认、execution仍blocked",
      "requiredEvidence": "UI/GET明确“待提成角色冻结”；无execution推进/最终closure宣称",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V09",
      "scenario": "真正合同变更准备/审核/激活→版本化plan→移交前rebaseline→各人重新确认",
      "requiredEvidence": "amendment精确before/after、impact真实项、旧链历史保持",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V10",
      "scenario": "amendment非effective/不当前/不同合同或项目/目标不是该变更snapshot/随机affectedUUID",
      "requiredEvidence": "400/404/409，链不切换",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V11",
      "scenario": "prepare/final/self-confirm/rebaseline分别并发和互竞",
      "requiredEvidence": "一赢家、唯一current、无重复count/freeze/impact；完整原始事务证据",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V12",
      "scenario": "在summary、payload、participant、todo、freeze、impact、audit、auth flush每个必需写处注入失败",
      "requiredEvidence": "原始前后DB对比、全部业务及相关common写回滚、无200",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V13",
      "scenario": "by-project current与by-id历史；源合同后来变更或新增",
      "requiredEvidence": "历史payload不漂移，当前source-changed/新版本可解释",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V14",
      "scenario": "敏感字段允许/遮罩/拒绝；必要security audit写失败",
      "requiredEvidence": "无金融原值泄漏，真实actor+同事务audit失败即500",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V15",
      "scenario": "D真实handover经R2真实文件checklist/refresh/package/download",
      "requiredEvidence": "字节hash、manifest、版本/security/expiry及错误路径；不只测read adapter",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V16",
      "scenario": "F按confirmedAt读取历史移交facts；签约前成本/无R5冻结",
      "requiredEvidence": "无假阶段区间、无循环依赖、不把confirmed等同execution",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V17",
      "scenario": "浏览器完成准备→各人确认→终结→显示R5pending；stale/denied/失败重试",
      "requiredEvidence": "真实UI网络/结果，按钮按allowedActions和身份，页面不能伪造成功",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V18",
      "scenario": "schema迁移/entity/contract一致；旧不完整seed/行识别",
      "requiredEvidence": "SQL-first、约束/复合归属、既有drift分类，无随机回填",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V19",
      "scenario": "Active变更待审/拒绝、激活中snapshot/plan/audit故障、新plan公开精确重试",
      "requiredEvidence": "旧Active事实持续有效；失败整链回滚；无重复plan/nodes；真实R2审核绑定",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V20",
      "scenario": "GET选择集与source hash：project:write可选active名字，只读者/缺权限/无效用户",
      "requiredEvidence": "不手输UUID，不扩平台管理权限，无敏感用户字段，prepare可由公开GET完成",
      "result": "not-run-G1-design-only"
    },
    {
      "id": "D-V21",
      "scenario": "参与人确认前合同/计划/附件真实来源变化，以及已确认者同版本重试但来源已变",
      "requiredEvidence": "self-confirm返回409 source_changed；participant/count/todo/audit均不写；安全basis摘要无source payload金融/风险/人工原文",
      "result": "not-run-G1-design-only"
    }
  ],

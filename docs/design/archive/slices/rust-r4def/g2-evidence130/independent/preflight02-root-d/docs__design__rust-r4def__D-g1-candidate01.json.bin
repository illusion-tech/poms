  "acceptedDecisions": {
    "kind": "R4-next-batch-explicit-user-decisions",
    "date": "2026-11-04",
    "source": "Current chat explicit question replies; not inferred from the Node implementation",
    "decisions": [
      {
        "topic": "operable-handover-and-amendment-scope",
        "answer": "补齐真实闭环并重核本批范围（推荐）",
        "meaning": "Add necessary public preparation, real participant confirmation and controlled contract amendment capabilities with a minimal usable UI; re-count the actual batch surface."
      },
      {
        "topic": "participant-responsibility-and-execution-admission",
        "answer": "按上述职责确认与执行准入规则（推荐）",
        "meaning": "Preparation explicitly assigns duties; one user may hold several duties, but authenticated participants confirm only their own duties. Handover facts do not bypass the R5 effective commission role freeze required for execution admission."
      },
      {
        "topic": "cost-money-and-allocation-precision",
        "answer": "采用上述精度和整批分摊规则（推荐）",
        "meaning": "Expense and ledger amounts use two decimals; rates retain four, hours/person-days two. Exact labor multiplication uses explicit HALF_UP to cents. Exact-weight allocation assigns deterministic residual cents, preserves the batch total and uses complete atomic batch replacement. Historical excess-scale amounts are not silently rewritten."
      }
    ],
    "G1Certified": false,
    "runtimeExecuted": false
  },
  "selectedProductClosure": {
    "option": 2,
    "preparationRoute": "POST /api/projects/{projectId}/project-handovers",
    "participantRoute": "POST /api/project-handovers/{id}/participant-confirmations",
    "independentDuties": true,

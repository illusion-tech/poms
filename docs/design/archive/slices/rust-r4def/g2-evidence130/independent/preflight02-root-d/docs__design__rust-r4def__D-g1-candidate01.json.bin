    "schemas": {
      "CommercialDiffLevel": {
        "type": "string",
        "enum": [
          "prompt",
          "review-required",
          "reapproval-required"
        ]
      },
      "CommercialDiffReviewStatus": {
        "type": "string",
        "enum": [
          "not-required",
          "pending-review",
          "approved",
          "rejected"
        ]
      },
      "ConfirmProjectHandoverParticipantConfirmationInput": {
        "type": "object",
        "properties": {
          "participantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"

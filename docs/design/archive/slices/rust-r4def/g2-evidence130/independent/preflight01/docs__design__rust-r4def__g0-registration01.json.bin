  "children": [
    {
      "key": "D",
      "number": 107,
      "id": 6190136983,
      "title": "[RUST-R4D] 移交五入口与回款判断冻结真实机制",
      "url": "https://github.com/illusion-tech/poms/issues/107",
      "scope": "5入口：合同承接摘要、项目最新/指定移交详情、确认、再基线化；补齐真实移交准备/参与人确认/摘要与回款判断冻结，验收R2附件真实消费。复核与R5角色冻结边界，不能将回款判断冻结当提成冻结或制造循环依赖。"
    },
    {
      "key": "E",
      "number": 108,
      "id": 6190138354,
      "title": "[RUST-R4E] 实际成本与费用基础十一入口",
      "url": "https://github.com/illusion-tech/poms/issues/108",
      "scope": "11入口：费率版本、统一多来源实际成本登记/列表/详情/人力替换、费用列表/详情/创建/修改/确认/作废；冻结真实payment/invoice/expense/procurement/labor来源、计入范围、映射唯一、版本链和精度，向F输出可依赖真实成本。"
    },
    {
      "key": "F",
      "number": 109,
      "id": 6190139855,
      "title": "[RUST-R4F] 分摊阶段归属税务十二入口",
      "url": "https://github.com/illusion-tech/poms/issues/109",
      "scope": "12入口：共享成本分摊4、阶段归属4、税务处理4。冻结跨项目权重/金额守恒/舍入/币种、真实来源和阶段证据、锁定/替换/重分类链、必要同事务审计。最终验收消费E真实成本，适用场景消费D事实。"
    }
  ],

const equivalentChecks = [];
function findPair(table, name) {
  const dropped = owner.find((p) => p.sql === `alter table "poms"."${table}" drop constraint "${name}";`);
  const added = owner.find((p) => p.sql.startsWith(`alter table "poms"."${table}" add constraint "${name}" check (`));
  assert(dropped && added); const expr = / check \((.*)\);$/.exec(added.sql)[1]; const cat = lookup(table, name); assert.equal(cat.contype, 'c');
  return { dropped, added, expr, cat };
}
for (const [table, name] of enumChecks) {
  const { dropped, added, expr, cat } = findPair(table, name);
  const actualExpr = /^CHECK\s*\(([\s\S]*)\)$/.exec(cat.definition)[1];
  assert.equal(stripOuter(expr), stripOuter(actualExpr), `${name}: not only redundant outer parentheses`);
  const detail = { table, constraintName: name, actual: cat.definition, proposed: added.sql, definitionSha256: sha(Buffer.from(cat.definition)), classification: 'tool-noise-exact-redundant-parentheses-CHECK', proof: 'Removing only balanced whole-expression outer parentheses yields byte-equal inner expressions; literals/casts/operators/order/null semantics unchanged.', statements: [dropped, added] };
  equivalentChecks.push(detail); for (const s of [dropped, added]) Object.assign(s, { classification: detail.classification, table, constraintName: name });
}
const ratioChecks = [];

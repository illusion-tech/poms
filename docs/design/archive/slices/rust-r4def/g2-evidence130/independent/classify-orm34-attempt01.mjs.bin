const priorUp = /override async up\(\): Promise<void> \{\s*this\.addSql\(String\.raw`([\s\S]*?)`\);/.exec(priorMigration)[1];
const newDDL = text('docs/design/rust-r4def/joint-g1-06/schema06.sql');
const compact = (value) => value.toLowerCase().replace(/\s+/g, '');

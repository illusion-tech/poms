const newNames = new Set(newFkList.constraints.map((p) => p.constraintName));
assert(oldNames.every((name) => !newNames.has(name)));
function lookup(table, constraint) {
  const n = nativeCatalog.constraints.find((p) => p.table_name === table && p.conname === constraint);
  const r = rustCatalog.constraints.find((p) => p.table_name === table && p.conname === constraint);
  assert(n && r, `${table}.${constraint}: catalog missing`);
  assert.equal(n.definition, r.definition, `${constraint}: Rust/Native catalog mismatch`);
  assert.equal(n.condeferrable, r.condeferrable); assert.equal(n.condeferred, r.condeferred);
  assert(n.convalidated && r.convalidated, `${constraint}: unvalidated`); return n;
}
const ownerFile = `${flowDir}/owner-schema-dump-stdout-redacted.txt`;
const appFile = `${flowDir}/app-schema-dump-stdout-redacted.txt`;
function statements(file) {
  const lines = text(file).split(/\r?\n/), result = [];
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim(); if (!line) continue;
    if (/^(set |alter |drop |create )/.test(line)) { assert(line.endsWith(';')); result.push({ file, line: i + 1, sql: line }); }
    else assert(line.startsWith('◇ injected env '), `Unexpected unparsed SQL at ${file}:${i + 1}`);
  }
  return result;
}
const owner = statements(ownerFile), app = statements(appFile);
assert.equal(owner.length, 67); assert.equal(app.length, 309);
const finiteFK = [];
for (const statement of owner) {
  const m = /^alter table "poms"\."([^"]+)" drop constraint "([^"]+)";$/.exec(statement.sql);
  if (!m || (!oldNames.includes(m[2]) && !newNames.has(m[2]))) continue;
  const table = m[1], constraintName = m[2], cat = lookup(table, constraintName); assert.equal(cat.contype, 'f');
  const sourceClass = oldNames.includes(constraintName) ? 'existing-r4abc-finite-SQL-owned-composite-FK' : 'new-r4def-finite-SQL-owned-composite-FK';
  const source = oldNames.includes(constraintName) ? priorUp : newDDL;
  assert(compact(source).includes(compact(`CONSTRAINT ${constraintName} ${cat.definition}`)), `${constraintName}: catalog not equal frozen migration definition`);
  if (newNames.has(constraintName)) {
    const proposed = newFkList.constraints.find((p) => p.constraintName === constraintName);
    assert.equal(proposed.table, table); assert.equal(proposed.definition, cat.definition);
    assert.equal(proposed.definitionSha256, sha(Buffer.from(cat.definition)));
    assert.equal(proposed.condeferrable, cat.condeferrable); assert.equal(proposed.condeferred, cat.condeferred);
  }
  const classification = { table, constraintName, definition: cat.definition, definitionSha256: sha(Buffer.from(cat.definition)), convalidated: cat.convalidated, condeferrable: cat.condeferrable, condeferred: cat.condeferred, sourceClass, classification: 'accepted-db-specific-difference-for-this-exact-constraint-only', statement };
  finiteFK.push(classification); Object.assign(statement, { classification: classification.classification, constraintName, table, detailRef: `finiteFK.${constraintName}` });
}
assert.equal(finiteFK.length, 44); assert.equal(finiteFK.filter((p) => p.sourceClass.startsWith('existing')).length, 16); assert.equal(finiteFK.filter((p) => p.sourceClass.startsWith('new-')).length, 28);
assert([...newNames, ...oldNames].every((name) => finiteFK.filter((p) => p.constraintName === name).length === 1));
function stripOuter(value) {
  let s = value.trim();
  for (;;) {
    if (!s.startsWith('(') || !s.endsWith(')')) return s;
    let level = 0, quote = null, full = true;
    for (let i = 0; i < s.length; i++) {
      const c = s[i];
      if (quote) { if (c === quote) { if (s[i + 1] === quote) i++; else quote = null; } continue; }
      if (c === "'" || c === '"') quote = c;
      else if (c === '(') level++;
      else if (c === ')') { level--; if (level === 0 && i < s.length - 1) full = false; }
      assert(level >= 0);
    }
    assert.equal(level, 0); if (!full) return s; s = s.slice(1, -1).trim();
  }
}

  const { dropped, added, expr, cat } = findPair(table, name);
  assert.equal(expr, `"${column}" between 0 and 1`);
  assert.equal(cat.definition, `CHECK (((${column} >= (0)::numeric) AND (${column} <= (1)::numeric)))`);
  const oldSource = priorUp.replace(/\s+/g, ' '); assert(oldSource.includes(`${column} numeric(5,4) NOT NULL CHECK (${column} BETWEEN 0 AND 1)`));
  const detail = { table, constraintName: name, actual: cat.definition, proposed: added.sql, classification: 'existing-tool-noise-BETWEEN-numeric-deparse', proof: 'Exact numeric column and same inclusive bounds 0/1; PostgreSQL BETWEEN expands to >=0 AND <=1; both preserve SQL NULL check result. Same three finite names as prior orm-classify27.', statements: [dropped, added] };
  ratioChecks.push(detail); for (const s of [dropped, added]) Object.assign(s, { classification: detail.classification, table, constraintName: name });
}

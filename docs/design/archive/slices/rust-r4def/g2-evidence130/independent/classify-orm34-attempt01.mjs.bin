const nativeCatalog = json('tmp/rust-r4def/root/catalog25/native-catalog.json');
const rustCatalog = json('tmp/rust-r4def/root/catalog25/rust-catalog.json');
const newFkList = json('tools/rust-r4def/F/orm-mapping28/sql-only-fks28.json');
assert.equal(newFkList.constraints.length, 28);

      ],
      "reviewedFileHash": "bc8602037865a94b148a4fb7629d30890c8d4ca78c9d44efd1be30f1d6b5f2f6",
      "title": "Contract snapshot evidence bypasses exact-decimal text capture",
      "trigger": "Use a real same-project contract-term-snapshot as stage/tax source evidence whose numeric(18,2) values contain high-value residual cents",
      "cause": "The contract snapshot branch selects to_jsonb(t) without text overrides for amount_tax_inclusive/exclusive or ratios, then SQLx decodes into serde_json::Value before immutable payload/hash. Other financial branches explicitly stringify decimal columns. The pinned serde_json configuration has raw_value, not arbitrary_precision; cached number/de parser sources show the non-arbitrary decimal f64 channel.",
      "impact": "Frozen source evidence can contain rounded financial numbers instead of the exact persisted snapshot; its resulting hash attests the rounded copy. Operational stage logic may not consume those amounts, but the claimed source snapshot is no longer exact.",
      "requiredCorrection": "Prefer a typed stage-reference allowlist containing exact identity/version/status/effective date/preparation currency proof, excluding unrelated financial numbers; alternatively cast every retained decimal to text. Do not change global serde semantics to paper over this local source boundary.",
      "requiredEvidence": "Actual PG source snapshot with a valid large18,2 value such as9999999999999999.99 and differing one-cent witnesses; copied/hash/replayed fields remain exact text or are intentionally absent from the typed stage reference.",
      "repairState": "Root acknowledged and assigned controlled F correction25; new bytes/runtime not reviewed in this22 snapshot"
    }
  ],
  "knownRequiredRepairs": [
    {
      "id": "EF22-KNOWN-PROGRESS",
      "notCountedAsNewBusinessFinding": true,
      "source": "Root technical update during this review",
      "description": "E03/current snapshot uses paid whereas authoritative C uses completed, and prior proof allowed version/status progress without a real increase. Root is replacing this with canonical completed plus real confirmed net payment total and strict version+total progress; C CAS increments even partial->partial.",
      "propagation": "F evidence.rs489-495 direct payable reference and633-667 pure vectors also use paid, so update them too; these paths are not all E helper calls.",

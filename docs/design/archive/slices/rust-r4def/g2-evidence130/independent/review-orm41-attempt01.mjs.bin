 finiteForeignKeyClassification:{existingCount:16,newCount:28,total:44,allDefinitionHashesValidatedAndDeferralsRechecked:true,constraints:old.finiteFK.constraints,acceptanceLimit:old.finiteFK.limits,noPrefixOrBlanketIgnore:true},

assert.equal(owner.length,65);assert.equal(app.length,308);
const generatedDDL=/^alter table "poms"\."project_actual_cost_record" (?:drop column "labor_scope_key"|add "labor_scope_key")/;
assert(!owner.some(p=>generatedDDL.test(p.sql)));assert(!app.some(p=>generatedDDL.test(p.sql)));

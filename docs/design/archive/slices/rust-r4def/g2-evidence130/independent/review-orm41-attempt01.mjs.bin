assert.deepEqual(app.map(p=>p.sql),withoutGenerated(old.appDDL.statements).map(p=>p.sql));
for(const[suffix,rows]of[['ownerDDL',owner],['appDDL',app]])for(const s of rows){const previous=old[suffix].statements.find(p=>p.sql===s.sql);assert(previous);Object.assign(s,{classification:previous.classification,previous34Line:previous.line});}
for(const c of old.finiteFK.constraints){for(const catalogFile of ['tmp/rust-r4def/root/catalog25/native-catalog.json','tmp/rust-r4def/root/catalog25/rust-catalog.json']){const cat=json(catalogFile).constraints.find(p=>p.table_name===c.table&&p.conname===c.constraintName);assert(cat?.convalidated);assert.equal(sha(Buffer.from(cat.definition)),c.definitionSha256);assert.equal(cat.condeferrable,c.condeferrable);assert.equal(cat.condeferred,c.condeferred);}}
function testSummary(dir){const receipt=json(`${dir}/receipt33.json`);assert.equal(receipt.exitCode,0);const source=text(`${dir}/console-original.bin`),suites=/Test Suites:\s+(\d+) passed, (\d+) total/.exec(source),tests=/Tests:\s+(\d+) passed, (\d+) total/.exec(source);assert(suites&&tests);assert.equal(suites[1],suites[2]);assert.equal(tests[1],tests[2]);return{receipt:capture(`${dir}/receipt33.json`),originalStream:capture(`${dir}/console-original.bin`),args:receipt.args,startedAt:receipt.startedAt,completedAt:receipt.completedAt,exitCode:receipt.exitCode,suitesPassed:Number(suites[1]),suitesTotal:Number(suites[2]),testsPassed:Number(tests[1]),testsTotal:Number(tests[2]),executedBy:'Root original Nx/Jest',independentlyRerun:false};}
const nativeTests=testSummary('tmp/rust-r4def/root/native-test38');assert.equal(nativeTests.suitesPassed,74);assert.equal(nativeTests.testsPassed,863);
const handoverTests=testSummary('tmp/rust-r4def/root/handover-test41');assert.equal(handoverTests.suitesPassed,1);assert.equal(handoverTests.testsPassed,6);
const actions=text('apps/poms-admin/src/app/features/project/project-handover-actions.ts'),ui=text('apps/poms-admin/src/app/features/project/project-contract-handover.ts'),spec=text('apps/poms-admin/src/app/features/project/project-contract-handover.spec.ts');
assert(actions.includes("readonly canManageContracts = computed(() => this.#auth.hasAnyPermission(['project:write']))"));
assert(ui.includes('readonly handoverAttachmentError = signal<string | null>(null)'));
assert(!ui.includes('readonly handoverAttachmentError = this.#workspaceStore.handoverAttachmentError'));
assert(ui.includes('readonly #pendingTasks = inject(PendingTasks)')&&ui.includes('const done = this.#pendingTasks.add()')&&ui.includes('done();'));
assert(spec.includes('ignores an old attachment failure and loading completion after A→B→A navigation'));

for(const cmd of receipt.commands){for(const[stream,e]of Object.entries(cmd.streams)){const file=`tmp/rust-r4def/root/orm-check41/${cmd.principal}-${cmd.mode}-${stream}-redacted.txt`;assert.equal(sha(read(file)),e.publicRedacted.sha256);assert.equal(read(file).length,e.publicRedacted.bytes);}assert.equal(cmd.DDLExecuted,false);assert.equal(cmd.exitCode,cmd.mode==='schema-dump'?0:1);}
function statements(file){return text(file).split(/\r?\n/).flatMap((raw,i)=>{const sql=raw.trim();if(!sql||sql.startsWith('◇ injected env '))return[];assert(/^(set |alter |drop |create |comment )/.test(sql)&&sql.endsWith(';'),`${file}:${i+1}: unparsed DDL`);return[{file,line:i+1,sql}];});}
const ownerFile='tmp/rust-r4def/root/orm-check41/owner-schema-dump-stdout-redacted.txt',appFile='tmp/rust-r4def/root/orm-check41/app-schema-dump-stdout-redacted.txt';

const read = (f) => fs.readFileSync(path.join(root, f));
const text = (f) => read(f).toString('utf8');
const json = (f) => JSON.parse(text(f));
const sha = (b) => createHash('sha256').update(b).digest('hex');
const write = (f,b) => {fs.mkdirSync(path.dirname(path.join(root,f)),{recursive:true});fs.writeFileSync(path.join(root,f),b,{flag:'wx'});};
const writeJson = (f,v) => write(f,JSON.stringify(v,null,2)+'\n');
const pins = [];
const capture = (file) => {const prior=pins.find(p=>p.file===file);if(prior)return prior;const b=read(file),snapshot=`${captureRoot}/${file}.bin`;write(snapshot,b);const p={file,bytes:b.length,rawBytesSha256:sha(b),snapshot};pins.push(p);return p;};

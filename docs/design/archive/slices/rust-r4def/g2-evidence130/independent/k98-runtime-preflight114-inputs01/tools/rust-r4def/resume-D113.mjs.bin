// Resume the real 201 preparation ACK. New envelope IDs must differ; content stays.
import fs from'node:fs';import assert from'node:assert/strict';import{createApiHarness}from'./api-harness32.mjs';
const h=createApiHarness(),out=h.win+'/tmp/rust-r4def/root/recovery113';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const actors=JSON.parse(fs.readFileSync(h.priv+'/actors33.json')).actors;
const prior=JSON.parse(fs.readFileSync(h.win+'/tmp/rust-r4def/root/recovery112/failed112.json'));assert.equal(prior.records.length,3);assert.equal(prior.records[2].status,201);const prepared=JSON.parse(fs.readFileSync(h.win+'/'+prior.records[2].receiptId)).responseBody,old=JSON.parse(fs.readFileSync(h.win+'/'+prior.records[0].receiptId)).responseBody;
const source=JSON.parse(fs.readFileSync(h.win+'/tmp/rust-r4def/root/auto-link-noop109/failed109.json')),records=[];
async function call(op,id=null,body=null,key='writer'){const r=await h.request(op,id,body,h.actor(key));records.push({op,status:r.status,receiptId:r.receiptId});assert.equal(r.status,200,r.receiptId);return r.body?.data??r.body;}
try{
 for(const key of ['writer','full','personA'])await h.login(actors[key]);
 let next=await call('ProjectHandoverController_getProjectHandoverDetailByProject',prepared.projectId);assert.equal(next.handoverId,prepared.handoverId);assert.equal(next.participantConfirmationSummary.confirmedCount,0);assert.equal(next.sourceChanged,false);assert.notEqual(next.frozenMaterials.basisSnapshotId,old.frozenMaterials.basisSnapshotId);assert.deepEqual(next.frozenMaterials.contracts,old.frozenMaterials.contracts);
 for(const p of next.participantConfirmationSummary.participants){const key=['full','personA','writer'].find(k=>h.actor(k).id===p.participantId);assert(key);next=await call('ProjectHandoverController_confirmProjectHandoverParticipant',next.handoverId,{summarySnapshotId:next.summarySnapshotId,handoverBasisSnapshotId:next.handoverBasisSnapshotId,expectedConfirmationVersion:next.participantConfirmationSummary.rowVersion,comment:'本人核对新材料版本后重新确认原职责'},key);}
 assert.equal(next.participantConfirmationSummary.confirmedCount,3);
 const final=await call('ProjectHandoverController_confirmProjectHandover',next.handoverId,{participantConfirmations:next.participantConfirmationSummary.participants.flatMap(p=>p.responsibilities.map(r=>({participantId:p.participantId,participantRoleKey:r.roleKey,participantStatus:'confirmed'}))),contractSummarySnapshotId:next.contractSummarySnapshotId,summarySnapshotId:next.summarySnapshotId,handoverBasisSnapshotId:next.handoverBasisSnapshotId,sourcePayloadHash:next.sourcePayloadHash,expectedVersion:next.rowVersion,receiptJudgmentMode:next.receiptJudgmentModeSummary.receiptJudgmentMode});assert.equal(final.businessStatusAfter,'confirmed');assert.equal(final.executionAdmission.allowed,false);
 const checklist=await call('AttachmentHandoverController_refreshChecklist',next.handoverId,{preserveManualExclusions:true,includeHistoricalSelections:true},'full');assert(checklist.items.some(i=>i.attachmentId==='5151e346-59d4-4d3b-8254-ccaae6bd3699'&&i.status==='included'));
 next=await call('ProjectHandoverController_getProjectHandoverDetailByProject',next.projectId);assert.equal(next.handoverStatus,'confirmed');assert.equal(next.sourceChanged,false);assert.equal(next.participantConfirmationSummary.confirmedCount,3);assert.equal(next.executionAdmission.allowed,false);
 const receipt={kind:'actual-effective-K98-auto-Link-four-barriers-and-current-D-recovery113',complete:true,sourceRuntime:'tmp/rust-r4def/root/final-runtime110.json',freshAutoLinkAndAuditProof:'tmp/rust-r4def/root/auto-link-noop109/fresh-auto-link109.json',fourActualBarriers:source.results,allFourEffectivePass:true,preparationACKResumed:prior.records[2].receiptId,preparationNotReplayed:true,previousFailuresRetained:['109: overstrong restore-old-hash assumption','111: helper used wrong request identifier property; 400 and no preparation','112: helper compared new envelope IDs; preparation ACK preserved'],frozenContractContentUnchanged:true,newMaterialEnvelopeIdentityObserved:true,newHandoverId:next.handoverId,newVersion:next.version,freshConfirmations:3,R5AdmissionAllowed:false,records,G3Certified:false,G4Certified:false};fs.writeFileSync(out+'/receipt113.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({complete:true,effectiveBarriers:4,newVersion:next.version,freshConfirmations:3,R5AdmissionAllowed:false}));
}catch(e){fs.writeFileSync(h.priv+'/recovery113-failure.log',e.stack??String(e),{flag:'wx',mode:0o600});fs.writeFileSync(out+'/failed113.json',JSON.stringify({complete:false,errorName:e.name,records,privateFailureRetained:true},null,2)+'\n',{flag:'wx'});console.error(JSON.stringify({complete:false,errorName:e.name,privateFailureRetained:true}));process.exitCode=1;}

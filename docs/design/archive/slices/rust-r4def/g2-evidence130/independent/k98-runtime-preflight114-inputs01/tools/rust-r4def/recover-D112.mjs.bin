// Continue only after the four acknowledged K109 proofs. No upload/void replay.
import fs from'node:fs';import assert from'node:assert/strict';import{createApiHarness}from'./api-harness32.mjs';import{connect}from'./db33.mjs';
const h=createApiHarness(),c=await connect(),actors=JSON.parse(fs.readFileSync(h.priv+'/actors33.json')).actors;
const failed=JSON.parse(fs.readFileSync(h.win+'/tmp/rust-r4def/root/auto-link-noop109/failed109.json')),fresh=JSON.parse(fs.readFileSync(h.win+'/tmp/rust-r4def/root/auto-link-noop109/fresh-auto-link109.json'));assert.equal(failed.results.length,4);assert.deepEqual(failed.results.map(r=>r.status),[200,409,200,409]);
const out=h.win+'/tmp/rust-r4def/root/recovery112';assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const records=[];
async function call(op,id=null,body=null,key='writer',status=200){const r=await h.request(op,id,body,h.actor(key));records.push({op,status:r.status,receiptId:r.receiptId});assert.equal(r.status,status,r.receiptId);return r.body?.data??r.body;}
try{
 for(const key of ['writer','full','personA'])await h.login(actors[key]);
 const rows=(await c.query('SELECT status,is_final,is_latest FROM poms.attachment WHERE id=$1',[failed.attachmentId])).rows;assert.equal(rows.length,1);assert.equal(rows[0].status,'voided');assert.equal(rows[0].is_final,false);
 const old=await call('ProjectHandoverController_getProjectHandoverDetailByProject',fresh.project);assert.equal(old.handoverId,fresh.handoverId);assert.equal(old.sourceChanged,true);assert.equal(old.handoverStatus,'confirmed');
 const summary=await call('ProjectHandoverController_getContractHandoverSummary',fresh.project);const participants=old.participantConfirmationSummary.participants.map(p=>({userId:p.participantId,responsibilities:p.responsibilities}));
 let next=await call('ProjectHandoverController_prepareProjectHandover',fresh.project,{executionOwnerUserId:old.executionOwnerUserId??participants.find(p=>p.responsibilities.some(r=>r.roleKey==='execution-owner')).userId,participants,financeConfirmationRequired:false,receiptJudgmentMode:old.receiptJudgmentModeSummary.receiptJudgmentMode,expectedProjectVersion:summary.projectRowVersion,expectedSourceHash:summary.sourcePayloadHash,expectedCurrentHandoverVersion:old.version,comment:'实际新增并作废材料改变来源事实；重新准备并由各人确认当前材料，不强行复用旧确认'},'writer',201);
 assert.notEqual(next.handoverId,old.handoverId);assert.equal(next.version,old.version+1);assert.equal(next.participantConfirmationSummary.confirmedCount,0);assert.deepEqual(next.frozenMaterials,old.frozenMaterials);
 for(const p of next.participantConfirmationSummary.participants){const key=['full','personA','writer'].find(k=>h.actor(k).id===p.participantId);assert(key);next=await call('ProjectHandoverController_confirmProjectHandoverParticipant',next.handoverId,{summarySnapshotId:next.summarySnapshotId,handoverBasisSnapshotId:next.handoverBasisSnapshotId,expectedConfirmationVersion:next.participantConfirmationSummary.rowVersion,comment:'本人对本次新材料和原职责重新确认'},key);}
 assert.equal(next.participantConfirmationSummary.confirmedCount,3);
 const result=await call('ProjectHandoverController_confirmProjectHandover',next.handoverId,{participantConfirmations:next.participantConfirmationSummary.participants.flatMap(p=>p.responsibilities.map(r=>({participantId:p.participantId,participantRoleKey:r.roleKey,participantStatus:'confirmed'}))),contractSummarySnapshotId:next.contractSummarySnapshotId,summarySnapshotId:next.summarySnapshotId,handoverBasisSnapshotId:next.handoverBasisSnapshotId,sourcePayloadHash:next.sourcePayloadHash,expectedVersion:next.rowVersion,receiptJudgmentMode:next.receiptJudgmentModeSummary.receiptJudgmentMode});assert.equal(result.businessStatusAfter,'confirmed');assert.equal(result.executionAdmission.allowed,false);
 const checklist=await call('AttachmentHandoverController_refreshChecklist',next.handoverId,{preserveManualExclusions:true,includeHistoricalSelections:true},'full');assert(checklist.items.some(i=>i.attachmentId==='5151e346-59d4-4d3b-8254-ccaae6bd3699'&&i.status==='included'));
 next=await call('ProjectHandoverController_getProjectHandoverDetailByProject',fresh.project);assert.equal(next.handoverStatus,'confirmed');assert.equal(next.sourceChanged,false);assert.equal(next.participantConfirmationSummary.confirmedCount,3);assert.equal(next.executionAdmission.allowed,false);
 const receipt={kind:'actual-K98-fresh-Link-and-idempotency-effective-proof-plus-D-recovery112',complete:true,initial109Failure:'Root postcondition incorrectly required a pre-new-material source hash to return after void; actual source history remains changed, requiring fresh preparation',original109FailurePreserved:true,original111Validation400Preserved:true,acknowledgedUploadVoidOrBarriersReplayed:false,freshAutoLinkProof:'tmp/rust-r4def/root/auto-link-noop109/fresh-auto-link109.json',fourActualBarrierProofs:failed.results,allFourEffectivePass:true,newHandoverId:next.handoverId,newVersion:next.version,freshConfirmations:3,R5AdmissionAllowed:false,records,G3Certified:false,G4Certified:false};fs.writeFileSync(out+'/receipt112.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({complete:true,freshAutoLinkAndAudit:true,effectiveBarriers:4,newVersion:next.version,allThreeFreshOwnConfirmations:true,R5AdmissionAllowed:false}));
}catch(e){fs.writeFileSync(h.priv+'/recovery112-failure.log',e.stack??String(e),{flag:'wx',mode:0o600});fs.writeFileSync(out+'/failed112.json',JSON.stringify({complete:false,errorName:e.name,records,privateFailureRetained:true},null,2)+'\n',{flag:'wx'});process.exitCode=1;console.error(JSON.stringify({complete:false,errorName:e.name,privateFailureRetained:true}));}finally{await c.end();}

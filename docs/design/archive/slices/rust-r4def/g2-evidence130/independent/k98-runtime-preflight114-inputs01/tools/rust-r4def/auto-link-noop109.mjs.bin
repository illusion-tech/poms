// Root real fresh auto-Link hydration and four observed idempotency barriers.
import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';
import{createApiHarness}from'./api-harness32.mjs';import{connect}from'./db33.mjs';
const epoch=process.argv[2];assert(/^\d+$/.test(epoch??''));const h=createApiHarness(),c=await connect(),o=await connect();
const dir=h.win+'/tmp/rust-r4def/root/auto-link-noop109',pdir=h.priv+'/auto-link-noop109';assert(!fs.existsSync(dir)&&!fs.existsSync(pdir));fs.mkdirSync(dir,{recursive:true});fs.mkdirSync(pdir,{mode:0o700});
const sha=b=>createHash('sha256').update(b).digest('hex'),actors=JSON.parse(fs.readFileSync(h.priv+'/actors33.json')).actors;
const runtime=JSON.parse(fs.readFileSync(h.priv+'/rust-api'+epoch+'-process.json'));assert.notEqual(epoch,'81');assert.notEqual(epoch,'95');assert.equal(sha(fs.readFileSync('/proc/'+runtime.pid+'/exe')),runtime.binarySha256);
const k=JSON.parse(fs.readFileSync(h.win+'/tools/rust-r4def/F/K98/delivery98.json'));assert.equal(sha(fs.readFileSync(h.root+'/'+k.product.file)),k.product.sourceAfter.rawBytesSha256);
const source=JSON.parse(fs.readFileSync(h.priv+'/continuation40.json')),project=source.context.project.id,contract=source.activeContract.id,category=JSON.parse(fs.readFileSync(h.out+'/attachments52-before.json')).context.attachmentCategory;
const results=[],sessions={};let sequence=0,pending=null,response=null,held=false,attachment,upload,hand;const allContext={epoch,runtime:{pid:runtime.pid,binarySha256:runtime.binarySha256},project,contract};
function save(name,body){const bytes=Buffer.from(JSON.stringify(body,null,2)+'\n');fs.writeFileSync(dir+'/'+name+'.json',bytes,{flag:'wx'});return'tmp/rust-r4def/root/auto-link-noop109/'+name+'.json';}
async function call(op,id=null,body=null,key='noopA109',status=200){const r=await h.request(op,id,body,h.actor(key));assert.equal(r.status,status,r.receiptId);return{...r,value:r.body?.data??r.body};}
async function frame(label){await o.query('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY');let graph;try{graph={attachments:(await o.query('SELECT to_jsonb(t)::text raw FROM poms.attachment t WHERE COALESCE(version_group_id,id)=$1 ORDER BY id',[attachment.versionGroupId])).rows.map(r=>r.raw),links:(await o.query('SELECT to_jsonb(t)::text raw FROM poms.attachment_link t WHERE attachment_id=$1 ORDER BY id',[attachment.id])).rows.map(r=>r.raw),audits:(await o.query('SELECT to_jsonb(t)::text raw FROM poms.audit_log t WHERE target_id=$1 ORDER BY id',[attachment.id])).rows.map(r=>r.raw)};await o.query('COMMIT');}catch(e){await o.query('ROLLBACK');throw e;}const bytes=Buffer.from(JSON.stringify(graph)+'\n'),file=pdir+'/'+label+'.json';fs.writeFileSync(file,bytes,{flag:'wx',mode:0o600});const receiptId=save(label,{kind:'actual-group-and-audit-raw-frame',privateOriginal:{file,bytes:bytes.length,sha256:sha(bytes)},counts:Object.fromEntries(Object.entries(graph).map(([k,v])=>[k,v.length])),group:attachment.versionGroupId});return{graph,receiptId};}
async function waitFor(fn){const deadline=Date.now()+10000;while(Date.now()<deadline){const r=await fn();if(r)return r;if(response)throw new Error('Request settled before actual barrier: '+response.status);await new Promise(r=>setTimeout(r,25));}throw new Error('Actual barrier deadline exceeded');}
async function noopBarrier(label,operation,id,body){
 const before=await frame(label+'-before');pending=null;response=null;await c.query('BEGIN');held=true;
 await c.query('SELECT pg_advisory_xact_lock(hashtextextended($1,0))',['poms:attachment-group:'+attachment.versionGroupId]);const lock=(await c.query("SELECT classid::text,objid::text,objsubid,granted FROM pg_locks WHERE pid=pg_backend_pid() AND locktype='advisory'")).rows;assert.equal(lock.length,1);
 pending=h.request(operation,id,body,h.actor('noopA109')).then(r=>{response=r;return r;});const waiter=await waitFor(async()=>{const rows=(await o.query("SELECT a.pid,a.query,a.wait_event,a.wait_event_type,l.granted FROM pg_locks l JOIN pg_stat_activity a ON a.pid=l.pid WHERE l.locktype='advisory' AND l.classid=$1::oid AND l.objid=$2::oid AND l.objsubid=$3 AND NOT l.granted AND a.datname=current_database() AND a.usename='poms_r4def_rust_app'",[lock[0].classid,lock[0].objid,lock[0].objsubid])).rows;assert(rows.length<=1);return rows[0];});
 const blocked=await frame(label+'-blocked');assert.deepEqual(blocked.graph,before.graph);await c.query('COMMIT');held=false;response=await pending;assert.equal(response.status,200,response.receiptId);const after=await frame(label+'-after');assert.deepEqual(after.graph,before.graph,'No-op must not mutate business rows/version/audit');const result={kind:'actual-no-dirty-canonical-group-barrier',label,waiter,heldBeforeRequest:true,hitProven:true,granted:false,released:true,HTTP:response.receiptId,status:response.status,before:before.receiptId,blocked:blocked.receiptId,after:after.receiptId,businessAndAuditUnchanged:true};save(label+'-receipt',result);results.push(result);pending=null;
}
async function staleBarrier(label,operation,id,body,mutate){
 pending=null;response=null;const before=await frame(label+'-before');await c.query('BEGIN');held=true;const pid=(await c.query('SELECT pg_backend_pid() pid')).rows[0].pid;await c.query('LOCK TABLE poms.contract IN ACCESS EXCLUSIVE MODE');
 pending=h.request(operation,id,body,h.actor('noopA109')).then(r=>{response=r;return r;});const waiter=await waitFor(async()=>{const rows=(await o.query("SELECT pid,query,wait_event,wait_event_type,pg_blocking_pids(pid) blockers FROM pg_stat_activity WHERE datname=current_database() AND usename='poms_r4def_rust_app' AND state='active' AND $1=ANY(pg_blocking_pids(pid)) AND query LIKE '%poms.contract%'",[pid])).rows;assert(rows.length<=1);return rows[0];});
 const mutation=await mutate();assert.equal(mutation.status,200);const changed=await frame(label+'-other-committed');await c.query('ROLLBACK');held=false;response=await pending;assert.equal(response.status,409,response.receiptId);const after=await frame(label+'-after');assert.deepEqual(after.graph,changed.graph,'Stale no-op must leave no business or audit writes');const result={kind:'actual-first-proof-stale-noop-rejection',label,waiter,heldBeforeRequest:true,sourceReadBoundary:'contract target access follows first Attachment/active-set capture; source-pinned K86/K98 implementation',otherMutation:mutation.receiptId,HTTP:response.receiptId,status:409,before:before.receiptId,changed:changed.receiptId,after:after.receiptId,staleRequestAddedNoWrites:true};save(label+'-receipt',result);results.push(result);pending=null;return{before:before.graph,changed:changed.graph};
}
try{
 for(const key of ['noopA109','noopB109']){const before=(await o.query('SELECT id FROM poms.auth_session WHERE user_id=$1',[actors.full.id])).rows.map(r=>r.id);await h.login({...actors.full,key});const added=(await o.query('SELECT id,user_id,status FROM poms.auth_session WHERE user_id=$1',[actors.full.id])).rows.filter(r=>!before.includes(r.id));assert.equal(added.length,1);sessions[key]=added[0];}assert.notEqual(sessions.noopA109.id,sessions.noopB109.id);save('admission109',{...allContext,sessions,onlyRealLoginSessions:true});
 hand=(await call('ProjectHandoverController_getProjectHandoverDetailByProject',project)).value;assert.equal(hand.handoverStatus,'confirmed');assert.equal(hand.sourceChanged,false);const originalSource=(await call('ProjectHandoverController_getContractHandoverSummary',project)).value.sourcePayloadHash;
 const data=Buffer.alloc(64,65),checksum=sha(data);upload=(await call('AttachmentUploadSessionController_create',null,{operationType:'create-attachment',targetType:'project',targetId:project,relationType:'normal',originalName:'R4DEF-fresh-auto-link109.txt',mimeType:'text/plain',sizeBytes:64,checksumSha256:checksum,category,securityLevel:'normal'},'noopA109',201)).value;
 await call('AttachmentUploadSessionController_createUploadTarget',upload.id,{expectedVersion:upload.rowVersion});const put=await h.binaryRequest('AttachmentUploadSessionController_proxyUploadObject',upload.id,new Uint8Array(data),h.actor('noopA109'));assert.equal(put.status,200);attachment=(await call('AttachmentUploadSessionController_complete',upload.id,{expectedVersion:put.body.rowVersion,checksumSha256:checksum})).value;
 await call('AttachmentController_link',attachment.id,{targetType:'project',targetId:project,relationType:'source'});await call('AttachmentController_link',attachment.id,{targetType:'contract',targetId:contract,relationType:'evidence'});attachment=(await call('AttachmentController_markFinal',attachment.id,{note:'Root actual fresh auto-Link and no-op acceptance'})).value;
 const beforeNew=(await o.query("SELECT id FROM poms.attachment_link WHERE attachment_id=$1 AND target_type='project-handover' AND target_id=$2",[attachment.id,hand.handoverId])).rows;assert.equal(beforeNew.length,0);
 const sourceBeforeRefresh=(await call('ProjectHandoverController_getContractHandoverSummary',project)).value.sourcePayloadHash;assert.notEqual(sourceBeforeRefresh,originalSource);
 const refreshed=await call('AttachmentHandoverController_refreshChecklist',hand.handoverId,{preserveManualExclusions:true,includeHistoricalSelections:true});assert(refreshed.value.items.some(r=>r.attachmentId===attachment.id&&r.status==='included'));
 const auto=(await o.query("SELECT to_jsonb(t) value FROM poms.attachment_link t WHERE attachment_id=$1 AND target_type='project-handover' AND target_id=$2 AND status='active'",[attachment.id,hand.handoverId])).rows;assert.equal(auto.length,1);for(const k of ['id','attachment_id','target_type','target_id','relation_type','status','linked_by','linked_at','unlinked_by','unlinked_at'])assert(Object.hasOwn(auto[0].value,k));assert.equal(auto[0].value.unlinked_by,null);assert.equal(auto[0].value.unlinked_at,null);
 const audit=(await o.query("SELECT id,event_type,target_id,request_id,result FROM poms.audit_log WHERE target_id=$1 AND event_type='attachment.handover_checklist_refreshed' AND request_id=$2",[hand.handoverId,refreshed.requestId])).rows;assert.equal(audit.length,1);assert.equal(audit[0].result,'success');assert.equal((await call('ProjectHandoverController_getContractHandoverSummary',project)).value.sourcePayloadHash,sourceBeforeRefresh);
 save('fresh-auto-link109',{...allContext,attachmentId:attachment.id,sessionId:upload.id,handoverId:hand.handoverId,refreshHTTP:refreshed.receiptId,actualCompleteLink:auto[0].value,necessaryAudit:audit[0],newAutoLinkCreated:true,metadataRefreshDidNotAlterMaterialHash:true});
 await noopBarrier('repeated-link','AttachmentController_link',attachment.id,{targetType:'project',targetId:project,relationType:'source'});
 const links=(await call('AttachmentController_get',attachment.id)).value.links,normal=links.find(l=>l.targetType==='project'&&l.targetId===project&&l.relationType==='normal'&&l.status==='active'),contractLink=links.find(l=>l.targetType==='contract'&&l.targetId===contract&&l.relationType==='evidence'&&l.status==='active');assert(normal?.id&&contractLink?.id);
 const setChange=await staleBarrier('repeated-link-active-set-changed','AttachmentController_link',attachment.id,{targetType:'contract',targetId:contract,relationType:'evidence'},()=>call('AttachmentController_unlink',{id:attachment.id,linkId:normal.id},null,'noopB109'));assert.deepEqual(setChange.before.attachments,setChange.changed.attachments,'Nonversioned Link set changes without Attachment row version change');
 await call('AttachmentController_unlink',{id:attachment.id,linkId:contractLink.id});
 await noopBarrier('inactive-unlink','AttachmentController_unlink',{id:attachment.id,linkId:contractLink.id},null);
 await staleBarrier('inactive-unlink-attachment-changed','AttachmentController_unlink',{id:attachment.id,linkId:contractLink.id},null,()=>call('AttachmentController_update',attachment.id,{displayName:'R4DEF109真实另一会话修改名称'},'noopB109'));
 await call('AttachmentController_void',attachment.id,{reason:'Root acceptance finished; withdraw only the newly created fixture final'});assert.equal((await call('ProjectHandoverController_getContractHandoverSummary',project)).value.sourcePayloadHash,originalSource);const final=(await call('ProjectHandoverController_getProjectHandoverDetailByProject',project)).value;assert.equal(final.handoverId,hand.handoverId);assert.equal(final.handoverStatus,'confirmed');assert.equal(final.sourceChanged,false);assert.equal(final.participantConfirmationSummary.confirmedCount,3);assert.equal(final.executionAdmission.allowed,false);
 save('result109',{kind:'actual-fresh-auto-Link-and-four-idempotency-barriers',complete:true,...allContext,attachmentId:attachment.id,newFixtureVoided:true,currentConfirmedDAndR5BoundaryPreserved:true,results,SQLBusinessProducers:0,temporaryLocksReleased:true,G3Certified:false,G4Certified:false});console.log(JSON.stringify({complete:true,newAutoLinkAndAudit:true,barriers:results.length,actualNoopGroupWaiters:2,staleNoop409:2}));
}catch(e){fs.writeFileSync(pdir+'/failure.log',e.stack??String(e),{flag:'wx',mode:0o600});save('failed109',{complete:false,errorName:e.name,results,attachmentId:attachment?.id,uploadSessionId:upload?.id,privateFailureRetained:true});console.error(JSON.stringify({complete:false,errorName:e.name,privateFailureRetained:true}));process.exitCode=1;}
finally{if(held)await c.query('ROLLBACK');if(pending&&!response)await pending;await c.end();await o.end();}

  "verifiedSourceBehavior": [
    {
      "file": "apps/poms-api-rust/src/attachments/store.rs",
      "line": 563,
      "behavior": "Single Link INSERT returns actual to_jsonb(attachment_link), including generated UUID and actual default NULL columns."
    },
    {
      "file": "apps/poms-api-rust/src/attachments/store.rs",
      "line": 882,
      "behavior": "Grouped Link INSERT returns complete tuples and feeds the same hydration helper; non-Link scheduling/return behavior is unchanged."
    },
    {
      "file": "apps/poms-api-rust/src/attachments/store.rs",
      "line": 586,
      "behavior": "Hydration requires expected row count, all ten Link columns, valid unique real UUIDs. Explicit planned UUID is matched by real identity. Generated identity is correlated uniquely against assigned INSERT fields, not result position."
    },
    {
      "file": "apps/poms-api-rust/src/attachments/store.rs",
      "line": 621,
      "behavior": "Sparse-row matching projects only to assigned fields for result association, with existing timestamp semantic comparison. Subsequent committed-row guard continues full-field comparison; absent is never synthesized as NULL."
    },
    {
      "file": "apps/poms-api-rust/src/attachments/store.rs",
      "line": 650,
      "behavior": "Full actual row replaces only saved-journal data; original stays None. Actual ID row is consumed once; duplicate/missing/ambiguous/mismatched returned identities fail the transaction."
    },
    {
      "file": "apps/poms-api-rust/src/attachments/store.rs",
      "line": 1785,
      "behavior": "Only after successful COMMIT ACK is mark_committed applied to the saved journal. Failure/unknown paths keep the existing checkpoint/poison/retain rules."
    },
    {
      "file": "apps/poms-api-rust/src/attachments/store.rs",
      "line": 1670,
      "behavior": "Strict clean-Link full tuple and first-source checks, canonical group ordering, no-dirty FlushGuard.has_intent and managed auth are preserved."
    }
  ],

{
  "openapi": "3.0.0",
  "paths": {
    "/api/project-handovers/{id}/attachment-checklist": {
      "get": {
        "operationId": "AttachmentHandoverController_getChecklist",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectHandoverAttachmentChecklistView"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "获取项目移交附件清单",
        "tags": [
          "Attachment Handover"
        ]
      }
    },
    "/api/project-handovers/{id}/attachment-checklist:refresh": {
      "post": {
        "operationId": "AttachmentHandoverController_refreshChecklist",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshProjectHandoverAttachmentChecklistRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectHandoverAttachmentChecklistView"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "刷新项目移交附件清单",
        "tags": [
          "Attachment Handover"
        ]
      }
    },
    "/api/project-handovers/{id}/attachment-download-packages": {
      "post": {
        "operationId": "AttachmentHandoverController_createDownloadPackage",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectHandoverAttachmentDownloadPackageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentDownloadPackageSummary"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "创建项目移交附件批量下载包",
        "tags": [
          "Attachment Handover"
        ]
      }
    },
    "/api/attachment-download-packages/{id}": {
      "get": {
        "operationId": "AttachmentHandoverController_getDownloadPackage",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentDownloadPackageSummary"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "获取附件下载包状态",
        "tags": [
          "Attachment Handover"
        ]
      }
    },
    "/api/attachment-download-packages/{id}/download": {
      "get": {
        "operationId": "AttachmentHandoverController_downloadPackage",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "下载附件批量包",
        "tags": [
          "Attachment Handover"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProjectHandoverAttachmentChecklistView": {
        "type": "object",
        "properties": {
          "handoverId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "counts": {
            "$ref": "#/components/schemas/ProjectHandoverAttachmentChecklistCounts"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectHandoverAttachmentChecklistItem"
            }
          }
        },
        "required": [
          "handoverId",
          "projectId",
          "generatedAt",
          "counts",
          "items"
        ]
      },
      "ProjectHandoverAttachmentChecklistCounts": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "included": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "missing": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "excluded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sensitiveExcluded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "staleVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "downloadable": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "total",
          "included",
          "missing",
          "excluded",
          "sensitiveExcluded",
          "staleVersion",
          "downloadable"
        ]
      },
      "ProjectHandoverAttachmentChecklistItem": {
        "type": "object",
        "properties": {
          "selectionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "handoverId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "attachmentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "versionGroupId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "displayName": {
            "type": "string"
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AttachmentCategory"
              }
            ],
            "nullable": true
          },
          "securityLevel": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AttachmentSecurityLevel"
              }
            ],
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/ProjectHandoverAttachmentChecklistItemStatus"
          },
          "selectionReason": {
            "type": "string",
            "nullable": true
          },
          "exclusionReason": {
            "type": "string",
            "nullable": true
          },
          "downloadEligible": {
            "type": "boolean"
          },
          "staleVersion": {
            "type": "boolean"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectHandoverAttachmentSourceRef"
            }
          },
          "rowVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "nullable": true
          }
        },
        "required": [
          "selectionId",
          "handoverId",
          "projectId",
          "attachmentId",
          "versionGroupId",
          "displayName",
          "category",
          "securityLevel",
          "status",
          "selectionReason",
          "exclusionReason",
          "downloadEligible",
          "staleVersion",
          "sourceRefs",
          "rowVersion",
          "updatedAt"
        ]
      },
      "AttachmentCategory": {
        "$ref": "#/components/schemas/DictionaryCode"
      },
      "DictionaryCode": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "AttachmentSecurityLevel": {
        "type": "string",
        "enum": [
          "normal",
          "internal",
          "sensitive",
          "confidential",
          "restricted"
        ]
      },
      "ProjectHandoverAttachmentChecklistItemStatus": {
        "type": "string",
        "enum": [
          "included",
          "missing",
          "excluded",
          "sensitive-excluded",
          "stale-version"
        ]
      },
      "ProjectHandoverAttachmentSourceRef": {
        "type": "object",
        "properties": {
          "sourceType": {
            "$ref": "#/components/schemas/AttachmentTargetType"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "relationType": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AttachmentRelationType"
              }
            ],
            "nullable": true
          },
          "label": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "sourceType",
          "sourceId",
          "relationType",
          "label"
        ]
      },
      "AttachmentTargetType": {
        "type": "string",
        "enum": [
          "lead",
          "customer",
          "project",
          "contract",
          "sales-follow-up",
          "project-handover"
        ]
      },
      "AttachmentRelationType": {
        "type": "string",
        "enum": [
          "normal",
          "source",
          "evidence",
          "final",
          "handover"
        ]
      },
      "RefreshProjectHandoverAttachmentChecklistRequest": {
        "type": "object",
        "properties": {
          "preserveManualExclusions": {
            "default": true,
            "type": "boolean"
          },
          "includeHistoricalSelections": {
            "default": true,
            "type": "boolean"
          }
        }
      },
      "CreateProjectHandoverAttachmentDownloadPackageRequest": {
        "type": "object",
        "properties": {
          "selectionIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "expectedSelectionVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentSelectionVersionExpectation"
            }
          },
          "confirmedSensitiveExclusion": {
            "default": true,
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true
          }
        }
      },
      "AttachmentSelectionVersionExpectation": {
        "type": "object",
        "properties": {
          "selectionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "rowVersion": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          }
        },
        "required": [
          "selectionId",
          "rowVersion"
        ]
      },
      "AttachmentDownloadPackageSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "handoverId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "$ref": "#/components/schemas/AttachmentDownloadPackageStatus"
          },
          "manifestSummary": {
            "$ref": "#/components/schemas/AttachmentDownloadPackageManifestSummary"
          },
          "fileName": {
            "type": "string",
            "nullable": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "createdBy": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "downloadedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "nullable": true
          },
          "downloadCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failedReason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "handoverId",
          "projectId",
          "status",
          "manifestSummary",
          "fileName",
          "expiresAt",
          "createdBy",
          "createdAt",
          "downloadedAt",
          "downloadCount",
          "failedReason"
        ]
      },
      "AttachmentDownloadPackageStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "ready",
          "failed",
          "expired",
          "cancelled"
        ]
      },
      "AttachmentDownloadPackageManifestSummary": {
        "type": "object",
        "properties": {
          "includedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "excludedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "includedAttachmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "excludedAttachmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "excludedReasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "includedCount",
          "excludedCount",
          "includedAttachmentIds",
          "excludedAttachmentIds",
          "excludedReasons"
        ]
      }
    },
    "securitySchemes": {
      "pomsSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "poms_session"
      },
      "pomsCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    }
  }
}

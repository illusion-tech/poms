          "username",
          "displayName",
          "email",
          "phone",
          "isActive",
          "primaryOrgUnitId",
          "primaryOrgUnitName",
          "roleNames",
          "createdAt",
          "updatedAt",
          "avatarUrl",
          "lastLoginAt",
          "emailVerified",
          "phoneVerified",
          "orgUnits"

{
  "openapi": "3.0.0",
  "info": {
    "title": "POMS API",
    "description": "Project Oriented Management System API",
    "version": "0.1.0",
    "contact": {}
  },
  "paths": {
    "/api/me/navigation": {
      "get": {
        "operationId": "NavigationController_getNavigation",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NavigationList"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "获取当前用户可见的导航菜单树",
        "tags": [
          "Navigation"
        ]
      }
    },
    "/api/platform/navigation": {
      "get": {
        "operationId": "PlatformController_getAllNavigationItems",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NavigationList"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "获取完整导航树（平台管理员只读视图）",
        "tags": [
          "Platform"
        ]
      }
    },
    "/api/platform/navigation:sync": {
      "post": {
        "operationId": "PlatformController_syncNavigation",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NavigationSyncSummary"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "记录当前导航 SSOT 的同步审计快照",
        "tags": [
          "Platform"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "NavigationList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/NavigationList__schema0"
        }
      },
      "NavigationList__schema0": {
        "$ref": "#/components/schemas/NavigationItem"
      },
      "NavigationItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/NavigationItemType"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "subtitle": {
            "type": "string",
            "nullable": true
          },
          "link": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "displayOrder": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "isHidden": {
            "type": "boolean"
          },
          "isDisabled": {
            "type": "boolean"
          },
          "requiredPermissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "platform:users:manage",
                "platform:roles:manage",
                "platform:navigation:manage",
                "platform:org-units:manage",
                "platform:dictionaries:manage",
                "platform:identity-providers:manage",
                "platform:org-sync:manage",
                "platform:attachment-storage-providers:manage",
                "platform:system-settings:manage",
                "customer:read",
                "customer:write",
                "commission:rule-versions:manage",
                "commission:assignments:manage",
                "commission:calculations:manage",
                "commission:payouts:manage",
                "commission:adjustments:manage",
                "contract:finance:manage",
                "contract:finance:sensitive:read",
                "operating:finance:sensitive:read",
                "commission:amount:sensitive:read",
                "labor-cost-rate:sensitive:read",
                "exception-approval-opinion:sensitive:read",
                "lead:read",
                "lead:write",
                "lead:assign",
                "lead:score:override",
                "project:read",
                "project:write",
                "project:delete",
                "nav:dashboard:view",
                "nav:customers:view",
                "nav:platform:view",
                "nav:leads:view",
                "nav:attachments:view",
                "nav:projects:view",
                "nav:contracts:view",
                "nav:profile:view"
              ]
            },
            "nullable": true
          },
          "meta": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "nullable": true
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NavigationList__schema0"
            },
            "nullable": true
          }
        },
        "required": [
          "id",
          "key",
          "type",
          "title",
          "subtitle",
          "link",
          "icon",
          "displayOrder",
          "isHidden",
          "isDisabled",
          "requiredPermissions",
          "meta",
          "children"
        ]
      },
      "NavigationItemType": {
        "type": "string",
        "enum": [
          "basic",
          "group",
          "collapsable",
          "divider"
        ]
      },
      "NavigationSyncSummary": {
        "type": "object",
        "properties": {
          "targetId": {
            "type": "string",
            "enum": [
              "platform-navigation"
            ]
          },
          "nodeCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "routeCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "hiddenCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "disabledCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "treeChecksum": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "navigationKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "routeLinks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "targetId",
          "nodeCount",
          "routeCount",
          "hiddenCount",
          "disabledCount",
          "treeChecksum",
          "navigationKeys",
          "routeLinks"
        ]
      }
    },
    "securitySchemes": {
      "pomsSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "poms_session"
      },
      "pomsCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    }
  }
}

            }
          },
          {
            "name": "permissionKey",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "name": "result",
            "required": false,
            "in": "query",
            "schema": {

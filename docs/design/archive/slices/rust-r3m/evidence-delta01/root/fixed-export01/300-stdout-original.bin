  },
  "components": {
    "schemas": {
      "AbortAttachmentUploadSessionRequest": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "AttachmentCategory": {
        "$ref": "#/components/schemas/DictionaryCode"
      },
      "AttachmentCenterRecord": {
        "type": "object",
        "properties": {
          "targetType": {
            "$ref": "#/components/schemas/AttachmentTargetType"
          },
          "targetId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "targetNo": {
            "type": "string"
          },
          "targetName": {
            "type": "string"
          },
          "targetOwnerName": {
            "type": "string",
            "nullable": true
          },
          "attachment": {
            "$ref": "#/components/schemas/AttachmentSummary"
          }
        },
        "required": [
          "targetType",
          "targetId",
          "targetNo",
          "targetName",
          "targetOwnerName",
          "attachment"
        ]
      },
      "AttachmentCenterRecordList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AttachmentCenterRecord"
        }
      },
      "AttachmentLinkStatus": {
        "type": "string",
        "enum": [
          "active",
          "unlinked"
        ]
      },
      "AttachmentLinkSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "attachmentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "targetType": {
            "$ref": "#/components/schemas/AttachmentTargetType"
          },
          "targetId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "relationType": {
            "$ref": "#/components/schemas/AttachmentRelationType"
          },
          "status": {
            "$ref": "#/components/schemas/AttachmentLinkStatus"
          },
          "linkedBy": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "linkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "unlinkedBy": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "nullable": true
          },
          "unlinkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "nullable": true
          }
        },
        "required": [
          "id",
          "attachmentId",
          "targetType",
          "targetId",
          "relationType",
          "status",
          "linkedBy",
          "linkedAt",
          "unlinkedBy",
          "unlinkedAt"
        ]
      },
      "AttachmentList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AttachmentSummary"
        }
      },
      "AttachmentRelationType": {
        "type": "string",
        "enum": [
          "normal",
          "source",
          "evidence",
          "final",
          "handover"
        ]
      },
      "AttachmentSecurityLevel": {
        "type": "string",
        "enum": [
          "normal",
          "internal",
          "sensitive",
          "confidential",
          "restricted"
        ]
      },
      "AttachmentStatus": {
        "type": "string",
        "enum": [
          "active",
          "voided",
          "deleted",
          "failed"
        ]
      },
      "AttachmentStorageProviderType": {
        "type": "string",
        "enum": [
          "local",
          "huawei-obs-s3"
        ]
      },
      "AttachmentSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "originalName": {
            "type": "string"

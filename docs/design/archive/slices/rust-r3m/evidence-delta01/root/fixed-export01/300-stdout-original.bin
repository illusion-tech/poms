            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentUploadTargetResult"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "通过 POMS 后端代理上传附件对象",
        "tags": [
          "AttachmentUploadSession"
        ]
      }
    },
    "/api/attachment-upload-sessions/{id}/upload-targets": {

    "/api/attachments": {
      "get": {
        "operationId": "AttachmentController_list",
        "parameters": [
          {
            "name": "targetType",
            "required": true,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AttachmentTargetType"
            }
          },
          {
            "name": "targetId",
            "required": true,
            "in": "query",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AttachmentCategory"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/AttachmentStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttachmentList"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "按业务对象获取附件列表",
        "tags": [
          "Attachment"
        ]
      }
    },

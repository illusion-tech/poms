            "maxLength": 1000
          }
        },
        "required": [
          "reason"
        ]
      }
    },
    "securitySchemes": {
      "pomsSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "poms_session"
      },
      "pomsCsrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    }
  }
}

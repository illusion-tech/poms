//! This verifies metadata; PostgreSQL flush ordering has separate Native evidence.
use super::schema::{Column, Table};
pub fn name(table: Table) -> &'static str {
    match table {
        Table::Contract => "contract",
        Table::ContractTerm => "contract_term_snapshot",
        Table::Payout => "commission_payout",
        Table::Adjustment => "commission_adjustment",
        Table::RoleAssignment => "commission_role_assignment",
        Table::GateBinding => "operating_signal_gate_binding",
        Table::GateReview => "commission_gate_review_record",
        Table::FinalSettlement => "commission_final_settlement_snapshot",
        Table::RuleExplanation => "commission_rule_explanation_snapshot",
        Table::Receipt => "receipt_record",
        Table::DepartureDecision => "commission_departure_exception_decision",
        Table::FreezeDispute => "commission_freeze_dispute_record",
        Table::Project => "project",
        Table::Lead => "lead",
        Table::Customer => "customer",
        _ => unreachable!("common table has its own frozen metadata"),
    }
}
pub fn class_name(table: Table) -> &'static str {
    match table {
        Table::Contract => "Contract",
        Table::ContractTerm => "ContractTermSnapshot",
        Table::Payout => "CommissionPayout",
        Table::Adjustment => "CommissionAdjustment",
        Table::RoleAssignment => "CommissionRoleAssignment",
        Table::GateBinding => "OperatingSignalToCommissionGateBinding",
        Table::GateReview => "CommissionGateReviewRecord",
        Table::FinalSettlement => "CommissionFinalSettlementSnapshot",
        Table::RuleExplanation => "CommissionRuleExplanationSnapshot",
        Table::Receipt => "ReceiptRecord",
        Table::DepartureDecision => "CommissionDepartureExceptionDecision",
        Table::FreezeDispute => "CommissionFreezeDisputeRecord",
        Table::Project => "Project",
        Table::Lead => "lead",
        Table::Customer => "Customer",
        _ => unreachable!("common table has its own frozen metadata"),
    }
}

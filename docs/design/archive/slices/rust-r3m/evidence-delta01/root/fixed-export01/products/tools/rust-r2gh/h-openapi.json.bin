            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OrgSyncDiffItemStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgSyncDiffItemList"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "获取组织同步差异项列表",
        "tags": [
          "External Org Sync"
        ]
      }
    },
    "/api/platform/org-sync-runs/{id}:apply": {
      "post": {
        "operationId": "ExternalOrgSyncController_applyOrgSyncRun",

    "/api/platform/external-org-sources/{sourceId}/department-mappings": {
      "get": {
        "operationId": "ExternalOrgSyncController_listExternalDepartmentMappings",
        "parameters": [
          {
            "name": "sourceId",
            "required": true,
            "in": "path",

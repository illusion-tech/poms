          },
          {
            "name": "reviewState",
            "required": false,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ExternalDepartmentMappingReviewState"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 255,
              "type": "string"
            }
          },
          {
            "name": "externalDepartmentId",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 255,
              "type": "string"
            }
          },
          {
            "name": "orgUnitId",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalDepartmentMappingList"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "获取外部部门映射列表",
        "tags": [
          "External Org Sync"
        ]
      },
      "put": {

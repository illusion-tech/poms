    "/api/platform/org-sync-runs/{id}/diff-items": {
      "get": {
        "operationId": "ExternalOrgSyncController_listOrgSyncDiffItems",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",

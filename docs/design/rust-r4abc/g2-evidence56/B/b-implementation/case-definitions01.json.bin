  "cases": [
    {"id":"B01-list","operationId":"ContractController_list","actions":["create independent real drafts in two projects","GET no filters/projectId/status/keyword/mixed filters"],"assert":["actual summary array, createdAt DESC","keyword matches contract_no/customer_contract_no only","project labels read from actual projects","masked event per nonnull contract amount; no event for full permission"]},
    {"id":"B02-create","operationId":"ContractController_create","actions":["POST real project contract with omitted defaults and legacy spoofed actor fields"],"assert":["201 onlydraft/CNY/null dates/currentSnapshotId","normalized amount two digits and exactlarge value","actual generated CT-UTCyear-pad6","same-TX number/contract/audit/session","createdBy/updatedBy actual actor, never body"]},
    {"id":"B03-detail","operationId":"ContractController_getById","actions":["read draft/prepared/pending/active contract detail after real producer chain"],"assert":["metadata-only currentPreparation/latestReviewBinding","currentTermSnapshot null until real active snapshot exists","new snapshot sourcePreparationId precise","no terms/seeds hidden outside sensitive projections"]},
    {"id":"B04-patch","operationId":"ContractController_updateBasicInfo","actions":["real draft changes external number/amount/currency/signedAt/date-only date"],"assert":["optional expectedVersion enforced","actual dirty fields one contract version increment","null clears nullable fields, missing retains","required audit safe DTO and auth same TX"]},
    {"id":"B05-approval","operationId":"ContractController_getCurrentApproval","actions":["read no history, pending, approved, rejected and resubmitted history"],"assert":["no history404","latest actual submitted/created order","R2 Contract targetTitle/status projection","no fabricated approval/confirmation"]},
    {"id":"B06-submit","operationId":"ContractController_submitReview","actions":["submit real current A08 preparation"],"assert":["actual common Contract pending-review + Approval pending + high/open Todo","resolved actual active vp_owner UUID","common flush happens inside outerTX before immediately FK binding INSERT","result real approval/todo/preparation IDs, snapshotId null","no ApprovalSummarySnapshot invented"]},
    {"id":"B07-activate","operationId":"ContractController_activate","actions":["approve real pending record then activate current expected contract version"],"assert":["actual latest approved exact binding and same preparation payload","new independent ActiveSnapshotId/version1/source_preparation_id/seeds/hash","preparation activated/CAS, readiness actual snapshot marker/CAS, common contract pointer/CAS","all necessary audit/auth writes same outerTX"]},
    {"id":"B08-lookup","operationId":"ContractController_getByNo","actions":["GET exact actual contractNo","case/space/plus/encoded/repeated/bracket/unknown query vectors"],"assert":["exact equality without trim/coerce/Unicode normalization","proper shared query/schema/error behavior","same detail projections and originalURL audit context","old /contracts/no path not restored"]},
    {"id":"B09-snapshot","operationId":"ContractTermSnapshotController_getById","actions":["read actual Active snapshot and missing UUID"],"assert":["sourcePreparationId present for new product","one six-field batch with nulls excluded","all financial scalars remain projected strings","404 for absent"]},
    {"id":"B-money-valid","vectors":["0.01","1","000001.20","9007199254740993.01","9999999999999999.99"],"assert":["exact positive numeric18,2","normalized two-digit wire/database","no binary64 loss"]},
    {"id":"B-money-invalid","vectors":["0","-1","+1","1.001","1e3","NaN","Infinity","10000000000000000.00",".1","1.","1,000.00",12,null],"assert":["400 no coerce/no silent rounding","failed create no number/contract/audit success partial commit","failed patch unchanged"]},
    {"id":"B-initial-state","vectors":["pending-review","active","terminated","completed"],"assert":["create400","no business bypass or marker/snapshot made"]},

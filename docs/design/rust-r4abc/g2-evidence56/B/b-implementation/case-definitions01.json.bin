    {"id":"B-uuid-scope","actions":["uppercase equivalent UUID","other-contract preparation same project","cross-project preparation","PreparationId substituted for ContractId","bad path UUID"],"assert":["typed equality for uppercase","wrong scope404/conflict per shared rules","bad UUID400","no wrong identity adoption"]},

Replace-Once '        if (!approval || !this.rejectForm.reason.trim()) return;' '        if (!approval || !this.canReject() || !this.rejectForm.reason.trim()) return;'

# Every awaited command handler retains its originating page, including A -> B -> A.
foreach ($method in @('saveContract','submitReview','approveApproval','rejectApproval','activateContract')) {
    $start = $text.IndexOf('    async ' + $method + '() {')
    if ($start -lt 0) { throw "Missing command handler: $method" }
    $end = $text.IndexOf("`n    }", $start) + 6
    $section = $text.Substring($start, $end - $start)
    $section = $section.Replace('    async ' + $method + '() {', '    async ' + $method + "() {`n        const page = this.#pageRequest;")
    # The API call is the first await. Check the page before any post-await local mutation/toast.
    $awaitAt = $section.IndexOf('            await ')
    if ($awaitAt -lt 0) { throw "Missing awaited command in $method" }
    $afterAwait = $section.IndexOf(";`n", $awaitAt) + 2
    if ($afterAwait -lt 2) { throw "Missing end of awaited command in $method" }
    $section = $section.Insert($afterAwait, "            if (page !== this.#pageRequest) return;`n")
    $section = $section.Replace('        } catch (error) {', "        } catch (error) {`n            if (page !== this.#pageRequest) return;")
    $text = $text.Substring(0,$start) + $section + $text.Substring($end)
}
Replace-Once @'
    async reloadAcknowledgedState() {
        const refreshed = await this.#contractStore.reloadAcknowledgedState();
        if (refreshed) this.#messageService.add({ severity: 'success', summary: '已重新加载', detail: '合同、审批与待办已更新', life: 3000 });
    }
'@ @'
    async reloadAcknowledgedState() {
        const page = this.#pageRequest;
        const acknowledgement = this.#contractStore.lastAcknowledgement();
        if (!acknowledgement || acknowledgement.contractId.toLowerCase() !== this.#routeContractId()?.toLowerCase()) return;
        const refreshed = await this.#contractStore.reloadAcknowledgedState();
        if (page !== this.#pageRequest) return;
        if (refreshed) this.#messageService.add({ severity: 'success', summary: '已重新加载', detail: '合同、审批与待办已更新', life: 3000 });
    }
'@
$destination = Join-Path (Join-Path $candidatePath 'products') $relativePath
[System.IO.Directory]::CreateDirectory([System.IO.Path]::GetDirectoryName($destination)) | Out-Null
[System.IO.File]::WriteAllText($destination, $text, $utf8)

import fs from 'node:fs';import path from'node:path';import assert from'node:assert/strict';import{createHash}from'node:crypto';
const out='docs/design/rust-r4abc/g1-evidence',sha=b=>createHash('sha256').update(b).digest('hex'),pin=file=>{const b=fs.readFileSync(file);return{file,bytes:b.length,rawBytesSha256:sha(b)}};assert(!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const entries=[];
for(const dir of ['tmp/rust-r4abc/independent','tmp/rust-r4abc/root/g1-static-checks01'])for(const name of fs.readdirSync(dir)){const file=dir+'/'+name;if(!fs.statSync(file).isFile())continue;const dest=out+'/'+(dir.includes('independent')?'independent/':'checks/')+name+'.bin';fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(file,dest,fs.constants.COPYFILE_EXCL);entries.push({logicalOrigin:file,storedAt:dest,...pin(dest)});}
const source='tmp/rust-r4abc/independent/g1-independent-review01.json',review=JSON.parse(fs.readFileSync(source,'utf8'));assert.equal(review.decision,'Pass');assert.equal(review.candidate.sha256,'cb653499442e5f390715b6f44f8d0fd67ec0d145ddcb5d165e13235ff3c34f36');const manifest=JSON.parse(fs.readFileSync('docs/design/rust-r4abc/g1-candidate-manifest01.json','utf8'));for(const p of manifest.files)assert.deepEqual(pin(p.file),p,p.file);
fs.writeFileSync(out+'/origin-map01.json',JSON.stringify({kind:'R4-G1-original-review-and-checks-map',entries},null,2)+'\n',{flag:'wx'});
const receipt={kind:'R4-first37-independent-G1-certified; online admission still pending',createdAt:new Date().toISOString(),base:manifest.base,issues:manifest.issues,activeCandidate:pin('docs/design/rust-r4abc/g1-candidate-manifest01.json'),review:{...pin(source),storedAt:entries.find(x=>x.logicalOrigin===source).storedAt,decision:'Pass'},checks:pin('tmp/rust-r4abc/root/g1-static-checks01/receipt01.json'),G1IndependentPass:true,G1Certified:true,G2Authorized:false,onlineFreezeApplied:false,productRuntimeExecuted:false,parentsRemainOpen:[101,57],representation:'New narrow **/*.bin binary attributes prevent raw evidence conversion; all reviewed491 files bytes still identical.'};fs.writeFileSync('docs/design/rust-r4abc/g1-gate-review01.json',JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({review:'Pass',unchangedInputFiles:manifest.files.length,rawEvidenceFiles:entries.length,online:false,G2:false}));

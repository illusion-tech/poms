  "findings": [
    {
      "id": "SRC-05-UI-01",
      "priority": "P2",
      "title": "Contract detail and late reads are not fenced to the current routed contract",
      "status": "Root confirmed; C05 correction assigned, not yet independently reviewed",
      "sourcePins": [
        {
          "file": "apps/poms-admin/src/app/features/contract/contract-detail.ts",
          "bytes": 48480,
          "sha256": "97be99281c1da46a2215dc4e7808ef6d101dd0d4b71966ecc014b5830061ce96"
        },
        {
          "file": "libs/admin/data-access/src/lib/contract/contract.store.ts",
          "bytes": 9823,
          "sha256": "77500861fe1faa8304866a2e0de3c538bead8c0684597daf5e36ad140f28c958"
        }
      ],
      "locations": [
        "ContractDetail.ngOnInit/ngOnDestroy and canSubmitReview/canApprove/canActivate",
        "ContractStore.loadContract/loadCurrentApproval and post-command reload paths"
      ],
      "trigger": "Navigate from /contracts/A to /contracts/B using a same-route-config in-app link, or allow an old A read to finish after the singleton store has been cleared and a B detail is loading.",
      "defect": "Detail reads route.snapshot.id only once and does not subscribe to paramMap. Store loads unconditionally write selectedContract/currentApproval without a route/identity generation check. Existing action predicates validate status and preparation binding, not routed view ownership.",
      "businessImpact": "The URL/user context can identify B while the page still displays or acts on A, including approval/submission/activation actions. Backend guards authorize the submitted entity and cannot detect the user's stale routed intent.",
      "requiredCorrection": "React to routed ID changes; invalidate old detail/approval reads and command ACK reloads with identity/generation fences or cancellation; clear old dialogs/ACK state; prevent stale A completions from writing the B view or reopening its actions.",
      "requiredRegression": "Same reused component changes A->B; late old detail and old approval completions after B; navigation/destruction during acknowledged-command reload; only B state/actions survive.",
      "evidenceClass": "Static reachable UI identity defect; no browser reproduction claimed by reviewer"
    }
  ],

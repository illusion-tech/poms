  "findings": [
    {
      "id": "SRC-05-UI-01",
      "priority": "P2",
      "title": "Contract detail and late reads were not fenced to the current routed contract",
      "status": "Closed in C05 affected-source review",
      "verifiedCorrection": [
        "ContractDetail observes live paramMap with distinctUntilChanged and takeUntilDestroyed; each routed page change increments page identity, resets all dialogs/forms/recovery/toasts and selects a new store scope.",
        "Displayed contract and approval target IDs must match the live route; actions require current matching detail, no pending detail/approval/save or failed ACK refresh.",
        "ContractStore uses a fresh scope object identity, preserving A->B->A distinction; per-read request counters fence detail/approval/list publication and pending indicators.",
        "Update/POST completions and saving finalizers are fenced to originating command scope. Late A ACK cannot reselect A or clear B saving state.",
        "ACK refresh uses private reads with captured scope; stale errors/results cannot overwrite B or its ACK. AuthStore optional isCurrent callback fences the ACK-triggered todo publication.",
        "All component command/reload completion handlers check originating page identity. Destruction clears the scope and ends route subscription."
      ],
      "regressionEvidence": "Root actual route-test37: real ContractDetail template + real ContractStore with delayed SDK Subjects, 1 suite/9 cases passed. Targeted tests are UI fixtures, not real HTTP/browser acceptance.",
      "runtimeReproductionByReviewer": false
    }
  ],

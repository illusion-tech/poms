{
  "kind":"R4-validation-candidate01-pure-vectors",
  "status":"defined-not-run",
  "scope":"Current37 request/query schema closure, no body/source/domain writer",
  "cases":[
    {"id":"body-missing","operation":"ContractController_create","raw":null,"expectStatus":400,"assert":"required object undefined issue, not default empty command"},
    {"id":"body-nonobject","operation":"ContractController_create","raws":["null","[]","true","1","\"draft\""],"expectStatus":400},
    {"id":"body-malformed","raws":["{","{\"value\":NaN}","{\"value\":\"\\ud800\"}"],"expectStatus":400,"boundary":"serde_json rejects malformed JSON/lone surrogate; no lossy replacement"},
    {"id":"unknown-strip","operation":"ContractController_create","body":{"projectId":"20000000-0000-4000-8000-000000000001","signedAmount":"1.00","unknown":{"signedAmount":"leak"}},"expect":"unknown omitted from returned object"},
    {"id":"source-trim","operation":"ContractController_create","body":{"projectId":"20000000-0000-4000-8000-000000000001","signedAmount":" 0001.20 ","customerContractNo":"  ref  "},"expectFields":{"signedAmount":"0001.20","customerContractNo":"ref"}},
    {"id":"no-global-trim","operation":"ContractController_getByNo","query":"contractNo=%20CT-2026-000001%20","expectFields":{"contractNo":" CT-2026-000001 "}},
    {"id":"keyword-trim","operation":"ContractController_list","query":"keyword=%20CT-%20","expectFields":{"keyword":"CT-"}},
    {"id":"legacy-no-trim-summary","operation":"ContractReadinessController_createCommercialReleaseBaseline","field":"paymentTermsSummary","input":"  opaque text  ","expect":"spaces preserved by source z.string().max only"},
    {"id":"nested-trim","operation":"ContractReadinessController_createCommercialReleaseBaseline","fields":{"contractTerms[0].paymentTerms":" terms ","contractTerms[0].receivablePlanSeeds[0].nodeKey":" first ","contractTerms[0].receivablePlanSeeds[0].note":" untouched "},"expect":"only paymentTerms and nodeKey trimmed; note retained"},
    {"id":"default-distinction","operation":"ContractReadinessController_reviewDiff","missing":["reviewedFieldKeys","attachmentIds"],"expectFields":{"reviewedFieldKeys":[],"attachmentIds":[]},"explicitNullStatus":400},
    {"id":"nested-defaults","operation":"ContractReadinessController_createCommercialReleaseBaseline","field":"diffItems[0]","missing":["isBlocking","sortOrder"],"expect":"current AST-declared defaults false and0; no guessed defaults on optional currency"},
    {"id":"null-optional","operation":"ContractController_updateBasicInfo","body":{"customerContractNo":null,"expectedVersion":1},"expect":"explicit null retained, no dropped-field substitution"},
    {"id":"empty-update-contract","operation":"ContractController_updateBasicInfo","bodies":[{}, {"expectedVersion":1}, {"unknown":true}],"expectStatus":400,"expectCode":"custom"},
    {"id":"empty-update-payable","operation":"ContractFinanceController_updatePayable","bodies":[{}, {"expectedVersion":1}, {"unknown":true}],"expectStatus":400,"expectCode":"custom"},
    {"id":"empty-update-invoice","operation":"ContractFinanceController_updateInvoice","bodies":[{}, {"expectedVersion":1}, {"unknown":true}],"expectStatus":400,"expectCode":"custom"},
    {"id":"declared-legacy-actor","operation":"ContractController_create","field":"createdBy","input":"00000000-0000-4000-8000-000000000001","expect":"declared UUID accepted, no permission/actor decision performed here"},
    {"id":"positive-money-good","type":"R4PositiveMoneyString","values":["0.01","0001.20","9007199254740993.01","9999999999999999.99"],"expect":"exact helper accepts, no f64 conversion"},
    {"id":"positive-money-bad","type":"R4PositiveMoneyString","values":["0","-1","+1","1.001","1e3","NaN","Infinity","10000000000000000.00"],"expectStatus":400},
    {"id":"nonnegative-money","type":"R4NonnegativeMoneyString","values":["0","0.00","1.23"],"expect":"accepted strings, zero not reclassified as positive"},
    {"id":"ratio","type":"R4RatioString","valid":["0","0.1300","1.0000"],"invalid":["1.0001","0.13001","-0.01","1e-2"],"invalidStatus":400},
    {"id":"nonstring-money","operation":"ContractController_create","signedAmounts":[1,null,true,[]],"expectStatus":400,"assert":"no implicit string coercion"},
    {"id":"uuid","valid":["00000000-0000-0000-0000-000000000000","ffffffff-ffff-ffff-ffff-ffffffffffff","ABCDEFAB-1234-4234-8234-ABCDEFABCDEF"],"invalid":["FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF","abcdefab-1234-0234-8234-abcdefabcdef","abcdefab-1234-4234-7234-abcdefabcdef"],"expect":"valid canonical lowercase; special max behavior matches currentpattern"},
    {"id":"dates","valid":["2028-02-29","2000-02-29"],"invalid":["2027-02-29","1900-02-29","2026-04-31","2026-1-01","2026-01-01T00:00:00Z"],"expect":"Gregorian date, no datetime slicing"},
    {"id":"datetime","valid":["2026-11-03T01:02:03Z","2026-11-03T01:02:03.123456Z"],"invalid":["2026-11-03","2026-11-03T01:02:60Z","2026-11-03T01:02:03+09:00"," 2026-11-03T01:02:03Z "],"expect":"current Shared Z-only pattern, no globaltrim"},
    {"id":"utf16","field":"customerContractNo","vectors":[{"valueDescription":"64 supplementary-plane characters","units":128,"expect":"accepted max128"},{"valueDescription":"65 supplementary-plane characters","units":130,"expectStatus":400}],"assert":"UTF16 length per explicit task requirement"},
    {"id":"integer-normalization","operation":"ContractController_activate","raw":"{\"expectedVersion\":1.0}","expectFields":{"expectedVersion":1},"assert":"downstream as_i64 sees validinteger"},
    {"id":"integer-invalid","operation":"ContractController_activate","versions":[0,-1,1.5,"1",null,9007199254740992],"expectStatus":400},
    {"id":"query-repeat","operation":"ContractController_getByNo","queries":["contractNo=A&contractNo=B","contractNo=A&contractNo=A"],"expectStatus":400,"assert":"array retained, never firstvalue wins"},
    {"id":"query-form","operation":"ContractController_getByNo","queries":["contractNo=A+B","contractNo=A%2BB","contractNo%5Bx%5D=A","contractNo=A&contractNo%5Bx%5D=B"],"expect":["A B","A+B","required contractNo400","A; bracketunknown stripped"]},
    {"id":"selection-query","operations":["ContractReadinessController_getDiffHistory","ContractReadinessController_getCurrentContractReadiness"],"queries":[null,"unknown=A","contractId=20000000-0000-4000-8000-000000000001","contractId=A&contractId=B"],"expect":["{}","{}","canonical optionalUUID","400"]},
    {"id":"contractTerms-unique","operation":"ContractReadinessController_createCommercialReleaseBaseline","input":"two valid terms with case-equivalent contractId","expectStatus":400,"assert":"current Shared explicit unique-contractId refine preserved"},
    {"id":"domain-boundary","operation":"ContractFinanceController_createPayment","input":"all syntactically positive amounts but inclusive != exclusive+tax","expect":"DTO validation passes; actual domain returns422, not validator400"},
    {"id":"seeds-boundary","operation":"ContractReadinessController_createContractReadinessPackage","input":"valid individually typed seeds whose sum/retention structure is semantically invalid","expect":"per-field DTO passes; actual domain checks business totals/source"},
    {"id":"exporter-fail-closed","sourceMutations":["new request refine","new unknown pattern","new coerce/transform","new query DTO field not reflected in current spec","remote ref","dictionary schema"],"expect":"Root actual generator fails explicitly, no partial success claimed"}
  ]
}

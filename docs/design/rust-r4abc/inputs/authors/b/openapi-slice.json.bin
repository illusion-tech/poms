{
  "kind": "static-openapi-contract-slice-not-runtime-verification",
  "source": "libs/shared/api-spec/openapi.json",
  "operations": [
    {
      "method": "GET",
      "path": "/api/contracts",
      "operationId": "ContractController_list",
      "original": {
        "operationId": "ContractController_list",
        "parameters": [
          {
            "name": "projectId",
            "required": false,
            "in": "query",
            "schema": {
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ContractStatus"
            }
          },
          {
            "name": "keyword",
            "required": false,
            "in": "query",
            "schema": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractList"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "获取合同列表",
        "tags": [
          "contract"
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/contracts",
      "operationId": "ContractController_create",
      "original": {
        "operationId": "ContractController_create",
        "parameters": [],

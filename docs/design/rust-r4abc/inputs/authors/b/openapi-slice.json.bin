        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractSummary"
                }
              }
            }
          }
        },
        "security": [
          {
            "pomsSession": []
          }
        ],
        "summary": "创建合同基础台账",

  "rootRelayedUserDecisions": [
    {
      "id": "C-D01",
      "decision": "Ordinary receipt and invoice money is finite positive decimal, at most 2 fractional places, within numeric(18,2). Reject overflow and silent rounding. Negative adjustments require a future explicit flow.",
      "evidence": "Root task message relaying user ruling; not an online freeze receipt"
    },
    {
      "id": "C-D02",
      "decision": "A selected payment contract is Active and belongs to the same project. If payable has a contract, the selected or inherited contract must equal it. An unbound payable may use a same-project Active contract.",
      "evidence": "Root task message relaying user ruling"
    },
    {
      "id": "C-D03",
      "decision": "C remains 19 existing routes plus minimum read-only cost mapping protection. Real cost producer belongs to later project-cost slice; R4 stage closes the full production loop. A prepared mapping fixture proves guard behavior only.",
      "evidence": "Root task message relaying user ruling"
    },
    {
      "id": "C-D04",
      "decision": "A prepared contract terms version is persisted and reviewed for one actual contract; activation makes the reviewed version effective in the same transaction. Formal receivable plan requires Active contract and valid snapshot. Do not add a receipt-plan hard gate.",
      "evidence": "Root task message relaying user ruling; A/B/Root own implementation"
    },
    {
      "id": "C-D05",
      "decision": "Use typed UUID domain equality and canonical entity UUID for mapping source_id. allowedActions must reflect formally executable actions and association conditions. Payable summaries derive exact confirmed payment sums.",
      "evidence": "Root accepted precise correctness corrections"
    },
    {
      "id": "C-D06",
      "decision": "Preserve invoice exception history independently from patchable business status; missing allowedActions must not create a new PATCH prohibition.",
      "evidence": "Root accepted precise correctness correction"
    },
    {
      "id": "C-D07",
      "decision": "Every successful actual finance content/state change writes mandatory audit_log in same TX. Actor is authenticated session.sub, not DTO. No-op PATCH adds no business version or business audit. No new finance organization/role restriction in this batch.",
      "evidence": "Root message relaying user fourth ruling"
    },
    {
      "id": "C-D08",
      "decision": "Each contract has its own amount and auditable source/difference. No project quote hard total cap or automatic allocation across contracts.",
      "evidence": "Root message relaying user fourth ruling"
    }
  ],

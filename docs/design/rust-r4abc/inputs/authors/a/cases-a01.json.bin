{
  "schemaVersion": 1,
  "evidenceClass": "pure-case-definitions-not-executed",
  "scope": "R4A nine existing HTTP operations plus A/B/C business handoff",
  "baselineReportedByRoot": "1730f304c1cf5600721f80b6c06feec24269d387",
  "semantics": "User decisions relayed by Root govern Rust expected behavior. Native is reference-only; no scenario here was executed by A.",
  "executionOwner": "Root",
  "prerequisites": [
    "Joint G1, DTO/DDL and business source contracts frozen by Root and independent reviewer before any implementation/run.",
    "Fresh isolated Native/Rust cohorts with unique project/customer/contract/source IDs; no old private or seed marker accepted as real business chain.",
    "Real cost/bid/direct/pricing HTTP production, new preparation/approval/active snapshot/plan rows observed from PostgreSQL, not a prepared SQL empty graph.",
    "Root supplies actual versioned DTO templates and session credentials in its own private runtime. No credential is stored in this definition."
  ],
  "placeholders": {
    "project": "actual project UUID from current run",
    "otherProject": "independent project UUID from current run",
    "contract": "selected draft contract UUID owned by project",
    "contract2": "second explicit contract of the same project",
    "baseline": "A01 returned real draft baseline UUID",
    "pricing": "actual R3 released pricing UUID referencing baseline",
    "diff": "computed contract-specific diff UUID, never an invented test ID",
    "readiness": "A05 returned source-bound readiness UUID",
    "preparation": "A08 returned real preparationId",
    "approval": "B submitReview returned exact bound approvalRecordId",
    "snapshot": "B activate returned real distinct active snapshot UUID",
    "plan": "A09 returned persisted plan version UUID",
    "versions": "read immediately from actual API/PG row before each CAS; stale variants keep the explicitly saved old value"
  },
  "sharedHttpReceipt": ["runId", "candidateSourceManifestSha256", "candidateBinarySha256", "runtimeKind/nativeOrRust", "method", "rawPath", "redactedRawRequestBody", "actorId", "permissionSet", "status", "redactedResponseHeaders", "rawResponseBody", "start/end timestamps", "PG before/after probe artifacts", "cohort ownership", "failure/barrier proof", "cleanup receipt"],
  "sharedPgAssertions": ["full rows, IDs and source refs", "rowVersion/business version/current/supersedes chain", "no orphan output IDs", "audit success count and payload", "managed session delta separately labeled", "failed cases restore business rows, audit and pending session state", "two cleanup passes with second business delta zero"],
  "fixtures": {
    "commercialTerms": { "amountTaxInclusive": "188000.00", "amountTaxExclusive": "177358.49", "taxRate": "0.0600", "downPaymentRate": "0.3000", "retentionRate": "0.0500", "paymentTerms": "30%首款，65%验收款，5%质保金", "currencyCode": "CNY" },
    "typedSeeds": [
      { "nodeKey": "down-payment", "label": "首付款", "plannedAmount": "56400.00", "plannedDate": "2026-11-15", "isRetentionNode": false, "sortOrder": 0 },
      { "nodeKey": "acceptance", "label": "验收款", "plannedAmount": "122200.00", "plannedDate": "2027-01-15", "isRetentionNode": false, "sortOrder": 1 },
      { "nodeKey": "retention", "label": "质保金", "plannedAmount": "9400.00", "plannedDate": "2028-01-15", "isRetentionNode": true, "sortOrder": 2 }
    ],
    "bodyRule": "These are business inputs for the new Root-frozen DTO, not an assertion that old DTO already supports them; copy exact approved field shape into each actual raw request."
  },
  "cases": [
    {
      "id": "A-chain01",
      "name": "真实直接商务合同闭环与九入口",
      "steps": [
        { "method": "POST", "path": "/api/projects/${project}/technical-cost-packages", "body": "Root-frozen valid real R3 cost DTO; capture current cost ID/version" },
        { "method": "POST", "path": "/api/projects/${project}/bid-commercial-processes", "body": "Root-frozen direct-commercial/not-required process DTO; capture current process" },
        { "method": "POST", "path": "/api/commercial-release-baselines", "body": "projectId and explicit project commercial source terms; server-derived draft candidate; no allowed override", "expectRust": "201 draft, actual immutable source baseline persistence" },
        { "method": "POST", "path": "/api/projects/${project}/pricing-margin-reviews", "body": "real current cost/bid refs and baseline ID, released decision and actual summary context", "expectRust": "released source exists and owns exact baseline payload" },
        { "method": "GET", "path": "/api/commercial-release-baselines/${baseline}", "expectRust": "200, actual typed terms/source state" },
        { "method": "POST", "path": "/api/contract-readiness-packages", "body": "projectId, explicit contractId, independent contractCoreTerms+typedSeeds, baseline/source assertions; server computes auditable diff and never grants authority from allowed/status flags", "expectRust": "201, contract-bound immutable payload and server-derived readiness after actual source/diff/review checks" },
        { "method": "GET", "path": "/api/commercial-release-baselines/${baseline}/diff-history?contractId=${contract}", "expectRust": "200, computed exact contract diff items and review history" },
        { "method": "POST", "path": "/api/commercial-release-baselines/${baseline}:reviewDiff", "body": "explicit contractId+diffResultId, real required field coverage/actors, expectedVersion", "expectRust": "200 when review required, exact diff decision records and associated package guard/status recomputed in one TX under Root-frozen role rule" },
        { "method": "GET", "path": "/api/contract-readiness-packages/${readiness}", "expectRust": "200, selected contract/source chain" },
        { "method": "GET", "path": "/api/projects/${project}/contract-readiness?contractId=${contract}", "expectRust": "200 same current package, business rows unchanged" },
        { "method": "POST", "path": "/api/contract-readiness-packages/${readiness}:initializeContractSnapshot", "body": "contractId, optional matching package ID, comment, current expectedVersion", "expectRust": "200 preparationId exists, status prepared, snapshotId null, contract not Active, no active snapshot" },
        { "method": "POST", "path": "/api/contracts/${contract}:submitReview", "body": "explicit preparationId and current contract expectedVersion", "expectRust": "approval/todo/contract transition and exact contract_review_binding atomically persisted" },
        { "method": "POST", "path": "/api/approval-records/${approval}:approve", "body": "Root actual canonical approval path/DTO and real assigned reviewer", "expectRust": "approved binding remains the same preparation/hash" },
        { "method": "POST", "path": "/api/contracts/${contract}:activate", "body": "expectedVersion", "expectRust": "active snapshot ID differs from preparationId; source_preparation_id points to exact approved preparation; contract Active" },
        { "method": "POST", "path": "/api/contract-readiness-packages/${readiness}:initializeReceivablePlan", "body": "contractId, snapshot/source assertion and expectedVersion under Root-frozen DTO", "expectRust": "real formal current plan version and 3 exact nodes; sum188000.00, date-only and source refs intact" },
        { "method": "POST", "path": "/api/contracts/${contract}/receipt-records", "body": "C-frozen positive exact amount and this Active contract", "expectRust": "ordinary receipt registration independent of plan prerequisite; C records its own actual confirmation chain" }
      ],
      "nativeReference": "Current Native can emit marker IDs but has no preparation or plan persistence. Capture the exact stage it diverges; do not assert Native business pass for missing producers.",
      "pg": ["existing-six-table-full-rows", "prepared-and-active-output-full-rows", "formal-plan-version-and-nodes", "approval-binding-audit-session"]
    },
    { "id": "A-chain02", "name": "真实投标路径", "variantOf": "A-chain01", "changes": ["real bid process with permissible won/current result and complete materials", "pricingPath=bid and exact current bidCommercialProcessId"], "expectRust": "same real output chain, direct fallback cannot bypass lost/cancelled/no-bid blockers" },
    { "id": "A-auth01", "name": "九入口认证矩阵", "operations": ["A01","A02","A03","A04","A05","A06","A07","A08","A09"], "variants": ["no cookie", "expired session", "revoked session", "disabled account", "authenticated without project permission", "read-only project:read", "write-only project:write", "correct permission"], "expectRust": "401/403 or allowed per frozen common guards; denied business delta zero; security/session artifacts separated" },
    { "id": "A-auth02", "name": "五写CSRF矩阵与解析顺序", "operations": ["A01","A04","A05","A08","A09"], "variants": ["missing header", "missing cookie", "mismatch", "token from another session", "valid", "malformed body plus missing CSRF"], "expectRust": "shared guard order and csrf_failed behavior, zero business delta on denial; GET has no CSRF requirement" },
    { "id": "A-id01", "name": "UUID身份与跨项目", "operations": ["A01","A04","A05","A06","A07","A08","A09"], "variants": ["all valid source UUID letters uppercase", "mixed-case equal path/body IDs", "malformed UUID", "nonexistent UUID", "other project baseline", "other baseline diff", "diff.projectId wrong", "other project contract", "preparation owned by contract2"], "expectRust": "case-insensitive parsed UUID identity succeeds where same resource; wrong ownership/malformed IDs reject without mutation or fallback" },
    { "id": "A-id02", "name": "路径与body包ID冲突", "operations": ["A08","A09"], "body": { "contractReadinessPackageId": "${differentReadiness}", "contractId": "${contract}", "comment": "cannot silently ignore source mismatch" }, "expectRust": "reject inconsistent source identity; body never redirects command away from path" },
    { "id": "A-route01", "name": "已清退route不复活", "requests": ["POST /api/commercial-release-baselines/${baseline}/review-diff", "POST /api/contract-readiness-packages/${readiness}/initialize-contract-snapshot", "POST /api/contract-readiness-packages/${readiness}/initialize-receivable-plan", "GET /api/projects/${project}/contract-readiness/current"], "expectRust": "no alias; no business delta; framework HTML/JSON 404 body differences alone are not business blockers" },
    { "id": "A-money01", "name": "合同金额精度", "target": "commercialTerms.amountTaxInclusive / amountTaxExclusive and selected contract inputs", "valid": ["0.01", "1", "188000.00", "9999999999999999.99"], "invalid": ["0", "-0.01", "1.001", "99999999999999999.99", "10000000000000000.00", "NaN", "Infinity", "1e3", "", " 1.00 "], "expectRust": "positive finite exact18,2 under user decision; preserve exact cents; any lexical trim policy Root freezes explicitly; no silent PG round or float" },
    { "id": "A-money02", "name": "比例和跨精度", "targets": ["taxRate", "downPaymentRate", "retentionRate"], "valid": ["0", "1", "0.0600", "0.2000"], "invalid": ["-0.0001", "1.0001", "0.12345", "NaN", "1e-2"], "crossSource": "R3 numeric(18,8) rate0.12345678 cannot silently become A numeric(5,4)0.1235", "expectRust": "Root-frozen ratio0..1 scale4, reject or explicit re-approved conversion; financial facts do not truncate" },
    { "id": "A-seed01", "name": "结构化计划节点", "variants": ["valid three seeds", "empty seeds", "duplicate nodeKey", "duplicate sortOrder", "zero/negative node amount", "sum off by0.01", "retention amount inconsistent", "retention dueDate mismatch", "date2027-02-29", "date2028-02-29", "datetime instead of date", "free-text paymentTerms only"], "expectRust": "only exact valid source nodes produce plan; valid leap date remains same date on Windows/Linux/PG timezones; prose never parsed as authoritative seeds" },
    { "id": "A-source01", "name": "服务端派生不能被body覆盖", "method": "POST", "path": "/api/contract-readiness-packages", "variants": ["no current cost", "tax review pending", "cost blocker count>0", "bid lost/cancelled", "pricing pending/rejected/escalation", "required pricing condition open", "stale cost ref", "stale bid ref", "pricing baseline from another project", "pricing quote amount/currency mismatch", "body ready+allowed+missing0+emptyitems over blocked real facts"], "expectRust": "actual source facts determine blockers/guard; no prepared or active output from self-reported ready fields" },
    { "id": "A-source02", "name": "draft baseline非循环来源顺序", "steps": ["A01 persists draft candidate", "R3 release references exact candidate", "A05 re-reads real current chain and promotes candidate only after all business checks"], "negative": ["A01 claims effective without actual release", "pricing release uses nonexistent baseline", "pricing release references wrong project baseline", "candidate payload mutated after release", "source pricing snapshot reference exists but proves no supported quotation approval handler"], "expectRust": "actual candidate->pricing->derived readiness chain; existence/FK/summary references are not claimed to be nonexistent quotation approval execution" },
    { "id": "A-diff01", "name": "真实差异等级边界", "vectors": ["amount deviation3.00%", "amount deviation3.01%", "margin9.9999%->10%", "margin29.9999%->30%", "downpayment19.99%->20%", "absolute downpayment5.00pp/5.01pp", "tax rate change", "node add/remove/reorder", "planned date shift10/11calendar days", "retention/scope condition change"], "expectRust": "Root-frozen formal threshold/algorithm computed from immutable left/right fields; diffLevel body cannot lower severity" },
    { "id": "A-diff02", "name": "复核来源/覆盖/双角色", "method": "POST", "path": "/api/commercial-release-baselines/${baseline}:reviewDiff", "variants": ["prompt no review needed", "review-required pending approve", "review-required reject", "reapproval-required approve", "reapproval-required reject", "unknown reviewedFieldKey", "missing required field", "sales role only", "finance role only", "required roles complete", "attachment ID not owned/existing"], "expectRust": "real diff/context and formal role coverage; reapproval cannot be made approved; audit and history preserve exact actor/fields/attachments; schema/permission changes Root-owned" },
    { "id": "A-current01", "name": "项目多合同选择与历史回看", "steps": ["produce current contract1 readiness", "A07 without contractId returns it for single-contract compatibility", "produce current contract2 readiness explicitly", "A07 no contractId yields409 contract_selection_required", "A07 with each contractId returns corresponding package", "A06 old package ID returns historical real source, no writes"], "expectRust": "never latest/first arbitrary contract; selectedContractId/project ownership coherent" },
    { "id": "A-current02", "name": "替代与current唯一", "variants": ["new baseline code", "duplicate current code", "reuse superseded code", "new package samecontract/source", "new package othercontract", "initialize superseded package"], "expectRust": "no duplicate current per frozen scope; baseline code conflict409; stale source cannot prepare; history remains; current scope is explicit rather than inferred from latest timestamp" },
    { "id": "A-prep01", "name": "真实prepared产物存在性", "method": "POST", "path": "/api/contract-readiness-packages/${readiness}:initializeContractSnapshot", "body": "explicit contractId/current versions/comment", "expectRust": ["preparation row and frozen seeds exist", "preparationId returned", "snapshotId null", "package.initializedContractSnapshotId remains null until actual active snapshot", "contract.currentSnapshotId null and status draft", "preparationId is not merely a reserved UUID"] },
    { "id": "A-prep02", "name": "初始化守卫读写一致", "variants": ["guard review-required", "package blocked", "conditional with unmet requirement", "missingPrerequisiteCount>0", "blocked actual item", "diff pending", "baseline superseded", "contract non-draft", "missing explicit contract core terms/seeds"], "expectRust": "no prepared output, necessary blocker/result semantics consistent with allowedActions; no Native guard review-required bypass" },
    { "id": "A-prep03", "name": "prepare幂等与新版本", "steps": ["A08 exact first initialization", "snapshot full rows/timestamps/versions/audit", "A08 exact same source+contract again", "create new source/readiness and reprepare only in allowed draft state"], "expectRust": "exact repeat returns same preparation/no changed timestamp/version/duplicate success audit; explicit new inputs create version+1, supersedes pointer and prior immutable payload preserved" },
    { "id": "A-bind01", "name": "审批精确绑定而非latest", "steps": ["prepare P1", "submit review explicitly binds P1", "attempt P2 source/preparation replacement while pending", "approve actual bound record", "attempt activation with body P2/latest source", "activate approved P1 only if still eligible"], "expectRust": "pending bound payload cannot change; wrong/stale source rejects or requires explicit reprepare+reapproval, no automatic source switch" },
    { "id": "A-active01", "name": "准备与生效UUID分离", "steps": ["approve preparation", "activate contract", "GET readiness/contract/snapshot"], "expectRust": "active snapshot.id differs from preparation.id and references it via source_preparation_id; exact approved fields/seeds preserved; one active snapshot percontract; preparation.status activated" },
    { "id": "A-plan01", "name": "正式计划时点和真实节点", "method": "POST", "path": "/api/contract-readiness-packages/${readiness}:initializeReceivablePlan", "variants": ["draft contract", "pending-review contract", "prepared only", "Active without valid current snapshot", "snapshot belonging contract2", "valid Active+exact effective snapshot", "later unrelated project pricing changed"], "expectRust": "only valid selected Active snapshot creates real version/nodes/init record; frozen active source remains authoritative after unrelated later project quote, no random marker output" },
    { "id": "A-plan02", "name": "计划幂等版本和拒绝整包改写", "steps": ["A09 initial production", "repeat exact command", "try supplying changed node amounts/dates through request", "attempt stale expectedVersion"], "expectRust": "same actual version returned with no duplicate nodes/init audit/timestamps, caller cannot rewrite frozen seeds, stale version409 and zero mutation" },
    { "id": "A-multi01", "name": "同项目双合同独立金额与输出隔离", "steps": ["explicitly provide independent contract1 and contract2 commercial amounts/terms/seeds", "choose contract amounts whose sum differs from project quote and capture computed differences/reviews", "prepare both with separate preparation IDs after their own source/diff/review rules pass", "approve/activate each exact binding", "initialize each plan from its own active snapshot"], "expectRust": "distinct prep/snapshot/plan IDs each owned by selectedcontract; no shared reservedsnapshot ID, no copying projecttotal, no autoallocation, no aggregate hard-budget equality rejection; per-contract source and difference are auditable and node sum equals that contract's own frozen total" },
    { "id": "A-actor01", "name": "伪造createdBy和comment留痕", "variants": ["body.createdBy=otherUser", "body.updatedBy=otherUser", "init comment nonempty", "review field/attachment comment"], "expectRust": "session actor controls operator and necessary audit; legitimate provenance distinct; comments persist in real initialization/review record rather than ignored" },
    { "id": "A-cas01", "name": "逐命令版本故障", "operations": ["A04","A08","A09"], "variants": ["saved old rowVersion", "explicit mismatching version", "source version changes after read before TX lock", "row_version int4 overflow at increment"], "expectRust": "conflict/failure and full rollback of parent/children/audit/session; no pre-TX-only validation" },
    { "id": "A-concurrent01", "name": "受控并发创建", "pairs": ["A01 sameproject/differentcode", "A01 sameproject/samecode", "A05 samecontract/samesource", "A05 contract1 vscontract2"], "barrier": "Root records both HTTPs blocked before final source/CAS section then releases together", "expectRust": "serializable source/current result under projectlock, unique current/version constraints, conflict classified, no orphans or duplicate current rows" },
    { "id": "A-concurrent02", "name": "受控并发review/init/source替代", "pairs": ["approve vs reject same diff version", "A08 vs A08 samecontract/source", "A09 vs A09 same active snapshot", "A08 vs A09 same package expectedVersion", "R3 cost/bid/pricing replace vs A05/A08", "Bactivate vs new preparation/source replacement"], "expectRust": "Root-frozen winner/conflict behavior; exactly one valid product per idempotency key, no lost update, no wrong-source approval/snapshot/plan, all necessary audit/session coherent" },
    { "id": "A-fault01", "name": "真实PG逐边拒写回滚", "faults": ["baseline insert", "diff insert", "diffitem insert after baseline", "reviewRecord insert", "diff CAS after reviewRecord", "packageitem after package/current switch", "source-ref/seed child after parent", "preparation initRecord after preparation", "Bactive contract update after snapshot", "plan node after version insert", "plan initRecord after nodes", "necessary success audit insert", "pending session flush after all business writes"], "mechanism": "Root controlled own-cohort PostgreSQL role/trigger failure, captured real fault hit; no production DB or broad failure injection", "expectRust": "each failure returns unsuccessful command and exact pre-state across business/current/version/source/audit/pending session; no dangling returned IDs" },
    { "id": "A-query01", "name": "四GET业务no-op与敏感投影", "operations": ["A02","A03","A06","A07"], "variants": ["full-permission actor", "project:read actor with masked sensitive fields", "single/multi-contract selector", "history after source supersession"], "repeat": 2, "expectRust": "no business/source/current/version/generated-output changes between before/after full-row probes; session touch and security events separately labeled; Root-frozen projection prevents unprivileged exact economics disclosure" },
    { "id": "A-cleanup01", "name": "清理归属与二次零变化", "steps": ["Root inventories every own-run source/output/audit/session row before mutation cleanup", "Root removes only explicit cohort in FK-safe order and restores seed/catalog/session baseline as authorized", "Root repeats read-only cleanup inventory"], "expectRust": "no remaining owncohort rows/orphans, no unrelated IDs removed; second pass0 changes; raw failed/partial/Native reference artifacts preserved" }
  ]
}

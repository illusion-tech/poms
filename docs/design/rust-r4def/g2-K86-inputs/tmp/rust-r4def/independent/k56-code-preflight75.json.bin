  "findings": [
    {
      "id": "K56-P2-01",
      "priority": "P2",
      "title": "Idempotent Link branches bypass the frozen no-dirty mutation-intent protocol",
      "locations": [
        {
          "file": "apps/poms-api-rust/src/attachments/service.rs",
          "line": 1549,
          "detail": "Existing active tuple returns get() directly, without guarded persist."
        },
        {
          "file": "apps/poms-api-rust/src/attachments/service.rs",
          "line": 1580,
          "detail": "Already inactive Link skips audit/persist and returns get()."
        },
        {
          "file": "apps/poms-api-rust/src/attachments/store.rs",
          "line": 1465,
          "detail": "The no-work return does not treat source_entities alone as a forcing mutation intent."
        }
      ],
      "authority": [
        {
          "file": "tools/rust-r4def/F/K55/PROPOSAL55.md",
          "line": 64,
          "detail": "No-dirty mutator authorization proof and replayed Link tuple must be rechecked under the group protocol."
        },
        {
          "file": "tools/rust-r4def/F/K55/proposal55.json",
          "line": 95,
          "detail": "Carry explicit mutation authorization/head/group intent even when values happen to be unchanged."
        }
      ],
      "trigger": "A repeated link finds an existing tuple, or unlink sees an already inactive row; a cooperative group/link/flag writer can change the prepared authorization/source set before this branch responds.",
      "observedStaticBehavior": "Both branches bypass Session/group/Attachment/Link guarded recheck and their local pending flush. get() performs reads but neither calls persist nor takes the canonical group lock. No actual race was executed by this reviewer.",
      "impact": "The exact accepted K55 no-dirty intent guarantee is absent on these successful mutator paths; the 33 pure checks and K71 positive chain cannot certify it.",
      "requiredCorrection": "Within the existing three-file whitelist, preserve sequential idempotent no-op behavior and existing audit semantics, but register explicit no-op Link/unlink intent, enter the common guarded flush even with no dirty values, and recheck the expected tuple/set plus first Attachment proof under the canonical group lock. Changed prepared proofs follow the frozen conflict policy; pending auth is consumed only on the acknowledged commit.",
      "requiredValidation": [
        "Actual controlled no-op repeated-link vs unlink/link-set change with unchanged head rowVersion.",
        "Actual no-op Link/unlink vs relevant metadata/flag/complete group mutation, with two distinct real sessions and PG lock proof.",
        "No-op sequential response preserved; no spurious successful business audit type is introduced.",
        "Known failure restores the call baseline; unknown result cannot trigger another flush."
      ]
    }
  ],
